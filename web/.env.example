# math-study 프로덕션 환경변수 예시.
# 실제 값은 PaaS 대시보드(Railway/Render)의 Variables 에 넣는다 — 이 파일을 .env 로
# 복사해 커밋하지 말 것(.env 는 .gitignore 됨). 로컬 개발용 기본값은 코드에 내장돼 있어
# 비워둬도 dev 서버는 뜬다. 아래는 "프로덕션에서 반드시 채워야 하는" 목록이다.

# ── 필수 ──────────────────────────────────────────────────────

# 관리형 Postgres 접속 문자열(Railway/Render 가 자동 주입하는 DATABASE_URL 을 여기에 매핑).
#   ★프로덕션(NODE_ENV=production)에서 이 값이 없으면 db.ts 가 의도적으로 기동 실패한다
#     (약한 dev 기본 자격증명 mathstudy:mathstudy 로 조용히 뜨는 것을 차단).
#   형식: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#   Railway 관리형 PG 는 보통 sslmode 가 필요 → ...?sslmode=require 를 붙인다.
MATH_STUDY_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 쿠키 Secure 플래그(HTTPS 전용 전송). 프로덕션은 항상 true.
#   NODE_ENV=production 이면 코드가 자동 true 로도 켜지지만 명시 권장.
MATH_STUDY_SECURE_COOKIES=true

# 런타임 모드. db.ts 의 프로덕션 가드·쿠키 Secure 기본값·Astro 최적화를 켠다.
NODE_ENV=production

# 바인드 포트/호스트. @astrojs/node standalone 이 네이티브로 읽는다.
#   ★PaaS 는 보통 PORT 를 동적으로 주입한다 → 그 값을 그대로 쓰게 두고 하드코딩하지 말 것.
#   HOST 는 컨테이너 외부 노출을 위해 0.0.0.0 고정.
PORT=8080
HOST=0.0.0.0

# ── 선택 ──────────────────────────────────────────────────────

# 단일 사용자 시스템의 고정 UUID(멀티유저 전환 전까지 기본값 사용 권장 → 보통 비워둠).
# MATH_STUDY_USER_ID=00000000-0000-0000-0000-000000000001

# ── 향후(현재 미사용 — 자리만 표시) ───────────────────────────

# LLM 튜터/교정기 API 키(현재 self-host claude -p 경유라 웹 런타임 불요. API 직결 전환 시).
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# 결제/구독(유료화 도입 시).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Google OAuth 로그인(슬롯만 존재 — 활성화 시).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
