ku","v":1},"functions/middle-1/좌표평면과_그래프/선분의_내분":{"figure":{"shapes":[{"type":"segment","from":[1,2],"to":[7,8]},{"type":"point","at":[1,2],"label":"A","labelDir":"W"},{"type":"point","at":[7,8],"label":"B","labelDir":"E"},{"type":"point","at":[3,4],"label":"P","labelDir":"S"},{"type":"point","at":[4,5],"label":"M","labelDir":"N"}],"showAxes":true,"range":[0,8],"yRange":[1,9],"title":"선분의 내분과 중점"},"label":"선분의 내분","note":"선분 AB를 1:2로 내분하는 점 P와 중점 M(1:1 내분)의 위치를 좌표로 표현합니다.","model":"haiku","v":1},"equations/high-1/방정식과_부등식/포물선과_직선의_교점":{"figure":{"shapes":[{"type":"parabola","vertex":[0,-1],"focus":[0,-0.75],"orientation":"up"},{"type":"segment","from":[-2,-1],"to":[2.5,3.5]},{"type":"point","at":[-1,0],"label":"(-1, 0)","labelDir":"NW"},{"type":"point","at":[2,3],"label":"(2, 3)","labelDir":"NE"},{"type":"text","at":[2.2,3.5],"text":"y = x + 1"},{"type":"text","at":[-1.5,2],"text":"y = x^2 - 1"}],"showAxes":true,"range":[-2.5,3],"yRange":[-2,5.5],"title":"포물선과 직선의 교점"},"label":"포물선과 직선의 교점","note":"y = x² - 1과 y = x + 1의 교점은 (-1, 0)과 (2, 3). 판별식 D > 0일 때 서로 다른 두 점에서 만남.","model":"haiku","v":1},"geometry/geometry-elective/이차곡선/타원_접선":{"figure":{"shapes":[{"type":"ellipse","center":[0,0],"rx":3,"ry":2},{"type":"point","at":[1.5,"sqrt(3)"],"label":"P","labelDir":"NE"},{"type":"segment","from":[-0.5,"13*sqrt(3)/9"],"to":[4,"4*sqrt(3)/9"],"label":"접선"}],"showAxes":false,"range":[-3.5,4.5],"yRange":[-2.5,3],"title":"타원 위의 점에서의 접선"},"label":"타원 접선","note":"타원 위의 점에서의 접선은 그 점의 좌표를 타원 방정식에 대입한 형태 $\\frac{xx_0}{a^2} + \\frac{yy_0}{b^2} = 1$로 표현된다.","model":"haiku","v":1},"geometry/geometry-elective/평면벡터/벡터의_합과_실수배":{"figure":{"shapes":[{"type":"point","at":[0,0],"label":"O","labelDir":"SW"},{"type":"point","at":[2.5,1],"label":"A","labelDir":"NW"},{"type":"point","at":[3.5,3.5],"label":"B","labelDir":"NE"},{"type":"point","at":[1,2.5],"label":"B'","labelDir":"E"},{"type":"vector","from":[0,0],"to":[2.5,1],"label":"$\\vec{a}$"},{"type":"vector","from":[0,0],"to":[1,2.5],"label":"$\\vec{b}$"},{"type":"vector","from":[0,0],"to":[3.5,3.5],"label":"$\\vec{a}+\\vec{b}$"},{"type":"vector","from":[0,0],"to":[5,2],"label":"$2\\vec{a}$"}],"showAxes":false,"range":[-0.5,5.5],"yRange":[-0.5,4],"title":"벡터의 합과 실수배"},"label":"벡터의 합과 실수배","note":"삼각형 법칙(O→A→B)과 평행사변형 법칙(O-A-B-B' 평행사변형)을 동시에 표현하며, 실수배 예시($2\\vec{a}$)를 포함.","model":"haiku","v":1},"geometry/high-1/도형의_방정식/원의_방정식":{"figure":{"shapes":[{"type":"circle","center":[1,2],"radius":3},{"type":"point","at":[1,2],"label":"C(a,b)","labelDir":"SW"},{"type":"point","at":[4,2],"label":"P(x,y)","labelDir":"E"},{"type":"segment","from":[1,2],"to":[4,2],"label":"r"}],"showAxes":true,"range":[-3,5],"yRange":[-2,6],"title":"원의 방정식"},"label":"원의 방정식","note":"중심 C(a,b)으로부터 일정한 거리 r에 있는 모든 점 P(x,y)의 집합이 원이며, 거리 공식을 적용하면 (x-a)²+(y-b)²=r²을 얻습니다.","model":"haiku","v":1},"geometry/middle-3/삼각비/삼각비_관계":{"figure":{"shapes":[{"type":"point","at":[0,0],"label":"O","labelDir":"SW"},{"type":"point","at":[3,0],"label":"A","labelDir":"SE"},{"type":"point","at":[3,4],"label":"B","labelDir":"NE"},{"type":"segment","from":[0,0],"to":[3,0],"label":"x"},{"type":"segment","from":[3,0],"to":[3,4],"label":"y"},{"type":"segment","from":[0,0],"to":[3,4],"label":"r"},{"type":"angle","at":[3,0],"from":[0,0],"to":[3,4],"label":"90°","radius":0.3},{"type":"angle","at":[0,0],"from":[3,0],"to":[3,4],"label":"θ","radius":0.7}],"showAxes":false,"range":[-0.5,3.5],"yRange":[-0.5,4.5],"title":"삼각비의 기본 항등식"},"label":"삼각비 관계","note":"sin²θ + cos²θ = (y/r)² + (x/r)² = (x²+y²)/r² = 1 (피타고라스 정리)","model":"haiku","v":1},"functions/math-1/삼각함수/피타고라스_삼각공식":{"figure":{"shapes":[{"type":"circle","center":[0,0],"radius":1},{"type":"segment","from":[0,0],"to":[0.5,"sqrt(3)/2"]},{"type":"point","at":[0.5,"sqrt(3)/2"],"label":"P","labelDir":"NE"},{"type":"segment","from":[0.5,0],"to":[0.5,"sqrt(3)/2"],"dashed":true},{"type":"segment","from":[0,"sqrt(3)/2"],"to":[0.5,"sqrt(3)/2"],"dashed":true},{"type":"angle","at":[0,0],"from":[1,0],"to":[0.5,"sqrt(3)/2"],"label":"\\theta","radius":0.25}],"showAxes":true,"range":[-1.3,1.3],"yRange":[-1.3,1.3],"title":"피타고라스 삼각공식"},"label":"피타고라스 삼각공식","note":"단위원 위의 점 P(cos θ, sin θ)에서 cos²θ + sin²θ = 1이 자동으로 성립","model":"haiku","v":1}}}