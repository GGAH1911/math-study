  "conditions": [
    "두 평면 α, β 는 서로 수직",
    "A, B 는 두 평면 α, β 의 교선 위의 점",
    "C 는 평면 α 위의 점",
    "D 는 평면 β 위의 점",
    "AC = 2√29",
    "BC = 6",
    "AD = 6",
    "BD = 6",
    "∠ABC = π/2",
    "D 와 평면 α 사이의 거리 = 4 (D 는 평면 α 밖의 점)",
    "M 은 선분 AB 의 중점이고 평면 α 위의 점",
    "DM ⟂ AB, DM ⟂ BC — 즉 DM ⟂ 평면 α 이므로 M 은 D 의 평면 α 위로의 정사영",
    "CD = 6√2",
    "CM = 2√14 (선분 CD 의 평면 α 위로의 정사영)",
    "∠DCM = θ 이고 cos θ = √7/3"
  ],
  "verify": "from sympy import acos\n\ns5 = sqrt(5)\n\n# ── 교선을 x축, 평면 alpha 를 z=0, 평면 beta 를 y=0 으로 두고 좌표를 잡는다.\nalpha = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]   # 평면 alpha (z = 0)\nbeta  = [(0, 0, 0), (1, 0, 0), (0, 0, 1)]   # 평면 beta  (y = 0)\n\nA = (0, 0, 0)\nB = (4*s5, 0, 0)\nC = (4*s5, -6, 0)\nD = (2*s5, 0, 4)\nM = (2*s5, 0, 0)      # D 에서 평면 alpha 에 내린 수선의 발 (= AB 의 중점)\n\n# ── 두 평면\nassert_planes_perpendicular(alpha, beta, \"두 평면 alpha, beta 는 서로 수직\")\n\n# ── A, B 는 교선 위 (두 평면 모두 위)\nassert_on_plane(A, alpha, \"A 는 평면 alpha 위\")\nassert_on_plane(A, beta,  \"A 는 평면 beta 위 (=> A 는 교선 위)\")\nassert_on_plane(B, alpha, \"B 는 평면 alpha 위\")\nassert_on_plane(B, beta,  \"B 는 평면 beta 위 (=> B 는 교선 위)\")\n\n# ── C 는 alpha 위, D 는 beta 위\nassert_on_plane(C, alpha, \"C 는 평면 alpha 위\")\nassert_on_plane(D, beta,  \"D 는 평면 beta 위\")\n\n# ── 길이 조건\nassert_distance(A, C, 2*sqrt(29), \"AC = 2sqrt(29)\")\nassert_distance(B, C, 6, \"BC = 6\")\nassert_distance(A, D, 6, \"AD = 6\")\nassert_distance(B, D, 6, \"BD = 6\")\n\n# ── 각 조건\nassert_angle(B, A, C, pi/2, \"각 ABC = pi/2\")\n\n# ── D 는 평면 alpha 밖 (진짜 입체)\nassert_point_plane_distance(D, alpha, 4, \"D 와 평면 alpha 의 거리 = 4\")\n\n# ── M 은 AB 의 중점이자 D 의 alpha 위 정사영\nassert_distance(M, tuple((Matrix(A) + Matrix(B))/2), 0, \"M 은 AB 의 중점\")\nassert_on_plane(M, alpha, \"M 은 평면 alpha 위\")\nassert_perpendicular(D, M, A, B, \"DM 수직 AB\")\nassert_perpendicular(D, M, B, C, \"DM 수직 BC  (=> DM 수직 평면 alpha, M 은 D 의 정사영)\")\n\n# ── 직선 CD 와 평면 alpha 가 이루는 예각 theta\nassert_distance(C, D, 6*sqrt(2), \"CD = 6sqrt(2)\")\nassert_distance(C, M, 2*sqrt(14), \"CM = 2sqrt(14) (CD 의 alpha 위 정사영)\")\nassert_angle(C, D, M, acos(sqrt(7)/3), \"각 DCM = theta, cos(theta) = sqrt(7)/3\")\n",
  "note": "D 에서 평면 α 에 내린 수선의 발 M 은 AD=BD 때문에 교선 AB 의 중점입니다. 그러면 θ 는 직각삼각형 DMC 의 ∠DCM 이고, cos θ = CM/CD 로 바로 구해집니다."
