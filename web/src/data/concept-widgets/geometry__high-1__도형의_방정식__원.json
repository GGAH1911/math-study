{
 "id": "geometry/high-1/도형의_방정식/원",
 "spec": {
  "title": "원의 방정식 (x−a)²+(y−b)²=r²",
  "params": [
   {
    "name": "a",
    "label": "중심 x (a)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "b",
    "label": "중심 y (b)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "r",
    "label": "반지름 r",
    "type": "slider",
    "min": 0.5,
    "max": 5,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "theta",
    "label": "점 위치 θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 0,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; px=a+r*cos(rad); py=b+r*sin(rad); dist=sqrt((px-a)^2+(py-b)^2)",
  "geometry": {
   "range": [
    -7,
    7
   ],
   "yRange": [
    -7,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      "=a",
      "=b"
     ],
     "radius": "=r"
    },
    {
     "type": "point",
     "at": [
      "=a",
      "=b"
     ],
     "label": "C(a,b)"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      "=b"
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "r"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "중심 C",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "반지름 r",
    "expr": "r",
    "digits": 2
   },
   {
    "label": "CP 거리",
    "expr": "dist",
    "digits": 4
   },
   {
    "label": "P의 x",
    "expr": "px",
    "digits": 3
   },
   {
    "label": "P의 y",
    "expr": "py",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "r": 3,
    "theta": 0
   },
   {
    "a": 0,
    "b": 0,
    "r": 2,
    "theta": 90
   },
   {
    "a": -2,
    "b": 1,
    "r": 4,
    "theta": 210
   },
   {
    "a": 3,
    "b": -1,
    "r": 1.5,
    "theta": 135
   }
  ],
  "invariants": [
   "(px-a)^2+(py-b)^2-r^2",
   "dist-r"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2,
     "r": 3,
     "theta": 0
    },
    "expect": {
     "px": 4,
     "py": 2,
     "dist": 3
    }
   },
   {
    "params": {
     "a": 0,
     "b": 0,
     "r": 2,
     "theta": 90
    },
    "expect": {
     "px": 0,
     "py": 2,
     "dist": 2
    }
   },
   {
    "params": {
     "a": 3,
     "b": -1,
     "r": 1.5,
     "theta": 180
    },
    "expect": {
     "px": 1.5,
     "py": -1,
     "dist": 1.5
    }
   }
  ],
  "tol": 0.000001
 }
}