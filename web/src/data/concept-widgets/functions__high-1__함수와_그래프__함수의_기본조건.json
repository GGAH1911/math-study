{
 "id": "functions/high-1/함수와_그래프/함수의_기본조건",
 "spec": {
  "title": "수직선 판정법: y²=x는 함수일까?",
  "params": [
   {
    "name": "a",
    "label": "수직선 x=a",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 2,
    "step": 0.25,
    "unit": ""
   }
  ],
  "scope": "yp = sqrt(a); yn = -sqrt(a); diff = yp - yn",
  "plot": {
   "range": [
    -1,
    4.5
   ],
   "yRange": [
    -2.5,
    2.5
   ],
   "fns": [
    {
     "fn": "sqrt(x)",
     "label": "y=√x (위쪽 가지)",
     "color": "#059669"
    },
    {
     "fn": "-sqrt(x)",
     "label": "y=-√x (아래쪽 가지)",
     "color": "#059669"
    }
   ]
  },
  "readout": [
   {
    "label": "위쪽 대응값 yp",
    "expr": "yp",
    "digits": 3
   },
   {
    "label": "아래쪽 대응값 yn",
    "expr": "yn",
    "digits": 3
   },
   {
    "label": "한 x=a 에 대응하는 y 개수",
    "expr": "a>0 ? 2 : 1",
    "digits": 0
   },
   {
    "label": "두 값의 간격 |yp-yn|",
    "expr": "diff",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": 4
   },
   {
    "a": 2.25
   },
   {
    "a": 0.25
   }
  ],
  "invariants": [
   "yp^2 - a",
   "yn^2 - a",
   "yp + yn",
   "diff - 2*sqrt(a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 4
    },
    "expect": {
     "yp": 2,
     "yn": -2,
     "diff": 4
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "yp": 1,
     "yn": -1,
     "diff": 2
    }
   },
   {
    "params": {
     "a": 2.25
    },
    "expect": {
     "yp": 1.5,
     "yn": -1.5,
     "diff": 3
    }
   }
  ],
  "tol": 0.000001
 }
}