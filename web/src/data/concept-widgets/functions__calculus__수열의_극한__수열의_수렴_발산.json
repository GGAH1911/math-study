    "expr": "L",
    "digits": 2
   },
   {
    "label": "N (이후 모든 항이 ε-띠 안)",
    "expr": "Nn",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "L": 1,
    "A": 1.5,
    "eps": 0.3
   },
   {
    "L": 0,
    "A": 1,
    "eps": 0.5
