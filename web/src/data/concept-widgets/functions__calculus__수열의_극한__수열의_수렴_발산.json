      "=Llow"
     ],
     "label": "L-ε",
     "color": "#e67e22"
    },
    {
     "type": "segment",
     "from": [
      "=Nr",
      -3.5
     ],
     "to": [
      "=Nr",
      3.5
     ],
     "label": "n=N",
