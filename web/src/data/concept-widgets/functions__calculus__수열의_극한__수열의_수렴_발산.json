{
 "id": "functions/calculus/수열의_극한/수열의_수렴_발산",
 "spec": {
  "title": "수열의 수렴·발산: ε–N 정의 탐구",
  "params": [
   {
    "name": "L",
    "label": "극한 L",
    "type": "slider",
    "min": -1,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "A",
    "label": "진폭 A",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "eps",
    "label": "오차범위 ε",
    "type": "slider",
    "min": 0.05,
    "max": 1,
    "init": 0.3,
    "step": 0.05
   }
  ],
  "scope": "Lup=L+eps; Llow=L-eps; Nr=abs(A)/eps; Nn=ceil(abs(A)/eps); a4=L+A*(-1)^4/4; a5=L+A*(-1)^5/5",
  "geometry": {
   "range": [
    0,
    15
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      "=L"
     ],
     "to": [
      15,
      "=L"
     ],
     "label": "L",
     "color": "#888888"
    },
    {
     "type": "segment",
     "from": [
      0,
      "=Lup"
     ],
     "to": [
      15,
      "=Lup"
     ],
     "label": "L+ε",
     "color": "#e67e22"
    },
    {
