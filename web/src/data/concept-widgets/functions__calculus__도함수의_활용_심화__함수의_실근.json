{
 "id": "functions/calculus/도함수의_활용_심화/함수의_실근",
 "spec": {
  "title": "삼차함수의 실근 개수 — 극값의 부호로 판정",
  "params": [
   {
    "name": "k",
    "label": "상수 k (그래프 상하 이동)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "fmax = (-1)^3 - 3*(-1) + k; fmin = 1^3 - 3*1 + k; prod = fmax * fmin",
  "geometry": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x + k",
     "label": "f(x)=x³-3x+k",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값 f(-1)",
    "expr": "fmax",
    "digits": 3
   },
   {
    "label": "극솟값 f(1)",
    "expr": "fmin",
    "digits": 3
   },
   {
    "label": "극값의 곱 (음수→실근 3개, 0→2개, 양수→1개)",
    "expr": "prod",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 0
   },
   {
    "k": 1.5
   },
   {
    "k": -2
   },
   {
    "k": 3
   }
  ],
  "invariants": [
   "fmax - fmin - 4",
   "fmax + fmin - 2*k"
  ],
  "oracle": [
   {
    "params": {
     "k": 0
    },
    "expect": {
     "fmax": 2,
     "fmin": -2,
     "prod": -4
    }
   },
   {
    "params": {
     "k": 2
    },
    "expect": {
     "fmax": 4,
     "fmin": 0,
     "prod": 0
    }
   },
   {
    "params": {
     "k": -3
    },
    "expect": {
     "fmax": -1,
     "fmin": -5,
     "prod": 5
    }
   }
  ],
  "tol": 0.000001
 }
}