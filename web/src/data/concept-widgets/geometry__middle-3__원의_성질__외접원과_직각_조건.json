{
 "id": "geometry/middle-3/원의_성질/외접원과_직각_조건",
 "spec": {
  "title": "외접원과 직각 조건 (탈레스 정리)",
  "params": [
   {
    "name": "phi",
    "label": "현 AB의 중심각 ∠AOB",
    "type": "slider",
    "min": 20,
    "max": 340,
    "init": 180,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "theta",
    "label": "점 C의 위치 θ",
    "type": "slider",
    "min": 2,
    "max": 358,
    "init": 60,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "r",
    "label": "C와 중심 O의 거리 |OC|",
    "type": "slider",
    "min": 0.15,
    "max": 1.8,
    "init": 1,
    "step": 0.05
   }
  ],
  "scope": "p=phi*pi/180; hx=sin(p/2); hy=-cos(p/2); ax=-hx; ay=hy; bx=hx; by=hy; rad=theta*pi/180; cx=r*cos(rad); cy=r*sin(rad); ux=ax-cx; uy=ay-cy; vx=bx-cx; vy=by-cy; la=sqrt(ux^2+uy^2); lb=sqrt(vx^2+vy^2); dot=ux*vx+uy*vy; den=(la*lb)<1e-9 ? 1e-9 : la*lb; cv=dot/den; cc=cv>1 ? 1 : (cv<-1 ? -1 : cv); ang=acos(cc)*180/pi; halfAB=hx; mx=0; my=hy; expect=cy>hy ? phi/2 : 180-phi/2",
  "geometry": {
   "range": [
    -2.1,
    2.1
   ],
   "yRange": [
    -1.85,
    1.85
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1,
     "stroke": "#1e6fd9"
    },
    {
     "type": "circle",
     "center": [
      0,
      "=my"
     ],
     "radius": "=halfAB",
     "stroke": "#9ca3af",
     "fillOpacity": 0
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=mx",
      "=my"
     ],
     "label": "M(AB의 중점)",
     "color": "#9ca3af"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=cy"
     ],
     "label": "C"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "AB"
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      "=cy"
     ],
     "to": [
      "=ax",
      "=ay"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      "=cy"
     ],
     "to": [
      "=bx",
      "=by"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "∠ACB (실제)",
    "expr": "ang",
    "digits": 2
   },
   {
    "label": "이론값 (C쪽 호 기준)",
    "expr": "expect",
    "digits": 2
   },
   {
    "label": "CA·CB (0이면 직각)",
    "expr": "dot",
    "digits": 4
   },
   {
    "label": "|OC| (1이면 C가 원 위)",
    "expr": "r",
    "digits": 2
   },
   {
    "label": "AB의 절반 (=직각삼각형 외접원 반지름)",
    "expr": "halfAB",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
