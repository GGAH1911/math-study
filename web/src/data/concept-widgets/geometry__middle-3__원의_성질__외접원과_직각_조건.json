   },
   {
    "phi": 180,
    "theta": 90,
    "r": 1.5
   }
  ],
  "invariants": [
   "cx^2+cy^2-r^2",
   "ax^2+ay^2-1",
   "bx^2+by^2-1"
  ],
  "oracle": [
