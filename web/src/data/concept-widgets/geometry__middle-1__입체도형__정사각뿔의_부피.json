{
 "id": "geometry/middle-1/입체도형/정사각뿔의_부피",
 "spec": {
  "title": "정사각뿔의 부피 V = ⅓a²h",
  "params": [
   {
    "name": "a",
    "label": "밑변 a",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 6,
    "step": 0.5,
    "unit": "cm"
   },
   {
    "name": "h",
    "label": "높이 h",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 8,
    "step": 0.5,
    "unit": "cm"
   }
  ],
  "scope": "A=a^2; V=A*h/3; prism=A*h; ratio=V/prism",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -1,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       "=-a/2",
       0
      ],
      [
       "=a/2",
       0
      ],
      [
       "=0",
       "=h"
      ]
     ],
     "label": "정사각뿔(옆면)"
    },
    {
     "type": "segment",
     "from": [
      "=0",
      0
     ],
     "to": [
      "=0",
      "=h"
     ],
     "label": "h"
    },
    {
     "type": "segment",
     "from": [
      "=-a/2",
      0
     ],
     "to": [
      "=a/2",
      0
     ],
     "label": "a"
    },
    {
     "type": "point",
     "at": [
      "=0",
      "=h"
     ],
     "label": "꼭짓점"
    }
   ]
  },
  "readout": [
   {
    "label": "밑넓이 a²",
    "expr": "A",
    "digits": 2
   },
   {
    "label": "부피 V=⅓a²h",
    "expr": "V",
    "digits": 2
   },
   {
    "label": "같은 밑면·높이 기둥 부피 a²h",
    "expr": "prism",
    "digits": 2
   },
   {
    "label": "부피비 V/기둥",
    "expr": "ratio",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 6,
    "h": 8
   },
   {
    "a": 3,
    "h": 4
   },
   {
    "a": 10,
    "h": 9
   },
   {
    "a": 6,
    "h": 6
   }
  ],
  "invariants": [
   "V*3 - prism",
   "V - a^2*h/3",
   "ratio - 1/3",
   "A - a^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 6,
     "h": 6
    },
    "expect": {
     "A": 36,
     "V": 72,
     "prism": 216
    }
   },
   {
    "params": {
     "a": 3,
     "h": 4
    },
    "expect": {
     "A": 9,
     "V": 12,
     "prism": 36
    }
   },
   {
    "params": {
     "a": 10,
     "h": 9
    },
    "expect": {
     "A": 100,
     "V": 300,
     "prism": 900
    }
   }
  ],
  "tol": 0.000001
 }
}