{
 "id": "geometry/middle-1/기본_도형/선분의_교점",
 "spec": {
  "title": "선분의 교점 — 두 선분이 만나는 점 P",
  "params": [
   {
    "name": "ch",
    "label": "점 C의 높이",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 4,
    "step": 0.1
   },
   {
    "name": "dp",
    "label": "점 D의 위치",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "cy=ch; dx=dp; ax=0; ay=0; bx=4; by=4; cx=0; dyy=0; px=cy*dx/(cy+dx); py=px",
  "geometry": {
   "range": [
    -1,
    6
   ],
   "yRange": [
    -1,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      4,
      4
     ],
     "label": "AB",
     "color": "#2563eb"
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      "=cy"
     ],
     "to": [
      "=dx",
      "=dyy"
     ],
     "label": "CD",
     "color": "#16a34a"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      4,
      4
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=cy"
     ],
     "label": "C"
    },
    {
     "type": "point",
     "at": [
      "=dx",
      "=dyy"
     ],
     "label": "D"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P(교점)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "교점 P의 x좌표",
    "expr": "px",
    "digits": 3
   },
   {
    "label": "교점 P의 y좌표",
    "expr": "py",
    "digits": 3
   },
   {
    "label": "P가 선분 AB 위 (y=x) 확인: y−x",
    "expr": "py-px",
    "digits": 6
   },
   {
    "label": "P가 선분 CD 위 확인: x/dx + y/cy − 1",
    "expr": "px/dx+py/cy-1",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "ch": 4,
    "dp": 4
   },
   {
    "ch": 2,
    "dp": 4
   },
   {
    "ch": 5,
    "dp": 1
   },
   {
    "ch": 3,
    "dp": 2
   }
  ],
  "invariants": [
   "py-px",
   "px/dx+py/cy-1"
  ],
  "oracle": [
   {
    "params": {
     "ch": 4,
     "dp": 4
    },
    "expect": {
     "px": 2,
     "py": 2
    }
   },
   {
    "params": {
     "ch": 2,
     "dp": 4
    },
    "expect": {
     "px": 1.3333333333333333,
     "py": 1.3333333333333333
    }
   },
   {
    "params": {
     "ch": 5,
     "dp": 1
    },
    "expect": {
     "px": 0.8333333333333334,
     "py": 0.8333333333333334
    }
   }
  ],
  "tol": 0.000001
 }
}