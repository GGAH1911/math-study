{
 "id": "geometry/middle-1/평면도형/사다리꼴_넓이",
 "spec": {
  "title": "사다리꼴의 넓이 S = ½(a+b)h",
  "params": [
   {
    "name": "a",
    "label": "윗변 a",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 4,
    "step": 0.5,
    "unit": "cm"
   },
   {
    "name": "b",
    "label": "아랫변 b",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 6,
    "step": 0.5,
    "unit": "cm"
   },
   {
    "name": "h",
    "label": "높이 h",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 5,
    "step": 0.5,
    "unit": "cm"
   }
  ],
  "scope": "off=(b-a)/2; S=(a+b)*h/2; mid=(a+b)/2",
  "geometry": {
   "range": [
    -2,
    12
   ],
   "yRange": [
    -1,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=b",
       0
      ],
      [
       "=off+a",
       "=h"
      ],
      [
       "=off",
       "=h"
      ]
     ],
     "label": "사다리꼴"
    },
    {
     "type": "segment",
     "from": [
      "=off",
      0
     ],
     "to": [
      "=off",
      "=h"
     ],
     "label": "h"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=off+a",
      "=h"
     ],
     "label": "대각선"
    }
   ]
  },
  "readout": [
   {
    "label": "윗변 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "아랫변 b",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "높이 h",
    "expr": "h",
    "digits": 2
   },
   {
    "label": "평균 밑변 (a+b)/2",
    "expr": "mid",
    "digits": 3
   },
   {
    "label": "넓이 S",
    "expr": "S",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 4,
    "b": 6,
    "h": 5
   },
   {
    "a": 3,
    "b": 3,
    "h": 4
   },
   {
    "a": 2,
    "b": 8,
    "h": 6
   },
   {
    "a": 5,
    "b": 7,
    "h": 3
   }
  ],
  "invariants": [
   "a*h/2 + b*h/2 - S",
   "mid*h - S",
   "off - (b-a)/2"
  ],
  "oracle": [
   {
    "params": {
     "a": 4,
     "b": 6,
     "h": 5
    },
    "expect": {
     "S": 25,
     "mid": 5,
     "off": 1
    }
   },
   {
    "params": {
     "a": 3,
     "b": 3,
     "h": 4
    },
    "expect": {
     "S": 12,
     "mid": 3,
     "off": 0
    }
   },
   {
    "params": {
     "a": 2,
     "b": 8,
     "h": 6
    },
    "expect": {
     "S": 30,
     "mid": 5,
     "off": 3
    }
   }
  ],
  "tol": 0.000001
 }
}