{
 "id": "functions/calculus/수열의_극한/망원급수",
 "spec": {
  "title": "망원급수: a_n = b_n − b_{n+k} (b_n = 1/n^s) 의 부분합과 수렴·발산",
  "params": [
   {
    "name": "N",
    "label": "더하는 항의 개수 N",
    "type": "slider",
    "min": 1,
    "max": 50,
    "init": 5,
    "step": 1
   },
   {
    "name": "s",
    "label": "b_n = 1/n^s 의 지수 s  (s<0 이면 b_n 이 발산)",
    "type": "slider",
    "min": -1,
    "max": 2,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "k",
    "label": "소거 간격 k  (a_n = b_n − b_{n+k})",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 1,
    "step": 1
   }
  ],
  "scope": "head = 1 + min(1,max(0,k-1))/2^s + min(1,max(0,k-2))/3^s; tail = 1/(N+1)^s + min(1,max(0,k-1))/(N+2)^s + min(1,max(0,k-2))/(N+3)^s; prevTail = 1/N^s + min(1,max(0,k-1))/(N+1)^s + min(1,max(0,k-2))/(N+2)^s; SN = head - tail; SNprev = head - prevTail; aN = 1/N^s - 1/(N+k)^s; remainder = head - SN; converges = s >= 0 ? 1 : 0",
  "plot": {
   "range": [
    "=1",
    "=max(8, N + k)"
   ],
   "yRange": [
    "=min(-0.5, 1.2*SN)",
    "=max(1.5, 1.25*head)"
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "1 + min(1,max(0,k-1))/2^s + min(1,max(0,k-2))/3^s - ( 1/(x+1)^s + min(1,max(0,k-1))/(x+2)^s + min(1,max(0,k-2))/(x+3)^s )",
     "label": "$S_N = (b_1+\\cdots+b_k) - (b_{N+1}+\\cdots+b_{N+k})$",
     "color": "#2563eb"
    },
    {
     "fn": "1 + min(1,max(0,k-1))/2^s + min(1,max(0,k-2))/3^s",
     "label": "$b_1+\\cdots+b_k$ (수렴할 때의 극한값)",
     "color": "#dc2626",
     "dashed": true
    },
    {
     "fn": "1/x^s - 1/(x+k)^s",
     "label": "$a_n = b_n - b_{n+k}$",
     "color": "#16a34a"
    }
   ],
   "points": [
    [
     "=N",
     "=SN"
    ]
   ],
   "pointsLabel": "$(N,\\ S_N)$ 현재 부분합"
  },
  "readout": [
   {
    "label": "부분합 S_N",
    "expr": "SN",
    "digits": 5
   },
   {
    "label": "소거되고 남는 앞쪽 k항의 합 = 극한 후보 b_1+…+b_k",
    "expr": "head",
    "digits": 5
   },
   {
    "label": "아직 안 지워진 꼬리 k항의 합 = 극한과의 오차",
    "expr": "tail",
    "digits": 5
   },
   {
    "label": "일반항 a_N = 1/N^s − 1/(N+k)^s",
    "expr": "aN",
    "digits": 6
   },
   {
    "label": "수렴하면 1, 발산하면 0 (b_{N+1} 의 극한 존재 여부)",
    "expr": "converges",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "N": 1,
    "s": 1,
    "k": 1
   },
   {
    "N": 5,
    "s": 1,
    "k": 1
   },
   {
    "N": 2,
    "s": 1,
    "k": 2
   },
   {
    "N": 3,
    "s": 2,
    "k": 1
   },
   {
    "N": 4,
    "s": -1,
    "k": 1
   },
   {
    "N": 2,
    "s": 0,
    "k": 3
   },
   {
    "N": 20,
    "s": 1,
    "k": 3
   }
  ],
  "invariants": [
   "SN - (head - tail)",
   "SN - SNprev - aN",
   "remainder - tail"
  ],
  "oracle": [
   {
    "params": {
     "N": 1,
     "s": 1,
     "k": 1
    },
    "expect": {
     "head": 1,
     "tail": 0.5,
     "SN": 0.5,
     "aN": 0.5,
     "converges": 1
    }
   },
   {
    "params": {
     "N": 3,
     "s": 1,
     "k": 1
    },
    "expect": {
     "head": 1,
     "tail": 0.25,
     "SN": 0.75,
     "aN": 0.0833333333333,
     "converges": 1
    }
   },
   {
    "params": {
     "N": 2,
     "s": 1,
     "k": 2
    },
    "expect": {
     "head": 1.5,
     "tail": 0.5833333333333,
     "SN": 0.9166666666667,
     "aN": 0.25,
     "converges": 1
    }
   },
   {
    "params": {
     "N": 3,
     "s": 2,
     "k": 1
    },
    "expect": {
     "head": 1,
     "tail": 0.0625,
     "SN": 0.9375,
     "aN": 0.0486111111111,
     "converges": 1
    }
   },
   {
    "params": {
     "N": 4,
     "s": -1,
     "k": 1
    },
    "expect": {
     "head": 1,
     "tail": 5,
     "SN": -4,
     "aN": -1,
     "converges": 0
    }
   },
   {
    "params": {
     "N": 2,
     "s": 0,
     "k": 3
    },
    "expect": {
     "head": 3,
     "tail": 3,
     "SN": 0,
     "aN": 0,
     "converges": 1
    }
   }
  ],
  "tol": 0.000001
 }
}