{
 "id": "algebra/middle-3/실수와_그_계산/무리수_계산",
 "spec": {
  "title": "√n을 a√b로 나타내기",
  "params": [
   {
    "name": "n",
    "label": "n",
    "type": "slider",
    "min": 2,
    "max": 30,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "a = mod(n,25)==0 ? 5 : mod(n,16)==0 ? 4 : mod(n,9)==0 ? 3 : mod(n,4)==0 ? 2 : 1; b = n / (a*a); val = sqrt(n)",
  "geometry": {
   "range": [
    -1,
    6
   ],
   "yRange": [
    -0.5,
    0.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=val",
      0
     ],
     "label": "√n"
    }
   ]
  },
  "readout": [
   {
    "label": "√n 값",
    "expr": "val",
    "digits": 6
   },
   {
    "label": "a",
    "expr": "a",
    "digits": 0
   },
   {
    "label": "b",
    "expr": "b",
    "digits": 0
   },
   {
    "label": "검산 (a√b-√n)",
    "expr": "a*sqrt(b) - sqrt(n)",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 2
   },
   {
    "n": 3
   },
   {
    "n": 4
   },
   {
    "n": 12
   },
   {
    "n": 18
   },
   {
    "n": 30
   }
  ],
  "invariants": [
   "a*a*b - n",
   "a*sqrt(b) - sqrt(n)"
  ],
  "oracle": [
   {
    "params": {
     "n": 2
    },
    "expect": {
     "a": 1,
     "b": 2
    }
   },
   {
    "params": {
     "n": 12
    },
    "expect": {
     "a": 2,
     "b": 3
    }
   },
   {
    "params": {
     "n": 18
    },
    "expect": {
     "a": 3,
     "b": 2
    }
   },
   {
    "params": {
     "n": 4
    },
    "expect": {
     "a": 2,
     "b": 1
    }
   }
  ],
  "tol": 0.000001
 }
}