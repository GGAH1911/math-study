{
 "id": "벡터의_선형결합",
 "spec": {
  "title": "벡터의 선형결합",
  "params": [
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "l",
    "label": "l",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0.5,
    "step": 0.1
   }
  ],
  "scope": "a1=1; a2=2; b1=2; b2=1; kx=k*a1+l*b1; ky=k*a2+l*b2;",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=k*a1",
       "=k*a2"
      ],
      [
       "=kx",
       "=ky"
      ],
      [
       "=l*b1",
       "=l*b2"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a1",
      "=a2"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=b1",
      "=b2"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=kx",
      "=ky"
     ]
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=a1",
      "=a2"
     ],
     "label": "a"
    },
    {
     "type": "point",
     "at": [
      "=b1",
      "=b2"
     ],
     "label": "b"
    },
    {
     "type": "point",
     "at": [
      "=kx",
      "=ky"
     ],
     "label": "w"
    }
   ]
  },
  "readout": [
   {
    "label": "w의 x성분",
    "expr": "kx",
    "digits": 2
   },
   {
    "label": "w의 y성분",
    "expr": "ky",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 1,
    "l": 0
   },
   {
    "k": 0,
    "l": 1
   },
   {
    "k": 1,
    "l": 1
   }
  ],
  "invariants": [
   "abs(0.5*((k*a1)*ky - (k*a2)*kx + kx*(l*b2) - ky*(l*b1)) - k*l*(a1*b2 - a2*b1))",
   "(kx - (k*a1 + l*b1))^2 + (ky - (k*a2 + l*b2))^2"
  ],
  "oracle": [
   {
    "params": {
     "k": 1,
     "l": 0
    },
    "expect": {
     "kx": 1,
     "ky": 2
    }
   },
   {
    "params": {
     "k": 0,
     "l": 1
    },
    "expect": {
     "kx": 2,
     "ky": 1
    }
   },
   {
    "params": {
     "k": 1,
     "l": 1
    },
    "expect": {
     "kx": 3,
     "ky": 3
    }
   }
  ],
  "tol": 0.000001
 }
}