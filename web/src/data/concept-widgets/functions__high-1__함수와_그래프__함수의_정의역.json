     "b": 3
    },
    "expect": {
     "m": 1,
     "h": 2,
     "len": 4
    }
   },
   {
    "params": {
     "a": 0,
     "b": 4
    },
    "expect": {
     "m": 2,
     "h": 2,
     "len": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "m": 1.5,
     "h": 0.5,
     "len": 1
