     "label": "y=√((x−a)(b−x))",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "정의역 좌경계 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "정의역 우경계 b",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "정의역 길이 (b−a)",
    "expr": "len",
    "digits": 2
   },
   {
    "label": "그래프 존재 구간",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "최댓값(=반지름 h)",
    "expr": "h",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1,
    "b": 3
   },
   {
    "a": 0,
    "b": 4
   },
   {
    "a": -3,
    "b": 2
   },
   {
    "a": 1,
    "b": 5
   }
  ],
  "invariants": [
   "h - sqrt((m-a)*(b-m))",
