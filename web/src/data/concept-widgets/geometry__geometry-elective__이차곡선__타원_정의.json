    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=t*pi/180; b=sqrt(a^2-c^2); px=a*cos(rad); py=b*sin(rad); d1=sqrt((px-c)^2+py^2); d2=sqrt((px+c)^2+py^2); sumd=d1+d2",
