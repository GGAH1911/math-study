 "spec": {
  "title": "타원의 정의 — 두 초점까지 거리의 합 |PF|+|PF'|=2a",
  "params": [
   {
    "name": "a",
    "label": "a (장반지름)",
    "type": "slider",
    "min": 2,
    "max": 6,
    "init": 5,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "c",
    "label": "c (초점거리 절반)",
