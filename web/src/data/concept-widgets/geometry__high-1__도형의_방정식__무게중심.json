    "Cx": 5,
    "Cy": 5
   }
  ],
  "invariants": [
   "Gx - (Ax + 2/3*(mBCx-Ax))",
   "Gy - (Ay + 2/3*(mBCy-Ay))",
   "(Ax-Gx)+(Bx-Gx)+(Cx-Gx)",
   "(Ay-Gy)+(By-Gy)+(Cy-Gy)",
   "sqrt((Gx-Ax)^2+(Gy-Ay)^2) - 2*sqrt((mBCx-Gx)^2+(mBCy-Gy)^2)"
  ],
  "oracle": [
   {
    "params": {
     "Ax": 0,
