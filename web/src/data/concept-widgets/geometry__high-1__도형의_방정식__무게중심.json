{
 "id": "geometry/high-1/도형의_방정식/무게중심",
 "spec": {
  "title": "삼각형의 무게중심 — 세 중선의 교점",
  "params": [
   {
    "name": "Ax",
    "label": "A_x",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "Ay",
    "label": "A_y",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "Bx",
    "label": "B_x",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 4,
    "step": 0.1
   },
   {
    "name": "By",
    "label": "B_y",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "Cx",
    "label": "C_x",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "Cy",
    "label": "C_y",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "Gx=(Ax+Bx+Cx)/3; Gy=(Ay+By+Cy)/3; mBCx=(Bx+Cx)/2; mBCy=(By+Cy)/2; mCAx=(Cx+Ax)/2; mCAy=(Cy+Ay)/2; mABx=(Ax+Bx)/2; mABy=(Ay+By)/2",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       "=Ax",
       "=Ay"
      ],
      [
       "=Bx",
       "=By"
      ],
      [
       "=Cx",
       "=Cy"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Ax",
      "=Ay"
     ],
     "to": [
      "=mBCx",
      "=mBCy"
     ],
     "color": "#9ca3af"
    },
    {
     "type": "segment",
     "from": [
      "=Bx",
      "=By"
     ],
     "to": [
      "=mCAx",
      "=mCAy"
     ],
     "color": "#9ca3af"
    },
    {
     "type": "segment",
     "from": [
      "=Cx",
      "=Cy"
     ],
     "to": [
      "=mABx",
      "=mABy"
     ],
     "color": "#9ca3af"
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    },
    {
     "type": "point",
     "at": [
      "=mBCx",
      "=mBCy"
     ],
     "label": "M"
    },
    {
     "type": "point",
     "at": [
      "=Gx",
      "=Gy"
     ],
     "label": "G",
     "color": "#ef4444"
    }
   ]
  },
  "readout": [
   {
    "label": "G_x = (A_x+B_x+C_x)/3",
    "expr": "Gx",
    "digits": 3
   },
   {
    "label": "G_y = (A_y+B_y+C_y)/3",
    "expr": "Gy",
    "digits": 3
   },
   {
    "label": "AG : GM (중선 내분비, 2가 정답)",
    "expr": "sqrt((Gx-Ax)^2+(Gy-Ay)^2)/sqrt((mBCx-Gx)^2+(mBCy-Gy)^2)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
