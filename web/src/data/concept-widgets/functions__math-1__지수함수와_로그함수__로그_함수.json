{
 "id": "functions/math-1/지수함수와_로그함수/로그_함수",
 "spec": {
  "title": "로그함수 y = log_a x — 지수함수 y = a^x 의 역함수",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.5,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "xq",
    "label": "점 x",
    "type": "slider",
    "min": 0.1,
    "max": 10,
    "init": 4,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "val = log(xq, a)",
  "geometry": {
   "range": [
    -2,
    8
   ],
   "yRange": [
    -2,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    8
   ],
   "yRange": [
    -2,
    8
   ],
   "fns": [
    {
     "fn": "log(x, a)",
     "label": "y = log_a x",
     "color": "#1565c0"
    },
    {
     "fn": "a^x",
     "label": "y = a^x (역함수)",
     "color": "#c62828"
    },
    {
     "fn": "x",
     "label": "y = x (대칭축)",
     "color": "#9e9e9e"
    }
   ]
  },
  "readout": [
   {
    "label": "log_a(x)",
    "expr": "val",
    "digits": 4
   },
   {
    "label": "a^(log_a x) = x 확인",
    "expr": "a^val",
    "digits": 4
   },
   {
    "label": "log_a(1) (항상 0)",
    "expr": "log(1, a)",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "xq": 8
   },
   {
    "a": 3,
    "xq": 9
   },
   {
    "a": 2,
    "xq": 0.5
   },
   {
    "a": 5,
    "xq": 1
   }
  ],
  "invariants": [
   "a^val - xq",
   "val*log(a) - log(xq)",
   "log(1, a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "xq": 8
    },
    "expect": {
     "val": 3
    }
   },
   {
    "params": {
     "a": 3,
     "xq": 9
    },
    "expect": {
     "val": 2
    }
   },
   {
    "params": {
     "a": 2,
     "xq": 0.5
    },
    "expect": {
     "val": -1
    }
   }
  ],
  "tol": 0.000001
 }
}