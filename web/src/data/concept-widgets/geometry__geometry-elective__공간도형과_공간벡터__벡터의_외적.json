{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/벡터의_외적",
 "spec": {
  "title": "벡터의 외적 — 평행사변형의 유향 넓이",
  "params": [
   {
    "name": "a1",
    "label": "a₁",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "a2",
    "label": "a₂",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b1",
    "label": "b₁",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b2",
    "label": "b₂",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "cross=a1*b2-a2*b1; dot=a1*b1+a2*b2; ma=sqrt(a1^2+a2^2); mb=sqrt(b1^2+b2^2); area=abs(cross)",
  "geometry": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -4,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=a1",
       "=a2"
      ],
      [
       "=a1+b1",
       "=a2+b2"
      ],
      [
       "=b1",
       "=b2"
      ]
     ],
     "label": "|a×b|"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a1",
      "=a2"
     ],
     "label": "a"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=b1",
      "=b2"
     ],
     "label": "b"
    },
    {
     "type": "point",
     "at": [
      "=a1",
      "=a2"
     ]
    },
    {
     "type": "point",
     "at": [
      "=b1",
      "=b2"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "a×b (외적, 부호 포함)",
    "expr": "cross",
    "digits": 3
   },
   {
    "label": "평행사변형 넓이 |a×b|",
    "expr": "area",
    "digits": 3
   },
   {
    "label": "내적 a·b (비교)",
    "expr": "dot",
    "digits": 3
   },
   {
    "label": "|a|·|b|",
    "expr": "ma*mb",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a1": 2,
    "a2": 1,
    "b1": 1,
    "b2": 2
   },
   {
    "a1": 1,
    "a2": 0,
    "b1": 0,
    "b2": 1
   },
   {
    "a1": 1,
    "a2": 1,
    "b1": 1,
    "b2": -1
   },
   {
    "a1": -2,
    "a2": 1.5,
    "b1": 0.5,
    "b2": 2
   }
  ],
  "invariants": [
   "cross-(a1*b2-a2*b1)",
   "cross^2+dot^2-ma^2*mb^2",
   "area-abs(cross)"
  ],
  "oracle": [
   {
    "params": {
     "a1": 1,
     "a2": 0,
     "b1": 0,
     "b2": 1
    },
    "expect": {
     "cross": 1,
     "dot": 0,
     "area": 1
    }
   },
   {
    "params": {
     "a1": 2,
     "a2": 0,
     "b1": 1,
     "b2": 1
    },
    "expect": {
     "cross": 2,
     "dot": 2,
     "area": 2
    }
   },
   {
    "params": {
     "a1": 1,
     "a2": 1,
     "b1": 1,
     "b2": -1
    },
    "expect": {
     "cross": -2,
     "dot": 0,
     "area": 2
    }
   }
  ],
  "tol": 0.000001
 }
}