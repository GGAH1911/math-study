    {
     "type": "point",
     "at": [
      "=nstar",
      "=ext"
     ],
     "label": "최값 항"
    }
   ]
  },
  "readout": [
   {
    "label": "대칭축(꼭짓점 n)",
    "expr": "p",
    "digits": 2
   },
   {
    "label": "최값이 되는 항 번호 n",
    "expr": "nstar",
    "digits": 0
   },
   {
    "label": "그 항의 값 aₙ",
    "expr": "ext",
    "digits": 3
   },
   {
    "label": "꼭짓점 값 q (연속 최값)",
    "expr": "q",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.3,
    "p": 5,
    "q": -3
   },
   {
    "a": -0.4,
    "p": 4,
    "q": 2
   },
   {
    "a": 0.5,
    "p": 4.3,
    "q": 0
   },
   {
    "a": 0,
    "p": 5.5,
    "q": 1
   }
  ],
  "invariants": [
   "(a*(4-p)^2+q) - 2*(a*(3-p)^2+q) + (a*(2-p)^2+q) - 2*a",
