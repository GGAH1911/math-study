{
 "id": "functions/math-1/수열/수열의_최대최소",
 "spec": {
  "title": "수열의 최대·최소: 이차수열 aₙ = a(n−p)² + q",
  "params": [
   {
    "name": "a",
    "label": "a (위로/아래로 볼록 · 폭)",
    "type": "slider",
    "min": -0.5,
    "max": 0.5,
    "init": 0.3,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "p (대칭축 · 꼭짓점 n)",
    "type": "slider",
    "min": 1,
    "max": 9,
    "init": 5,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "q (꼭짓점 값)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -3,
    "step": 0.5
   }
  ],
  "scope": "nstar = max(1, round(p)); ext = a*(nstar-p)^2 + q",
  "geometry": {
   "range": [
    0,
    10
   ],
   "yRange": [
    -8,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=p",
      "=-8"
     ],
     "to": [
      "=p",
      "=12"
     ],
     "label": "대칭축 n=p"
    },
    {
     "type": "segment",
     "from": [
      "=0",
      "=q"
     ],
     "to": [
      "=10",
      "=q"
     ],
     "label": "꼭짓점 값 q"
    },
    {
     "type": "point",
     "at": [
      "=1",
      "=a*(1-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=2",
      "=a*(2-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=3",
      "=a*(3-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=4",
      "=a*(4-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=5",
      "=a*(5-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=6",
      "=a*(6-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=7",
      "=a*(7-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=8",
      "=a*(8-p)^2+q"
     ]
    },
    {
     "type": "point",
     "at": [
      "=9",
      "=a*(9-p)^2+q"
     ]
