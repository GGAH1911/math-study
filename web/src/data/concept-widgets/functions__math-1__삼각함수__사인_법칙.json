{
 "id": "functions/math-1/삼각함수/사인_법칙",
 "spec": {
  "title": "사인 법칙: a/sin A = b/sin B = c/sin C = 2R",
  "params": [
   {
    "name": "A",
    "label": "∠A",
    "type": "slider",
    "min": 30,
    "max": 85,
    "init": 30,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "B",
    "label": "∠B",
    "type": "slider",
    "min": 30,
    "max": 85,
    "init": 60,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "R",
