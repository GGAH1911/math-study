    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 2,
    "step": 0.5
   }
  ],
  "scope": "Ar=A*pi/180; Br=B*pi/180; C=180-A-B; Cr=C*pi/180; phiA=pi/2; phiB=phiA+2*Cr; phiC=phiB+2*Ar; Ax=R*cos(phiA); Ay=R*sin(phiA); Bx=R*cos(phiB); By=R*sin(phiB); Cx=R*cos(phiC); Cy=R*sin(phiC); a=2*R*sin(Ar); b=2*R*sin(Br); c=2*R*sin(Cr); ratioA=a/sin(Ar); ratioB=b/sin(Br); ratioC=c/sin(Cr)",
  "geometry": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=R",
     "label": "외접원(R)"
    },
    {
