      [
       "=Ax",
       "=Ay"
      ],
      [
       "=Bx",
       "=By"
      ],
      [
       "=Cx",
       "=Cy"
      ]
     ],
     "label": "△ABC"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "a/sin A",
    "expr": "ratioA",
    "digits": 3
   },
   {
    "label": "b/sin B",
    "expr": "ratioB",
    "digits": 3
   },
   {
    "label": "c/sin C",
