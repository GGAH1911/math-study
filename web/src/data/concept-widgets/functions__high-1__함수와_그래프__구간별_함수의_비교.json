{
 "id": "functions/high-1/함수와_그래프/구간별_함수의_비교",
 "spec": {
  "title": "구간별 함수의 비교: f(x)=(x<1이면 -2x+1, x≥1이면 x²-1) vs g(x)=ax+b",
  "params": [
   {
    "name": "a",
    "label": "g의 기울기 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "g의 절편 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "비교할 x₀",
    "type": "slider",
    "min": -3,
    "max": 4,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "mask1=(x0<1); mask2=(x0>=1); fx0=mask1*(-2*x0+1)+mask2*(x0^2-1); gx0=a*x0+b; diff=fx0-gx0; gx1=a*(x0+1)+b",
  "plot": {
   "range": [
    -3,
    4
   ],
   "yRange": [
    -6,
    16
   ],
   "fns": [
    {
     "fn": "(x<1)*(-2*x+1)+(x>=1)*(x^2-1)",
     "label": "f(x) 구간별",
     "color": "#2563eb"
    },
    {
     "fn": "a*x+b",
     "label": "g(x)=ax+b",
     "color": "#dc2626"
    }
   ],
   "points": [
    [
     "=x0",
     "=fx0"
    ],
    [
     "=x0",
     "=gx0"
    ],
    [
     "=x0+1",
     "=gx1"
    ]
   ],
   "pointsLabel": "$(x_0,f(x_0)),\\,(x_0,g(x_0)),\\,(x_0{+}1,g(x_0{+}1))$"
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "fx0",
    "digits": 3
   },
   {
    "label": "g(x₀)",
    "expr": "gx0",
    "digits": 3
   },
   {
    "label": "f(x₀)-g(x₀)",
    "expr": "diff",
    "digits": 3
   },
   {
    "label": "부호(양수면 f가 위)",
    "expr": "sign(diff)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "x0": 0
   },
   {
    "a": 1,
    "b": 0,
    "x0": 2
   },
   {
    "a": 2,
    "b": 1,
    "x0": 3
   },
   {
    "a": -1,
    "b": 2,
    "x0": -2
   }
  ],
  "invariants": [
   "mask1+mask2-1",
   "mask1*(fx0-(-2*x0+1))+mask2*(fx0-(x0^2-1))",
   "diff-(fx0-gx0)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "x0": 0
    },
    "expect": {
     "fx0": 1,
     "gx0": 0,
     "diff": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "x0": 2
    },
    "expect": {
     "fx0": 3,
     "gx0": 2,
     "diff": 1
    }
   },
   {
    "params": {
     "a": 2,
     "b": 1,
     "x0": 3
    },
    "expect": {
     "fx0": 8,
     "gx0": 7,
     "diff": 1
    }
   }
  ],
  "tol": 0.000001
 }
}