k_4+ok_5+ok_6+ok_7+ok_8+ok_9+ok_10+ok_11+ok_12+ok_13+ok_14+ok_15+ok_16+ok_17+ok_18+ok_19+ok_20+ok_21+ok_22+ok_23+ok_24+ok_25+ok_26+ok_27+ok_28+ok_29+ok_30; sum_err=ok_1*(x_1*y_1-T)+ok_2*(x_2*y_2-T)+ok_3*(x_3*y_3-T)+ok_4*(x_4*y_4-T)+ok_5*(x_5*y_5-T)+ok_6*(x_6*y_6-T)+ok_7*(x_7*y_7-T)+ok_8*(x_8*y_8-T)+ok_9*(x_9*y_9-T)+ok_10*(x_10*y_10-T)+ok_11*(x_11*y_11-T)+ok_12*(x_12*y_12-T)+ok_13*(x_13*y_13-T)+ok_14*(x_14*y_14-T)+ok_15*(x_15*y_15-T)+ok_16*(x_16*y_16-T)+ok_17*(x_17*y_17-T)+ok_18*(x_18*y_18-T)+ok_19*(x_19*y_19-T)+ok_20*(x_20*y_20-T)+ok_21*(x_21*y_21-T)+ok_22*(x_22*y_22-T)+ok_23*(x_23*y_23-T)+ok_24*(x_24*y_24-T)+ok_25*(x_25*y_25-T)+ok_26*(x_26*y_26-T)+ok_27*(x_27*y_27-T)+ok_28*(x_28*y_28-T)+ok_29*(x_29*y_29-T)+ok_30*(x_30*y_30-T); p=(pi==1)?2:((pi==2)?3:((pi==3)?5:7)); q=(p==2)?3:((p==3)?5:((p==5)?7:11)); u=a+1; v=b+1; D=u*v; n=p^a*q^b; match=(D==T)?1:0; sq=(mod(a,2)==0?1:0)*(mod(b,2)==0?1:0); cube=(mod(a,3)==0?1:0)*(mod(b,3)==0?1:0); chk=match*(D-T); err_D=D-(a+1)*(b+1);",
