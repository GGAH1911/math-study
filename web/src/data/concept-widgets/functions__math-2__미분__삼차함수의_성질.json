{
 "id": "functions/math-2/미분/삼차함수의_성질",
 "spec": {
  "title": "삼차함수의 성질 — 극값·변곡점·점대칭",
  "params": [
   {
    "name": "a",
    "label": "a (최고차항 계수, ≠0)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "D = 4*b^2 - 12*a*c; xi = -b/(3*a); yi = a*xi^3 + b*xi^2 + c*xi + d; s = sqrt(abs(D)); x1 = (-2*b - s)/(6*a); x2 = (-2*b + s)/(6*a); sp = a*(xi+1)^3 + b*(xi+1)^2 + c*(xi+1) + d; sm = a*(xi-1)^3 + b*(xi-1)^2 + c*(xi-1) + d",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -12,
    12
   ],
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "f(x)=ax³+bx²+cx+d",
     "color": "#2563eb"
    },
    {
     "fn": "3*a*x^2 + 2*b*x + c",
     "label": "f'(x)=3ax²+2bx+c",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = 4b²−12ac",
    "expr": "D",
    "digits": 2
   },
   {
    "label": "변곡점 x = −b/3a",
    "expr": "xi",
    "digits": 3
   },
   {
    "label": "변곡점 y = f(−b/3a)",
    "expr": "yi",
    "digits": 3
   },
   {
    "label": "극값 개수 (D>0 ⇒ 2, D≤0 ⇒ 0)",
    "expr": "D > 0 ? 2 : 0",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": -3,
    "d": 0
   },
   {
    "a": 1,
    "b": 3,
    "c": 3,
    "d": 1
   },
   {
    "a": 1,
    "b": 0,
    "c": 3,
    "d": 0
   },
   {
    "a": -1,
    "b": 2,
    "c": 1,
    "d": -2
   }
  ],
  "invariants": [
   "6*a*xi + 2*b",
   "sp + sm - 2*yi",
   "(x1 + x2)/2 - xi"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 3,
     "c": 0,
     "d": 0
    },
    "expect": {
     "D": 36,
     "xi": -1,
     "yi": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 3,
     "c": 3,
     "d": 1
    },
    "expect": {
     "D": 0,
     "xi": -1,
     "yi": 0
    }
   },
   {
    "params": {
     "a": -1,
     "b": 0,
     "c": 3,
     "d": 1
    },
    "expect": {
     "D": 36,
     "xi": 0,
     "yi": 1
    }
   }
  ],
  "tol": 0.000001
 }
}