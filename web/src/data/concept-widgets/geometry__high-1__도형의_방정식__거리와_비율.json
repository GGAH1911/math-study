{
 "id": "geometry/high-1/도형의_방정식/거리와_비율",
 "spec": {
  "title": "거리와 내분점 — AP:PB = m:n",
  "params": [
   {
    "name": "m",
    "label": "m (A쪽 비)",
    "type": "slider",
    "min": 1,
    "max": 9,
    "init": 2,
    "step": 1
   },
   {
    "name": "n",
    "label": "n (B쪽 비)",
    "type": "slider",
    "min": 1,
    "max": 9,
    "init": 1,
    "step": 1
   }
  ],
  "scope": "x1=1; y1=1; x2=7; y2=5; px=(m*x2+n*x1)/(m+n); py=(m*y2+n*y1)/(m+n); AB=sqrt((x2-x1)^2+(y2-y1)^2); AP=sqrt((px-x1)^2+(py-y1)^2); PB=sqrt((x2-px)^2+(y2-py)^2); cross=(px-x1)*(y2-y1)-(py-y1)*(x2-x1)",
  "geometry": {
   "range": [
    0,
    8
   ],
   "yRange": [
    0,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      1,
      1
     ],
     "to": [
      7,
      5
     ]
    },
    {
     "type": "point",
     "at": [
      1,
      1
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      7,
      5
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "거리 AB",
    "expr": "AB",
    "digits": 4
   },
   {
    "label": "AP",
    "expr": "AP",
    "digits": 4
   },
   {
    "label": "PB",
    "expr": "PB",
    "digits": 4
   },
   {
    "label": "P_x",
    "expr": "px",
    "digits": 4
   },
   {
    "label": "P_y",
    "expr": "py",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m": 1,
    "n": 1
   },
   {
    "m": 2,
    "n": 1
   },
   {
    "m": 3,
    "n": 1
   },
   {
    "m": 1,
    "n": 3
   }
  ],
  "invariants": [
   "cross",
   "AP*n-PB*m",
   "AP+PB-AB"
  ],
  "oracle": [
   {
    "params": {
     "m": 1,
     "n": 1
    },
    "expect": {
     "px": 4,
     "py": 3
    }
   },
   {
    "params": {
     "m": 3,
     "n": 1
    },
    "expect": {
     "px": 5.5,
     "py": 4
    }
   },
   {
    "params": {
     "m": 2,
     "n": 1
    },
    "expect": {
     "px": 5,
     "py": 3.6666666667
    }
   }
  ],
  "tol": 0.000001
 }
}