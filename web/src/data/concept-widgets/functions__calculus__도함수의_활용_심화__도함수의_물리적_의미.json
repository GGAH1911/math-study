{
 "id": "functions/calculus/도함수의_활용_심화/도함수의_물리적_의미",
 "spec": {
  "title": "도함수의 물리적 의미: 위치·속도·가속도 (s(t)=5t²)",
  "params": [
   {
    "name": "t",
    "label": "시각 t",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 3,
    "step": 0.1,
    "unit": "s"
   }
  ],
  "scope": "pos = 5*t^2; vel = 10*t; acc = 10; x1 = t-1; y1 = pos - vel; x2 = t+1; y2 = pos + vel",
  "plot": {
   "range": [
    0,
    7
   ],
   "yRange": [
    -40,
    220
   ],
   "fns": [
    {
     "fn": "5*x^2",
     "label": "위치 s(t)=5t²",
     "color": "#2563eb"
    },
    {
     "fn": "pos + vel*(x - t)",
     "label": "t에서의 접선 (기울기=속도 v)",
     "color": "#dc2626"
    }
   ],
   "points": [
    [
     "=t",
     "=pos"
    ]
   ],
   "pointsLabel": "$(t,\\,s(t))$"
  },
  "readout": [
   {
    "label": "시각 t",
    "expr": "t",
    "digits": 2
   },
   {
    "label": "위치 s(t)",
    "expr": "pos",
    "digits": 2
   },
   {
    "label": "속도 s'(t)=v (접선기울기)",
    "expr": "vel",
    "digits": 2
   },
   {
    "label": "가속도 s''(t)=a",
    "expr": "acc",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "t": 0
   },
   {
    "t": 1
   },
   {
    "t": 3
   },
   {
    "t": 5
   }
  ],
  "invariants": [
   "pos - 5*t^2",
   "vel - 10*t",
   "acc - 10",
   "(y2 - y1)/(x2 - x1) - vel"
  ],
  "oracle": [
   {
    "params": {
     "t": 3
    },
    "expect": {
     "pos": 45,
     "vel": 30,
     "acc": 10
    }
   },
   {
    "params": {
     "t": 2
    },
    "expect": {
     "pos": 20,
     "vel": 20,
     "acc": 10
    }
   },
   {
    "params": {
     "t": 1
    },
    "expect": {
     "pos": 5,
     "vel": 10,
     "acc": 10
    }
   }
  ],
  "tol": 0.000001
 }
}