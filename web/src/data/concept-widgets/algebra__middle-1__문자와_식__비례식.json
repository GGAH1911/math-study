{
 "id": "algebra/middle-1/문자와_식/비례식",
 "spec": {
  "title": "비례식의 외항과 내항",
  "params": [
   {
    "name": "k",
    "label": "비율 k",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "내항 b",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 3,
    "step": 1
   },
   {
    "name": "d",
    "label": "외항 d",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 5,
    "step": 1
   }
  ],
  "scope": "a=k*b; c=k*d; outer=a*d; inner=b*c; diff=outer-inner",
  "geometry": {
   "range": [
    0,
    45
   ],
   "yRange": [
    0,
    35
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=a",
       0
      ],
      [
       "=a",
       "=d"
      ],
      [
       0,
       "=d"
      ]
     ]
    },
    {
     "type": "polygon",
     "points": [
      [
       "=a+2",
       0
      ],
      [
       "=a+2+b",
       0
      ],
      [
       "=a+2+b",
       "=c"
      ],
      [
       "=a+2",
       "=c"
      ]
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "외항 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "내항 c",
    "expr": "c",
    "digits": 2
   },
   {
    "label": "외항의 곱 a×d",
    "expr": "outer",
    "digits": 2
   },
   {
    "label": "내항의 곱 b×c",
    "expr": "inner",
    "digits": 2
   },
   {
    "label": "차이 a×d - b×c",
    "expr": "diff",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 1.5,
    "b": 3,
    "d": 5
   },
   {
    "k": 2,
    "b": 4,
    "d": 2
   },
   {
    "k": 0.5,
    "b": 10,
    "d": 10
   },
   {
    "k": 3,
    "b": 1,
    "d": 1
   }
  ],
  "invariants": [
   "a*d - b*c",
   "a/b - c/d",
   "outer - inner"
  ],
  "oracle": [
   {
    "params": {
     "k": 2,
     "b": 3,
     "d": 5
    },
    "expect": {
     "a": 6,
     "c": 10,
     "outer": 30,
     "inner": 30
    }
   },
   {
    "params": {
     "k": 0.5,
     "b": 10,
     "d": 4
    },
    "expect": {
     "a": 5,
     "c": 2,
     "outer": 20,
     "inner": 20
    }
   },
   {
    "params": {
     "k": 1.5,
     "b": 4,
     "d": 2
    },
    "expect": {
     "a": 6,
     "c": 3,
     "outer": 12,
     "inner": 12
    }
   }
  ],
  "tol": 0.000001
 }
}