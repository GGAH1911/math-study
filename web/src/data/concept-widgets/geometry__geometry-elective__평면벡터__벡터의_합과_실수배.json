{
 "id": "geometry/geometry-elective/평면벡터/벡터의_합과_실수배",
 "spec": {
  "title": "벡터의 합과 실수배 — 평행사변형 법칙",
  "params": [
   {
    "name": "ax",
    "label": "aₓ",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "ay",
    "label": "a_y",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "bx",
    "label": "bₓ",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "by",
    "label": "b_y",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "k",
    "label": "실수배 k (a에 적용)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 2,
    "step": 0.5
   }
  ],
  "scope": "sx=ax+bx; sy=ay+by; kx=k*ax; ky=k*ay",
  "geometry": {
   "range": [
    -7,
    7
   ],
   "yRange": [
    -7,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=ax",
       "=ay"
      ],
      [
       "=sx",
       "=sy"
      ],
      [
       "=bx",
       "=by"
      ]
     ],
     "label": "평행사변형",
     "color": "#bbb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=ax",
      "=ay"
     ],
     "label": "a",
     "color": "blue"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "b",
     "color": "green"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=sx",
      "=sy"
     ],
     "label": "b(평행이동)",
     "color": "#8fbf8f"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=sx",
      "=sy"
     ],
     "label": "a+b",
     "color": "red"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=kx",
      "=ky"
     ],
     "label": "ka",
     "color": "orange"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=sx",
      "=sy"
     ],
     "label": "a+b"
    }
   ]
  },
  "readout": [
   {
    "label": "(a+b)ₓ",
    "expr": "sx",
    "digits": 2
   },
   {
    "label": "(a+b)_y",
    "expr": "sy",
    "digits": 2
   },
   {
    "label": "|a+b|",
    "expr": "sqrt(sx^2+sy^2)",
    "digits": 3
   },
   {
    "label": "(ka)ₓ",
    "expr": "kx",
    "digits": 2
   },
   {
    "label": "(ka)_y",
    "expr": "ky",
    "digits": 2
   },
   {
    "label": "|ka|",
    "expr": "sqrt(kx^2+ky^2)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "ax": 3,
    "ay": 1,
    "bx": 1,
    "by": 3,
    "k": 2
   },
   {
    "ax": 2,
    "ay": 0,
    "bx": 0,
    "by": 2,
    "k": -1
   },
   {
    "ax": -2,
    "ay": 1,
    "bx": 1,
    "by": 1,
    "k": 0.5
   },
   {
    "ax": 1,
    "ay": -3,
    "bx": -2,
    "by": 2,
    "k": -2
   }
  ],
  "invariants": [
   "kx*ay - ky*ax",
   "sqrt(kx^2+ky^2) - abs(k)*sqrt(ax^2+ay^2)",
   "(sx^2+sy^2) + ((ax-bx)^2+(ay-by)^2) - 2*(ax^2+ay^2) - 2*(bx^2+by^2)",
   "sx - (bx+ax)",
   "sy - (by+ay)"
  ],
  "oracle": [
   {
    "params": {
     "ax": 3,
     "ay": 1,
     "bx": 1,
     "by": 3,
     "k": 2
    },
    "expect": {
     "sx": 4,
     "sy": 4,
     "kx": 6,
     "ky": 2
    }
   },
   {
    "params": {
     "ax": 2,
     "ay": 0,
     "bx": 0,
     "by": 2,
     "k": -1
    },
    "expect": {
     "sx": 2,
     "sy": 2,
     "kx": -2,
     "ky": 0
    }
   },
   {
    "params": {
     "ax": -2,
     "ay": 1,
     "bx": 1,
     "by": 1,
     "k": 0.5
    },
    "expect": {
     "sx": -1,
     "sy": 2,
     "kx": -1,
     "ky": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}