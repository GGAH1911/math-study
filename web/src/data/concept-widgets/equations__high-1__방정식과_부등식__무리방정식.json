{
 "id": "equations/high-1/방정식과_부등식/무리방정식",
 "spec": {
  "title": "무리방정식 √(x+1) = x + a 탐구",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -2,
    "max": 1.2,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "d=5-4*a; sq=sqrt(d); y1=(1+sq)/2; y2=(1-sq)/2; x1=y1-a; x2=y2-a",
  "geometry": {
   "range": [
    -3,
    6
   ],
   "yRange": [
    -4,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -3,
    6
   ],
   "yRange": [
    -4,
    4
   ],
   "fns": [
    {
     "fn": "sqrt(x+1)",
     "label": "y=√(x+1)",
     "color": "blue"
    },
    {
     "fn": "-sqrt(x+1)",
     "label": "y=-√(x+1)",
     "color": "gray"
    },
    {
     "fn": "x+a",
     "label": "y=x+a",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "x₁ (후보)",
    "expr": "x1",
    "digits": 4
   },
   {
    "label": "y₁",
    "expr": "y1",
    "digits": 4
   },
   {
    "label": "x₂ (후보)",
    "expr": "x2",
    "digits": 4
   },
   {
    "label": "y₂",
    "expr": "y2",
    "digits": 4
   },
   {
    "label": "무연근 (y₂<0)",
    "expr": "y2 < 0 ? 1 : 0",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1
   },
   {
    "a": 0.25
   },
   {
    "a": 1
   }
  ],
  "invariants": [
   "y1^2-(x1+1)",
   "y2^2-(x2+1)",
   "y1-(x1+a)",
   "y2-(x2+a)",
   "y2 < 0 ? sqrt(x2+1)+y2 : sqrt(x2+1)-y2"
  ],
  "oracle": [
   {
    "params": {
     "a": -1
    },
    "expect": {
     "x1": 3,
     "y1": 2,
     "x2": 0,
     "y2": -1
    }
   },
   {
    "params": {
     "a": 0.25
    },
    "expect": {
     "x1": 1.25,
     "y1": 1.5,
     "x2": -0.75,
     "y2": -0.5
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "x1": 0,
     "y1": 1,
     "x2": -1,
     "y2": 0
    }
   }
  ],
  "tol": 0.000001
 }
}