{
 "id": "functions/calculus/정적분의_활용/적분값_최적화",
 "spec": {
  "title": "적분값 최적화 — 상한 b에 따른 I(b)=∫₀ᵇ(t²−4)dt 의 극값",
  "params": [
   {
    "name": "b",
    "label": "적분 상한 b",
    "type": "slider",
    "min": 0,
    "max": 3.5,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fb = b^2 - 4; Ib = b^3/3 - 4*b",
  "plot": {
   "range": [
    0,
    3.5
   ],
   "yRange": [
    -6,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^2 - 4",
     "label": "f(t)=t²−4 (피적분함수 = I'의 값)",
     "color": "#999999"
    },
    {
     "fn": "x^3/3 - 4*x",
     "label": "I(b)=∫₀ᵇ(t²−4)dt (적분값)",
     "color": "#2aa66a"
    }
   ],
   "points": [
    [
     "=b",
     "=fb"
    ],
    [
     "=b",
     "=Ib"
    ]
   ],
   "pointsLabel": "$t=b$ 위치: 회색점 $f(b)$, 초록점 $I(b)$"
  },
  "readout": [
   {
    "label": "적분값 I(b)",
    "expr": "Ib",
    "digits": 3
   },
   {
    "label": "f(b) = I'(b) (증감의 부호)",
    "expr": "fb",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 0
   },
   {
    "b": 1
   },
   {
    "b": 2
   },
   {
    "b": 3
   }
  ],
  "invariants": [
   "(b/6)*( (0^2 - 4) + 4*((b/2)^2 - 4) + (b^2 - 4) ) - Ib",
   "(( (b+0.0001)^3/3 - 4*(b+0.0001) ) - ( (b-0.0001)^3/3 - 4*(b-0.0001) )) / 0.0002 - fb"
  ],
  "oracle": [
   {
    "params": {
     "b": 1
    },
    "expect": {
     "Ib": -3.6666666667,
     "fb": -3
    }
   },
   {
    "params": {
     "b": 2
    },
    "expect": {
     "Ib": -5.3333333333,
     "fb": 0
    }
   },
   {
    "params": {
     "b": 3
    },
    "expect": {
     "Ib": -3,
     "fb": 5
    }
   }
  ],
  "tol": 0.000001
 }
}