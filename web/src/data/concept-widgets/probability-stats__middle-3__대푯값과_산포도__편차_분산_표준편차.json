     ]
    },
    {
     "type": "segment",
     "from": [
      "=x4",
      1.5
     ],
     "to": [
      "=mean",
      1.5
     ]
    },
    {
     "type": "segment",
     "from": [
      "=mean",
      0.2
     ],
     "to": [
      "=mean",
      1.6
     ]
    },
    {
     "type": "segment",
     "from": [
      "=mean-std",
      -0.3
     ],
     "to": [
      "=mean+std",
      -0.3
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "평균",
