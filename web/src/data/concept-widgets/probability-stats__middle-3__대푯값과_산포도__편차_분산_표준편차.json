    "expr": "d1+d2+d3+d4",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x1": 2,
    "x2": 4,
    "x3": 6,
    "x4": 8
   },
   {
    "x1": 0,
    "x2": 0,
