{
 "id": "functions/middle-1/좌표평면과_그래프/그래프",
 "spec": {
  "title": "함수의 그래프: 점 (x, f(x))의 모임",
  "params": [
   {
    "name": "a",
    "label": "a (계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "x₀ (표본 x)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "y0 = a*x0^2; y_neg = a*(-x0)^2",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -4,
    9
   ],
   "fns": [
    {
     "fn": "a*x^2",
     "label": "y = a·x²",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "표본 점 (x₀, f(x₀)) 의 y값",
    "expr": "y0",
    "digits": 2
   },
   {
    "label": "f(-x₀) (좌우대칭 확인)",
    "expr": "y_neg",
    "digits": 2
   },
   {
    "label": "x₀",
    "expr": "x0",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "x0": 2
   },
   {
    "a": 0.5,
    "x0": -2
   },
   {
    "a": -1,
    "x0": 3
   },
   {
    "a": 1.5,
    "x0": 0
   }
  ],
  "invariants": [
   "y0 - a*x0^2",
   "y0 - y_neg"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "x0": 2
    },
    "expect": {
     "y0": 4,
     "y_neg": 4
    }
   },
   {
    "params": {
     "a": 0.5,
     "x0": -2
    },
    "expect": {
     "y0": 2,
     "y_neg": 2
    }
   },
   {
    "params": {
     "a": -1,
     "x0": 3
    },
    "expect": {
     "y0": -9,
     "y_neg": -9
    }
   }
  ],
  "tol": 0.000001
 }
}