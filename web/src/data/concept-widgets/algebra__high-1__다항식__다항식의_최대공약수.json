{
 "id": "algebra/high-1/다항식/다항식의_최대공약수",
 "spec": {
  "title": "다항식의 최대공약수",
  "params": [
   {
    "name": "r1",
    "label": "첫 번째 근",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "r2",
    "label": "두 번째 근",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "r3",
    "label": "세 번째 근",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -1,
    "step": 0.1
   }
  ],
  "scope": "f10=(10-r1)*(10-r2); g10=(10-r2)*(10-r3); d10=(r1==r3 ? (10-r1)*(10-r2) : (10-r2)); degree=(r1==r3 ? 2 : 1); inv1=f10 - d10*(r1==r3 ? 1 : (10-r1)); inv2=g10 - d10*(r1==r3 ? 1 : (10-r3));",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -80,
    80
   ],
   "fns": [
    {
     "fn": "(x-r1)*(x-r2)",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "(x-r2)*(x-r3)",
     "label": "g(x)",
     "color": "red"
    },
    {
     "fn": "r1 == r3 ? (x-r1)*(x-r2) : (x-r2)",
     "label": "gcd",
     "color": "green"
    }
   ]
  },
  "readout": [
   {
    "label": "최대공약수의 차수",
    "expr": "degree",
    "digits": 0
   },
   {
    "label": "공통근",
    "expr": "r2",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "r1": 1,
    "r2": 0,
    "r3": -1
   },
   {
    "r1": 2,
    "r2": 1,
    "r3": 2
   },
   {
    "r1": -1,
    "r2": 2,
    "r3": 1
   },
   {
    "r1": 0,
    "r2": 0,
    "r3": 0
   }
  ],
  "invariants": [
   "inv1",
   "inv2"
  ],
  "oracle": [
   {
    "params": {
     "r1": 1,
     "r2": 0,
     "r3": -1
    },
    "expect": {
     "f10": 90,
     "d10": 10,
     "degree": 1
    }
   },
   {
    "params": {
     "r1": 2,
     "r2": 1,
     "r3": 2
    },
    "expect": {
     "f10": 72,
     "d10": 72,
     "degree": 2
    }
   }
  ],
  "tol": 0.000001
 }
}