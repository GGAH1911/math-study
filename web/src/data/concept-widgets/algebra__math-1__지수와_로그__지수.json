{
 "id": "algebra/math-1/지수와_로그/지수",
 "spec": {
  "title": "지수함수와 지수법칙",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.5,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "평행이동 c",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "조사점 t",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0.5,
    "step": 0.1
   }
  ],
  "scope": "f0=a^t; f1=a^(t+c); prod=f0*a^c; diff=f1-prod;",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    0,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a^x",
     "label": "y=a^x",
     "color": "blue"
    },
    {
     "fn": "a^(x+c)",
     "label": "y=a^(x+c)",
     "color": "red"
    }
   ],
   "points": [
    [
     "=t",
     "=a^t"
    ],
    [
     "=t+c",
     "=a^(t+c)"
    ]
   ],
   "pointsLabel": "$t$"
  },
  "readout": [
   {
    "label": "a^t",
    "expr": "f0",
    "digits": 4
   },
   {
    "label": "a^(t+c)",
    "expr": "f1",
    "digits": 4
   },
   {
    "label": "a^t·a^c",
    "expr": "prod",
    "digits": 4
   },
   {
    "label": "오차",
    "expr": "diff",
    "digits": 8
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1.5,
    "c": 1,
    "t": 0.5
   },
   {
    "a": 2,
    "c": -1,
    "t": 1.2
   },
   {
    "a": 0.8,
    "c": 0.5,
    "t": -0.7
   },
   {
    "a": 2.5,
    "c": 2,
    "t": -1.5
   }
  ],
  "invariants": [
   "diff"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "c": 1,
     "t": 0
    },
    "expect": {
     "f1": 2,
     "prod": 2,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 1.5,
     "c": 2,
     "t": 1
    },
    "expect": {
     "f1": 3.375,
     "prod": 3.375,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 0.5,
     "c": -1,
     "t": 2
    },
    "expect": {
     "f1": 0.5,
     "prod": 0.5,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}