       0,
       0
      ],
      [
       "=a",
       0
      ],
      [
       "=a",
       "=b"
      ],
      [
       0,
       "=b"
      ]
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "a × b",
    "expr": "p",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 3
   },
   {
    "a": -2,
    "b": 3
   },
   {
    "a": -2,
    "b": -3
   },
   {
    "a": 0,
    "b": 5
