{
 "id": "functions/calculus/수열의_극한/지수수열의_극한",
 "spec": {
  "title": "지수수열의 극한 {aⁿ}",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.2,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "n",
    "label": "항 번호 n",
    "type": "slider",
    "min": 1,
    "max": 30,
    "init": 6,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "an = a^n; an1 = a^(n+1)",
  "plot": {
   "range": [
    0,
    10
   ],
   "yRange": [
    0,
    8
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y = aˣ",
     "color": "#2563eb"
    },
    {
     "fn": "1",
     "label": "y = 1 (경계)",
     "color": "#9ca3af"
    }
   ],
   "points": [
    [
     "=n",
     "=an"
    ]
   ],
   "pointsLabel": "$a^n$"
  },
  "readout": [
   {
    "label": "밑 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "aⁿ (n번째 항)",
    "expr": "an",
    "digits": 5
   },
   {
    "label": "aⁿ⁺¹ (다음 항)",
    "expr": "an1",
    "digits": 5
   },
   {
    "label": "증가율 aⁿ⁺¹/aⁿ",
    "expr": "an1/an",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1.5,
    "n": 4
   },
   {
    "a": 0.8,
    "n": 10
   },
   {
    "a": 2.2,
    "n": 3
   },
   {
    "a": 1,
    "n": 7
   }
  ],
  "invariants": [
   "an1 - a*an",
   "an - exp(n*log(a))",
   "an1/an - a"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "n": 3
    },
    "expect": {
     "an": 8,
     "an1": 16
    }
   },
   {
    "params": {
     "a": 0.5,
     "n": 2
    },
    "expect": {
     "an": 0.25,
     "an1": 0.125
    }
   },
   {
    "params": {
     "a": 1,
     "n": 5
    },
    "expect": {
     "an": 1,
     "an1": 1
    }
   }
  ],
  "tol": 0.000001
 }
}