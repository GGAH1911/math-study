{
 "id": "삼각함수의_기본값",
 "spec": {
  "title": "삼각함수의 기본값 (단위원)",
  "params": [
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad = theta * pi / 180; cx = cos(rad); sy = sin(rad); ty = tan(rad)",
  "geometry": {
   "range": [
    -1.4,
    1.4
   ],
   "yRange": [
    -1.4,
    1.4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "cos θ",
    "expr": "cx",
    "digits": 4
   },
   {
    "label": "tan θ",
    "expr": "ty",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 30
   },
   {
    "theta": 45
   },
   {
    "theta": 120
   },
   {
    "theta": 225
   }
  ],
  "invariants": [
   "cx^2 + sy^2 - 1",
   "abs(ty - sy/cx)"
  ],
  "oracle": [
   {
    "params": {
     "theta": 30
    },
    "expect": {
     "cx": 0.8660254037844386,
     "sy": 0.5,
     "ty": 0.5773502691896257
    }
   },
   {
    "params": {
     "theta": 45
    },
    "expect": {
     "cx": 0.7071067811865476,
     "sy": 0.7071067811865476,
     "ty": 1
    }
   },
   {
    "params": {
     "theta": 120
    },
    "expect": {
     "cx": -0.5,
     "sy": 0.8660254037844386,
     "ty": -1.7320508075688772
    }
   }
  ],
  "tol": 0.000001
 }
}