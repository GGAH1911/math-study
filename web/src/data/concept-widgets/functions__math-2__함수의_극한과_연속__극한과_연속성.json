{
 "id": "functions/math-2/함수의_극한과_연속/극한과_연속성",
 "spec": {
  "title": "극한과 연속성 — f(1)을 어떻게 정의해야 연속일까?",
  "params": [
   {
    "name": "c",
    "label": "x=1에서 정의할 함숫값 f(1)=c",
    "type": "slider",
    "min": -1,
    "max": 5,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "L = 2; fa = c; gap = c - L; cont = (abs(c - 2) < 1e-9) ? 1 : 0; Lcheck = ((1 + 1e-7)^2 - 1)/((1 + 1e-7) - 1) - 2",
  "geometry": {
   "range": [
    -1,
    3
   ],
   "yRange": [
    -1.5,
    5.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      -1,
      0
     ],
     "to": [
      3,
      4
     ],
     "label": "y=(x^2-1)/(x-1)=x+1",
     "color": "#888888"
    },
    {
     "type": "segment",
     "from": [
      1,
      -1.5
     ],
     "to": [
      1,
      5.5
     ],
     "color": "#cccccc"
    },
    {
     "type": "circle",
     "center": [
      1,
      2
     ],
     "radius": 0.1,
     "label": "극한 L=2 (구멍)",
     "color": "#1565c0"
    },
    {
     "type": "point",
     "at": [
      1,
      "=fa"
     ],
     "label": "f(1)=c",
     "color": "#d32f2f"
    }
   ]
  },
  "readout": [
   {
    "label": "극한값 lim(x→1) f(x)",
    "expr": "L",
    "digits": 2
   },
   {
    "label": "함숫값 f(1)",
    "expr": "fa",
    "digits": 2
   },
   {
    "label": "극한 − 함숫값",
    "expr": "gap",
    "digits": 2
   },
   {
    "label": "연속이면 1, 불연속이면 0",
    "expr": "cont",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 0
   },
   {
    "c": 1
   },
   {
    "c": 2
   },
   {
    "c": 3.5
   }
  ],
  "invariants": [
   "Lcheck",
   "fa - c",
   "gap - (fa - L)"
  ],
  "oracle": [
   {
    "params": {
     "c": 0
    },
    "expect": {
     "L": 2,
     "fa": 0,
     "gap": -2,
     "cont": 0
    }
   },
   {
    "params": {
     "c": 2
    },
    "expect": {
     "L": 2,
     "fa": 2,
     "gap": 0,
     "cont": 1
    }
   },
   {
    "params": {
     "c": 5
    },
    "expect": {
     "L": 2,
     "fa": 5,
     "gap": 3,
     "cont": 0
    }
   }
  ],
  "tol": 0.000001
 }
}