{
 "id": "극댓값과_극솟값",
 "spec": {
  "title": "극댓값과 극솟값",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0.1,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "s=sqrt(a/3); x_max=-s; x_min=s; y_max=2*a*s/3; y_min=-2*a*s/3",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -3,
    3
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^3 - a*x",
     "label": "f(x) = x³ - ax",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "극대점 x",
    "expr": "x_max",
    "digits": 4
   },
   {
    "label": "극댓값",
    "expr": "y_max",
    "digits": 4
   },
   {
    "label": "극소점 x",
    "expr": "x_min",
    "digits": 4
   },
   {
    "label": "극솟값",
    "expr": "y_min",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5
   },
   {
    "a": 1
   },
   {
    "a": 2
   },
   {
    "a": 3
   }
  ],
  "invariants": [
   "x_max^3 - a*x_max - y_max",
   "x_min^3 - a*x_min - y_min",
   "3*x_max^2 - a",
   "3*x_min^2 - a",
   "y_max + y_min"
  ],
  "oracle": [
   {
    "params": {
     "a": 0.75
    },
    "expect": {
     "x_max": -0.5,
     "y_max": 0.25,
     "x_min": 0.5,
     "y_min": -0.25
    }
   },
   {
    "params": {
     "a": 3
    },
    "expect": {
     "x_max": -1,
     "y_max": 2,
     "x_min": 1,
     "y_min": -2
    }
   }
  ],
  "tol": 0.000001
 }
}