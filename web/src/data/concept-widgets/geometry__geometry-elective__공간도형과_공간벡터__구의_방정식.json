{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/구의_방정식",
 "spec": {
  "title": "구의 방정식: 평면 z=k로 자른 단면",
  "params": [
   {
    "name": "a",
    "label": "중심 a (x)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "중심 b (y)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "중심 c (z)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "r",
    "label": "반지름 r",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 4,
    "step": 0.1
   },
   {
    "name": "k",
    "label": "절단 평면 z=k",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "d = k - c; rho = sqrt(r^2 - d^2)",
  "geometry": {
   "range": [
    -9,
    9
   ],
   "yRange": [
    -9,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      "=a",
      "=b"
     ],
     "radius": "=r",
     "label": "중심 높이 대원 (반지름 r)",
     "color": "#cccccc"
    },
    {
     "type": "circle",
     "center": [
      "=a",
      "=b"
     ],
     "radius": "=rho",
     "label": "단면 z=k (반지름 √(r²−d²))",
     "color": "#1f77b4"
    },
    {
     "type": "point",
     "at": [
      "=a",
      "=b"
     ],
     "label": "C(a,b)",
     "color": "#d62728"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      "=b"
     ],
     "to": [
      "=a+rho",
      "=b"
     ],
     "label": "단면 반지름 ρ",
     "color": "#2ca02c"
    },
    {
     "type": "point",
     "at": [
      "=a+rho",
      "=b"
     ],
     "label": "P (구 위의 점)",
     "color": "#2ca02c"
    }
   ]
  },
  "readout": [
   {
    "label": "평면-중심 거리 |d|=|k−c|",
    "expr": "abs(d)",
    "digits": 3
   },
   {
    "label": "단면 반지름 ρ=√(r²−d²)",
    "expr": "rho",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 0,
    "c": 0,
    "r": 5,
    "k": 4
   },
   {
    "a": 1,
    "b": 1,
    "c": 0,
    "r": 5,
    "k": 3
   },
   {
    "a": 2,
    "b": -1,
    "c": 1,
    "r": 4,
    "k": 1
   },
   {
    "a": 0,
    "b": 0,
    "c": 2,
    "r": 6,
    "k": 0
   }
  ],
  "invariants": [
   "rho^2 + (k-c)^2 - r^2",
   "(a+rho - a)^2 + (b - b)^2 + (k-c)^2 - r^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 0,
     "c": 0,
     "r": 5,
     "k": 4
    },
    "expect": {
     "d": 4,
     "rho": 3
    }
   },
   {
    "params": {
     "a": 0,
     "b": 0,
     "c": 0,
     "r": 5,
     "k": 3
    },
    "expect": {
     "d": 3,
     "rho": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 1,
     "r": 3,
     "k": 1
    },
    "expect": {
     "d": 0,
     "rho": 3
    }
   }
  ],
  "tol": 0.000001
 }
}