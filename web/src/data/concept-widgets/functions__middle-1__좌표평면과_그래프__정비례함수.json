{
 "id": "functions/middle-1/좌표평면과_그래프/정비례함수",
 "spec": {
  "title": "정비례함수 y = ax",
  "params": [
   {
    "name": "a",
    "label": "비례상수 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "x 값",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.5,
    "unit": ""
   }
  ],
  "scope": "y0 = a*x0; x2 = 2*x0; y2 = a*x2; ratio = y0/x0",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "a*x",
     "label": "y = ax",
     "color": "#2563eb"
    }
   ],
   "points": [
    [
     "=x0",
     "=y0"
    ],
    [
     "=x2",
     "=y2"
    ]
   ],
   "pointsLabel": "$P(x_0,y_0),\\,Q(2x_0,\\,2y_0)$"
  },
  "readout": [
   {
    "label": "기울기 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "P 의 y = a·x",
    "expr": "y0",
    "digits": 3
   },
   {
    "label": "x를 2배(=x2)로 하면 y",
    "expr": "y2",
    "digits": 3
   },
   {
    "label": "y/x (항상 a)",
    "expr": "ratio",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "x0": 2
   },
   {
    "a": -1,
    "x0": 3
   },
   {
    "a": 0.5,
    "x0": 4
   },
   {
    "a": -2.5,
    "x0": -2
   }
  ],
  "invariants": [
   "y0 - a*x0",
   "y2 - 2*y0",
   "ratio - a",
   "a*0"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "x0": 2
    },
    "expect": {
     "y0": 4,
     "y2": 8,
     "ratio": 2
    }
   },
   {
    "params": {
     "a": -1,
     "x0": 3
    },
    "expect": {
     "y0": -3,
     "y2": -6,
     "ratio": -1
    }
   },
   {
    "params": {
     "a": 0.5,
     "x0": 4
    },
    "expect": {
     "y0": 2,
     "y2": 4,
     "ratio": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}