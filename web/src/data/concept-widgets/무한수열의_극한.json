{
 "id": "무한수열의_극한",
 "spec": {
  "title": "무한수열의 극한: ε–N 정의와 수렴·발산",
  "params": [
   {
    "name": "A",
    "label": "A (극한 후보 · 수렴값)",
    "type": "slider",
    "min": -2,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "B",
    "label": "B (1/n 항 · 접근 속도와 방향)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "C",
    "label": "C (n 항 · 0이 아니면 발산)",
    "type": "slider",
    "min": -0.3,
    "max": 0.3,
    "init": 0,
    "step": 0.05
   },
   {
    "name": "D",
    "label": "D ((-1)^n 항 · 0이 아니면 진동)",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "eps",
    "label": "ε (허용 오차)",
    "type": "slider",
    "min": 0.05,
    "max": 1,
    "init": 0.5,
    "step": 0.05
   },
   {
    "name": "N",
    "label": "N (기준 번호)",
    "type": "slider",
    "min": 1,
    "max": 30,
    "init": 5,
    "step": 1
   }
  ],
  "scope": "L = A; aN1 = A + B/(N+1) + C*(N+1) + D*cos(pi*(N+1)); err = abs(aN1 - L); conv = (abs(C) < 0.001 ? (abs(D) < 0.001 ? 1 : 0) : 0); tail = (conv == 1 ? abs(B)/(N+1) : 1000000); ok = (tail < eps ? 1 : 0); Nreq = (conv == 1 ? max(1, ceil(abs(B)/eps)) : -1)",
  "plot": {
   "range": [
    1,
    30
   ],
   "yRange": [
    -3,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "A + B/x + C*x + D*cos(pi*x)",
     "label": "$a_n = A + \\dfrac{B}{n} + Cn + D(-1)^n$",
     "color": "#2196F3"
    },
    {
     "fn": "L",
     "label": "$L = A$",
     "color": "#9ca3af",
     "dashed": true
    },
    {
     "fn": "L+eps",
     "label": "$L+\\varepsilon$",
     "color": "#10b981",
     "dashed": true
    },
    {
     "fn": "L-eps",
     "label": "$L-\\varepsilon$",
     "color": "#10b981",
     "dashed": true
    }
   ],
   "points": [
    [
     "=N+1",
     "=aN1"
    ],
    [
     "=N+2",
     "=A + B/(N+2) + C*(N+2) + D*cos(pi*(N+2))"
    ],
    [
     "=N+3",
     "=A + B/(N+3) + C*(N+3) + D*cos(pi*(N+3))"
    ]
   ],
   "pointsLabel": "$n>N$ 인 항들"
  },
  "readout": [
   {
    "label": "극한 후보 L",
    "expr": "L",
    "digits": 2
   },
   {
    "label": "ε",
    "expr": "eps",
    "digits": 2
   },
   {
    "label": "a_{N+1}",
    "expr": "aN1",
    "digits": 4
   },
   {
    "label": "|a_{N+1} − L|",
    "expr": "err",
    "digits": 4
   },
   {
    "label": "수렴? (1=수렴, 0=발산·진동)",
    "expr": "conv",
    "digits": 0
   },
   {
    "label": "n>N 인 모든 항이 밴드 안? (1=예)",
    "expr": "ok",
    "digits": 0
   },
   {
    "label": "이 ε에 충분한 N (없으면 −1)",
    "expr": "Nreq",
    "digits": 0
   }
  ]
 },
 "recipe": {
