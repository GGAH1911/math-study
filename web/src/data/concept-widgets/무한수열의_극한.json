    "C": 0,
    "D": 0,
    "eps": 0.05,
    "N": 1
   }
  ],
  "invariants": [
   "aN1 - (A + B/(N+1) + C*(N+1) + D*cos(pi*(N+1)))",
   "err - abs(aN1 - L)",
   "L - A",
   "(conv == 1 ? tail - abs(B)/(N+1) : 0)",
   "ok - (tail < eps ? 1 : 0)",
   "(conv == 1 ? (abs(B)/(Nreq+1) < eps ? 0 : 1) : 0)",
   "(abs(C) < 0.001 ? (abs(D) < 0.001 ? conv - 1 : conv) : conv)"
  ],
