{
 "id": "geometry/middle-3/삼각비/피타고라스_항등식",
 "spec": {
  "title": "피타고라스 항등식: sin²θ + cos²θ = 1",
  "params": [
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; cx=cos(rad); sy=sin(rad)",
  "geometry": {
   "range": [
    -1.4,
    1.4
   ],
   "yRange": [
    -1.4,
    1.4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1,
     "label": "단위원"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ],
     "label": "1"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      0
     ],
     "label": "cosθ"
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ],
     "label": "sinθ"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P(cosθ, sinθ)"
    }
   ]
  },
  "readout": [
   {
    "label": "cosθ",
    "expr": "cx",
    "digits": 4
   },
   {
    "label": "sinθ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "sin²θ + cos²θ",
    "expr": "sy^2+cx^2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 0
   },
   {
    "theta": 30
   },
   {
    "theta": 90
   },
   {
    "theta": 225
   }
  ],
  "invariants": [
   "sy^2+cx^2-1",
   "cx-cos(theta*pi/180)",
   "sy-sin(theta*pi/180)"
  ],
  "oracle": [
   {
    "params": {
     "theta": 30
    },
    "expect": {
     "cx": 0.8660254037844387,
     "sy": 0.5
    }
   },
   {
    "params": {
     "theta": 90
    },
    "expect": {
     "cx": 0,
     "sy": 1
    }
   },
   {
    "params": {
     "theta": 0
    },
    "expect": {
     "cx": 1,
     "sy": 0
    }
   }
  ],
  "tol": 0.000001
 }
}