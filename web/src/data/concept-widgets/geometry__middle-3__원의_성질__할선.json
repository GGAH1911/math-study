{
 "id": "geometry/middle-3/원의_성질/할선",
 "spec": {
  "title": "할선 — 원과 두 점에서 만나는 직선",
  "params": [
   {
    "name": "phi",
    "label": "수선 방향 φ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "d",
    "label": "중심~직선 거리 d",
    "type": "slider",
    "min": 0,
    "max": 2.8,
    "init": 1.8,
    "step": 0.1
   }
  ],
  "scope": "R=3; rad=phi*pi/180; fx=d*cos(rad); fy=d*sin(rad); ux=-sin(rad); uy=cos(rad); t=sqrt(R^2-d^2); ax=fx+t*ux; ay=fy+t*uy; bx=fx-t*ux; by=fy-t*uy; chord=2*t",
  "geometry": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -4,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=R",
     "label": "원 O"
    },
    {
     "type": "line",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "할선"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "현 AB"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=fx",
      "=fy"
     ],
     "label": "거리 d"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    }
   ]
  },
  "readout": [
   {
    "label": "현 AB 길이",
    "expr": "chord",
    "digits": 3
   },
   {
    "label": "중심에서의 거리 d",
    "expr": "d",
    "digits": 3
   },
   {
    "label": "반현 길이 √(R²−d²)",
    "expr": "t",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "phi": 30,
    "d": 1.8
   },
   {
    "phi": 0,
    "d": 0
   },
   {
    "phi": 90,
    "d": 0
   },
   {
    "phi": 210,
    "d": 2.4
   }
  ],
  "invariants": [
   "ax^2+ay^2-R^2",
   "bx^2+by^2-R^2",
   "chord^2-4*(R^2-d^2)",
   "(ax+bx)/2-fx",
   "(ay+by)/2-fy",
   "(ax-bx)*fx+(ay-by)*fy"
  ],
  "oracle": [
   {
    "params": {
     "phi": 0,
     "d": 0
    },
    "expect": {
     "ax": 0,
     "ay": 3,
     "bx": 0,
     "by": -3,
     "chord": 6
    }
   },
   {
    "params": {
     "phi": 0,
     "d": 1.8
    },
    "expect": {
     "fx": 1.8,
     "ax": 1.8,
     "ay": 2.4,
     "by": -2.4,
     "chord": 4.8
    }
   },
   {
    "params": {
     "phi": 90,
     "d": 0
    },
    "expect": {
     "ax": -3,
     "chord": 6
    }
   }
  ],
  "tol": 0.000001
 }
}