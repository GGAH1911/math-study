{
 "id": "functions/middle-2/일차함수/일차함수의_그래프",
 "spec": {
  "title": "일차함수의 그래프 y = ax + b",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "y절편 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "y0=a*0+b; y1=a*1+b; y2=a*3+b; slope=(y2-y1)/(3-1); xint=-b/a",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "a*x+b",
     "label": "y=ax+b",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "기울기 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "y절편 (0,b)",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "x절편 (-b/a)",
    "expr": "xint",
    "digits": 2
   },
   {
    "label": "두 점 (1,3) 사이 기울기",
    "expr": "slope",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1
   },
   {
    "a": -1,
    "b": 3
   },
   {
    "a": 0.5,
    "b": -2
   },
   {
    "a": -3,
    "b": 0
   }
  ],
  "invariants": [
   "y0 - b",
   "slope - a",
   "(a*xint+b)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1
    },
    "expect": {
     "y0": 1,
     "y1": 3,
     "y2": 7,
     "slope": 2,
     "xint": -0.5
    }
   },
   {
    "params": {
     "a": -1,
     "b": 3
    },
    "expect": {
     "y0": 3,
     "y1": 2,
     "y2": 0,
     "slope": -1,
     "xint": 3
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": -2
    },
    "expect": {
     "y0": -2,
     "y1": -1.5,
     "y2": -0.5,
     "slope": 0.5,
     "xint": 4
    }
   }
  ],
  "tol": 0.000001
 }
}