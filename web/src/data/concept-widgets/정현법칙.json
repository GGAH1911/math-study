{
 "id": "정현법칙",
 "spec": {
  "title": "정현법칙 탐구",
  "params": [
   {
    "name": "angleA",
    "label": "각 A",
    "type": "slider",
    "min": 10,
    "max": 160,
    "init": 50,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "angleB",
    "label": "각 B",
    "type": "slider",
    "min": 10,
    "max": 160,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "Adeg = angleA; Bdeg = min(angleB, 170 - angleA); Arad = Adeg * pi / 180; Brad = Bdeg * pi / 180; Cdeg = 180 - Adeg - Bdeg; Crad = Cdeg * pi / 180; R = 1; a = 2 * R * sin(Arad); b = 2 * R * sin(Brad); c = 2 * R * sin(Crad); xA = R; yA = 0; Bpos = 2 * Crad; xB = R * cos(Bpos); yB = R * sin(Bpos); Cpos = 2 * Crad + 2 * Arad; xC = R * cos(Cpos); yC = R * sin(Cpos);",
  "geometry": {
   "range": [
    -1.6,
    1.6
   ],
   "yRange": [
    -1.6,
    1.6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=R"
    },
    {
     "type": "polygon",
     "vertices": [
      [
       "=xA",
       "=yA"
      ],
      [
       "=xB",
       "=yB"
      ],
      [
       "=xC",
       "=yC"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      "=xA",
      "=yA"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=xB",
      "=yB"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=xC",
      "=yC"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "각 A",
    "expr": "Adeg",
    "digits": 1
   },
   {
    "label": "각 B",
    "expr": "Bdeg",
    "digits": 1
   },
   {
    "label": "각 C",
    "expr": "Cdeg",
    "digits": 1
   },
   {
    "label": "변 a",
