  "invariants": [
   "a / sin(Arad) - b / sin(Brad)",
   "a / sin(Arad) - c / sin(Crad)",
   "sqrt((xB-xC)^2 + (yB-yC)^2) - a",
   "sqrt((xC-xA)^2 + (yC-yA)^2) - b",
   "sqrt((xA-xB)^2 + (yA-yB)^2) - c",
   "xA^2 + yA^2 - R^2",
   "xB^2 + yB^2 - R^2",
   "xC^2 + yC^2 - R^2"
  ],
  "oracle": [
