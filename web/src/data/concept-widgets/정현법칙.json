   },
   {
    "label": "sin C",
    "expr": "sin(Crad)",
    "digits": 4
   },
   {
    "label": "a/sin A",
    "expr": "a / sin(Arad)",
    "digits": 4
   },
   {
    "label": "b/sin B",
    "expr": "b / sin(Brad)",
    "digits": 4
   },
   {
    "label": "c/sin C",
    "expr": "c / sin(Crad)",
    "digits": 4
   },
   {
    "label": "2R",
    "expr": "2 * R",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
