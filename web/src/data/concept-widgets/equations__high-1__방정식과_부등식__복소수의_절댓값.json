    }
   },
   {
    "params": {
     "a": 0,
     "b": 2
    },
    "expect": {
     "r": 2
    }
   },
   {
    "params": {
     "a": -3,
     "b": 4
    },
    "expect": {
     "r": 5
    }
   }
  ],
  "tol": 1e-06
 }
}
