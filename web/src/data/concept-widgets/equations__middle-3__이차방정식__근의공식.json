{
 "id": "equations/middle-3/이차방정식/근의공식",
 "spec": {
  "title": "근의공식 탐구",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "D=b^2-4*a*c; x1=D>=0?(-b+sqrt(D))/(2*a):0/0; x2=D>=0?(-b-sqrt(D))/(2*a):0/0",
  "plot": {
   "range": [
    -10,
    10
   ],
   "yRange": [
    -20,
    20
   ],
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "y = ax² + bx + c",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D",
    "expr": "D",
    "digits": 2
   },
   {
    "label": "x₁",
    "expr": "x1",
    "digits": 4
   },
   {
    "label": "x₂",
    "expr": "x2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": -3,
    "c": 2
   },
   {
    "a": 1,
    "b": 2,
    "c": -3
   },
   {
    "a": 2,
    "b": 5,
    "c": -3
   },
   {
    "a": 1,
    "b": -2,
    "c": 1
   }
  ],
  "invariants": [
   "abs(a*x1^2 + b*x1 + c) + abs(a*x2^2 + b*x2 + c)",
   "abs(x1+x2 + b/a) + abs(x1*x2 - c/a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": -3,
     "c": 2
    },
    "expect": {
     "D": 1,
     "x1": 2,
     "x2": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": -3
    },
    "expect": {
     "D": 16,
     "x1": 1,
     "x2": -3
    }
   },
   {
    "params": {
     "a": 2,
     "b": 5,
     "c": -3
    },
    "expect": {
     "D": 49,
     "x1": 0.5,
     "x2": -3
    }
   }
  ],
  "tol": 0.000001
 }
}