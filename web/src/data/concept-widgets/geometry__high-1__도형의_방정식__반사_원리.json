{
 "id": "geometry/high-1/도형의_방정식/반사_원리",
 "spec": {
  "title": "반사 원리: 직선 l에 대한 점의 대칭이동",
  "params": [
   {
    "name": "m",
    "label": "직선 l 기울기",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "k",
    "label": "직선 l y절편",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "px",
    "label": "P의 x",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "py",
    "label": "P의 y",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "a=m; b=-1; c=k; den=a^2+b^2; d=(a*px+b*py+c)/den; qx=px-2*a*d; qy=py-2*b*d; midx=(px+qx)/2; midy=(py+qy)/2",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=-6",
      "=m*-6+k"
     ],
     "to": [
      "=6",
      "=m*6+k"
     ],
     "label": "l",
     "color": "#888"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P",
     "color": "#1565c0"
    },
    {
     "type": "point",
     "at": [
      "=qx",
      "=qy"
     ],
     "label": "P'",
     "color": "#c62828"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=qx",
      "=qy"
     ],
     "color": "#c62828"
    },
    {
     "type": "point",
     "at": [
      "=midx",
      "=midy"
     ],
     "label": "M",
     "color": "#2e7d32"
    }
   ]
  },
  "readout": [
   {
    "label": "P' x",
    "expr": "qx",
    "digits": 3
   },
   {
    "label": "P' y",
    "expr": "qy",
    "digits": 3
   },
   {
    "label": "중점 M",
    "expr": "midx",
    "digits": 3
   },
   {
    "label": "PM 길이 = MP'",
    "expr": "sqrt((px-midx)^2+(py-midy)^2)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m": 1,
    "k": 0,
    "px": 3,
    "py": 1
   },
   {
    "m": 0,
    "k": 0,
    "px": 2,
    "py": 3
   },
   {
    "m": 0,
    "k": 2,
    "px": 1,
    "py": 1
   },
   {
    "m": -2,
    "k": 1,
    "px": 4,
    "py": -2
   }
  ],
  "invariants": [
   "m*midx+k-midy",
   "(qx-px)*1+(qy-py)*m",
   "(a*px+b*py+c)+(a*qx+b*qy+c)"
  ],
  "oracle": [
   {
    "params": {
     "m": 1,
     "k": 0,
     "px": 3,
     "py": 1
    },
    "expect": {
     "qx": 1,
     "qy": 3
    }
   },
   {
    "params": {
     "m": 0,
     "k": 0,
     "px": 2,
     "py": 3
    },
    "expect": {
     "qx": 2,
     "qy": -3
    }
   },
   {
    "params": {
     "m": 0,
     "k": 2,
     "px": 1,
     "py": 1
    },
    "expect": {
     "qx": 1,
     "qy": 3
    }
   }
  ],
  "tol": 0.000001
 }
}