{
 "id": "functions/math-1/삼각함수/함수의_주기성",
 "spec": {
  "title": "함수의 주기성 — f(x+T) = f(x)",
  "params": [
   {
    "name": "T",
    "label": "기본 주기 T",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 3,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "관찰점 x₀",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 0.75,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "w = 2*pi/T; y0 = sin(w*x0); y1 = sin(w*(x0+T)); y2 = sin(w*(x0+2*T))",
  "plot": {
   "range": [
    0,
    12
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "sin(2*pi*x/T)",
     "label": "f(x)=sin(2πx/T)",
     "color": "#2563eb"
    },
    {
     "fn": "y0",
     "label": "y=f(x₀) (반복되는 높이)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "기본 주기 T",
    "expr": "T",
    "digits": 2
   },
   {
    "label": "f(x₀)",
    "expr": "y0",
    "digits": 4
   },
   {
    "label": "f(x₀+T)",
    "expr": "y1",
    "digits": 4
   },
   {
    "label": "f(x₀+2T)",
    "expr": "y2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "T": 3,
    "x0": 0.75
   },
   {
    "T": 4,
    "x0": 1
   },
   {
    "T": 6,
    "x0": 0.5
   },
   {
    "T": 2,
    "x0": 1.3
   }
  ],
  "invariants": [
   "y0 - y1",
   "y1 - y2",
   "y0 - y2"
  ],
  "oracle": [
   {
    "params": {
     "T": 4,
     "x0": 1
    },
    "expect": {
     "y0": 1,
     "y1": 1,
     "y2": 1
    }
   },
   {
    "params": {
     "T": 6,
     "x0": 0.5
    },
    "expect": {
     "y0": 0.5,
     "y1": 0.5
    }
   },
   {
    "params": {
     "T": 3,
     "x0": 0.75
    },
    "expect": {
     "y0": 1,
     "y1": 1
    }
   }
  ],
  "tol": 0.000001
 }
}