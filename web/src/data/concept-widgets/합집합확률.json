{
 "id": "합집합확률",
 "spec": {
  "title": "합집합확률",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.4,
    "step": 0.01
   },
   {
    "name": "pB",
    "label": "P(B)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.6,
    "step": 0.01
   },
   {
    "name": "t",
    "label": "교집합 비율 t",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "low=max(0,pA+pB-1); high=min(pA,pB); pAB=low+(high-low)*t; pUnion=pA+pB-pAB",
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1
   ],
   "fns": [
    {
     "fn": "pA+pB-(low+(high-low)*x)",
     "label": "P(A∪B)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "P(A)",
    "expr": "pA",
    "digits": 3
   },
   {
    "label": "P(B)",
    "expr": "pB",
    "digits": 3
   },
   {
    "label": "P(A∩B)",
    "expr": "pAB",
    "digits": 3
   },
   {
    "label": "P(A∪B)",
    "expr": "pUnion",
    "digits": 3
   },
   {
    "label": "P(A∩B) 최소",
    "expr": "low",
    "digits": 3
   },
   {
    "label": "P(A∩B) 최대",
    "expr": "high",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "pA": 0.4,
    "pB": 0.6,
    "t": 0.5
   },
   {
    "pA": 0.8,
    "pB": 0.9,
    "t": 0.7
   },
   {
    "pA": 0.2,
    "pB": 0.3,
    "t": 1
   },
   {
    "pA": 0.5,
    "pB": 0.5,
    "t": 0
   }
  ],
  "invariants": [
   "max(low-pAB, pAB-high, 0)",
   "t==0 ? abs(pUnion - min(1,pA+pB)) : 0",
   "t==1 ? abs(pUnion - max(pA,pB)) : 0"
  ],
  "oracle": [
   {
    "params": {
     "pA": 0.4,
     "pB": 0.6,
     "t": 0.5
    },
    "expect": {
     "pAB": 0.2,
     "pUnion": 0.8
    }
   },
   {
    "params": {
     "pA": 0.8,
     "pB": 0.9,
     "t": 0.7
    },
    "expect": {
     "pAB": 0.77,
     "pUnion": 0.93
    }
   },
   {
    "params": {
     "pA": 0.2,
     "pB": 0.3,
     "t": 1
    },
    "expect": {
     "pAB": 0.2,
     "pUnion": 0.3
    }
   }
  ],
  "tol": 0.000001
 }
}