{
 "id": "함수의_최댓값",
 "spec": {
  "title": "함수의 최댓값",
  "params": [
   {
    "name": "a",
    "label": "계수 a",
    "type": "slider",
    "min": 0.1,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "h",
    "label": "꼭짓점의 x좌표",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "k",
    "label": "최댓값 M",
    "type": "slider",
    "min": -2,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "x",
    "label": "탐구점의 x좌표",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "M=k; vx=h; fx=-a*(x-h)^2+k",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "-a*(x-h)^2+k",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "k",
     "label": "최댓값 M",
     "color": "red"
    }
   ],
   "points": [
    [
     "=x",
     "=fx"
    ]
   ],
   "pointsLabel": "$(x, f(x))$"
  },
  "readout": [
   {
    "label": "최댓값 M",
    "expr": "M"
   },
   {
    "label": "최댓점 x좌표",
    "expr": "vx"
   },
   {
    "label": "f(x)",
    "expr": "fx"
   },
   {
    "label": "M - f(x)",
    "expr": "M - fx"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "h": 0,
    "k": 2,
    "x": 1
   },
   {
    "a": 1,
    "h": 0,
    "k": 2,
    "x": 0
   },
   {
    "a": 0.5,
    "h": -1,
    "k": 3,
    "x": 1
   },
   {
    "a": 2,
    "h": 2,
    "k": -1,
    "x": 3
   }
  ],
  "invariants": [
   "M - (-a*(h-h)^2 + k)",
   "max(0, fx - M)",
   "(-a*(h+1-h)^2 + k) - (-a*(h-1-h)^2 + k)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "h": 0,
     "k": 2,
     "x": 1
    },
    "expect": {
     "M": 2,
     "vx": 0,
     "fx": 1
    }
   },
   {
    "params": {
     "a": 1,
     "h": 0,
     "k": 2,
     "x": 0
    },
    "expect": {
     "M": 2,
     "vx": 0,
     "fx": 2
    }
   },
   {
    "params": {
     "a": 0.5,
     "h": -1,
     "k": 3,
     "x": 1
    },
    "expect": {
     "M": 3,
     "vx": -1,
     "fx": 1
    }
   },
   {
    "params": {
     "a": 2,
     "h": 2,
     "k": -1,
     "x": 3
    },
    "expect": {
     "M": -1,
     "vx": 2,
     "fx": -3
    }
   }
  ],
  "tol": 0.000001
 }
}