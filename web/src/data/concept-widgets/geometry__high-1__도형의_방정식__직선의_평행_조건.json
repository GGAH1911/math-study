{
 "id": "geometry/high-1/도형의_방정식/직선의_평행_조건",
 "spec": {
  "title": "직선의 평행 조건: 기울기와 y절편",
  "params": [
   {
    "name": "m1",
    "label": "m₁ (l₁ 기울기)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "n1",
    "label": "n₁ (l₁ y절편)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.5
   },
   {
    "name": "m2",
    "label": "m₂ (l₂ 기울기)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "n2",
    "label": "n₂ (l₂ y절편)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.5
   }
  ],
  "scope": "sd = m2 - m1; d0 = n2 - n1; d1 = (m2 + n2) - (m1 + n1); d2 = (2*m2 + n2) - (2*m1 + n1); gapinv = (d1 - d0) - sd",
  "geometry": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "m1*x + n1",
     "label": "l₁: y=m₁x+n₁",
     "color": "#2563eb"
    },
    {
     "fn": "m2*x + n2",
     "label": "l₂: y=m₂x+n₂",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "기울기 차 |m₂-m₁| (0이면 평행 후보)",
    "expr": "abs(sd)",
    "digits": 3
   },
   {
    "label": "y절편 차 |n₂-n₁| (0이면 일치)",
    "expr": "abs(n2-n1)",
    "digits": 3
   },
   {
    "label": "두 직선 세로 간격(x=0)",
    "expr": "d0",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m1": 1,
    "n1": 0,
    "m2": 1,
    "n2": 2
   },
   {
    "m1": 2,
    "n1": 1,
    "m2": -1,
    "n2": 3
   },
   {
    "m1": -0.5,
    "n1": -2,
    "m2": 3,
    "n2": 0
   },
   {
    "m1": 0,
    "n1": 1,
    "m2": 0,
    "n2": -3
   }
  ],
  "invariants": [
   "(d1 - d0) - sd",
   "(d2 - d0) - 2*sd",
   "gapinv"
  ],
  "oracle": [
   {
    "params": {
     "m1": 1,
     "n1": 0,
     "m2": 1,
     "n2": 2
    },
    "expect": {
     "sd": 0,
     "d0": 2,
     "d1": 2
    }
   },
   {
    "params": {
     "m1": 2,
     "n1": 1,
     "m2": -1,
     "n2": 3
    },
    "expect": {
     "sd": -3,
     "d0": 2,
     "d1": -1
    }
   },
   {
    "params": {
     "m1": -0.5,
     "n1": -2,
     "m2": 3,
     "n2": 0
    },
    "expect": {
     "sd": 3.5,
     "d0": 2,
     "d1": 5.5
    }
   }
  ],
  "tol": 0.000001
 }
}