{
 "id": "functions/math-2/미분/극값의_합_조건",
 "spec": {
  "title": "극값의 합 조건 — 변곡점에 대한 점대칭",
  "params": [
   {
    "name": "a",
    "label": "최고차항 a",
    "type": "slider",
    "min": 0.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "극대 위치 α",
    "type": "slider",
    "min": -2.5,
    "max": -0.5,
    "init": -1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "q",
    "label": "극소 위치 β",
    "type": "slider",
    "min": 0.5,
    "max": 2.5,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "d",
    "label": "상수항 d (세로 이동)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   }
  ],
  "scope": "b = -3*a*(p+q)/2; c = 3*a*p*q; xi = (p+q)/2; M = a*p^3 + b*p^2 + c*p + d; m = a*q^3 + b*q^2 + c*q + d; fi = a*xi^3 + b*xi^2 + c*xi + d; sumExt = M + m; twoFi = 2*fi",
  "plot": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "f(x)=ax³+bx²+cx+d",
     "color": "#2563eb"
    },
    {
     "fn": "M",
     "label": "극댓값 M (x=α 접선)",
     "color": "#ef4444"
    },
    {
     "fn": "m",
     "label": "극솟값 m (x=β 접선)",
     "color": "#10b981"
    },
    {
     "fn": "fi",
     "label": "변곡점 높이 = (M+m)/2",
     "color": "#a855f7"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값 M = f(α)",
    "expr": "M",
    "digits": 3
   },
   {
    "label": "극솟값 m = f(β)",
    "expr": "m",
    "digits": 3
   },
   {
    "label": "극값의 합 M+m",
    "expr": "sumExt",
    "digits": 3
   },
   {
    "label": "변곡점 x좌표 (α+β)/2",
    "expr": "xi",
    "digits": 3
   },
   {
    "label": "변곡점 함수값 f(변곡점)",
    "expr": "fi",
    "digits": 3
   },
   {
    "label": "변곡점 함수값의 2배 (= M+m 확인)",
    "expr": "twoFi",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "p": -1,
    "q": 1,
    "d": 1
   },
   {
    "a": 1,
    "p": -2,
    "q": 2,
    "d": 0
   },
   {
    "a": 1,
    "p": -2,
    "q": 1,
    "d": 0
   },
   {
    "a": 1.2,
    "p": -1.5,
    "q": 0.5,
    "d": 2
   }
  ],
  "invariants": [
   "M + m - 2*fi",
   "3*a*p^2 + 2*b*p + c",
   "3*a*q^2 + 2*b*q + c",
   "6*a*xi + 2*b",
   "xi - (p+q)/2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "p": -1,
     "q": 1,
     "d": 1
    },
    "expect": {
     "M": 3,
     "m": -1,
     "fi": 1,
     "sumExt": 2,
     "xi": 0
    }
   },
   {
    "params": {
     "a": 1,
     "p": -2,
     "q": 2,
     "d": 0
    },
    "expect": {
     "M": 16,
     "m": -16,
     "fi": 0,
     "sumExt": 0,
     "xi": 0
    }
   },
   {
    "params": {
     "a": 1,
     "p": -2,
     "q": 1,
     "d": 0
    },
    "expect": {
     "M": 10,
     "m": -3.5,
     "fi": 3.25,
     "sumExt": 6.5,
     "xi": -0.5
    }
   }
  ],
  "tol": 0.000001
 }
}