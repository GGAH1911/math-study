{
 "id": "geometry/middle-3/원의_성질/삼각형의_내접원",
 "spec": {
  "title": "삼각형의 내접원과 내심",
  "params": [
   {
    "name": "Bx",
    "label": "B의 x좌표 (밑변 길이)",
    "type": "slider",
    "min": 3,
    "max": 9,
    "init": 6,
    "step": 0.5
   },
   {
    "name": "Cx",
    "label": "C의 x좌표",
    "type": "slider",
    "min": -1,
    "max": 7,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "Cy",
    "label": "C의 y좌표 (높이)",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 4,
    "step": 0.5
   }
  ],
  "scope": "c = Bx; b = sqrt(Cx^2 + Cy^2); a = sqrt((Bx-Cx)^2 + Cy^2); per = a+b+c; s = per/2; area = abs(Bx*Cy)/2; r = area/s; Ix = (b*Bx + c*Cx)/per; Iy = c*Cy/per; distCA = abs(Cy*Ix - Cx*Iy)/b",
  "geometry": {
   "range": [
    -1,
    7
   ],
   "yRange": [
    -1,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=Bx",
       0
      ],
      [
       "=Cx",
       "=Cy"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      0
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    },
    {
     "type": "circle",
     "center": [
      "=Ix",
      "=Iy"
     ],
     "radius": "=r"
    },
    {
     "type": "point",
     "at": [
      "=Ix",
      "=Iy"
     ],
     "label": "I (내심)"
    },
    {
     "type": "segment",
     "from": [
      "=Ix",
      "=Iy"
     ],
     "to": [
      "=Ix",
      0
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "내접원 반지름 r",
    "expr": "r",
    "digits": 3
   },
   {
    "label": "삼각형 넓이 A",
    "expr": "area",
    "digits": 3
   },
   {
    "label": "둘레의 절반 s",
    "expr": "s",
    "digits": 3
   },
   {
    "label": "r·s (=넓이 검산)",
    "expr": "r*s",
    "digits": 3
   },
   {
    "label": "내심 x좌표",
    "expr": "Ix",
    "digits": 3
   },
   {
    "label": "내심 y좌표 (=밑변까지 거리=r)",
    "expr": "Iy",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "Bx": 6,
    "Cx": 3,
    "Cy": 4
   },
   {
    "Bx": 5,
    "Cx": 2,
    "Cy": 3
   },
   {
    "Bx": 7,
    "Cx": 4,
    "Cy": 5
   },
   {
    "Bx": 4,
    "Cx": 1,
    "Cy": 2
   }
  ],
  "invariants": [
   "area - r*s",
   "Iy - r",
   "distCA - r"
  ],
  "oracle": [
   {
    "params": {
     "Bx": 6,
     "Cx": 3,
     "Cy": 4
    },
    "expect": {
     "r": 1.5,
     "Ix": 3,
     "Iy": 1.5,
     "area": 12,
     "s": 8
    }
   },
   {
    "params": {
     "Bx": 4,
     "Cx": 0,
     "Cy": 3
    },
    "expect": {
     "r": 1,
     "Ix": 1,
     "Iy": 1,
     "area": 6,
     "s": 6
    }
   },
   {
    "params": {
     "Bx": 8,
     "Cx": 0,
     "Cy": 6
    },
    "expect": {
     "r": 2,
     "Ix": 2,
     "Iy": 2,
     "area": 24,
     "s": 12
    }
   }
  ],
  "tol": 1e-06
 }
}
