  "scope": "dx=bx-ax; dy=by-ay; L=sqrt(dx^2+dy^2); Ls=L<1e-9?1:L; mx=(ax+bx)/2; my=(ay+by)/2; nx=-dy/Ls; ny=dx/Ls; px=mx+t*nx; py=my+t*ny; da=sqrt((px-ax)^2+(py-ay)^2); db=sqrt((px-bx)^2+(py-by)^2); ex=cx-bx; ey=cy-by; L2=sqrt(ex^2+ey^2); L2s=L2<1e-9?1:L2; m2x=(bx+cx)/2; m2y=(by+cy)/2; n2x=-ey/L2s; n2y=ex/L2s; det=2*((bx-ax)*(cy-ay)-(by-ay)*(cx-ax)); col=abs(det)<1e-6?1:0; ds=col==1?1:det; qa=ax^2+ay^2; qb=bx^2+by^2; qc=cx^2+cy^2; ux=(qa*(by-cy)+qb*(cy-ay)+qc*(ay-by))/ds; uy=(qa*(cx-bx)+qb*(ax-cx)+qc*(bx-ax))/ds; ox=col==1?mx:ux; oy=col==1?my:uy; R=col==1?0:sqrt((ox-ax)^2+(oy-ay)^2); ra=sqrt((ox-ax)^2+(oy-ay)^2); rb=sqrt((ox-bx)^2+(oy-by)^2); rc=sqrt((ox-cx)^2+(oy-cy)^2)",
