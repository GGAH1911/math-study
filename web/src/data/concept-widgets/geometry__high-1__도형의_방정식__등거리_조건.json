{
 "id": "geometry/high-1/도형의_방정식/등거리_조건",
 "spec": {
  "title": "등거리 조건: 두 점의 수직이등분선",
  "params": [
   {
    "name": "t",
    "label": "수직이등분선 위 P의 위치",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "ax=-2; ay=-1; bx=3; by=1; mx=(ax+bx)/2; my=(ay+by)/2; dx=bx-ax; dy=by-ay; L=sqrt(dx^2+dy^2); nx=-dy/L; ny=dx/L; px=mx+t*nx; py=my+t*ny; da=sqrt((px-ax)^2+(py-ay)^2); db=sqrt((px-bx)^2+(py-by)^2)",
  "geometry": {
   "range": [
    -4,
    5
   ],
   "yRange": [
    -4,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "AB"
    },
    {
     "type": "segment",
     "from": [
      "=mx-4.2*nx",
      "=my-4.2*ny"
     ],
     "to": [
      "=mx+4.2*nx",
      "=my+4.2*ny"
     ],
     "label": "수직이등분선"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=mx",
      "=my"
     ],
     "label": "M(중점)"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=ax",
      "=ay"
     ],
     "label": "PA"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "PB"
    }
   ]
  },
  "readout": [
   {
    "label": "|PA|",
    "expr": "da",
    "digits": 4
   },
   {
    "label": "|PB|",
    "expr": "db",
    "digits": 4
   },
   {
    "label": "|PA|-|PB| (항상 0)",
    "expr": "da-db",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "t": -2
   },
   {
    "t": 0
   },
   {
    "t": 1
   },
   {
    "t": 3
   }
  ],
  "invariants": [
   "da-db",
   "da^2-db^2",
   "da^2-((mx-ax)^2+(my-ay)^2+t^2)"
  ],
  "oracle": [
   {
    "params": {
     "t": 0
    },
    "expect": {
     "da": 2.692582403567252,
     "db": 2.692582403567252
    }
   },
   {
    "params": {
     "t": 1
    },
    "expect": {
     "da": 2.8722813232690143,
     "db": 2.8722813232690143
    }
   },
   {
    "params": {
     "t": 2
    },
    "expect": {
     "da": 3.3541019662496847,
     "db": 3.3541019662496847
    }
   }
  ],
  "tol": 0.000001
 }
}