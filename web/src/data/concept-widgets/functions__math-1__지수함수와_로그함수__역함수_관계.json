{
 "id": "functions/math-1/지수함수와_로그함수/역함수_관계",
 "spec": {
  "title": "역함수 관계: 지수함수 y=a^x 와 로그함수 y=log_a x",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.5,
    "max": 4,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "t",
    "label": "점 위치 t",
    "type": "slider",
    "min": -2,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "ft = a^t; gft = log(ft)/log(a); fgf = a^gft",
  "plot": {
   "range": [
    -2,
    8
   ],
   "yRange": [
    -2,
    8
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "f(x)=a^x",
     "color": "#e11d48"
    },
    {
     "fn": "log(x)/log(a)",
     "label": "g(x)=log_a x",
     "color": "#1565c0"
    },
    {
     "fn": "x",
     "label": "y=x (대칭축)",
     "color": "#9e9e9e"
    }
   ]
  },
  "readout": [
   {
    "label": "f(t)=a^t",
    "expr": "ft",
    "digits": 4
   },
   {
    "label": "g(f(t))=log_a(a^t)",
    "expr": "gft",
    "digits": 4
   },
   {
    "label": "f(g(f(t)))",
    "expr": "fgf",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "t": 1
   },
   {
    "a": 2,
    "t": 3
   },
   {
    "a": 3,
    "t": -1
   },
   {
    "a": 1.5,
    "t": 2
   }
  ],
  "invariants": [
   "gft - t",
   "fgf - ft"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "t": 3
    },
    "expect": {
     "ft": 8,
     "gft": 3,
     "fgf": 8
    }
   },
   {
    "params": {
     "a": 2,
     "t": 0
    },
    "expect": {
     "ft": 1,
     "gft": 0,
     "fgf": 1
    }
   },
   {
    "params": {
     "a": 3,
     "t": 2
    },
    "expect": {
     "ft": 9,
     "gft": 2,
     "fgf": 9
    }
   }
  ],
  "tol": 0.000001
 }
}