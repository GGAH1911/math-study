{
 "id": "functions/calculus/도함수의_활용_심화/도함수의_부호와_증감",
 "spec": {
  "title": "도함수의 부호와 함수의 증가·감소",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (관찰점)",
    "type": "slider",
    "min": -2.2,
    "max": 2.2,
    "init": 1.5,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "f0 = x0^3 - 3*x0; d0 = 3*x0^2 - 3",
  "plot": {
   "range": [
    -2.4,
    2.4
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x",
     "label": "f(x)=x³−3x",
     "color": "#2563eb"
    },
    {
     "fn": "f0 + d0*(x - x0)",
     "label": "x₀에서의 접선 (기울기=f'(x₀))",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "x₀",
    "expr": "x0",
    "digits": 2
   },
   {
    "label": "f(x₀)",
    "expr": "f0",
    "digits": 3
   },
   {
    "label": "f'(x₀) = 접선의 기울기",
    "expr": "d0",
    "digits": 3
   },
   {
    "label": "증감 (+1:증가 / 0:극값후보 / −1:감소)",
    "expr": "sign(d0)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": -2
   },
   {
    "x0": -0.5
   },
   {
    "x0": 0.7
   },
   {
    "x0": 1.8
   }
  ],
  "invariants": [
   "f0 - (x0^3 - 3*x0)",
   "d0 - (3*x0^2 - 3)",
   "d0 - (3*x0^2 - 3*1)"
  ],
  "oracle": [
   {
    "params": {
     "x0": 0
    },
    "expect": {
     "f0": 0,
     "d0": -3
    }
   },
   {
    "params": {
     "x0": 1
    },
    "expect": {
     "f0": -2,
     "d0": 0
    }
   },
   {
    "params": {
     "x0": 2
    },
    "expect": {
     "f0": 2,
     "d0": 9
    }
   }
  ],
  "tol": 0.000001
 }
}