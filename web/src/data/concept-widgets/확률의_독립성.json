{
 "id": "확률의_독립성",
 "spec": {
  "title": "확률의 독립성",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0.01,
    "max": 0.99,
    "init": 0.5,
    "step": 0.01
   },
   {
    "name": "pB",
    "label": "P(B)",
    "type": "slider",
    "min": 0.01,
    "max": 0.99,
    "init": 0.5,
    "step": 0.01
   },
   {
    "name": "d",
    "label": "의존도 d",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 0,
    "step": 0.01
   }
  ],
  "scope": "posDev = min(pA,pB) - pA*pB; negDev = pA*pB - max(0, pA+pB-1); pAB = pA*pB + (d >= 0 ? d*posDev : d*negDev); pBgivenA = pAB / pA; prod = pA*pB; lower = max(0, pA+pB-1); upper = min(pA,pB);",
  "geometry": {
   "range": [
    -0.2,
    1.5
   ],
   "yRange": [
    -0.1,
    1.3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0.1,
       0
      ],
      [
       0.3,
       0
      ],
      [
       0.3,
       "=pB"
      ],
      [
       0.1,
       "=pB"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0.2,
      "=pB"
     ],
     "label": "P(B)"
    },
    {
     "type": "polygon",
     "points": [
      [
       0.4,
       0
      ],
      [
       0.6,
       0
      ],
      [
       0.6,
       "=pBgivenA"
      ],
      [
       0.4,
       "=pBgivenA"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0.5,
      "=pBgivenA"
     ],
     "label": "P(B|A)"
    },
    {
     "type": "polygon",
     "points": [
      [
       0.7,
       0
      ],
      [
       0.9,
       0
      ],
      [
       0.9,
       "=pAB"
      ],
      [
       0.7,
       "=pAB"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0.8,
      "=pAB"
     ],
     "label": "P(A∩B)"
    },
    {
     "type": "polygon",
     "points": [
      [
       1,
       0
      ],
      [
       1.2,
       0
      ],
      [
       1.2,
       "=prod"
      ],
      [
       1,
       "=prod"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      1.1,
      "=prod"
     ],
     "label": "P(A)·P(B)"
    }
   ]
  },
  "readout": [
   {
    "label": "P(B)",
    "expr": "pB",
    "digits": 4
   },
   {
    "label": "P(B|A)",
    "expr": "pBgivenA",
    "digits": 4
   },
   {
    "label": "P(A∩B)",
    "expr": "pAB",
    "digits": 4
   },
   {
    "label": "P(A)·P(B)",
    "expr": "prod",
    "digits": 4
   },
   {
    "label": "|P(B|A)-P(B)|",
    "expr": "abs(pBgivenA-pB)",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "pA": 0.3,
    "pB": 0.4,
    "d": 0
   },
   {
    "pA": 0.4,
    "pB": 0.6,
    "d": 1
   },
   {
    "pA": 0.4,
    "pB": 0.6,
    "d": -1
   },
   {
    "pA": 0.7,
    "pB": 0.2,
    "d": 0.5
   }
  ],
  "invariants": [
   "max(lower-pAB,0)+max(pAB-upper,0)",
   "min(1,max(0,pBgivenA))-pBgivenA",
   "abs(pBgivenA*pA-pAB)"
  ],
  "oracle": [
   {
    "params": {
     "pA": 0.3,
     "pB": 0.4,
     "d": 0
    },
    "expect": {
     "pAB": 0.12,
     "pBgivenA": 0.4,
     "prod": 0.12
    }
   },
   {
    "params": {
     "pA": 0.4,
     "pB": 0.6,
     "d": 1
    },
    "expect": {
     "pAB": 0.4,
     "pBgivenA": 1,
     "prod": 0.24
    }
   },
   {
    "params": {
     "pA": 0.4,
     "pB": 0.6,
     "d": -1
    },
    "expect": {
     "pAB": 0,
     "pBgivenA": 0,
     "prod": 0.24
    }
   }
  ],
  "tol": 0.000001
 }
}