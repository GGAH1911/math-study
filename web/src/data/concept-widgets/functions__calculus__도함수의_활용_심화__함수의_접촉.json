{
 "id": "functions/calculus/도함수의_활용_심화/함수의_접촉",
 "spec": {
  "title": "함수의 접촉: 포물선 f(x)=x²와 그 접선 g(x)",
  "params": [
   {
    "name": "a",
    "label": "접점의 x좌표 a",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "fa = a^2; m = 2*a; ga = m*a - a^2; valgap = fa - ga; slopegap = 2*a - m; disc = m^2 - 4*a^2",
  "plot": {
   "range": [
    -2.7,
    2.7
   ],
   "yRange": [
    -1.5,
    6.5
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#2563eb"
    },
    {
     "fn": "m*x - a^2",
     "label": "접선 g(x)=2ax−a²",
     "color": "#dc2626"
    },
    {
     "fn": "(x-a)^2",
     "label": "f−g=(x−a)² (접점서 이중근)",
     "color": "#16a34a"
    }
   ]
  },
  "readout": [
   {
    "label": "접점 P=(a,f(a))의 a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "공통 함숫값 f(a)=g(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "공통 기울기 f'(a)=g'(a)",
    "expr": "m",
    "digits": 3
   },
   {
    "label": "함숫값 차 f(a)−g(a)",
    "expr": "valgap",
    "digits": 3
   },
   {
    "label": "판별식 m²−4a² (접촉⇔0)",
    "expr": "disc",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": -0.5
   },
   {
    "a": 0
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "valgap",
   "slopegap",
   "disc",
   "fa - ga",
   "2*a - m"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": 1,
     "m": 2,
     "ga": 1,
     "valgap": 0,
     "disc": 0
    }
   },
   {
    "params": {
     "a": -0.5
    },
    "expect": {
     "fa": 0.25,
     "m": -1,
     "ga": 0.25,
     "valgap": 0,
     "disc": 0
    }
   }
  ],
  "tol": 0.000001
 }
}