{
 "id": "functions/math-2/미분/절댓값함수의_미분가능성",
 "spec": {
  "title": "절댓값함수 f(x)=|x²−c|의 미분가능성",
  "params": [
   {
    "name": "c",
    "label": "c (내부함수 g(x)=x²−c의 상수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "g0 = -c; xk = sqrt(abs(c)); ndiff = sign(c) + abs(sign(c)); g1 = 1 - c; f1 = abs(1 - c); gk = xk^2 - c; fk = abs(xk^2 - c)",
  "plot": {
   "range": [
    -2.2,
    2.2
   ],
   "yRange": [
    -2.5,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "abs(x^2 - c)",
     "label": "f(x)=|x²−c|",
     "color": "#2563eb"
    },
    {
     "fn": "x^2 - c",
     "label": "g(x)=x²−c",
     "color": "#9ca3af"
    }
   ]
  },
  "readout": [
   {
    "label": "g(0)=g의 최솟값 (음수면 g가 부호 변화 → 꺾임)",
    "expr": "g0",
    "digits": 2
   },
   {
    "label": "꺾인점 후보 위치 x=±√|c| (c>0일 때만 실제 꺾임)",
    "expr": "xk",
    "digits": 3
   },
   {
    "label": "미분불가능한 점의 개수",
    "expr": "ndiff",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 1
   },
   {
    "c": 0
   },
   {
    "c": -1
   },
   {
    "c": 2
   }
  ],
  "invariants": [
   "f1^2 - g1^2",
   "fk^2 - gk^2"
  ],
  "oracle": [
   {
    "params": {
     "c": 1
    },
    "expect": {
     "g0": -1,
     "xk": 1,
     "ndiff": 2,
     "f1": 0
    }
   },
   {
    "params": {
     "c": 0
    },
    "expect": {
     "g0": 0,
     "xk": 0,
     "ndiff": 0,
     "f1": 1
    }
   },
   {
    "params": {
     "c": -1
    },
    "expect": {
     "g0": 1,
     "xk": 1,
     "ndiff": 0,
     "f1": 2
    }
   }
  ],
  "tol": 0.000001
 }
}