{
 "id": "functions/calculus/여러가지함수의_극한/자연상수_e",
 "spec": {
  "title": "자연상수 e — (1+r/n)^n 은 e^r 로 간다 (r=1일 때가 e)",
  "params": [
   {
    "name": "n",
    "label": "n (분할 횟수)",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 10,
    "step": 1
   },
   {
    "name": "r",
    "label": "r (연이율)",
    "type": "slider",
    "min": -1,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "xval = n > 0 ? 1/n : 0; base = n > 0 ? 1 + r/n : 1; aval = base^n; target = e^r; gap = target - aval",
  "plot": {
   "range": [
    1,
    100
   ],
   "yRange": [
    0,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "(1+r/x)^x",
     "label": "$y=(1+r/x)^x$",
     "color": "#2563eb"
    },
    {
     "fn": "e^r",
     "label": "$y=e^r$ (극한값)",
     "color": "#dc2626"
    },
    {
     "fn": "aval",
     "label": "$y=(1+r/n)^n$ (지금 값)",
     "color": "#16a34a",
     "dashed": true
    }
   ],
   "points": [
    [
     "=n",
     "=aval"
    ]
   ],
   "pointsLabel": "$(n,\\ (1+r/n)^n)$"
  },
  "readout": [
   {
    "label": "$(1+r/n)^n$",
    "expr": "aval",
    "digits": 6
   },
   {
    "label": "$e^r$ (극한값)",
    "expr": "target",
    "digits": 6
   },
   {
    "label": "남은 거리 $e^r-(1+r/n)^n$",
    "expr": "gap",
    "digits": 6
   },
   {
    "label": "$x=1/n$ (0으로 간다)",
    "expr": "xval",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "r": 1
   },
   {
    "n": 10,
    "r": 1
   },
   {
    "n": 100,
    "r": 1
   },
   {
    "n": 5,
    "r": 0
   },
   {
    "n": 7,
    "r": -1
   },
   {
    "n": 50,
    "r": 1.5
   },
   {
    "n": 2,
    "r": -1
   }
  ],
  "invariants": [
   "log(aval) - n*log(1+r/n)",
   "target - exp(r)"
  ],
  "oracle": [
   {
    "params": {
     "n": 1,
     "r": 1
    },
    "expect": {
     "aval": 2,
     "target": 2.718281828459045,
     "xval": 1
    }
   },
   {
    "params": {
     "n": 2,
     "r": 1
    },
    "expect": {
     "aval": 2.25
    }
   },
   {
    "params": {
     "n": 4,
     "r": 1
    },
    "expect": {
     "aval": 2.44140625,
     "xval": 0.25
    }
   },
   {
    "params": {
     "n": 2,
     "r": 1.5
    },
    "expect": {
     "aval": 3.0625,
     "target": 4.481689070338065
    }
   },
   {
    "params": {
     "n": 10,
     "r": 0
    },
    "expect": {
     "aval": 1,
     "target": 1
    }
   },
   {
    "params": {
     "n": 4,
     "r": -1
    },
    "expect": {
     "aval": 0.31640625,
     "target": 0.36787944117144233
    }
   }
  ],
  "tol": 0.000001
 }
}