      ],
      [
       "=W",
       0
      ],
      [
       "=W",
       "=cx"
      ],
      [
       "=ax",
       "=cx"
      ]
     ]
    },
    {
     "type": "polygon",
     "vertices": [
      [
       0,
       "=cx"
      ],
      [
       "=ax",
       "=cx"
      ],
      [
       "=ax",
       "=H"
      ],
      [
       0,
       "=H"
      ]
     ]
    },
    {
     "type": "polygon",
     "vertices": [
      [
       "=ax",
       "=cx"
      ],
      [
       "=W",
       "=cx"
      ],
      [
       "=W",
       "=H"
      ],
      [
       "=ax",
       "=H"
      ]
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "가로 (ax+b)",
    "expr": "W",
    "digits": 4
   },
   {
    "label": "세로 (cx+d)",
    "expr": "H",
    "digits": 4
   },
   {
    "label": "acx²",
    "expr": "s1",
    "digits": 4
   },
   {
    "label": "adx",
    "expr": "s2",
    "digits": 4
   },
   {
    "label": "bcx",
    "expr": "s3",
    "digits": 4
   },
   {
    "label": "bd",
    "expr": "s4",
    "digits": 4
   },
   {
    "label": "넓이 (ax+b)(cx+d)",
    "expr": "prod",
    "digits": 4
   },
   {
    "label": "전개 결과 acx²+(ad+bc)x+bd",
    "expr": "expanded",
    "digits": 4
   },
   {
    "label": "차이 (0이면 일치)",
    "expr": "diff",
    "digits": 6
   }
  ]
 },
