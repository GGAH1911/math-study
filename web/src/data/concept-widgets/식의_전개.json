{
 "id": "식의_전개",
 "spec": {
  "title": "식의 전개 - 다항식의 곱셈 (분배법칙)",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 3,
    "step": 1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 1
   },
   {
    "name": "d",
    "label": "d",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 1,
    "step": 1
   },
   {
    "name": "x",
    "label": "x",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 0.5
   }
  ],
  "scope": "W=a*x+b; H=c*x+d; ax=a*x; cx=c*x; s1=a*c*x^2; s2=a*d*x; s3=b*c*x; s4=b*d; expanded=s1+s2+s3+s4; prod=W*H; lhs=(a*x+b)*(c*x+d); rhs=a*c*x^2+(a*d+b*c)*x+b*d; diff=abs(lhs-rhs)",
  "geometry": {
   "range": [
    0,
    "=max(W,H)*1.15"
   ],
   "yRange": [
    0,
    "=max(W,H)*1.15"
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
