{
 "id": "functions/high-1/함수와_그래프/역함수",
 "spec": {
  "title": "역함수와 y=x 대칭",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": 0.3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "절편 b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "점 x₀",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "y0 = a*x0 + b; finvx0 = (x0 - b)/a; qx = y0; qy = x0",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "a*x + b",
     "label": "y=f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "(x - b)/a",
     "label": "y=f⁻¹(x)",
     "color": "#dc2626"
    },
    {
     "fn": "x",
     "label": "y=x",
     "color": "#9ca3af"
    }
   ],
   "points": [
    [
     "=x0",
     "=y0"
    ],
    [
     "=y0",
     "=x0"
    ]
   ],
   "pointsLabel": "$(x_0,\\,f(x_0))$과 $y=x$ 대칭점 $(f(x_0),\\,x_0)$"
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "y0",
    "digits": 3
   },
   {
    "label": "f⁻¹(f(x₀))",
    "expr": "(y0 - b)/a",
    "digits": 3
   },
   {
    "label": "f(f⁻¹(x₀))",
    "expr": "a*finvx0 + b",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1,
    "x0": 1
   },
   {
    "a": 1,
    "b": 0,
    "x0": 2
   },
   {
    "a": 2,
    "b": -2,
    "x0": 3
   },
   {
    "a": 0.5,
    "b": 2,
    "x0": -2
   }
  ],
  "invariants": [
   "y0 - (a*x0 + b)",
   "(y0 - b)/a - x0",
   "a*finvx0 + b - x0",
   "qx - y0",
   "qy - x0"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1,
     "x0": 1
    },
    "expect": {
     "y0": 3,
     "finvx0": 0,
     "qx": 3,
     "qy": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "x0": 2
    },
    "expect": {
     "y0": 2,
     "finvx0": 2,
     "qx": 2,
     "qy": 2
    }
   },
   {
    "params": {
     "a": 2,
     "b": -2,
     "x0": 3
    },
    "expect": {
     "y0": 4,
     "finvx0": 2.5,
     "qx": 4,
     "qy": 3
    }
   }
  ],
  "tol": 0.000001
 }
}