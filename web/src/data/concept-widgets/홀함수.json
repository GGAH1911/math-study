{
 "id": "홀함수",
 "spec": {
  "title": "홀함수 f(-x) = -f(x): 원점 대칭",
  "params": [
   {
    "name": "a",
    "label": "a (x³ 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (x 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "x₀ (표본점)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "fx=a*x0^3+b*x0; fn=a*(-x0)^3+b*(-x0); s=fx+fn",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -9,
    9
   ],
   "fns": [
    {
     "fn": "a*x^3+b*x",
     "label": "f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "-(a*(-x)^3+b*(-x))",
     "label": "-f(-x) (홀함수면 완전히 겹침)",
     "color": "#f97316"
    }
   ],
   "points": [
    [
     "=x0",
     "=fx"
    ],
    [
     "=-x0",
     "=fn"
    ]
   ],
   "pointsLabel": "$(x_0, f(x_0))$ 와 $(-x_0, f(-x_0))$ — 원점 대칭"
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "fx",
    "digits": 4
   },
   {
    "label": "f(-x₀)",
    "expr": "fn",
    "digits": 4
   },
   {
    "label": "f(x₀)+f(-x₀) (항상 0)",
    "expr": "s",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": -2,
    "x0": 1
   },
   {
    "a": 1,
    "b": 0,
    "x0": 2
   },
   {
    "a": 0.5,
    "b": 1,
    "x0": -1
   },
   {
    "a": -1.5,
    "b": 2,
    "x0": 1.3
   }
  ],
  "invariants": [
   "fx+fn",
   "a*0^3+b*0"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": -2,
     "x0": 1
    },
    "expect": {
     "fx": -1,
     "fn": 1,
     "s": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "x0": 2
    },
    "expect": {
     "fx": 8,
     "fn": -8,
     "s": 0
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 1,
     "x0": -1
    },
    "expect": {
     "fx": -1.5,
     "fn": 1.5,
     "s": 0
    }
   }
  ],
  "tol": 0.000001
 }
}