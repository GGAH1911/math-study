{
 "id": "equations/high-1/방정식과_부등식/공통근",
 "spec": {
  "title": "공통근",
  "params": [
   {
    "name": "u",
    "label": "u",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": -4,
    "step": 0.1
   },
   {
    "name": "v",
    "label": "v",
    "type": "slider",
    "min": -4,
    "max": 6,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "f1=1^2-4*1+3; f3=3^2-4*3+3; g1=(1-u)*(1-v); g3=(3-u)*(3-v); g1_exp=1-u-v+u*v; g3_exp=9-3*u-3*v+u*v; diff5=8-(5-u)*(5-v); L5=(u+v-4)*5+(3-u*v); common1=(abs(u-1)<1e-6 or abs(v-1)<1e-6)?1:0; common3=(abs(u-3)<1e-6 or abs(v-3)<1e-6)?1:0",
  "geometry": {
   "range": [
    -4,
    6
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -4,
    6
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "x^2-4*x+3",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "(x-u)*(x-v)",
     "label": "g(x)",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "g(1)",
    "expr": "g1",
    "digits": 3
   },
   {
    "label": "g(3)",
    "expr": "g3",
    "digits": 3
   },
   {
    "label": "x=1 공통",
    "expr": "common1",
    "digits": 0
   },
   {
    "label": "x=3 공통",
    "expr": "common3",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "u": 1,
    "v": 2
   },
   {
    "u": -1,
    "v": 3
   },
   {
    "u": -2,
    "v": -1
   },
   {
    "u": 1,
    "v": 3
   }
  ],
  "invariants": [
   "g1 - g1_exp",
   "g3 - g3_exp",
   "diff5 - L5"
  ],
  "oracle": [
   {
    "params": {
     "u": 1,
     "v": 2
    },
    "expect": {
     "g1": 0,
     "g3": 2,
     "diff5": -4,
     "L5": -4,
     "common1": 1,
     "common3": 0
    }
   },
   {
    "params": {
     "u": -1,
     "v": 3
    },
    "expect": {
     "g1": -4,
     "g3": 0,
     "diff5": -4,
     "L5": -4,
     "common1": 0,
     "common3": 1
    }
   },
   {
    "params": {
     "u": -2,
     "v": -1
    },
    "expect": {
     "g1": 6,
     "g3": 20,
     "diff5": -34,
     "L5": -34,
     "common1": 0,
     "common3": 0
    }
   }
  ],
  "tol": 0.000001
 }
}