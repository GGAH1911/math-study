     "rt_high": 2
    }
   },
   {
    "params": {
     "yLow": 0.25,
     "yHigh": 1
    },
    "expect": {
     "rt_low": 0.5,
     "rt_high": 1
    }
   },
   {
    "params": {
     "yLow": 2.25,
     "yHigh": 6.25
    },
    "expect": {
     "rt_low": 1.5,
     "rt_high": 2.5
    }
   }
  ],
  "tol": 0.000001
 }
