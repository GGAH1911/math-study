   "shapes": [
    {
     "type": "segment",
     "from": [
      -6,
      0
     ],
     "to": [
      6,
      0
     ],
     "color": "#888"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      0.5
     ],
     "to": [
      "=xmax",
      0.5
     ],
     "color": "#1f77b4"
    },
    {
     "type": "circle",
     "center": [
      "=a",
      0.5
     ],
     "radius": 0.1,
     "color": "#1f77b4"
    },
    {
     "type": "segment",
     "from": [
      "=c",
      -0.5
     ],
     "to": [
      "=xmax",
      -0.5
     ],
     "color": "#2ca02c"
    },
    {
     "type": "circle",
     "center": [
      "=c",
      -0.5
     ],
     "radius": 0.1,
     "color": "#2ca02c"
    },
    {
     "type": "segment",
     "from": [
      "=xmin",
      0.2
     ],
     "to": [
      "=b",
      0.2
     ],
     "color": "#d62728"
    },
    {
     "type": "circle",
     "center": [
      "=b",
      0.2
     ],
     "radius": 0.1,
     "color": "#d62728"
    },
    {
     "type": "segment",
     "from": [
      "=ix1",
      -0.2
     ],
     "to": [
      "=ix2",
      -0.2
     ],
     "color": "#ff7f0e"
    }
   ]
  },
  "readout": [
   {
    "label": "공통해 존재",
    "expr": "nonempty",
    "digits": 0
   },
   {
    "label": "공통해 하한",
    "expr": "lower",
    "digits": 2
   },
   {
    "label": "공통해 상한",
    "expr": "upper",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -2,
    "c": 1,
    "b": 3
   },
   {
    "a": 2,
    "c": 4,
    "b": 3
   },
   {
    "a": -3,
    "c": -1,
    "b": 0
   },
   {
    "a": 5,
    "c": -2,
    "b": 4
   }
  ],
  "invariants": [
   "lower - max(a,c)",
   "nonempty - ((lower<upper)?1:0)",
   "nonempty * (((mid>a) and (mid>c) and (mid<b)) ? 0 : 1)"
  ],
  "oracle": [
   {
    "params": {
     "a": -2,
     "c": 1,
     "b": 3
    },
    "expect": {
     "lower": 1,
     "upper": 3,
     "nonempty": 1,
     "mid": 2
    }
   },
   {
    "params": {
     "a": 2,
     "c": 4,
     "b": 3
    },
    "expect": {
     "lower": 4,
     "upper": 3,
     "nonempty": 0,
     "mid": 0
    }
   }
  ],
  "tol": 1e-06
 }
