{
 "id": "equations/high-1/방정식과_부등식/해의_합_조건",
 "spec": {
  "title": "해의 합 조건 (연립일차부등식의 공통해)",
  "params": [
   {
    "name": "a",
    "label": "하한 a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "하한 c",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "상한 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1
   }
  ],
  "scope": "xmin=-6; xmax=6; y1=0.5; y2=-0.5; y3=0.2; yI=-0.2; lower=max(a,c); upper=b; nonempty=(lower<upper)?1:0; mid=(nonempty)? ((lower+upper)/2) : 0; ix1=(nonempty)? lower : 100; ix2=(nonempty)? upper : 100;",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -0.8,
    0.8
   ],
   "showAxes": true,
