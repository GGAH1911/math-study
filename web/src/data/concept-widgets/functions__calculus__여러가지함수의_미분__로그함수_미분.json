{
 "id": "functions/calculus/여러가지함수의_미분/로그함수_미분",
 "spec": {
  "title": "로그함수의 미분 — 접선의 기울기 = 1/(x·ln a)",
  "params": [
   {
    "name": "x0",
    "label": "접점 x₀",
    "type": "slider",
    "min": 0.2,
    "max": 8,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "la = log(a); y0 = log(x0)/la; m = 1/(x0*la); h = 0.00001; numd = (log(x0+h)/la - log(x0-h)/la)/(2*h)",
  "plot": {
   "range": [
    0,
    8
   ],
   "yRange": [
    -3,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "log(x)/log(a)",
     "label": "y = log_a x",
     "color": "#2563eb"
    },
    {
     "fn": "y0 + m*(x - x0)",
     "label": "x₀에서의 접선 (기울기 m)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "접선의 기울기  m = 1/(x₀·ln a)",
    "expr": "m",
    "digits": 5
   },
   {
    "label": "log_a(x₀)",
    "expr": "y0",
    "digits": 5
   },
   {
    "label": "ln a",
    "expr": "la",
    "digits": 5
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 1,
    "a": 2
   },
   {
    "x0": 3,
    "a": 5
   },
   {
    "x0": 0.5,
    "a": 3
   },
   {
    "x0": 6,
    "a": 2
   }
  ],
  "invariants": [
   "a^y0 - x0",
   "m*x0*la - 1",
   "m - numd"
  ],
  "oracle": [
   {
    "params": {
     "x0": 1,
     "a": 2
    },
    "expect": {
     "y0": 0,
     "m": 1.4426950408889634
    }
   },
   {
    "params": {
     "x0": 2,
     "a": 4
    },
    "expect": {
     "y0": 0.5,
     "m": 0.36067376022224085
    }
   },
   {
    "params": {
     "x0": 4,
     "a": 4
    },
    "expect": {
     "y0": 1,
     "m": 0.18033688011112042
    }
   }
  ],
  "tol": 0.000001
 }
}