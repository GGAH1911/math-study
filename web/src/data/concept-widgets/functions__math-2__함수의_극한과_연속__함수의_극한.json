{
 "id": "functions/math-2/함수의_극한과_연속/함수의_극한",
 "spec": {
  "title": "함수의 극한: ε-δ 정의 (f(x)=2x+1, x→1, L=3)",
  "params": [
   {
    "name": "eps",
    "label": "ε (허용 오차)",
    "type": "slider",
    "min": 0.1,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "delta",
    "label": "δ (x가 1에 가까운 정도)",
    "type": "slider",
    "min": 0.05,
    "max": 1.2,
    "init": 0.5,
    "step": 0.05
   }
  ],
  "scope": "a=1; L=3; reqDelta=eps/2; fLo=2*(a-delta)+1; fHi=2*(a+delta)+1; worstErr=max(abs(fHi-L),abs(fLo-L)); ok=eps-worstErr",
  "geometry": null,
  "plot": {
   "range": [
    -0.5,
    2.5
   ],
   "yRange": [
    -1,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "2*x+1",
     "label": "f(x)=2x+1",
     "color": "#2563eb"
    },
    {
     "fn": "L",
     "label": "L=3 (극한값)",
     "color": "#059669"
    },
    {
     "fn": "L+eps",
     "label": "L+ε",
     "color": "#f59e0b"
    },
    {
     "fn": "L-eps",
     "label": "L-ε",
     "color": "#f59e0b"
    }
   ]
  },
  "readout": [
   {
    "label": "필요한 δ (=ε/2)",
    "expr": "reqDelta",
    "digits": 3
   },
   {
    "label": "구간 끝에서의 최대오차 |f(x)-L|",
    "expr": "worstErr",
    "digits": 3
   },
   {
    "label": "성공 여백 ε-최대오차 (0 이상이면 |f(x)-L|<ε 보장)",
    "expr": "ok",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "eps": 1,
    "delta": 0.5
   },
   {
    "eps": 0.4,
    "delta": 0.5
   },
   {
    "eps": 1.6,
    "delta": 0.3
   },
   {
    "eps": 0.2,
    "delta": 0.1
   }
  ],
  "invariants": [
   "2*a+1-L",
   "reqDelta*2-eps",
   "fHi-L-2*delta",
   "L-fLo-2*delta",
   "ok-(eps-worstErr)"
  ],
  "oracle": [
   {
    "params": {
     "eps": 1,
     "delta": 0.5
    },
    "expect": {
     "reqDelta": 0.5,
     "worstErr": 1,
     "ok": 0
    }
   },
   {
    "params": {
     "eps": 1,
     "delta": 0.3
    },
    "expect": {
     "reqDelta": 0.5,
     "worstErr": 0.6,
     "ok": 0.4
    }
   },
   {
    "params": {
     "eps": 0.4,
     "delta": 0.5
    },
    "expect": {
     "reqDelta": 0.2,
     "worstErr": 1,
     "ok": -0.6
    }
   }
  ],
  "tol": 0.000001
 }
}