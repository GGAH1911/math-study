{
 "id": "functions/math-2/미분/극값_최적화",
 "spec": {
  "title": "극값 최적화: 삼차함수 f(x)=x³−3ax의 극대·극소",
  "params": [
   {
    "name": "a",
    "label": "a (모양 조절)",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "r = sqrt(a); xmax = -r; xmin = r; ymax = 2*a*r; ymin = -2*a*r",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -18,
    18
   ],
   "fns": [
    {
     "fn": "x^3 - 3*a*x",
     "label": "f(x)=x³−3ax",
     "color": "#2563eb"
    },
    {
     "fn": "3*x^2 - 3*a",
     "label": "f'(x)=3x²−3a",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극값 개수",
    "expr": "a>0 ? 2 : 0",
    "digits": 0
   },
   {
    "label": "극대점 x = −√a",
    "expr": "xmax",
    "digits": 3
   },
   {
    "label": "극댓값 f(−√a)",
    "expr": "ymax",
    "digits": 3
   },
   {
    "label": "극소점 x = √a",
    "expr": "xmin",
    "digits": 3
   },
   {
    "label": "극솟값 f(√a)",
    "expr": "ymin",
    "digits": 3
   },
   {
    "label": "극대점에서의 기울기 f'(xmax)",
    "expr": "3*xmax^2 - 3*a",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": 4
   },
   {
    "a": 0.25
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "3*xmax^2 - 3*a",
   "3*xmin^2 - 3*a",
   "ymax - (xmax^3 - 3*a*xmax)",
   "ymin - (xmin^3 - 3*a*xmin)",
   "ymax + ymin",
   "xmax + xmin"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "xmax": -1,
     "xmin": 1,
     "ymax": 2,
     "ymin": -2
    }
   },
   {
    "params": {
     "a": 4
    },
    "expect": {
     "xmax": -2,
     "xmin": 2,
     "ymax": 16,
     "ymin": -16
    }
   },
   {
    "params": {
     "a": 0.25
    },
    "expect": {
     "xmax": -0.5,
     "xmin": 0.5,
     "ymax": 0.25,
     "ymin": -0.25
    }
   }
  ],
  "tol": 0.000001
 }
}