{
 "id": "algebra/math-1/지수와_로그/로그_밑의_조건",
 "spec": {
  "title": "로그 밑의 조건",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": -2,
    "max": 4,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "비교할 밑 b",
    "type": "slider",
    "min": -2,
    "max": 4,
    "init": 0.5,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "진수 x",
    "type": "slider",
    "min": -2,
    "max": 8,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "aok = (a > 0 and abs(a - 1) > 0.02) ? 1 : 0; bok = (b > 0 and abs(b - 1) > 0.02) ? 1 : 0; tok = (t > 0) ? 1 : 0; la = (aok == 1 and tok == 1) ? log(t)/log(a) : NaN; lb = (bok == 1 and tok == 1) ? log(t)/log(b) : NaN; mono = (aok == 1) ? ((a > 1) ? 1 : -1) : 0; px = (aok == 1 and tok == 1) ? t : -999; py = (aok == 1 and tok == 1) ? log(t)/log(a) : -999;",
  "geometry": {
   "range": [
    -2.5,
    4.5
   ],
   "yRange": [
    -1.2,
    1.2
   ],
   "showAxes": false,
   "showGrid": false,
   "shapes": [
    {
     "type": "segment",
     "from": [-2.5, 0],
     "to": [0, 0],
     "color": "red"
    },
    {
     "type": "segment",
     "from": [0, 0],
     "to": [1, 0],
     "color": "green"
    },
    {
     "type": "segment",
     "from": [1, 0],
     "to": [4.5, 0],
     "color": "blue"
    },
    {
     "type": "point",
     "at": [0, 0],
     "color": "red",
     "label": "a=0"
    },
    {
     "type": "point",
     "at": [1, 0],
     "color": "red",
     "label": "a=1 불가"
    },
    {
     "type": "point",
     "at": ["=a", 0],
     "color": "orange",
     "label": "현재 밑 a"
    },
    {
     "type": "point",
     "at": ["=b", 0],
     "color": "green",
     "label": "밑 b"
    },
    {
     "type": "text",
     "at": [-1.3, 0.5],
     "text": "a ≤ 0 : 정의 불가",
     "color": "red"
    },
    {
     "type": "text",
     "at": [0.5, 0.5],
     "text": "0<a<1 : 감소",
     "color": "green"
    },
    {
     "type": "text",
     "at": [2.7, 0.5],
     "text": "a>1 : 증가",
     "color": "blue"
    },
    {
     "type": "text",
     "at": [1.0, -0.6],
     "text": "a=1 이면 1^y=1 로 고정 → 역함수 없음",
     "color": "gray"
    }
   ]
  },
  "plot": {
   "range": [
    -4,
    8
   ],
   "yRange": [
    -4,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "aok ? log(x)/log(a) : NaN",
     "label": "$y=\\log_a x$",
     "color": "blue"
    },
    {
     "fn": "bok ? log(x)/log(b) : NaN",
     "label": "$y=\\log_b x$",
     "color": "green"
    },
    {
     "fn": "aok ? a^x : NaN",
     "label": "$y=a^x$ (역함수)",
     "color": "orange",
     "dashed": true
    },
    {
     "fn": "x",
     "label": "$y=x$",
     "color": "gray",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "aok ? log(x)/log(a) : NaN",
     "in": [0.2, 8],
     "label": "밑이 무엇이든 $(1,0)$"
    }
   ],
   "points": [
    ["=px", "=py"],
    ["=py", "=px"]
   ],
   "pointsLabel": "$(x,\\ \\log_a x)$ 와 $y=x$ 대칭점 $(\\log_a x,\\ x)$"
  },
  "readout": [
   {
    "label": "밑 a 사용 가능 (1=예)",
    "expr": "aok",
    "digits": 0
   },
   {
    "label": "밑 b 사용 가능 (1=예)",
    "expr": "bok",
    "digits": 0
   },
   {
    "label": "진수 조건 $x>0$ (1=예)",
    "expr": "tok",
    "digits": 0
   },
   {
    "label": "$\\log_a x$",
    "expr": "la",
    "digits": 3
   },
   {
    "label": "$\\log_b x$",
    "expr": "lb",
    "digits": 3
   },
   {
    "label": "증가 1 · 감소 −1 · 불가 0",
    "expr": "mono",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   { "a": 2, "b": 0.5, "t": 4 },
   { "a": 0.5, "b": 3, "t": 1 },
   { "a": 1, "b": 2, "t": 2 },
   { "a": -1, "b": 0.5, "t": 5 },
   { "a": 2, "b": 0.5, "t": -1 }
  ],
  "invariants": [
   "(aok == 1 and tok == 1) ? a^la - t : 0",
   "(aok == 1) ? log(1)/log(a) : 0",
   "(aok == 1 and bok == 1 and tok == 1) ? la*log(a) - lb*log(b) : 0"
  ],
  "oracle": [
   {
    "params": { "a": 2, "b": 0.5, "t": 8 },
    "expect": { "aok": 1, "bok": 1, "tok": 1, "la": 3, "lb": -3, "mono": 1 }
   },
   {
    "params": { "a": 0.5, "b": 2, "t": 4 },
    "expect": { "aok": 1, "la": -2, "lb": 2, "mono": -1 }
   },
   {
    "params": { "a": 1, "b": 2, "t": 4 },
    "expect": { "aok": 0, "mono": 0, "bok": 1 }
   },
   {
    "params": { "a": -2, "b": 2, "t": 4 },
    "expect": { "aok": 0, "mono": 0 }
   },
   {
    "params": { "a": 2, "b": 0.5, "t": -1 },
    "expect": { "aok": 1, "tok": 0 }
   }
  ],
  "tol": 0.000001
 }
}
