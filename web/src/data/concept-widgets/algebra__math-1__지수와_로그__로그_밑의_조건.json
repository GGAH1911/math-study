{
 "id": "algebra/math-1/지수와_로그/로그_밑의_조건",
 "spec": {
  "title": "로그 밑의 조건",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": -2,
    "max": 3,
    "init": 1.5,
    "step": 0.1
   }
  ],
  "scope": "valid = (a > 0 and a != 1) ? 1 : 0; log2 = valid ? log(2,a) : NaN;",
  "geometry": {
   "range": [
    0.01,
    8
   ],
   "yRange": [
    -4,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    0.01,
    8
   ],
   "yRange": [
    -4,
    4
   ],
   "fns": [
    {
     "fn": "valid ? log(x)/log(a) : NaN",
     "label": "y = log_a(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "밑 조건 (a>0, a≠1)",
    "expr": "valid",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5
   },
   {
    "a": 1.5
   },
   {
    "a": 2.5
   }
  ],
  "invariants": [
   "a^log(2,a) - 2",
   "valid - 1"
  ],
  "oracle": [
   {
    "params": {
     "a": 2
    },
    "expect": {
     "valid": 1,
     "log2": 1
    }
   },
   {
    "params": {
     "a": 0.5
    },
    "expect": {
     "valid": 1,
     "log2": -1
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "valid": 0
    }
   }
  ],
  "tol": 0.000001
 }
}