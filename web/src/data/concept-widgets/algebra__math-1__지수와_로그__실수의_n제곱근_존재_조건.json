{
 "id": "algebra/math-1/지수와_로그/실수의_n제곱근_존재_조건",
 "spec": {
  "title": "실수의 n제곱근 존재 조건",
  "params": [
   {
    "name": "n",
    "label": "차수 n",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 3,
    "step": 1
   },
   {
    "name": "a",
    "label": "실수 a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -1,
    "step": 0.1
   }
  ],
  "scope": "exists = (mod(n,2)==1 or a>=0) ? 1 : 0; r = (mod(n,2)==1) ? sign(a)*(abs(a)^(1/n)) : (a>=0 ? a^(1/n) : 0)",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -30,
    30
   ],
   "fns": [
    {
     "fn": "x^n",
     "label": "y = x^n",
     "color": "#1f77b4"
    },
    {
     "fn": "a",
     "label": "y = a",
     "color": "#d62728"
    }
   ]
  },
  "readout": [
   {
    "label": "실근 존재",
    "expr": "exists",
    "digits": 0
   },
   {
    "label": "실근 값",
    "expr": "r",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 3,
    "a": -8
   },
   {
    "n": 4,
    "a": -2
   },
   {
    "n": 2,
    "a": 9
   },
   {
    "n": 5,
    "a": 0
   }
  ],
  "invariants": [
   "exists * (r^n - a)",
   "(1-exists) - ((mod(n,2)==0 and a<0) ? 1 : 0)"
  ],
  "oracle": [
   {
    "params": {
     "n": 3,
     "a": 8
    },
    "expect": {
     "exists": 1,
     "r": 2
    }
   },
   {
    "params": {
     "n": 4,
     "a": -2
    },
    "expect": {
     "exists": 0,
     "r": 0
    }
   },
   {
    "params": {
     "n": 2,
     "a": 9
    },
    "expect": {
     "exists": 1,
     "r": 3
    }
   }
  ],
  "tol": 0.000001
 }
}