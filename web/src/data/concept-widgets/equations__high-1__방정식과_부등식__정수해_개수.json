{
 "id": "equations/high-1/방정식과_부등식/정수해_개수",
 "spec": {
  "title": "정수해 개수 탐구",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -10,
    "max": 10,
    "init": -2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -10,
    "max": 10,
    "init": 5,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "inc",
    "label": "경계 포함",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "c_incl = max(0, floor(b) - ceil(a) + 1); c_strict = max(0, ceil(b) - floor(a) - 1); count = inc == 1 ? c_incl : c_strict; diff = c_incl - c_strict - (a <= b ? (mod(a,1) == 0 ? 1 : 0) + (mod(b,1) == 0 ? 1 : 0) - (a == b ? 1 : 0) : 0)",
  "geometry": {
   "range": [
    -11,
    11
   ],
   "yRange": [
    -1,
    1
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=a",
      0
     ],
     "to": [
      "=b",
      0
     ]
    },
    {
     "type": "circle",
     "center": [
      "=a",
      0
     ],
     "radius": 0.12,
     "fill": "=inc == 1 ? '#fb7185' : 'none'",
     "fillOpacity": 1
    },
    {
     "type": "circle",
     "center": [
      "=b",
      0
     ],
     "radius": 0.12,
     "fill": "=inc == 1 ? '#fb7185' : 'none'",
     "fillOpacity": 1
    }
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 1
   },
   {
    "label": "b",
    "expr": "b",
    "digits": 1
   },
   {
    "label": "정수해 개수",
    "expr": "count",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -2,
    "b": 5,
    "inc": 0
   },
   {
    "a": -2,
    "b": 5,
    "inc": 1
   },
   {
    "a": 1,
    "b": 4,
    "inc": 0
   },
   {
    "a": 0.5,
    "b": 3.5,
    "inc": 1
   }
  ],
  "invariants": [
   "diff",
   "count - (inc == 1 ? c_incl : c_strict)"
  ],
  "oracle": [
   {
    "params": {
     "a": -2,
     "b": 5,
     "inc": 0
    },
    "expect": {
     "count": 6,
     "c_incl": 8,
     "c_strict": 6
    }
   },
   {
    "params": {
     "a": -2,
     "b": 5,
     "inc": 1
    },
    "expect": {
     "count": 8,
     "c_incl": 8,
     "c_strict": 6
    }
   },
   {
    "params": {
     "a": 1,
     "b": 4,
     "inc": 0
    },
    "expect": {
     "count": 2,
     "c_incl": 4,
     "c_strict": 2
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 3.5,
     "inc": 1
    },
    "expect": {
     "count": 3,
     "c_incl": 3,
     "c_strict": 3
    }
   }
  ],
  "tol": 0.000001
 }
}