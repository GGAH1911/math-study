{
 "id": "functions/calculus/여러가지함수의_극한/극한의_기본_공식",
 "spec": {
  "title": "lim(x→0) sin x / x = 1 : 부채꼴 넓이 조임(squeeze)",
  "params": [
   {
    "name": "theta",
    "label": "θ (도)",
    "type": "slider",
    "min": 1,
    "max": 80,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; cx=cos(rad); sy=sin(rad); ty=tan(rad); ratio=sy/rad",
  "geometry": {
   "range": [
    -1.3,
    1.6
   ],
   "yRange": [
    -1.3,
    1.9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       1,
       0
      ],
      [
       "=cx",
       "=sy"
      ]
     ],
     "label": "△OAP=½sinθ"
    },
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       1,
       0
      ],
      [
       1,
       "=ty"
      ]
     ],
     "label": "△OAT=½tanθ"
    },
    {
     "type": "point",
     "at": [
      1,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    },
    {
     "type": "point",
     "at": [
      1,
      "=ty"
     ],
     "label": "T"
    }
   ]
  },
  "readout": [
   {
    "label": "θ (라디안)=호 길이",
    "expr": "rad",
    "digits": 4
   },
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "tan θ",
    "expr": "ty",
    "digits": 4
   },
   {
    "label": "sin θ / θ",
    "expr": "ratio",
    "digits": 5
   },
   {
    "label": "cos θ (하한)",
    "expr": "cx",
    "digits": 5
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 10
   },
   {
    "theta": 30
   },
   {
    "theta": 45
   },
   {
    "theta": 60
   }
  ],
  "invariants": [
   "cx^2 + sy^2 - 1",
   "ty*cx - sy",
   "ratio*rad - sy"
  ],
  "oracle": [
   {
    "params": {
     "theta": 30
    },
    "expect": {
     "cx": 0.8660254037844387,
     "sy": 0.5,
     "ty": 0.5773502691896258,
     "rad": 0.5235987755982988,
     "ratio": 0.954929658551372
    }
   },
   {
    "params": {
     "theta": 60
    },
    "expect": {
     "cx": 0.5,
     "sy": 0.8660254037844386,
     "ty": 1.7320508075688767,
     "rad": 1.0471975511965976,
     "ratio": 0.8269933431326881
    }
   },
   {
    "params": {
     "theta": 45
    },
    "expect": {
     "cx": 0.7071067811865476,
     "sy": 0.7071067811865476,
     "ty": 0.9999999999999999,
     "rad": 0.7853981633974483,
     "ratio": 0.9003163161571061
    }
   }
  ],
  "tol": 0.000001
 }
