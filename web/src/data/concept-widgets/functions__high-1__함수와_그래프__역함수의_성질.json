{
 "id": "functions/high-1/함수와_그래프/역함수의_성질",
 "spec": {
  "title": "역함수의 성질 — y=x 대칭",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": 0.3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "절편 b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "x0",
    "label": "점 x₀",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 3,
    "step": 0.5
   }
  ],
  "scope": "fa=a*x0+b; inv_at_fa=(fa-b)/a; inv_slope=1/a",
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "a*x+b",
     "label": "y=f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "(x-b)/a",
     "label": "y=f⁻¹(x)",
     "color": "#dc2626"
    },
    {
     "fn": "x",
     "label": "y=x",
     "color": "#9ca3af"
    }
   ],
   "points": [
    [
     "=x0",
     "=fa"
    ],
    [
     "=fa",
     "=x0"
    ]
   ],
   "pointsLabel": "$(x_0,\\,f(x_0))\\,,\\ (f(x_0),\\,x_0)$"
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f⁻¹(f(x₀))",
    "expr": "inv_at_fa",
    "digits": 3
   },
   {
    "label": "역함수 기울기 1/a",
    "expr": "inv_slope",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1,
    "x0": 3
   },
   {
    "a": 1,
    "b": 0,
    "x0": 2
   },
   {
    "a": 0.5,
    "b": -1,
    "x0": 4
   },
   {
    "a": 1.5,
    "b": 2,
    "x0": -2
   }
  ],
  "invariants": [
   "inv_at_fa-x0",
   "a*inv_slope-1",
   "(a*x0+b)-fa"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1,
     "x0": 3
    },
    "expect": {
     "fa": 7,
     "inv_at_fa": 3
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": -1,
     "x0": 4
    },
    "expect": {
     "fa": 1,
     "inv_at_fa": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "x0": 2
    },
    "expect": {
     "fa": 2,
     "inv_at_fa": 2
    }
   }
  ],
  "tol": 0.000001
 }
}