{
 "id": "functions/math-2/함수의_극한과_연속/미정상수_결정",
 "spec": {
  "title": "미정상수 결정 — 구간별 함수가 x=1에서 연속이 되도록",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "L = 1 + a; R = 2 + b; gap = R - L; cond = a - b",
  "geometry": null,
  "plot": {
   "range": [
    -1,
    3
   ],
   "yRange": [
    -3,
    7
   ],
   "fns": [
    {
     "fn": "x^2 + a",
     "label": "y = x²+a  (x ≤ 1)",
     "color": "#2563eb"
    },
    {
     "fn": "2*x + b",
     "label": "y = 2x+b  (x > 1)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "좌극한  lim(x→1⁻) f = 1+a",
    "expr": "L",
    "digits": 3
   },
   {
    "label": "우극한  lim(x→1⁺) f = 2+b",
    "expr": "R",
    "digits": 3
   },
   {
    "label": "불연속 간격 (우−좌)",
    "expr": "gap",
    "digits": 3
   },
   {
    "label": "a−b  (연속이려면 = 1)",
    "expr": "cond",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 1
   },
   {
    "a": 1,
    "b": 0
   },
   {
    "a": -2,
    "b": 0.5
   },
   {
    "a": 2,
    "b": 1
   }
  ],
  "invariants": [
   "L - (1 + a)",
   "R - (2 + b)",
   "gap - (R - L)",
   "gap - (1 + b - a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 1
    },
    "expect": {
     "L": 1,
     "R": 3,
     "gap": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0
    },
    "expect": {
     "L": 2,
     "R": 2,
     "gap": 0
    }
   },
   {
    "params": {
     "a": -2,
     "b": 0.5
    },
    "expect": {
     "L": -1,
     "R": 2.5,
     "gap": 3.5
    }
   }
  ],
  "tol": 0.000001
 }
}