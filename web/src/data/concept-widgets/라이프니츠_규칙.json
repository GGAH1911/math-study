{
 "id": "라이프니츠_규칙",
 "spec": {
  "title": "라이프니츠 규칙 시각화",
  "params": [
   {
    "name": "m",
    "label": "하한 a(x)=x^m 의 지수 m",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 1
   },
   {
    "name": "n",
    "label": "상한 b(x)=x^n 의 지수 n",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 2,
    "step": 1
   },
   {
    "name": "p",
    "label": "피적분함수의 x 지수 p (f=x^p·t^q)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 1
   },
   {
    "name": "q",
    "label": "피적분함수의 t 지수 q",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 2,
    "step": 1
   },
   {
    "name": "s",
    "label": "보고 있는 위치 x",
    "type": "slider",
    "min": 0.5,
    "max": 1.4,
    "init": 1,
    "step": 0.01
   }
  ],
  "scope": "a=s^m; b=s^n; da=(m==0 ? 0 : m*s^(m-1)); db=(n==0 ? 0 : n*s^(n-1)); f_a=s^p*a^q; f_b=s^p*b^q; term_b=f_b*db; term_a=-f_a*da; interior=(p==0 ? 0 : p*s^(p-1)*(b^(q+1)-a^(q+1))/(q+1)); total=term_b+term_a+interior; h=0.0001; Fp=(s+h)^p*((s+h)^(n*(q+1))-(s+h)^(m*(q+1)))/(q+1); Fm=(s-h)^p*((s-h)^(n*(q+1))-(s-h)^(m*(q+1)))/(q+1); Fval=s^p*(s^(n*(q+1))-s^(m*(q+1)))/(q+1); numderiv=(Fp-Fm)/(2*h)",
  "plot": {
   "range": [
    0.5,
    1.4
   ],
   "yRange": [
    -30,
    30
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^p*(x^n)^q*n*x^(n-1)",
     "label": "$f(x,b(x))\\,b'(x)$ 상한 경계항",
     "color": "red"
    },
    {
     "fn": "-(x^p*(x^m)^q*m*x^(m-1))",
     "label": "$-f(x,a(x))\\,a'(x)$ 하한 경계항",
     "color": "blue"
    },
    {
     "fn": "p*x^(p-1)*((x^n)^(q+1)-(x^m)^(q+1))/(q+1)",
     "label": "$\\int \\partial f/\\partial x\\, dt$ 내부항",
     "color": "green"
    },
    {
     "fn": "x^p*(x^n)^q*n*x^(n-1)-(x^p*(x^m)^q*m*x^(m-1))+p*x^(p-1)*((x^n)^(q+1)-(x^m)^(q+1))/(q+1)",
     "label": "$dF/dx$ 총 도함수",
     "color": "purple"
    },
    {
     "fn": "x^m",
     "label": "$a(x)$",
     "color": "blue",
     "dashed": true
    },
    {
     "fn": "x^n",
     "label": "$b(x)$",
     "color": "red",
     "dashed": true
    }
   ],
   "points": [
    [
     "=s",
     "=term_b"
    ],
    [
     "=s",
     "=term_a"
    ],
    [
     "=s",
     "=interior"
    ],
    [
     "=s",
     "=total"
    ],
    [
     "=s",
     "=a"
    ],
    [
     "=s",
     "=b"
    ]
   ],
   "pointsLabel": "$x=s$ 에서의 각 항의 값"
  },
  "readout": [
   {
    "label": "a(x)",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "b(x)",
    "expr": "b",
    "digits": 3
   },
   {
    "label": "a'(x)",
    "expr": "da",
    "digits": 3
   },
   {
    "label": "b'(x)",
    "expr": "db",
    "digits": 3
   },
   {
    "label": "상한 경계항",
    "expr": "term_b",
    "digits": 4
   },
   {
    "label": "하한 경계항",
    "expr": "term_a",
    "digits": 4
   },
   {
    "label": "내부항",
    "expr": "interior",
    "digits": 4
   },
   {
    "label": "총 도함수",
    "expr": "total",
    "digits": 4
   },
   {
    "label": "F(x) 값",
    "expr": "Fval",
    "digits": 4
   },
   {
    "label": "수치미분으로 검증한 F'(x)",
    "expr": "numderiv",
    "digits": 4
   }
  ]
 },
