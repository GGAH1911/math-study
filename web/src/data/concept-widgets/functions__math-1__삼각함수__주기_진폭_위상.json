{
 "id": "functions/math-1/삼각함수/주기_진폭_위상",
 "spec": {
  "title": "주기·진폭·위상: y = A·sin(Bx + C) + D",
  "params": [
   {
    "name": "A",
    "label": "A (진폭계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "B",
    "label": "B (각진동수)",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "C",
    "label": "C (위상상수)",
    "type": "slider",
    "min": -3.14,
    "max": 3.14,
    "init": 0,
    "step": 0.1,
    "unit": "rad"
   },
   {
    "name": "D",
    "label": "D (수직이동)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "amp=abs(A); period=2*pi/abs(B); phase=-C/B; ymax=D+amp; ymin=D-amp",
  "plot": {
   "range": [
    -6.5,
    6.5
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "A*sin(B*x+C)+D",
     "label": "y = A sin(Bx+C)+D",
     "color": "#2563eb"
    },
    {
     "fn": "sin(x)",
     "label": "y = sin x (기본형)",
     "color": "#9ca3af"
    },
    {
     "fn": "D",
     "label": "중심선 y = D",
     "color": "#f59e0b"
    }
   ]
  },
  "readout": [
   {
    "label": "진폭 |A|",
    "expr": "amp",
    "digits": 3
   },
   {
    "label": "주기 2π/|B|",
    "expr": "period",
    "digits": 3
   },
   {
    "label": "위상이동 -C/B",
    "expr": "phase",
    "digits": 3
   },
   {
    "label": "최댓값 D+|A|",
    "expr": "ymax",
    "digits": 3
   },
   {
    "label": "최솟값 D-|A|",
    "expr": "ymin",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "A": 2,
    "B": 1,
    "C": 0,
    "D": 0
   },
   {
    "A": 1,
    "B": 2,
    "C": 1,
    "D": 1
   },
   {
    "A": 0.5,
    "B": 3,
    "C": -2,
    "D": -1
   },
   {
    "A": -1.5,
    "B": 0.5,
    "C": 2,
    "D": 0
   }
  ],
  "invariants": [
   "amp-abs(A)",
   "period*abs(B)-2*pi",
   "phase*B+C",
   "(ymax+ymin)-2*D",
   "(ymax-ymin)-2*amp"
  ],
  "oracle": [
   {
    "params": {
     "A": 2,
     "B": 1,
     "C": 0,
     "D": 0
    },
    "expect": {
     "amp": 2,
     "period": 6.283185307179586,
     "phase": 0,
     "ymax": 2,
     "ymin": -2
    }
   },
   {
    "params": {
     "A": 1,
     "B": 2,
     "C": 1,
     "D": 0
    },
    "expect": {
     "amp": 1,
     "period": 3.141592653589793,
     "phase": -0.5,
     "ymax": 1,
     "ymin": -1
    }
   },
   {
    "params": {
     "A": 0.5,
     "B": 3,
     "C": -3,
     "D": 1
    },
    "expect": {
     "amp": 0.5,
     "period": 2.0943951023931953,
     "phase": 1,
     "ymax": 1.5,
     "ymin": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}