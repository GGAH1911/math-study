{
 "id": "algebra/middle-3/실수와_그_계산/무리수",
 "spec": {
  "title": "√n의 유리수 근사와 오차",
  "params": [
   {
    "name": "n",
    "label": "n",
    "type": "slider",
    "min": 2,
    "max": 9,
    "init": 2,
    "step": 1
   },
   {
    "name": "q",
    "label": "분모 q",
    "type": "slider",
    "min": 1,
    "max": 20,
    "init": 5,
    "step": 1
   }
  ],
  "scope": "r=sqrt(n); p=round(r*q); approx=p/q; err=abs(r-approx); isRational=(round(r)^2==n)?1:0",
  "plot": {
   "range": [
    0.5,
    20.5
   ],
   "yRange": [
    0,
    1
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "abs(r - round(r*x)/x)",
     "label": "최선의 유리수 근사 오차",
     "color": "#d62728"
    }
   ],
   "points": [
    [
     "=q",
     "=err"
    ]
   ],
   "pointsLabel": "$q=$ 현재 분모"
  },
  "readout": [
   {
    "label": "√n",
    "expr": "r",
    "digits": 10
   },
   {
    "label": "q에서 최선 분수",
    "expr": "approx",
    "digits": 10
   },
   {
    "label": "오차",
    "expr": "err",
    "digits": 12
   },
   {
    "label": "유리수(1)",
    "expr": "isRational",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 2,
    "q": 1
   },
   {
    "n": 2,
    "q": 5
   },
   {
    "n": 5,
    "q": 3
   },
   {
    "n": 9,
    "q": 10
   }
  ],
  "invariants": [
   "r^2 - n",
   "max(0, 2*q*err - 1)",
   "isRational * err",
   "max(0, (1-isRational)*(1 - sign(err)))"
  ],
  "oracle": [
   {
    "params": {
     "n": 2,
     "q": 1
    },
    "expect": {
     "r": 1.41421356237,
     "p": 1,
     "approx": 1,
     "err": 0.41421356237,
     "isRational": 0
    }
   },
   {
    "params": {
     "n": 2,
     "q": 5
    },
    "expect": {
     "r": 1.41421356237,
     "p": 7,
     "approx": 1.4,
     "err": 0.01421356237,
     "isRational": 0
    }
   },
   {
    "params": {
     "n": 4,
     "q": 3
    },
    "expect": {
     "r": 2,
     "p": 6,
     "approx": 2,
     "err": 0,
     "isRational": 1
    }
   }
  ],
  "tol": 0.000001
 }
}