      "=a"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=-xc",
      "=a"
     ]
    },
    {
     "type": "point",
     "at": [
      "=xc",
      "=a"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=-xc",
      "=a"
     ],
     "label": "B"
    }
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "해1 (rad)",
    "expr": "x1",
    "digits": 6
   },
   {
    "label": "해2 (rad)",
    "expr": "x2",
    "digits": 6
   },
   {
    "label": "해1 (deg)",
    "expr": "x1deg",
    "digits": 2
   },
   {
    "label": "해2 (deg)",
    "expr": "x2deg",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
