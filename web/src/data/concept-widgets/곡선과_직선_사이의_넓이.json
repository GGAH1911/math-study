{
 "id": "곡선과_직선_사이의_넓이",
 "spec": {
  "title": "곡선과 직선 사이의 넓이",
  "params": [
   {
    "name": "b",
    "label": "직선 y=x+b의 y절편 b",
    "type": "slider",
    "min": -0.25,
    "max": 4,
    "init": 0.5,
    "step": 0.05
   }
  ],
  "scope": "alpha=(1 - sqrt(1+4*b))/2; beta=(1 + sqrt(1+4*b))/2; area=(beta^2/2 + b*beta - beta^3/3) - (alpha^2/2 + b*alpha - alpha^3/3)",
  "plot": {
   "range": [
    -2.5,
    3
   ],
   "yRange": [
    -1,
    7
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y = x²",
     "color": "blue"
    },
    {
     "fn": "x + b",
     "label": "y = x + b",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "α (왼쪽 교점의 x좌표)",
    "expr": "alpha",
    "digits": 4
   },
   {
    "label": "β (오른쪽 교점의 x좌표)",
    "expr": "beta",
    "digits": 4
   },
   {
    "label": "넓이",
    "expr": "area",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": -0.25
   },
   {
    "b": 0
   },
   {
    "b": 0.75
   },
   {
    "b": 2
   }
  ],
  "invariants": [
   "alpha^2 - alpha - b",
   "beta^2 - beta - b",
   "area - (1+4*b)^(3/2)/6"
  ],
  "oracle": [
   {
    "params": {
     "b": 0
    },
    "expect": {
     "alpha": 0,
     "beta": 1,
     "area": 0.16666666666666666
    }
   },
   {
    "params": {
     "b": 0.75
    },
    "expect": {
     "alpha": -0.5,
     "beta": 1.5,
     "area": 1.3333333333333333
    }
   },
   {
    "params": {
     "b": 2
    },
    "expect": {
     "alpha": -1,
     "beta": 2,
     "area": 4.5
    }
   }
  ],
  "tol": 0.000001
 }
}