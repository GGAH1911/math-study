{
 "id": "functions/math-2/미분/실근의_개수_조건",
 "spec": {
  "title": "실근의 개수 조건 — 삼차곡선 y = px³ + ax² + bx 와 수평선 y = k 의 교점",
  "params": [
   {
    "name": "p",
    "label": "p",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.25
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -3,
    "step": 0.25
   },
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 0,
    "step": 0.2
   }
  ],
  "scope": "peff = abs(p) < 0.25 ? 0.25 : p; D4 = a^2 - 3*peff*b; sq = D4 > 0 ? sqrt(D4) : 0; xA = (-a - sq)/(3*peff); xB = (-a + sq)/(3*peff); xlo = min(xA, xB); xhi = max(xA, xB); flo = peff*xlo^3 + a*xlo^2 + b*xlo; fhi = peff*xhi^3 + a*xhi^2 + b*xhi; g1 = flo - k; g2 = fhi - k; prod = D4 > 0 ? g1*g2 : 1; nroots = D4 > 0 ? 2 - sign(prod) : 1; bLo = min(-20, xlo - 1); bHi = max(20, xhi + 1)",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "peff*x^3 + a*x^2 + b*x",
     "label": "$y=px^3+ax^2+bx$",
     "color": "#2563eb"
    },
    {
     "fn": "0*x + k",
     "label": "$y=k$",
     "color": "#f59e0b",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "peff*x^3 + a*x^2 + b*x - k",
     "in": [
      "=bLo",
      "=xlo"
     ],
     "label": "근"
    },
    {
     "fn": "peff*x^3 + a*x^2 + b*x - k",
     "in": [
      "=xlo",
      "=xhi"
     ],
     "label": "근"
    },
    {
     "fn": "peff*x^3 + a*x^2 + b*x - k",
     "in": [
      "=xhi",
      "=bHi"
     ],
     "label": "근"
    }
   ],
   "points": [
    [
     "=xlo",
     "=flo"
    ],
    [
     "=xhi",
     "=fhi"
    ]
   ],
   "pointsLabel": "극점 (극댓값·극솟값을 주는 점)"
  },
  "readout": [
   {
    "label": "극값 판별식 $a^2-3pb$",
    "expr": "D4",
    "digits": 2
   },
   {
    "label": "왼쪽 극값 $f(x_1)$",
    "expr": "flo",
    "digits": 2
   },
   {
    "label": "오른쪽 극값 $f(x_2)$",
    "expr": "fhi",
    "digits": 2
   },
   {
    "label": "$f(x_1)-k$",
    "expr": "g1",
    "digits": 2
   },
   {
    "label": "두 차의 곱",
    "expr": "prod",
    "digits": 2
   },
   {
    "label": "서로 다른 실근의 개수",
    "expr": "nroots",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 1,
    "a": 0,
    "b": -3,
    "k": 0
   },
   {
    "p": 1,
    "a": 0,
    "b": -3,
    "k": 2
   },
   {
    "p": 1,
    "a": 0,
    "b": 3,
    "k": 0
   },
   {
    "p": -1,
    "a": 0,
    "b": 3,
    "k": 0
   },
   {
    "p": 1,
    "a": -3,
    "b": 0,
    "k": 0
   },
   {
    "p": 0,
    "a": 2,
    "b": -4,
    "k": 1
   }
  ],
  "invariants": [
   "D4 - (a^2 - 3*peff*b)",
   "g1 - (flo - k)",
   "g2 - (fhi - k)",
   "(3*peff*xlo^2 + 2*a*xlo + b) * (D4 > 0 ? 1 : 0)",
   "nroots - (D4 > 0 ? 2 - sign(prod) : 1)"
  ],
  "oracle": [
   {
    "params": {
     "p": 1,
     "a": 0,
     "b": -3,
     "k": 0
    },
    "expect": {
     "D4": 9,
     "xlo": -1,
     "xhi": 1,
     "flo": 2,
     "fhi": -2,
     "prod": -4,
     "nroots": 3
    }
   },
   {
    "params": {
     "p": 1,
     "a": 0,
     "b": -3,
     "k": 2
    },
    "expect": {
     "g1": 0,
     "g2": -4,
     "prod": 0,
     "nroots": 2
    }
   },
   {
    "params": {
     "p": 1,
     "a": 0,
     "b": -3,
     "k": 3
    },
    "expect": {
     "g1": -1,
     "g2": -5,
     "prod": 5,
     "nroots": 1
    }
   },
   {
    "params": {
     "p": 1,
     "a": 0,
     "b": 3,
     "k": 0
    },
    "expect": {
     "D4": -9,
     "xlo": 0,
     "xhi": 0,
     "prod": 1,
     "nroots": 1
    }
   },
   {
    "params": {
     "p": -1,
     "a": 0,
     "b": 3,
     "k": 0
    },
    "expect": {
     "D4": 9,
     "xlo": -1,
     "xhi": 1,
     "flo": -2,
     "fhi": 2,
     "prod": -4,
     "nroots": 3
    }
   },
   {
    "params": {
     "p": 1,
     "a": -3,
     "b": 0,
     "k": 0
    },
    "expect": {
     "D4": 9,
     "xlo": 0,
     "xhi": 2,
     "flo": 0,
     "fhi": -4,
     "prod": 0,
     "nroots": 2
    }
   }
  ],
  "tol": 0.000001
 }
}
