{
 "id": "functions/high-1/함수와_그래프/기하와_함수",
 "spec": {
  "title": "지수함수와 로그함수 — 직선 y=x에 대한 대칭 (역함수)",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.2,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "p",
    "label": "점의 x좌표 p",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "ex=p; ey=a^p; lx=a^p; ly=p",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -3,
    3
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y = a^x (지수함수)",
     "color": "#e11d48"
    },
    {
     "fn": "log(x)/log(a)",
     "label": "y = log_a x (로그함수)",
     "color": "#2563eb"
    },
    {
     "fn": "x",
     "label": "y = x (대칭축)",
     "color": "#9ca3af"
    }
   ],
   "points": [
    [
     "=ex",
     "=ey"
    ],
    [
     "=lx",
     "=ly"
    ]
   ],
   "pointsLabel": "$(p,\\,a^p)$ — 지수함수 위의 점, $(a^p,\\,p)$ — 이를 $y=x$로 반사한 로그함수 위의 점"
  },
  "readout": [
   {
    "label": "지수함수 위 점 (p, a^p) 의 y값",
    "expr": "ey",
    "digits": 3
   },
   {
    "label": "이를 y=x로 반사한 점 (a^p, p) — 로그함수 위 점",
    "expr": "ly",
    "digits": 3
   },
   {
    "label": "log_a(a^p) 값 (=p 여야 함)",
    "expr": "log(lx)/log(a)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "p": 1
   },
   {
    "a": 2,
    "p": 2
   },
   {
    "a": 3,
    "p": 0
   },
   {
    "a": 2.5,
    "p": -1
   }
  ],
  "invariants": [
   "log(lx)/log(a)-ly",
   "lx-ey",
   "ly-ex"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "p": 1
    },
    "expect": {
     "ey": 2,
     "lx": 2,
     "ly": 1
    }
   },
   {
    "params": {
     "a": 3,
     "p": 0
    },
    "expect": {
     "ey": 1,
     "lx": 1,
     "ly": 0
    }
   },
   {
    "params": {
     "a": 2,
     "p": 2
    },
    "expect": {
     "ey": 4,
     "lx": 4,
     "ly": 2
    }
   }
  ],
  "tol": 0.000001
 }
}