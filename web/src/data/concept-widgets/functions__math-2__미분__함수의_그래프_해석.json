{
 "id": "functions/math-2/미분/함수의_그래프_해석",
 "spec": {
  "title": "함수의 그래프 해석: f(x)=x³−3kx",
  "params": [
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": 0.25,
    "max": 4,
    "init": 1,
    "step": 0.25,
    "unit": ""
   }
  ],
  "scope": "xmax = -sqrt(k); xmin = sqrt(k); fmax = 2*k*sqrt(k); fmin = -2*k*sqrt(k)",
  "geometry": null,
  "plot": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -18,
    18
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^3 - 3*k*x",
     "label": "f(x)=x³−3kx",
     "color": "#2563eb"
    },
    {
     "fn": "3*x^2 - 3*k",
     "label": "f'(x)=3x²−3k",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극대점 x = −√k",
    "expr": "xmax",
    "digits": 3
   },
   {
    "label": "극소점 x = √k",
    "expr": "xmin",
    "digits": 3
   },
   {
    "label": "극댓값 f(−√k)",
    "expr": "fmax",
    "digits": 3
   },
   {
    "label": "극솟값 f(√k)",
    "expr": "fmin",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 0.5
   },
   {
    "k": 1
   },
   {
    "k": 2
   },
   {
    "k": 3
   }
  ],
  "invariants": [
   "3*xmin^2 - 3*k",
   "3*xmax^2 - 3*k",
   "fmax - (xmax^3 - 3*k*xmax)",
   "fmin - (xmin^3 - 3*k*xmin)",
   "fmax + fmin",
   "xmax + xmin"
  ],
  "oracle": [
   {
    "params": {
     "k": 1
    },
    "expect": {
     "xmax": -1,
     "xmin": 1,
     "fmax": 2,
     "fmin": -2
    }
   },
   {
    "params": {
     "k": 4
    },
    "expect": {
     "xmax": -2,
     "xmin": 2,
     "fmax": 16,
     "fmin": -16
    }
   },
   {
    "params": {
     "k": 0.25
    },
    "expect": {
     "xmax": -0.5,
     "xmin": 0.5,
     "fmax": 0.25,
     "fmin": -0.25
    }
   }
  ],
  "tol": 0.000001
 }
}