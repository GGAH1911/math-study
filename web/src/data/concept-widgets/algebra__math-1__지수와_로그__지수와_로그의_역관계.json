{
 "id": "algebra/math-1/지수와_로그/지수와_로그의_역관계",
 "spec": {
  "title": "지수와 로그의 역관계",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.5,
    "max": 4,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "t",
    "label": "매개 t",
    "type": "slider",
    "min": -1,
    "max": 1.5,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "px=t; py=a^t; qx=py; qy=px; lv=log(qx)/log(a)",
  "plot": {
   "range": [
    -1.5,
    5
   ],
   "yRange": [
    -2.5,
    6
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y = a^x",
     "color": "blue"
    },
    {
     "fn": "log(x)/log(a)",
     "label": "y = log_a(x)",
     "color": "red"
    },
    {
     "fn": "x",
     "label": "y = x",
     "color": "gray"
    }
   ]
  },
  "readout": [
   {
    "label": "t",
    "expr": "t",
    "digits": 3
   },
   {
    "label": "a^t",
    "expr": "py",
    "digits": 5
   },
   {
    "label": "log_a(a^t)",
    "expr": "lv",
    "digits": 5
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "t": 0.5
   },
   {
    "a": 3,
    "t": -0.7
   },
   {
    "a": 1.5,
    "t": 1.2
   }
  ],
  "invariants": [
   "abs(qx - py)",
   "abs(lv - qy)",
   "abs(a^(log(qx)/log(a)) - qx)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "t": 1
    },
    "expect": {
     "px": 1,
     "py": 2,
     "qx": 2,
     "qy": 1,
     "lv": 1
    }
   },
   {
    "params": {
     "a": 4,
     "t": 0.5
    },
    "expect": {
     "px": 0.5,
     "py": 2,
     "qx": 2,
     "qy": 0.5,
     "lv": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}