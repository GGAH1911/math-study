{
 "id": "정의역_조건",
 "spec": {
  "title": "로그함수의 정의역 조건 (진수 조건)",
  "params": [
   {
    "name": "c",
    "label": "c (진수 상수)",
    "type": "slider",
    "min": -2,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "x₀ (탐구 지점)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "g0 = x0^2 - c; f0 = (g0 > 0) ? log(g0) : 0; defined = (g0 > 0) ? 1 : 0; b = sqrt(max(c,0))",
  "geometry": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -5,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -5,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^2 - c",
     "label": "g(x) = x² - c",
     "color": "#888"
    },
    {
     "fn": "log(x^2 - c)",
     "label": "f(x) = log(x² - c)",
     "color": "#d00"
    }
   ],
   "points": [
    [
     "=x0",
     "=g0"
    ],
    [
     "=x0",
     "=f0"
    ]
   ],
   "pointsLabel": "$x_0$"
  },
  "readout": [
   {
    "label": "g(x₀)",
    "expr": "g0",
    "digits": 4
   },
   {
    "label": "f(x₀)",
    "expr": "f0",
    "digits": 4
   },
   {
    "label": "정의역 포함?",
    "expr": "defined",
    "digits": 0
   },
   {
    "label": "경계 거리 √c",
    "expr": "b",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 1,
    "x0": 0.5
   },
   {
    "c": -1,
    "x0": 3
   },
   {
    "c": 4,
    "x0": 0
   },
   {
    "c": 0.25,
    "x0": 0
   }
  ],
  "invariants": [
   "(g0 > 0) ? (exp(f0) - g0) : 0",
   "defined - ((g0 > 0) ? 1 : 0)"
  ],
  "oracle": [
   {
    "params": {
     "c": 3,
     "x0": 2
    },
    "expect": {
     "g0": 1,
     "f0": 0,
     "defined": 1
    }
   },
   {
    "params": {
     "c": 3,
     "x0": 1
    },
    "expect": {
     "g0": -2,
     "f0": 0,
     "defined": 0
    }
   },
   {
    "params": {
     "c": -1,
     "x0": 0
    },
    "expect": {
     "g0": 1,
     "f0": 0,
     "defined": 1
    }
   }
  ],
  "tol": 0.000001
 }
}