{
 "id": "방정식의_해의_개수",
 "spec": {
  "title": "방정식의 해의 개수",
  "params": [
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "y_max = k + 2; y_min = k - 2; disc = 108 - 27*k^2; num_roots = disc > 0 ? 3 : (disc < 0 ? 1 : 2)",
  "plot": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x + k",
     "label": "y = f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값 (x=-1)",
    "expr": "y_max",
    "digits": 2
   },
   {
    "label": "극솟값 (x=1)",
    "expr": "y_min",
    "digits": 2
   },
   {
    "label": "판별식 Δ",
    "expr": "disc",
    "digits": 2
   },
   {
    "label": "서로 다른 실근의 개수",
    "expr": "num_roots",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 0
   },
   {
    "k": 1.5
   },
   {
    "k": 2
   },
   {
    "k": 3
   }
  ],
  "invariants": [
   "y_max - y_min - 4",
   "y_max + y_min - 2*k"
  ],
  "oracle": [
   {
    "params": {
     "k": 0
    },
    "expect": {
     "y_max": 2,
     "y_min": -2,
     "disc": 108,
     "num_roots": 3
    }
   },
   {
    "params": {
     "k": 2
    },
    "expect": {
     "y_max": 4,
     "y_min": 0,
     "disc": 0,
     "num_roots": 2
    }
   },
   {
    "params": {
     "k": 3
    },
    "expect": {
     "y_max": 5,
     "y_min": 1,
     "disc": -135,
     "num_roots": 1
    }
   }
  ],
  "tol": 0.000001
 }
}