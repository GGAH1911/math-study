{
 "id": "algebra/math-1/지수와_로그/로그_조건",
 "spec": {
  "title": "로그의 정의 조건",
  "params": [
   {
    "name": "base",
    "label": "밑 a",
    "type": "slider",
    "min": 0.1,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "arg",
    "label": "진수 x",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 3,
    "step": 0.1
   }
  ],
  "scope": "valid = ((base > 0) and (base != 1) and (arg > 0)) ? 1 : 0; y = (valid == 1) ? log(arg)/log(base) : NaN",
  "plot": {
   "range": [
    0,
    10
   ],
   "yRange": [
    -4,
    4
   ],
   "fns": [
    {
     "fn": "x > 0 and base > 0 and base != 1 ? log(x)/log(base) : NaN",
     "label": "y = log_a x",
     "color": "#1f77b4"
    }
   ],
   "points": [
    [
     "=arg",
     "=(valid == 1) ? y : NaN"
    ]
   ],
   "pointsLabel": "$(x,\\ \\log_a x)$"
  },
  "readout": [
   {
    "label": "정의 가능",
    "expr": "valid",
    "digits": 0
   },
   {
    "label": "log_a x",
    "expr": "y",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "base": 2,
    "arg": 8
   },
   {
    "base": 3,
    "arg": 9
   },
   {
    "base": 0.5,
    "arg": 4
   },
   {
    "base": 4,
    "arg": 2
   }
  ],
  "invariants": [
   "abs(base^y - arg)",
   "abs(valid - 1)"
  ],
  "oracle": [
   {
    "params": {
     "base": 2,
     "arg": 8
    },
    "expect": {
     "valid": 1,
     "y": 3
    }
   },
   {
    "params": {
     "base": 3,
     "arg": 9
    },
    "expect": {
     "valid": 1,
     "y": 2
    }
   },
   {
    "params": {
     "base": 0.5,
     "arg": 4
    },
    "expect": {
     "valid": 1,
     "y": -2
    }
   },
   {
    "params": {
     "base": 4,
     "arg": 2
    },
    "expect": {
     "valid": 1,
     "y": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}