{
 "id": "functions/math-1/지수함수와_로그함수/지수방정식",
 "spec": {
  "title": "지수방정식 a^x = b",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.8,
    "max": 4,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "우변 b",
    "type": "slider",
    "min": 0.5,
    "max": 9,
    "init": 8,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "sol = log(b)/log(a)",
  "plot": {
   "range": [
    -2,
    6
   ],
   "yRange": [
    0,
    12
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y=a^x",
     "color": "#2563eb"
    },
    {
     "fn": "b",
     "label": "y=b (목표값)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "해 x = log_a b",
    "expr": "sol",
    "digits": 4
   },
   {
    "label": "검산 a^x (=b여야)",
    "expr": "a^sol",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 8
   },
   {
    "a": 3,
    "b": 4
   },
   {
    "a": 2.5,
    "b": 6
   },
   {
    "a": 4,
    "b": 0.5
   }
  ],
  "invariants": [
   "a^sol - b"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 8
    },
    "expect": {
     "sol": 3
    }
   },
   {
    "params": {
     "a": 3,
     "b": 9
    },
    "expect": {
     "sol": 2
    }
   },
   {
    "params": {
     "a": 4,
     "b": 2
    },
    "expect": {
     "sol": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}