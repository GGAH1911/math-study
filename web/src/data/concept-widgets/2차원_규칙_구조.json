      5,
      5
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      1
     ],
     "to": [
      5,
      1
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      2
     ],
     "to": [
      5,
      2
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      3
     ],
     "to": [
      5,
      3
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      4
     ],
     "to": [
      5,
      4
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      5
     ],
     "to": [
      5,
      5
     ]
    },
    {
     "type": "point",
     "at": [
      "=n",
      "=m"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      1,
      0.5
     ],
     "to": [
      "=C+1",
