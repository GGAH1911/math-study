      1,
      1
     ],
     "to": [
      1,
      5
     ]
    },
    {
     "type": "segment",
     "from": [
      2,
      1
     ],
     "to": [
      2,
      5
     ]
    },
    {
     "type": "segment",
     "from": [
      3,
      1
     ],
     "to": [
      3,
      5
     ]
    },
    {
     "type": "segment",
     "from": [
      4,
      1
     ],
     "to": [
      4,
      5
     ]
    },
    {
     "type": "segment",
     "from": [
      5,
