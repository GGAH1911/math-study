{
 "id": "2차원_규칙_구조",
 "spec": {
  "title": "2차원 규칙 구조",
  "params": [
   {
    "name": "C",
    "label": "열의 개수",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 3,
    "step": 1
   },
   {
    "name": "m",
    "label": "행 번호",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 1,
    "step": 1
   },
   {
    "name": "n",
    "label": "열 번호",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 1,
    "step": 1
   }
  ],
  "scope": "val=C*(m-1)+n; valRight=C*(m-1)+(n+1); valDown=C*m+n",
  "geometry": {
   "range": [
    0,
    8
   ],
   "yRange": [
    0,
    6
   ],
   "showAxes": true,
   "showGrid": false,
