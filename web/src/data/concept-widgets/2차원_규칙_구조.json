    {
     "type": "point",
     "at": [
      "=C+1",
      0.5
     ],
     "label": "C",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "선택한 항의 값",
    "expr": "val",
    "digits": 0
   },
   {
    "label": "오른쪽 항의 값",
    "expr": "valRight",
    "digits": 0
   },
   {
    "label": "아래쪽 항의 값",
    "expr": "valDown",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "C": 3,
    "m": 1,
    "n": 1
   },
   {
    "C": 3,
