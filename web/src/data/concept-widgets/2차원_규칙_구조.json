    "m": 4,
    "n": 2
   },
   {
    "C": 1,
    "m": 3,
    "n": 1
   }
  ],
  "invariants": [
   "valRight - val - 1",
   "valDown - val - C"
  ],
  "oracle": [
   {
    "params": {
     "C": 3,
     "m": 2,
     "n": 1
    },
    "expect": {
     "val": 4,
     "valRight": 5,
     "valDown": 7
    }
   },
   {
    "params": {
     "C": 5,
     "m": 4,
     "n": 3
    },
    "expect": {
     "val": 18,
     "valRight": 19,
     "valDown": 23
    }
   },
   {
    "params": {
     "C": 2,
     "m": 3,
     "n": 2
    },
    "expect": {
     "val": 6,
     "valRight": 7,
     "valDown": 8
    }
   }
  ],
  "tol": 0.000001
