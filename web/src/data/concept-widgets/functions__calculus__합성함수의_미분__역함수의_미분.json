{
 "id": "functions/calculus/합성함수의_미분/역함수의_미분",
 "spec": {
  "title": "역함수의 미분: 기울기는 서로 역수",
  "params": [
   {
    "name": "a",
    "label": "접점의 x좌표 a",
    "type": "slider",
    "min": 0.4,
    "max": 2,
    "init": 1,
    "step": 0.05
   }
  ],
  "scope": "fa=a^2; df=2*a; dinv=1/(2*a); prod=df*dinv",
  "plot": {
   "range": [
    0,
    4.2
   ],
   "yRange": [
    0,
    4.2
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#2563eb"
    },
    {
     "fn": "sqrt(x)",
     "label": "f⁻¹(x)=√x",
     "color": "#dc2626"
    },
    {
     "fn": "x",
     "label": "y=x (대칭축)",
     "color": "#9ca3af"
    },
    {
     "fn": "2*a*x - a^2",
     "label": "f의 접선 (기울기 2a)",
     "color": "#1d4ed8"
    },
    {
     "fn": "x/(2*a) + a/2",
     "label": "f⁻¹의 접선 (기울기 1/2a)",
     "color": "#b91c1c"
    }
   ]
  },
  "readout": [
   {
    "label": "f '(a)",
    "expr": "df",
    "digits": 3
   },
   {
    "label": "(f⁻¹)'(f(a))",
    "expr": "dinv",
    "digits": 3
   },
   {
    "label": "두 기울기의 곱",
    "expr": "prod",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.4
   },
   {
    "a": 1
   },
   {
    "a": 1.5
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "df*dinv - 1",
   "dinv - 1/df",
   "a - sqrt(fa)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": 1,
     "df": 2,
     "dinv": 0.5,
     "prod": 1
    }
   },
   {
    "params": {
     "a": 0.5
    },
    "expect": {
     "fa": 0.25,
     "df": 1,
     "dinv": 1,
     "prod": 1
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 4,
     "df": 4,
     "dinv": 0.25,
     "prod": 1
    }
   }
  ],
  "tol": 0.000001
 }
}