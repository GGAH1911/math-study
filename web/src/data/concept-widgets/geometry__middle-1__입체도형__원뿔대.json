{
 "id": "geometry/middle-1/입체도형/원뿔대",
 "spec": {
  "title": "원뿔대 — 평행한 평면으로 자르기와 닮음비",
  "params": [
   {
    "name": "R",
    "label": "밑면 반지름 R",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "H",
    "label": "원뿔 높이 H",
    "type": "slider",
    "min": 2,
    "max": 8,
    "init": 6,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "자르는 높이비 t (밑면→꼭지점)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "hc = t*H; r = R*(1-t); Hf = hc; V = pi*Hf/3*(R^2 + R*r + r^2); Vcone = pi*H/3*R^2; Vsmall = pi*(H-hc)/3*r^2",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -1,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       "=-R",
       0
      ],
      [
       "=R",
       0
      ],
      [
       0,
       "=H"
      ]
     ],
     "label": "원뿔(전체)",
     "color": "#cccccc"
    },
    {
     "type": "polygon",
     "points": [
      [
       "=-R",
       0
      ],
      [
       "=R",
       0
      ],
      [
       "=r",
       "=hc"
      ],
      [
       "=-r",
       "=hc"
      ]
     ],
     "label": "원뿔대",
     "color": "#4488ff"
    },
    {
     "type": "segment",
     "from": [
      "=-r",
      "=hc"
     ],
     "to": [
      "=r",
      "=hc"
     ],
     "label": "자른 평면",
     "color": "#ff5500"
    },
    {
     "type": "point",
     "at": [
      "=R",
      0
     ],
     "label": "R"
    },
    {
     "type": "point",
     "at": [
      "=r",
      "=hc"
     ],
     "label": "r"
    },
    {
     "type": "point",
     "at": [
      0,
      "=H"
     ],
     "label": "꼭지점"
    }
   ]
  },
  "readout": [
   {
    "label": "윗면 반지름 r",
    "expr": "r",
    "digits": 3
   },
   {
    "label": "원뿔대 높이",
    "expr": "Hf",
    "digits": 3
   },
   {
    "label": "닮음비 r/R",
    "expr": "r/R",
    "digits": 3
   },
   {
    "label": "원뿔대 부피 V",
    "expr": "V",
    "digits": 3
   },
   {
    "label": "큰 원뿔 부피",
    "expr": "Vcone",
    "digits": 3
   },
   {
    "label": "작은(잘린) 원뿔 부피",
    "expr": "Vsmall",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "R": 3,
    "H": 6,
    "t": 0.5
   },
   {
    "R": 4,
    "H": 8,
    "t": 0.25
   },
   {
    "R": 2,
    "H": 5,
    "t": 0.8
   },
   {
    "R": 5,
    "H": 4,
    "t": 0.5
   }
  ],
  "invariants": [
   "r*H - R*(H - hc)",
   "H*r + R*hc - R*H",
   "V - (Vcone - Vsmall)"
  ],
  "oracle": [
   {
    "params": {
     "R": 3,
     "H": 6,
     "t": 0.5
    },
    "expect": {
     "r": 1.5,
     "hc": 3,
     "Hf": 3,
     "V": 49.480084
    }
   },
   {
    "params": {
     "R": 4,
     "H": 8,
     "t": 0.25
    },
    "expect": {
     "r": 3,
     "hc": 2,
     "Hf": 2,
     "V": 77.492619
    }
   },
   {
    "params": {
     "R": 2,
     "H": 5,
     "t": 0.8
    },
    "expect": {
     "r": 0.4,
     "hc": 4,
     "Hf": 4,
     "V": 20.776399
    }
   }
  ],
  "tol": 0.000001
 }
}