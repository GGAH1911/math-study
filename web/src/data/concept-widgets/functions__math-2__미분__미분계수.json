{
 "id": "functions/math-2/미분/미분계수",
 "spec": {
  "title": "미분계수: 할선에서 접선으로",
  "params": [
   {
    "name": "a",
    "label": "a (접점의 x좌표)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "h",
    "label": "h (증분)",
    "type": "slider",
    "min": 0.05,
    "max": 3,
    "init": 2,
    "step": 0.05
   }
  ],
  "scope": "fa=a^2; fah=(a+h)^2; msec=(fah-fa)/h; mtan=2*a",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -3,
    17
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#2563eb"
    },
    {
     "fn": "fa+msec*(x-a)",
     "label": "할선 (secant): 두 점 (a,f(a)),(a+h,f(a+h))",
     "color": "#f59e0b"
    },
    {
     "fn": "fa+mtan*(x-a)",
     "label": "접선 (tangent): 기울기 f'(a)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "할선 기울기  (f(a+h)-f(a))/h",
    "expr": "msec",
    "digits": 4
   },
   {
    "label": "접선 기울기 = 미분계수 f'(a)",
    "expr": "mtan",
    "digits": 4
   },
   {
    "label": "할선−접선 (= h, h→0이면 0)",
    "expr": "msec-mtan",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "h": 2
   },
   {
    "a": 2,
    "h": 1
   },
   {
    "a": 0,
    "h": 1
   },
   {
    "a": -1,
    "h": 0.5
   }
  ],
  "invariants": [
   "fa-a^2",
   "fah-(a+h)^2",
   "mtan-2*a",
   "msec-(2*a+h)",
   "mtan-(msec-h)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "h": 2
    },
    "expect": {
     "fa": 1,
     "fah": 9,
     "msec": 4,
     "mtan": 2
    }
   },
   {
    "params": {
     "a": 2,
     "h": 1
    },
    "expect": {
     "fa": 4,
     "fah": 9,
     "msec": 5,
     "mtan": 4
    }
   },
   {
    "params": {
     "a": 0,
     "h": 1
    },
    "expect": {
     "fa": 0,
     "fah": 1,
     "msec": 1,
     "mtan": 0
    }
   }
  ],
  "tol": 0.000001
 }
}