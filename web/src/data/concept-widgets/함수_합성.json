{
 "id": "함수_합성",
 "spec": {
  "title": "함수 합성",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "t (x)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "f_t = a*t + b; g_t = c*t + d; fog_t = a*(c*t + d) + b; gof_t = c*(a*t + b) + d; slope_fog = a*c; slope_gof = a*c; intercept_fog = a*d + b; intercept_gof = c*b + d; h_t = t + 1; fog_h = a*(c*h_t + d) + b; gh_t = c*h_t + d; f_gh = a*gh_t + b",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -20,
    20
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x + b",
     "label": "f(x) = ax+b",
     "color": "blue"
    },
    {
     "fn": "c*x + d",
     "label": "g(x) = cx+d",
     "color": "green"
    },
    {
     "fn": "a*(c*x + d) + b",
     "label": "f∘g",
     "color": "red"
    },
    {
     "fn": "c*(a*x + b) + d",
     "label": "g∘f",
     "color": "purple"
    }
   ]
  },
  "readout": [
   {
    "label": "f(t)",
    "expr": "f_t",
    "digits": 4
   },
   {
    "label": "g(t)",
    "expr": "g_t",
    "digits": 4
   },
   {
    "label": "f(g(t))",
    "expr": "fog_t",
    "digits": 4
   },
   {
    "label": "g(f(t))",
    "expr": "gof_t",
    "digits": 4
   },
   {
    "label": "slope(f∘g)",
    "expr": "slope_fog",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "c": 2,
    "d": -1,
    "t": 1
   },
   {
    "a": -2,
    "b": 1,
    "c": 0.5,
    "d": -2,
    "t": -3
   },
   {
    "a": 0,
    "b": 3,
    "c": 2,
    "d": 4,
    "t": 2
   },
   {
    "a": 2,
    "b": 3,
    "c": 4,
    "d": 5,
    "t": 4
   }
  ],
  "invariants": [
   "fog_t - (a*c*t + a*d + b)",
   "gof_t - (a*c*t + c*b + d)",
   "fog_h - f_gh"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 3,
     "c": 4,
     "d": 5,
     "t": 4
    },
    "expect": {
     "fog_t": 45,
     "gof_t": 49,
     "slope_fog": 8,
     "intercept_fog": 13,
     "fog_h": 53,
     "f_gh": 53
    }
   },
   {
    "params": {
     "a": -1,
     "b": 0,
     "c": 2,
     "d": 1,
     "t": -2
    },
    "expect": {
     "fog_t": 3,
     "gof_t": 5,
     "slope_fog": -2,
     "intercept_fog": -1,
     "fog_h": 1,
     "f_gh": 1
    }
   },
   {
    "params": {
     "a": 0,
     "b": 3,
     "c": 2,
     "d": 4,
     "t": 2
    },
    "expect": {
     "fog_t": 3,
     "gof_t": 10,
     "slope_fog": 0,
     "intercept_fog": 3,
     "fog_h": 3,
     "f_gh": 3
    }
   }
  ],
  "tol": 0.000001
 }
}