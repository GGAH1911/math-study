{
 "id": "일측극한",
 "spec": {
  "title": "일측극한 (One-Sided Limits)",
  "params": [
   {
    "name": "side",
    "label": "방향 (좌=0, 우=1)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0,
    "step": 1
   },
   {
    "name": "eps",
    "label": "거리 ε",
    "type": "slider",
    "min": 0.01,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "a=2; left_limit=a^2; right_limit=a^2+1; x=a+(side==0?-eps:eps); fval=x<a?x^2:x^2+1; limit_diff=abs(right_limit-left_limit); limit_exists=limit_diff==0?1:0",
  "plot": {
   "range": [
    1,
    3
   ],
   "yRange": [
    0,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x<2 ? x^2 : NaN",
     "label": "좌측 (x<2)",
     "color": "blue"
    },
    {
     "fn": "x>=2 ? x^2+1 : NaN",
     "label": "우측 (x>=2)",
     "color": "red"
    },
    {
     "fn": "4",
     "label": "좌극한 L-",
     "color": "green"
    },
    {
     "fn": "5",
     "label": "우극한 L+",
     "color": "orange"
    }
   ],
   "points": [
    [
     "=x",
     "=fval"
    ]
   ],
   "pointsLabel": "$(x, f(x))$"
  },
  "readout": [
   {
    "label": "x",
    "expr": "x",
    "digits": 3
   },
   {
    "label": "f(x)",
    "expr": "fval",
    "digits": 3
   },
   {
    "label": "좌극한",
    "expr": "left_limit",
    "digits": 3
   },
   {
    "label": "우극한",
    "expr": "right_limit",
    "digits": 3
   },
   {
    "label": "극한 존재?",
    "expr": "limit_exists",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "side": 0,
    "eps": 0.5
   },
   {
    "side": 0,
    "eps": 0.2
   },
   {
    "side": 1,
    "eps": 0.5
   },
   {
    "side": 1,
    "eps": 0.2
   }
  ],
  "invariants": [
   "abs(x - (a + (side == 0 ? -eps : eps)))",
   "abs((side == 0 ? (a - x) : (x - a)) - eps)",
   "abs(left_limit - 4)",
   "abs(right_limit - 5)",
   "abs(fval - (x < a ? x^2 : x^2 + 1))"
  ],
  "oracle": [
   {
    "params": {
     "side": 0,
     "eps": 0.5
    },
    "expect": {
     "x": 1.5,
     "fval": 2.25,
     "left_limit": 4,
     "right_limit": 5
    }
   },
   {
    "params": {
     "side": 1,
     "eps": 0.5
    },
    "expect": {
     "x": 2.5,
     "fval": 7.25,
     "left_limit": 4,
     "right_limit": 5
    }
   }
  ],
  "tol": 0.000001
 }
}