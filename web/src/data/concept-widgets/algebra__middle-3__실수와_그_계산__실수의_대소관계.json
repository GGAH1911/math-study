{
 "id": "algebra/middle-3/실수와_그_계산/실수의_대소관계",
 "spec": {
  "title": "실수의 대소관계",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -1.5,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "diff = a - b; sgn = sign(diff)",
  "geometry": {
   "range": [
    -5.5,
    5.5
   ],
   "yRange": [
    -0.5,
    0.5
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=a",
      0
     ],
     "label": "a"
    },
    {
     "type": "point",
     "at": [
      "=b",
      0
     ],
     "label": "b"
    }
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "b",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "a − b",
    "expr": "diff",
    "digits": 2
   },
   {
    "label": "부호",
    "expr": "sgn",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1.5,
    "b": 2
   },
   {
    "a": 2,
    "b": -1.5
   },
   {
    "a": 1.2,
    "b": 1.2
   },
   {
    "a": -3,
    "b": -3.5
   }
  ],
  "invariants": [
   "(a>b ? 1 : 0) + (a<b ? 1 : 0) + (a==b ? 1 : 0) - 1",
   "sgn - (a>b ? 1 : (a<b ? -1 : 0))",
   "diff - (a - b)"
  ],
  "oracle": [
   {
    "params": {
     "a": -1.5,
     "b": 2
    },
    "expect": {
     "diff": -3.5,
     "sgn": -1
    }
   },
   {
    "params": {
     "a": 2,
     "b": -1.5
    },
    "expect": {
     "diff": 3.5,
     "sgn": 1
    }
   },
   {
    "params": {
     "a": 1.2,
     "b": 1.2
    },
    "expect": {
     "diff": 0,
     "sgn": 0
    }
   }
  ],
  "tol": 0.000001
 }
}