{
 "id": "functions/calculus/수열의_극한/경계값_계산",
 "spec": {
  "title": "수열의 극한과 경계값 (ε-N 정의)",
  "params": [
   {
    "name": "n",
    "label": "n (항 번호)",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 5,
    "step": 1,
    "unit": "번째"
   },
   {
    "name": "eps",
    "label": "ε (허용 오차)",
    "type": "slider",
    "min": 0.02,
    "max": 1,
    "init": 0.3,
    "step": 0.01
   }
  ],
  "scope": "an = 2 + 1/n; L = 2; err = abs(an - L); N = ceil(1/eps)",
  "plot": {
   "range": [
    1,
    40
   ],
   "yRange": [
    0.8,
    3.2
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "2 + 1/x",
     "label": "aₙ = 2 + 1/n",
     "color": "#1f77b4"
    },
    {
     "fn": "2",
     "label": "경계값 L = 2",
     "color": "#000000"
    },
    {
     "fn": "2 + eps",
     "label": "L + ε",
     "color": "#d62728"
    },
    {
     "fn": "2 - eps",
     "label": "L − ε",
     "color": "#d62728"
    }
   ],
   "points": [
    [
     "=n",
     "=an"
    ],
    [
     "=n",
     "=L + eps"
    ],
    [
     "=n",
     "=L - eps"
    ]
   ],
   "pointsLabel": "$(n,\\ a_n),\\ (n,\\ L\\pm\\varepsilon)$"
  },
  "readout": [
   {
    "label": "aₙ (n번째 항)",
    "expr": "an",
    "digits": 4
   },
   {
    "label": "경계값 L",
    "expr": "L",
    "digits": 2
   },
   {
    "label": "오차 |aₙ − L|",
    "expr": "err",
    "digits": 4
   },
   {
    "label": "N (n>N이면 ε-밴드 안)",
    "expr": "N",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "eps": 0.5
   },
   {
    "n": 4,
    "eps": 0.1
   },
   {
    "n": 10,
    "eps": 0.05
   },
   {
    "n": 25,
    "eps": 0.2
   }
  ],
  "invariants": [
   "an - 2 - 1/n",
   "err - 1/n"
  ],
  "oracle": [
   {
    "params": {
     "n": 1,
     "eps": 0.5
    },
    "expect": {
     "an": 3,
     "err": 1,
     "L": 2,
     "N": 2
    }
   },
   {
    "params": {
     "n": 4,
     "eps": 0.1
    },
    "expect": {
     "an": 2.25,
     "err": 0.25,
     "L": 2,
     "N": 10
    }
   },
   {
    "params": {
     "n": 10,
     "eps": 0.05
    },
    "expect": {
     "an": 2.1,
     "err": 0.1,
     "L": 2,
     "N": 20
    }
   }
  ],
  "tol": 0.000001
 }
}