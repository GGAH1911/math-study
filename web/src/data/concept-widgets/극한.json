{
 "id": "극한",
 "spec": {
  "title": "극한의 개념",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "x",
    "type": "slider",
    "min": -1,
    "max": 4.5,
    "init": 1.5,
    "step": 0.01,
    "unit": ""
   },
   {
    "name": "h",
    "label": "h",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "eps",
    "label": "ε",
    "type": "slider",
    "min": 0.1,
    "max": 2,
    "init": 0.5,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "L = 2*a; fx = (x0^2 - a^2)/(x0 - a) + (x0 > a ? h : 0); Lleft = 2*a; Lright = 2*a + h; gap = abs(h); delta = abs(h) < eps ? eps - abs(h) : 0; actual_diff = abs(fx - L); expected_diff = abs(x0 - a); inband = actual_diff < eps ? 1 : 0",
  "plot": {
   "range": [
    -1,
    4.5
   ],
   "yRange": [
    -2,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x + a",
     "range": ["=-1", "=a"],
     "label": "$f(x)\\ (x<a)$",
     "color": "blue"
    },
    {
     "fn": "x + a + h",
     "range": ["=a", "=4.5"],
     "label": "$f(x)\\ (x>a)$",
     "color": "blue"
    },
    {
     "fn": "2*a",
     "label": "$L=2a$",
     "color": "green"
    },
    {
     "fn": "2*a + eps",
     "label": "$L+\\varepsilon$",
     "color": "orange",
     "dashed": true
    },
    {
     "fn": "2*a - eps",
     "label": "$L-\\varepsilon$",
     "color": "orange",
     "dashed": true
    }
   ],
   "points": [
    [
     "=x0",
     "=fx"
    ],
    [
     "=a-delta",
     "=L"
    ],
    [
     "=a+delta",
     "=L"
    ]
   ],
   "pointsLabel": "$(x,f(x))$ 와 $\\delta$ 구간"
  },
  "readout": [
   {
    "label": "x",
    "expr": "x0",
    "digits": 2
   },
   {
    "label": "$f(x)$",
    "expr": "fx",
    "digits": 4
   },
   {
    "label": "좌극한",
    "expr": "Lleft",
    "digits": 3
   },
   {
    "label": "우극한",
    "expr": "Lright",
    "digits": 3
   },
   {
    "label": "$|f(x)-L|$",
    "expr": "actual_diff",
    "digits": 4
   },
   {
    "label": "$\\delta$ (허용 폭)",
    "expr": "delta",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "x0": 0,
    "h": 0,
    "eps": 0.5
   },
   {
    "a": 2,
    "x0": 1.5,
    "h": 0,
    "eps": 0.5
   },
   {
    "a": 2,
    "x0": 2.5,
    "h": 1,
    "eps": 0.5
   },
   {
    "a": 0.5,
    "x0": 1.5,
    "h": -1,
    "eps": 1.5
   }
  ],
  "invariants": [
   "abs(Lright - Lleft - h)",
   "abs(L - 2*a)",
   "abs(fx - (x0 + a + (x0 > a ? h : 0)))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "x0": 0,
     "h": 0,
     "eps": 0.5
    },
    "expect": {
     "fx": 1,
     "L": 2,
     "Lleft": 2,
     "Lright": 2,
     "actual_diff": 1,
     "delta": 0.5
    }
   },
   {
    "params": {
     "a": 2,
     "x0": 1.5,
     "h": 0,
     "eps": 0.5
    },
    "expect": {
     "fx": 3.5,
     "L": 4,
     "Lleft": 4,
     "Lright": 4,
     "actual_diff": 0.5,
     "delta": 0.5
    }
   },
   {
    "params": {
     "a": 2,
     "x0": 2.5,
     "h": 1,
     "eps": 0.5
    },
    "expect": {
     "fx": 5.5,
     "L": 4,
     "Lleft": 4,
     "Lright": 5,
     "actual_diff": 1.5,
     "delta": 0
    }
   },
   {
    "params": {
     "a": 0.5,
     "x0": 1.5,
     "h": -1,
     "eps": 1.5
    },
    "expect": {
     "fx": 1,
     "L": 1,
     "Lleft": 1,
     "Lright": 0,
     "actual_diff": 0,
     "delta": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}
