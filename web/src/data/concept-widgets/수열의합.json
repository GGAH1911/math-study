{
 "id": "수열의합",
 "spec": {
  "title": "수열의 합",
  "params": [
   {
    "name": "n",
    "label": "항 수 n",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 5,
    "step": 1
   },
   {
    "name": "a",
    "label": "첫째 항 a",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 1,
    "step": 1
   },
   {
    "name": "d",
    "label": "공차 d",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 0.5
   }
  ],
  "scope": "last=a+(n-1)*d; Sn=n/2*(2*a+(n-1)*d)",
  "plot": {
   "range": [
    0,
    10
   ],
   "yRange": [
    0,
    150
   ],
   "fns": [
    {
     "fn": "min(floor(x),n)/2 * (2*a + (min(floor(x),n)-1)*d)",
     "label": "누적합 S_k",
     "color": "blue"
    }
   ],
   "points": [
    [
     "=n",
     "=Sn"
    ]
   ],
   "pointsLabel": "$S_n$"
  },
  "readout": [
   {
    "label": "S_n (수열의 합)",
    "expr": "Sn",
    "digits": 4
   },
   {
    "label": "마지막 항 a_n",
    "expr": "last",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 3,
    "a": 1,
    "d": 1
   },
   {
    "n": 5,
    "a": 2,
    "d": 0.5
   },
   {
    "n": 10,
    "a": 3,
    "d": 2
   },
   {
    "n": 1,
    "a": 4,
    "d": 1
   }
  ],
  "invariants": [
   "Sn - n*(a+last)/2"
  ],
  "oracle": [
   {
    "params": {
     "n": 3,
     "a": 1,
     "d": 1
    },
    "expect": {
     "Sn": 6,
     "last": 3
    }
   },
   {
    "params": {
     "n": 4,
     "a": 2,
     "d": 0.5
    },
    "expect": {
     "Sn": 11,
     "last": 3.5
    }
   },
   {
    "params": {
     "n": 1,
     "a": 5,
     "d": 2
    },
    "expect": {
     "Sn": 5,
     "last": 5
    }
   }
  ],
  "tol": 0.000001
 }
}