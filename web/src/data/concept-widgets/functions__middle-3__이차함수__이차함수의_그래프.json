{
 "id": "functions/middle-3/이차함수/이차함수의_그래프",
 "spec": {
  "title": "이차함수의 그래프 y = ax² + bx + c",
  "params": [
   {
    "name": "a",
    "label": "a (볼록·폭)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "vx = -b/(2*a); vy = a*vx^2 + b*vx + c; disc = b^2 - 4*a*c",
  "plot": {
   "range": [
    -8,
    8
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "y = ax²+bx+c",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "꼭짓점 x = -b/2a",
    "expr": "vx",
    "digits": 3
   },
   {
    "label": "꼭짓점 y (최댓·최솟값)",
    "expr": "vy",
    "digits": 3
   },
   {
    "label": "판별식 b²-4ac",
    "expr": "disc",
    "digits": 3
   },
   {
    "label": "볼록 방향 (a>0 아래로 볼록)",
    "expr": "a",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": 0
   },
   {
    "a": 1,
    "b": -2,
    "c": 1
   },
   {
    "a": -2,
    "b": 4,
    "c": 1
   },
   {
    "a": 0.5,
    "b": 3,
    "c": -1
   }
  ],
  "invariants": [
   "a*vx^2 + b*vx + c - vy",
   "2*a*vx + b",
   "disc - (b^2 - 4*a*c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 0
    },
    "expect": {
     "vx": 0,
     "vy": 0,
     "disc": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": -2,
     "c": 1
    },
    "expect": {
     "vx": 1,
     "vy": 0,
     "disc": 0
    }
   },
   {
    "params": {
     "a": -2,
     "b": 4,
     "c": 1
    },
    "expect": {
     "vx": 1,
     "vy": 3,
     "disc": 24
    }
   }
  ],
  "tol": 0.000001
 }
}