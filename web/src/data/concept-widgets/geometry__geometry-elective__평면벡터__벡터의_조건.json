{
 "id": "geometry/geometry-elective/평면벡터/벡터의_조건",
 "spec": {
  "title": "벡터가 같을 조건: 성분이 모두 일치",
  "params": [
   {
    "name": "a1",
    "label": "a₁ (a의 x성분)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 1
   },
   {
    "name": "a2",
    "label": "a₂ (a의 y성분)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 1
   },
   {
    "name": "b1",
    "label": "b₁ (b의 x성분)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 1
   },
   {
    "name": "b2",
    "label": "b₂ (b의 y성분)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -2,
    "step": 1
   }
  ],
  "scope": "dx=b1-a1; dy=b2-a2; dist=sqrt(dx^2+dy^2); mag_a=sqrt(a1^2+a2^2); mag_b=sqrt(b1^2+b2^2)",
  "geometry": {
   "range": [
    -5.5,
    5.5
   ],
   "yRange": [
    -5.5,
    5.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a1",
      "=a2"
     ],
     "label": "a",
     "color": "#e11"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=b1",
      "=b2"
     ],
     "label": "b",
     "color": "#17a"
    },
    {
     "type": "point",
     "at": [
      "=a1",
      "=a2"
     ],
     "label": "(a₁,a₂)",
     "color": "#e11"
    },
    {
     "type": "point",
     "at": [
      "=b1",
      "=b2"
     ],
     "label": "(b₁,b₂)",
     "color": "#17a"
    }
   ]
  },
  "readout": [
   {
    "label": "x성분 차 a₁−b₁",
    "expr": "a1-b1",
    "digits": 0
   },
   {
    "label": "y성분 차 a₂−b₂",
    "expr": "a2-b2",
    "digits": 0
   },
   {
    "label": "두 끝점 거리 |a−b| (0이면 같은 벡터)",
    "expr": "dist",
    "digits": 4
   },
   {
    "label": "|a|",
    "expr": "mag_a",
    "digits": 4
   },
   {
    "label": "|b|",
    "expr": "mag_b",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a1": 3,
    "a2": 2,
    "b1": 3,
    "b2": 2
   },
   {
    "a1": 3,
    "a2": 2,
    "b1": 3,
    "b2": -2
   },
   {
    "a1": -1,
    "a2": 4,
    "b1": 2,
    "b2": 2
   },
   {
    "a1": 0,
    "a2": 0,
    "b1": 5,
    "b2": 5
   }
  ],
  "invariants": [
   "mag_a^2 - (a1^2+a2^2)",
   "mag_b^2 - (b1^2+b2^2)",
   "dist^2 - ((b1-a1)^2+(b2-a2)^2)",
   "dx - (b1-a1)",
   "dy - (b2-a2)"
  ],
  "oracle": [
   {
    "params": {
     "a1": 3,
     "a2": 2,
     "b1": 3,
     "b2": 2
    },
    "expect": {
     "dx": 0,
     "dy": 0,
     "dist": 0,
     "mag_a": 3.605551275,
     "mag_b": 3.605551275
    }
   },
   {
    "params": {
     "a1": 3,
     "a2": 2,
     "b1": 3,
     "b2": -2
    },
    "expect": {
     "dx": 0,
     "dy": -4,
     "dist": 4,
     "mag_a": 3.605551275
    }
   },
   {
    "params": {
     "a1": -1,
     "a2": 4,
     "b1": 2,
     "b2": 2
    },
    "expect": {
     "dx": 3,
     "dy": -2,
     "dist": 3.605551275,
     "mag_a": 4.123105626
    }
   }
  ],
  "tol": 0.000001
 }
}