{
 "id": "근의_개수",
 "spec": {
  "title": "근의 개수",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": -2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "D=b^2-4*a*c; cnt = D > 0 ? 2 : (D == 0 ? 1 : 0)",
  "plot": {
   "range": [
    -10,
    10
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^2+b*x+c",
     "label": "y = ax² + bx + c",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D",
    "expr": "D",
    "digits": 2
   },
   {
    "label": "실근의 개수",
    "expr": "cnt",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": -3,
    "c": 2
   },
   {
    "a": 1,
    "b": 2,
    "c": 1
   },
   {
    "a": 1,
    "b": 0,
    "c": 1
   },
   {
    "a": 2,
    "b": -4,
    "c": 1
   }
  ],
  "invariants": [
   "D - (b^2 - 4*a*c)",
   "(cnt == 2 ? (D > 0 ? 0 : 1) : (cnt == 1 ? (D == 0 ? 0 : 1) : (D < 0 ? 0 : 1)))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": -3,
     "c": 2
    },
    "expect": {
     "D": 1,
     "cnt": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 1
    },
    "expect": {
     "D": 0,
     "cnt": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 1
    },
    "expect": {
     "D": -4,
     "cnt": 0
    }
   }
  ],
  "tol": 0.000001
 }
}