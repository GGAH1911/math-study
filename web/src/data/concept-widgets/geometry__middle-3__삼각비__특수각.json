{
 "id": "geometry/middle-3/삼각비/특수각",
 "spec": {
  "title": "특수각의 삼각비 (30°·45°·60°)",
  "params": [
   {
    "name": "theta",
    "label": "각도 θ",
    "type": "slider",
    "min": 30,
    "max": 60,
    "init": 30,
    "step": 15,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; cx=cos(rad); sy=sin(rad); ty=tan(rad)",
  "geometry": {
   "range": [
    -1.4,
    1.4
   ],
   "yRange": [
    -1.4,
    1.4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1,
     "color": "#bbbbbb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ],
     "color": "#333333",
     "label": "r=1"
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      "=sy"
     ],
     "to": [
      "=cx",
      0
     ],
     "color": "#e8483c",
     "label": "sin"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      0
     ],
     "color": "#2c7be5",
     "label": "cos"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "cos θ",
    "expr": "cx",
    "digits": 4
   },
   {
    "label": "tan θ",
    "expr": "ty",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 30
   },
   {
    "theta": 45
   },
   {
    "theta": 60
   }
  ],
  "invariants": [
   "cx^2+sy^2-1",
   "ty-sy/cx"
  ],
  "oracle": [
   {
    "params": {
     "theta": 30
    },
    "expect": {
     "cx": 0.8660254037844386,
     "sy": 0.5,
     "ty": 0.5773502691896257
    }
   },
   {
    "params": {
     "theta": 45
    },
    "expect": {
     "cx": 0.7071067811865476,
     "sy": 0.7071067811865476,
     "ty": 1
    }
   },
   {
    "params": {
     "theta": 60
    },
    "expect": {
     "cx": 0.5,
     "sy": 0.8660254037844386,
     "ty": 1.7320508075688772
    }
   }
  ],
  "tol": 0.000001
 }
}