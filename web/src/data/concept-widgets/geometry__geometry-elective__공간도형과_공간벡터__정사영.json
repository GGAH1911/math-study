{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/정사영",
 "spec": {
  "title": "정사영 — 벡터 a를 b 방향으로 투영",
  "params": [
   {
    "name": "ax",
    "label": "a_x",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "ay",
    "label": "a_y",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "bt",
    "label": "b 방향각 β",
    "type": "slider",
    "min": 0,
    "max": 180,
    "init": 0,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "bx=cos(bt*pi/180); by=sin(bt*pi/180); dot=ax*bx+ay*by; px=dot*bx; py=dot*by; comp=dot",
  "geometry": {
   "range": [
    -3.6,
    3.6
   ],
   "yRange": [
    -3.6,
    3.6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=-4*bx",
      "=-4*by"
     ],
     "to": [
      "=4*bx",
      "=4*by"
     ],
     "color": "#bbb",
     "label": "b방향"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=ax",
      "=ay"
     ],
     "color": "#1e66f5",
     "label": "a"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ],
     "color": "#e64553",
     "label": "proj_b a"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=px",
      "=py"
     ],
     "color": "#40a02b",
     "label": "수선"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P'"
    }
   ]
  },
  "readout": [
   {
    "label": "a·b",
    "expr": "dot",
    "digits": 3
   },
   {
    "label": "스칼라성분 comp_b a",
    "expr": "comp",
    "digits": 3
   },
   {
    "label": "|proj_b a|",
    "expr": "abs(comp)",
    "digits": 3
   },
   {
    "label": "수선⊥b 내적",
    "expr": "(ax-px)*bx+(ay-py)*by",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "ax": 2,
    "ay": 3,
    "bt": 0
   },
   {
    "ax": 2,
    "ay": 3,
    "bt": 90
   },
   {
    "ax": 2,
    "ay": 2,
    "bt": 45
   },
   {
    "ax": -3,
    "ay": 1,
    "bt": 120
   }
  ],
  "invariants": [
   "bx^2+by^2-1",
   "px*by-py*bx",
   "(ax-px)*bx+(ay-py)*by",
   "comp-dot"
  ],
  "oracle": [
   {
    "params": {
     "ax": 2,
     "ay": 3,
     "bt": 0
    },
    "expect": {
     "bx": 1,
     "by": 0,
     "dot": 2,
     "px": 2,
     "py": 0,
     "comp": 2
    }
   },
   {
    "params": {
     "ax": 2,
     "ay": 3,
     "bt": 90
    },
    "expect": {
     "dot": 3,
     "px": 0,
     "py": 3,
     "comp": 3
    }
   },
   {
    "params": {
     "ax": 2,
     "ay": 2,
     "bt": 45
    },
    "expect": {
     "dot": 2.828427124746,
     "px": 2,
     "py": 2,
     "comp": 2.828427124746
    }
   }
  ],
  "tol": 0.000001
 }
}