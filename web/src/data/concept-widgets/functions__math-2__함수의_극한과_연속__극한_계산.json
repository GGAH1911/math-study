{
 "id": "functions/math-2/함수의_극한과_연속/극한_계산",
 "spec": {
  "title": "극한 계산: 0/0 부정형의 인수분해 — lim_{x→a} (x²−a²)/(x−a)",
  "params": [
   {
    "name": "a",
    "label": "a (가까워지는 점)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "L = 2*a; xn = a + 0.001; fxn = (xn^2 - a^2)/(xn - a)",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "(x^2 - a^2)/(x - a)",
     "label": "f(x)=(x²−a²)/(x−a)  (x=a에서 0/0)",
     "color": "#2563eb"
    },
    {
     "fn": "2*a",
     "label": "극한값 y=2a",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극한값 L = lim_{x→a} f(x) = 2a",
    "expr": "L",
    "digits": 3
   },
   {
    "label": "f(a+0.001) → L 수렴 확인",
    "expr": "fxn",
    "digits": 4
   },
   {
    "label": "a (대입하면 분모=0, 분자=0 부정형)",
    "expr": "a",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": 2
   },
   {
    "a": -1
   },
   {
    "a": 0.5
   }
  ],
  "invariants": [
   "fxn - (xn + a)",
   "L - (a + a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "L": 2,
     "fxn": 2.001
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "L": 4,
     "fxn": 4.001
    }
   },
   {
    "params": {
     "a": -1
    },
    "expect": {
     "L": -2,
     "fxn": -1.999
    }
   }
  ],
  "tol": 0.000001
 }
}