{
 "id": "다항함수_결정",
 "spec": {
  "title": "다항함수 결정 – 적분 조건으로 계수 찾기",
  "params": [
   {
    "name": "a",
    "label": "a (x³의 계수)",
    "type": "slider",
    "min": 0,
    "max": 16,
    "init": 4,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "b=2-a; integral=a/4+(2-a)/3+1; error=integral-1",
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    -2,
    4
   ],
   "fns": [
    {
     "fn": "a*x^3+b*x^2+1",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "∫₀¹ f(x)dx",
    "expr": "integral",
    "digits": 4
   },
   {
    "label": "오차 (적분값−1)",
    "expr": "error",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0
   },
   {
    "a": 4
   },
   {
    "a": 8
   },
   {
    "a": 12
   }
  ],
  "invariants": [
   "b-(2-a)",
   "a+b+1-3"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "integral": 1.6666666666666667
    }
   },
   {
    "params": {
     "a": 4
    },
    "expect": {
     "integral": 1.3333333333333333
    }
   },
   {
    "params": {
     "a": 8
    },
    "expect": {
     "integral": 1
    }
   }
  ],
  "tol": 0.000001
 }
}