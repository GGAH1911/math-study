{
 "id": "geometry/high-1/도형의_방정식/축_대칭",
 "spec": {
  "title": "축 대칭 — 함수 그래프의 x축·y축 대칭이동",
  "params": [
   {
    "name": "a",
    "label": "a (이차항 계수)",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (일차항 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "p (표본점의 x좌표)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "px = p; py = a*p^2 + b*p; qx = p; qy = -(a*p^2 + b*p); rx = -p; ry = a*p^2 + b*p",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -9,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^2 + b*x",
     "label": "y=f(x) 원본",
     "color": "#2563eb"
    },
    {
     "fn": "-(a*x^2 + b*x)",
     "label": "y=-f(x) : x축 대칭",
     "color": "#dc2626"
    },
    {
     "fn": "a*x^2 - b*x",
     "label": "y=f(-x) : y축 대칭",
     "color": "#16a34a"
    }
   ],
   "points": [
    [
     "=px",
     "=py"
    ],
    [
     "=qx",
     "=qy"
    ],
    [
     "=rx",
     "=ry"
    ]
   ],
   "pointsLabel": "$P(p,f(p)),\\ Q(p,-f(p)),\\ R(-p,f(p))$"
  },
  "readout": [
   {
    "label": "원본 P=(p, f(p)) 의 y좌표",
    "expr": "py",
    "digits": 3
   },
   {
    "label": "x축대칭 Q 의 y좌표 (부호반전 → -f(p))",
    "expr": "qy",
    "digits": 3
   },
   {
    "label": "y축대칭 R 의 x좌표 (부호반전 → -p)",
    "expr": "rx",
    "digits": 3
   },
   {
    "label": "y축대칭 곡선값 f(-p) = a·p²-b·p",
    "expr": "a*p^2 - b*p",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "p": 1
   },
   {
    "a": 0.5,
    "b": 1,
    "p": 2
   },
   {
    "a": -1,
    "b": 1,
    "p": -1
   },
   {
    "a": 1.5,
    "b": -2,
    "p": 0.5
   }
  ],
  "invariants": [
   "qx - px",
   "qy + py",
   "rx + px",
   "ry - py"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2,
     "p": 1
    },
    "expect": {
     "px": 1,
     "py": 3,
     "qx": 1,
     "qy": -3,
     "rx": -1,
     "ry": 3
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 1,
     "p": 2
    },
    "expect": {
     "px": 2,
     "py": 4,
     "qx": 2,
     "qy": -4,
     "rx": -2,
     "ry": 4
    }
   },
   {
    "params": {
     "a": -1,
     "b": 1,
     "p": -1
    },
    "expect": {
     "px": -1,
     "py": -2,
     "qx": -1,
     "qy": 2,
     "rx": 1,
     "ry": -2
    }
   }
  ],
  "tol": 0.000001
 }
}