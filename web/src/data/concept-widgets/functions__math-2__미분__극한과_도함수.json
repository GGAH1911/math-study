{
 "id": "functions/math-2/미분/극한과_도함수",
 "spec": {
  "title": "극한과 도함수: 할선이 접선으로 (f(x)=x²)",
  "params": [
   {
    "name": "a",
    "label": "접점 x=a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "h",
    "label": "증분 h (0으로 보내보기)",
    "type": "slider",
    "min": 0.01,
    "max": 2,
    "init": 1,
    "step": 0.01,
    "unit": ""
   }
  ],
  "scope": "fa = a^2; fah = (a+h)^2; slope = (fah - fa)/h; dslope = 2*a",
  "geometry": {
   "range": [
    -2.5,
    3.5
   ],
   "yRange": [
    -1.5,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=a",
      "=fa"
     ],
     "label": "P(a, f(a))"
    },
    {
     "type": "point",
     "at": [
      "=a+h",
      "=fah"
     ],
     "label": "Q(a+h, f(a+h))"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      "=fa"
     ],
     "to": [
      "=a+h",
      "=fah"
     ],
     "label": "할선"
    }
   ]
  },
  "plot": {
   "range": [
    -2.5,
    3.5
   ],
   "yRange": [
    -1.5,
    9
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#333333"
    },
    {
     "fn": "fa + slope*(x-a)",
     "label": "할선(평균변화율)",
     "color": "#e6552e"
    },
    {
     "fn": "fa + dslope*(x-a)",
     "label": "접선 f'(a)",
     "color": "#2a9d5c"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f(a+h)",
    "expr": "fah",
    "digits": 3
   },
   {
    "label": "평균변화율 (할선 기울기) = (f(a+h)-f(a))/h",
    "expr": "slope",
    "digits": 4
   },
   {
    "label": "순간변화율 f'(a) (접선 기울기) = 2a",
    "expr": "dslope",
    "digits": 4
   },
   {
    "label": "할선-접선 오차 (= h)",
    "expr": "abs(slope-dslope)",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "h": 1
   },
   {
    "a": 2,
    "h": 0.5
   },
   {
    "a": -1,
    "h": 1
   },
   {
    "a": 0.5,
    "h": 0.01
   }
  ],
  "invariants": [
   "fah - (a+h)^2",
   "fa - a^2",
   "slope - (fah - fa)/h",
   "slope - (2*a + h)",
   "dslope - 2*a",
   "slope - dslope - h"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "h": 1
    },
    "expect": {
     "fa": 1,
     "fah": 4,
     "slope": 3,
     "dslope": 2
    }
   },
   {
    "params": {
     "a": 2,
     "h": 0.5
    },
    "expect": {
     "fa": 4,
     "fah": 6.25,
     "slope": 4.5,
     "dslope": 4
    }
   },
   {
    "params": {
     "a": -1,
     "h": 1
    },
    "expect": {
     "fa": 1,
     "fah": 0,
     "slope": -1,
     "dslope": -2
    }
   }
  ],
  "tol": 0.000001
 }
}