    "init": 40,
    "step": 1
   }
  ],
  "scope": "c=sqrt(a^2-b^2); rad=t*pi/180; px=a*cos(rad); py=b*sin(rad); d1=sqrt((px-c)^2+py^2); d2=sqrt((px+c)^2+py^2); focalSum=d1+d2",
