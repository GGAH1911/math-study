 "spec": {
  "title": "타원의 표준형 x²/a² + y²/b² = 1 (a>b)",
  "params": [
   {
    "name": "a",
    "label": "a (장축 반길이)",
    "type": "slider",
    "min": 3,
    "max": 5,
    "init": 5,
    "step": 0.1
