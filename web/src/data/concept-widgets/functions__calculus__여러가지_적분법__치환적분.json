{
 "id": "functions/calculus/여러가지_적분법/치환적분",
 "spec": {
  "title": "치환적분: ∫₀ᵇ f(g(x))g′(x)dx = ∫_{g(0)}^{g(b)} f(u)du — g(x)=k·xⁿ+c 를 직접 바꿔보기 (f(u)=cos u 고정)",
  "params": [
   {
    "name": "b",
    "label": "적분 상한 b",
    "type": "slider",
    "min": 0,
    "max": 2.5,
    "init": 1.2,
    "step": 0.05
   },
   {
    "name": "k",
    "label": "치환 계수 k (g=k·xⁿ+c)",
    "type": "slider",
    "min": 0.3,
    "max": 1.0,
    "init": 1,
    "step": 0.05
   },
   {
    "name": "n",
    "label": "차수 n (1=선형치환, 2=이차치환)",
    "type": "slider",
    "min": 1,
    "max": 2,
    "init": 2,
    "step": 1
   },
   {
    "name": "c",
    "label": "상수 c (u 하한 = g(0) = c)",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "g0 = c; gb = k*b^n + c; gp = k*n*b^(n-1); fgb = cos(gb); hb = fgb*gp; Ax = sin(gb) - sin(c); Au = sin(gb) - sin(c); dA = Ax - Au; xm1 = min(2.5, ((pi - c)/k)^(1/n)); xm2 = min(2.5, ((2*pi - c)/k)^(1/n)); xm3 = min(2.5, ((3*pi - c)/k)^(1/n))",
  "plot": {
   "range": [
    0,
    2.5
   ],
   "yRange": [
    -5.2,
    5.2
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "k*n*x^(n-1)*cos(k*x^n+c)",
     "label": "$f(g(x))\\,g'(x)$ 실제 피적분함수",
     "color": "#2563eb"
    },
    {
     "fn": "cos(k*x^n+c)",
     "label": "$f(g(x))=\\cos g(x)$ 겉함수 부분",
     "color": "#16a34a",
     "dashed": true
    },
    {
     "fn": "k*n*x^(n-1)",
     "label": "$g'(x)$ 치환의 늘림 배율",
     "color": "#f59e0b",
     "dashed": true
    },
    {
     "fn": "sin(k*x^n+c) - sin(c)",
     "label": "$\\int_0^x f(g(t))g'(t)\\,dt$ 누적 넓이",
     "color": "#dc2626"
    }
   ],
   "roots": [
    {
     "fn": "k*n*x^(n-1)*cos(k*x^n+c)",
     "in": [
      "=0.02",
      "=xm1"
     ],
     "label": "$f(g(x))g'(x)=0$ (누적 넓이의 극점)"
    },
    {
     "fn": "k*n*x^(n-1)*cos(k*x^n+c)",
     "in": [
      "=xm1",
      "=xm2"
     ],
     "label": "$f(g(x))g'(x)=0$ (누적 넓이의 극점)"
    },
    {
     "fn": "k*n*x^(n-1)*cos(k*x^n+c)",
     "in": [
      "=xm2",
      "=xm3"
     ],
     "label": "$f(g(x))g'(x)=0$ (누적 넓이의 극점)"
    }
   ],
