{
 "id": "functions/math-2/미분/그래프_분석",
 "spec": {
  "title": "그래프 분석: 도함수로 보는 증감·극값·변곡점",
  "params": [
   {
    "name": "t",
    "label": "점의 x좌표",
    "type": "slider",
    "min": -2.2,
    "max": 2.2,
    "init": -1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "ft = t^3 - 3*t; d1 = 3*t^2 - 3; d2 = 6*t",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -9,
    9
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x",
     "label": "f(x)=x³-3x",
     "color": "#1f77b4"
    },
    {
     "fn": "3*x^2 - 3",
     "label": "f'(x) (증감 부호)",
     "color": "#2ca02c"
    },
    {
     "fn": "ft + d1*(x - t)",
     "label": "x=t에서의 접선",
     "color": "#d62728"
    }
   ]
  },
  "readout": [
   {
    "label": "x = t",
    "expr": "t",
    "digits": 3
   },
   {
    "label": "f(t) (점의 높이)",
    "expr": "ft",
    "digits": 3
   },
   {
    "label": "f'(t) = 접선 기울기",
    "expr": "d1",
    "digits": 3
   },
   {
    "label": "증가(+1)/감소(-1)",
    "expr": "sign(d1)",
    "digits": 0
   },
   {
    "label": "f''(t)",
    "expr": "d2",
    "digits": 3
   },
   {
    "label": "아래로볼록(+1)/위로볼록(-1)",
    "expr": "sign(d2)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "t": -1
   },
   {
    "t": 0
   },
   {
    "t": 1
   },
   {
    "t": 1.5
   }
  ],
  "invariants": [
   "t*d1 - 3*ft - d2",
   "2*d1 - t*d2 + 6"
  ],
  "oracle": [
   {
    "params": {
     "t": -1
    },
    "expect": {
     "ft": 2,
     "d1": 0,
     "d2": -6
    }
   },
   {
    "params": {
     "t": 0
    },
    "expect": {
     "ft": 0,
     "d1": -3,
     "d2": 0
    }
   },
   {
    "params": {
     "t": 1
    },
    "expect": {
     "ft": -2,
     "d1": 0,
     "d2": 6
    }
   }
  ],
  "tol": 0.000001
 }
}