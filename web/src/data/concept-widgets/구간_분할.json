{
 "id": "구간_분할",
 "spec": {
  "title": "구간 분할",
  "params": [
   {
    "name": "n",
    "label": "부분 구간 수",
    "type": "slider",
    "min": 1,
    "max": 50,
    "init": 5,
    "step": 1,
    "unit": "개"
   }
  ],
  "scope": "dx=1/n; left_sum=(1/n^3)*((n-1)*n*(2*n-1)/6); integral=1/3; error=abs(left_sum-integral)",
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1.1
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x) = x²",
     "color": "blue"
    },
    {
     "fn": "(min(floor(x*n), n-1)/n)^2",
     "label": "왼쪽 리만 근사",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "구간 폭",
    "expr": "dx",
    "digits": 4
   },
   {
    "label": "왼쪽 리만 합",
    "expr": "left_sum",
    "digits": 6
   },
   {
    "label": "정적분",
    "expr": "integral",
    "digits": 6
   },
   {
    "label": "오차",
    "expr": "error",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 2
   },
   {
    "n": 5
   },
   {
    "n": 10
   }
  ],
  "invariants": [
   "n*dx-1"
  ],
  "oracle": [
   {
    "params": {
     "n": 2
    },
    "expect": {
     "dx": 0.5,
     "left_sum": 0.125,
     "integral": 0.3333333333333333,
     "error": 0.20833333333333334
    }
   },
   {
    "params": {
     "n": 5
    },
    "expect": {
     "dx": 0.2,
     "left_sum": 0.24,
     "integral": 0.3333333333333333,
     "error": 0.0933333333333333
    }
   },
   {
    "params": {
     "n": 10
    },
    "expect": {
     "dx": 0.1,
     "left_sum": 0.285,
     "integral": 0.3333333333333333,
     "error": 0.0483333333333333
    }
   }
  ],
  "tol": 0.000001
 }
}