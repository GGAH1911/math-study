    "min": 0,
    "max": 360,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=t*pi/180; Px=5*cos(rad); Py=4*sin(rad); Tx=-5*sin(rad); Ty=4*cos(rad); Tn=sqrt(Tx^2+Ty^2); thx=Tx/Tn; thy=Ty/Tn; d1x=3-Px; d1y=-Py; L1=sqrt(d1x^2+d1y^2); ux=d1x/L1; uy=d1y/L1; d2x=-3-Px; d2y=-Py; L2=sqrt(d2x^2+d2y^2); u2x=d2x/L2; u2y=d2y/L2; dot1=thx*ux+thy*uy; dot2=thx*u2x+thy*u2y; bisect=dot1+dot2; sumL=L1+L2; ang1=acos(abs(dot1))*180/pi; ang2=acos(abs(dot2))*180/pi; tex1=Px+5*thx; tey1=Py+5*thy; tex2=Px-5*thx; tey2=Py-5*thy",
