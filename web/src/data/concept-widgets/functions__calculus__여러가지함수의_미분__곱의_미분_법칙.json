{
 "id": "functions/calculus/여러가지함수의_미분/곱의_미분_법칙",
 "spec": {
  "title": "곱의 미분 법칙: f(x)=x²·sin x 의 접선 기울기",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (미분하는 점)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "u = x0^2; v = sin(x0); du = 2*x0; dv = cos(x0); termA = du*v; termB = u*dv; f = u*v; slope = termA + termB; naive = du*dv",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "x^2*sin(x)",
     "label": "f = x²·sin x",
     "color": "#2563eb"
    },
    {
     "fn": "f + slope*(x - x0)",
     "label": "접선 (기울기 = u'v + uv')",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(x₀) = u·v",
    "expr": "f",
    "digits": 4
   },
   {
    "label": "u'·v (u가 변해 생긴 변화)",
    "expr": "termA",
    "digits": 4
   },
   {
    "label": "u·v' (v가 변해 생긴 변화)",
    "expr": "termB",
    "digits": 4
   },
   {
    "label": "(uv)' = u'v + uv'",
    "expr": "slope",
    "digits": 4
   },
   {
    "label": "틀린 계산 u'·v'",
    "expr": "naive",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 0.5
   },
   {
    "x0": 1.3
   },
   {
    "x0": -2
   },
   {
    "x0": 2.5
   }
  ],
  "invariants": [
   "slope - (2*x0*sin(x0) + x0^2*cos(x0))",
   "f - x0^2*sin(x0)",
   "slope - termA - termB",
   "f - u*v"
  ],
  "oracle": [
   {
    "params": {
     "x0": 0
    },
    "expect": {
     "f": 0,
     "termA": 0,
     "termB": 0,
     "slope": 0
    }
   },
   {
    "params": {
     "x0": 1
    },
    "expect": {
     "f": 0.8414709848,
     "termA": 1.6829419696,
     "termB": 0.5403023059,
     "slope": 2.2232442755
    }
   },
   {
    "params": {
     "x0": 1.5707963268
    },
    "expect": {
     "f": 2.4674011003,
     "termB": 0,
     "slope": 3.1415926536
    }
   }
  ],
  "tol": 0.000001
 }
}