{
 "id": "functions/middle-3/이차함수/매개변수의_범위",
 "spec": {
  "title": "매개변수의 범위 — f(x)=x²-ax+3 이 항상 양수일 조건",
  "params": [
   {
    "name": "a",
    "label": "a (매개변수)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "D = a^2 - 12; vx = a/2; vy = 3 - a^2/4",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -3,
    13
   ],
   "fns": [
    {
     "fn": "x^2 - a*x + 3",
     "label": "f(x)=x²-ax+3",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = a²-12",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "꼭짓점 x = a/2",
    "expr": "vx",
    "digits": 3
   },
   {
    "label": "최솟값 f(a/2) = 3 - a²/4",
    "expr": "vy",
    "digits": 3
   },
   {
    "label": "항상 양수?(1=예)",
    "expr": "vy > 0 ? 1 : 0",
    "digits": 0
   },
   {
    "label": "경계값 ±2√3",
    "expr": "2*sqrt(3)",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0
   },
   {
    "a": 2
   },
   {
    "a": 4
   },
   {
    "a": -3.4641016151
   }
  ],
  "invariants": [
   "D + 4*vy",
   "vx^2 - a*vx + 3 - vy",
   "vy - (3 - a^2/4)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "D": -12,
     "vx": 0,
     "vy": 3
    }
   },
   {
    "params": {
     "a": 4
    },
    "expect": {
     "D": 4,
     "vx": 2,
     "vy": -1
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "D": -8,
     "vx": 1,
     "vy": 2
    }
   }
  ],
  "tol": 0.000001
 }
}