{
 "id": "functions/high-1/함수와_그래프/매개변수",
 "spec": {
  "title": "매개변수: 원 위를 움직이는 점 (x=cos t, y=sin t)",
  "params": [
   {
    "name": "t",
    "label": "t (매개변수, 각도)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=t*pi/180; px=cos(rad); py=sin(rad)",
  "geometry": {
   "range": [
    -1.5,
    1.5
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=px",
      0
     ]
    },
    {
     "type": "segment",
     "from": [
      "=px",
      0
     ],
     "to": [
      0,
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P(cos t, sin t)"
    },
    {
     "type": "point",
     "at": [
      "=px",
      0
     ],
     "label": "x=cos t"
    },
    {
     "type": "point",
     "at": [
      0,
      "=py"
     ],
     "label": "y=sin t"
    }
   ]
  },
  "readout": [
   {
    "label": "x = cos t",
    "expr": "px",
    "digits": 4
   },
   {
    "label": "y = sin t",
    "expr": "py",
    "digits": 4
   },
   {
    "label": "x²+y² (항상 1)",
    "expr": "px^2+py^2",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "t": 0
   },
   {
    "t": 90
   },
   {
    "t": 180
   },
   {
    "t": 30
   }
  ],
  "invariants": [
   "px^2+py^2-1"
  ],
  "oracle": [
   {
    "params": {
     "t": 0
    },
    "expect": {
     "px": 1,
     "py": 0
    }
   },
   {
    "params": {
     "t": 90
    },
    "expect": {
     "px": 0,
     "py": 1
    }
   },
   {
    "params": {
     "t": 30
    },
    "expect": {
     "px": 0.8660254037844387,
     "py": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}