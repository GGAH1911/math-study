  "readout": [
   {
    "label": "P(X=0)",
    "expr": "p0",
    "digits": 4
   },
   {
    "label": "P(X=1)",
    "expr": "p1",
    "digits": 4
   },
   {
    "label": "확률 합계",
    "expr": "total",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1
   },
   {
    "n": 2
   },
   {
    "n": 3
   },
   {
    "n": 5
   }
  ],
  "invariants": [
   "total-1",
   "p0-0.5^n"
  ],
  "oracle": [
   {
    "params": {
     "n": 1
    },
    "expect": {
     "p0": 0.5,
     "p1": 0.5,
     "total": 1
    }
   },
   {
    "params": {
