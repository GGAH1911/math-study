{
 "id": "probability-stats/prob-stats-elective/통계/이산확률변수",
 "spec": {
  "title": "이산확률변수의 확률질량함수 (동전 던지기)",
  "params": [
   {
    "name": "n",
    "label": "동전 던지는 횟수 n",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 5,
    "step": 1,
    "unit": "회"
   }
  ],
  "scope": "p0=(0<=n)?combinations(n,0)*0.5^n:0; p1=(1<=n)?combinations(n,1)*0.5^n:0; p2=(2<=n)?combinations(n,2)*0.5^n:0; p3=(3<=n)?combinations(n,3)*0.5^n:0; p4=(4<=n)?combinations(n,4)*0.5^n:0; p5=(5<=n)?combinations(n,5)*0.5^n:0; p6=(6<=n)?combinations(n,6)*0.5^n:0; p7=(7<=n)?combinations(n,7)*0.5^n:0; p8=(8<=n)?combinations(n,8)*0.5^n:0; p9=(9<=n)?combinations(n,9)*0.5^n:0; p10=(10<=n)?combinations(n,10)*0.5^n:0; total=p0+p1+p2+p3+p4+p5+p6+p7+p8+p9+p10",
  "geometry": {
   "range": [
    -0.5,
    10.5
   ],
   "yRange": [
    -0.05,
    0.65
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      0,
      "=p0"
     ]
    },
    {
