{
 "id": "극한_조건을_통한_계수_결정",
 "spec": {
  "title": "극한 조건을 통한 계수 결정",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "L0",
    "label": "목표 극한값 L₀",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "N1 = a+b; ok = (N1 == 0 ? 1 : 0); L = (ok == 1 ? a : 1e308)",
  "geometry": {
   "range": [
    0,
    2
   ],
   "yRange": [
    -10,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    0,
    2
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "(a*x+b)/(x-1)",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "L0",
     "label": "목표 L₀",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "N(1)=a+b",
    "expr": "N1",
    "digits": 2
   },
   {
    "label": "극한값 L",
    "expr": "L",
    "digits": 2
   },
   {
    "label": "극한 존재",
    "expr": "ok",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": -2,
    "L0": 2
   },
   {
    "a": 3,
    "b": -3,
    "L0": 5
   },
   {
    "a": 1,
    "b": 1,
    "L0": 2
   },
   {
    "a": 0,
    "b": 0,
    "L0": 0
   }
  ],
  "invariants": [
   "abs(ok * N1)",
   "abs(ok * (L - a))"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": -2,
     "L0": 2
    },
    "expect": {
     "N1": 0,
     "ok": 1,
     "L": 2
    }
   },
   {
    "params": {
     "a": 3,
     "b": -3,
     "L0": 5
    },
    "expect": {
     "N1": 0,
     "ok": 1,
     "L": 3
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "L0": 2
    },
    "expect": {
     "N1": 2,
     "ok": 0,
     "L": 1e+308
    }
   },
   {
    "params": {
     "a": 0,
     "b": 0,
     "L0": 0
    },
    "expect": {
     "N1": 0,
     "ok": 1,
     "L": 0
    }
   }
  ],
  "tol": 0.000001
 }
}