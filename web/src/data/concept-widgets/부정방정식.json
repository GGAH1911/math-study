{
 "id": "부정방정식",
 "spec": {
  "title": "부정방정식: 자연수 해 찾기",
  "params": [
   {
    "name": "c",
    "label": "상수 c",
    "type": "slider",
    "min": 1,
    "max": 30,
    "init": 12,
    "step": 1,
    "unit": ""
   },
   {
    "name": "x",
    "label": "x",
    "type": "slider",
    "min": -5,
    "max": 15,
    "init": 3,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "a=2; b=3; y=(c - a*x)/b; isInt=((y == round(y)) ? 1 : 0); isNat=((x > 0) and (y > 0) and (y == round(y))) ? 1 : 0; yBot=-5; yTop=20; xBot=(c - b*yBot)/a; xTop=(c - b*yTop)/a;",
  "geometry": {
   "range": [
    -5,
    20
   ],
   "yRange": [
    -5,
    20
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=xBot",
      "=yBot"
     ],
     "to": [
      "=xTop",
      "=yTop"
     ]
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=y"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "y",
    "expr": "y",
    "digits": 3
   },
   {
    "label": "정수해?",
    "expr": "isNat",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 12,
    "x": 3
   },
   {
    "c": 12,
    "x": 4
   },
   {
    "c": 20,
    "x": 1
   },
   {
    "c": 7,
    "x": -2
   }
  ],
  "invariants": [
   "a*x + b*y - c",
   "(y - round(y)) * isNat"
  ],
  "oracle": [
   {
    "params": {
     "c": 12,
     "x": 3
    },
    "expect": {
     "y": 2,
     "isNat": 1
    }
   },
   {
    "params": {
     "c": 12,
     "x": 4
    },
    "expect": {
     "y": 1.3333333333333333,
     "isNat": 0
    }
   },
   {
    "params": {
     "c": 18,
     "x": 3
    },
    "expect": {
     "y": 4,
     "isNat": 1
    }
   }
  ],
  "tol": 0.000001
 }
}