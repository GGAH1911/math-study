{
 "id": "극한값_읽기",
 "spec": {
  "title": "극한값 읽기",
  "params": [
   {
    "name": "xval",
    "label": "x",
    "type": "slider",
    "min": 0.01,
    "max": 1.99,
    "init": 0.5,
    "step": 0.02,
    "unit": ""
   }
  ],
  "scope": "a=1; alpha=2; fx=(xval^2-1)/(xval-1)",
  "geometry": {
   "range": [
    0,
    2
   ],
   "yRange": [
    0,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=xval",
      "=fx"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      "=xval",
      "=fx"
     ],
     "to": [
      "=xval",
      "=alpha"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      "=alpha"
     ],
     "to": [
      2,
      "=alpha"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=a",
      0
     ],
     "to": [
      "=a",
      4
     ]
    },
    {
     "type": "circle",
     "center": [
      "=a",
      "=alpha"
     ],
     "radius": 0.05
    }
   ]
  },
  "plot": {
   "range": [
    0,
    2
   ],
   "yRange": [
    0,
    4
   ],
   "fns": [
    {
     "fn": "(x^2-1)/(x-1)",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "alpha",
     "label": "극한값",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "x",
    "expr": "xval"
   },
   {
    "label": "f(x)",
    "expr": "fx"
   },
   {
    "label": "극한값 α",
    "expr": "alpha"
   },
   {
    "label": "|f(x)-α|",
    "expr": "abs(fx-alpha)"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "xval": 0.5
   },
   {
    "xval": 1.2
   },
   {
    "xval": 1.8
   },
   {
    "xval": 0.98
   }
  ],
  "invariants": [
   "abs(fx - (xval+1))",
   "abs(fx - alpha) - abs(xval - a)"
  ],
  "oracle": [
   {
    "params": {
     "xval": 0.5
    },
    "expect": {
     "fx": 1.5,
     "alpha": 2,
     "a": 1
    }
   },
   {
    "params": {
     "xval": 1.2
    },
    "expect": {
     "fx": 2.2,
     "alpha": 2,
     "a": 1
    }
   },
   {
    "params": {
     "xval": 1.8
    },
    "expect": {
     "fx": 2.8,
     "alpha": 2,
     "a": 1
    }
   }
  ],
  "tol": 0.000001
 }
}