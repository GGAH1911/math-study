{
 "id": "functions/math-2/미분/초기값_조건",
 "spec": {
  "title": "초기값 조건: 일반해 y=x²+C 중 점 (x₀,y₀)를 지나는 특수해 고르기",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (초기점의 x)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "y0",
    "label": "y₀ (초기점의 y)",
    "type": "slider",
    "min": -4,
    "max": 10,
    "init": 3,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "C = y0 - x0^2",
  "geometry": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -4,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -4,
    10
   ],
   "fns": [
    {
     "fn": "x^2 - 2",
     "label": "일반해 family (C=-2)",
     "color": "#cccccc"
    },
    {
     "fn": "x^2",
     "label": "일반해 family (C=0)",
     "color": "#cccccc"
    },
    {
     "fn": "x^2 + 2",
     "label": "일반해 family (C=2)",
     "color": "#cccccc"
    },
    {
     "fn": "x^2 + 4",
     "label": "일반해 family (C=4)",
     "color": "#cccccc"
    },
    {
     "fn": "x^2 + C",
     "label": "=concat('특수해 y=x²+', format(C,3))",
     "color": "#d62728"
    }
   ]
  },
  "readout": [
   {
    "label": "결정된 적분상수 C = y₀ − x₀²",
    "expr": "C",
    "digits": 3
   },
   {
    "label": "특수해의 함숫값 y(x₀) = x₀²+C",
    "expr": "x0^2 + C",
    "digits": 3
   },
   {
    "label": "초기값 조건 확인 y(x₀) − y₀ (=0)",
    "expr": "x0^2 + C - y0",
    "digits": 6
   },
   {
    "label": "그 점에서의 기울기 dy/dx = 2x₀",
    "expr": "2*x0",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 1,
    "y0": 3
   },
   {
    "x0": 2,
    "y0": 1
   },
   {
    "x0": -1,
    "y0": 0
   },
   {
    "x0": 0,
    "y0": 5
   }
  ],
  "invariants": [
   "x0^2 + C - y0",
   "C - (y0 - x0^2)"
  ],
  "oracle": [
   {
    "params": {
     "x0": 1,
     "y0": 3
    },
    "expect": {
     "C": 2
    }
   },
   {
    "params": {
     "x0": 2,
     "y0": 1
    },
    "expect": {
     "C": -3
    }
   },
   {
    "params": {
     "x0": 0,
     "y0": 5
    },
    "expect": {
     "C": 5
    }
   }
  ],
  "tol": 0.000001
 }
}