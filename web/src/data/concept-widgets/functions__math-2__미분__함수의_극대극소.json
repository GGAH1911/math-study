{
 "id": "functions/math-2/미분/함수의_극대극소",
 "spec": {
  "title": "함수의 극대극소: 도함수의 부호 변화",
  "params": [
   {
    "name": "c",
    "label": "임계점 위치 c (임계점 = ±c)",
    "type": "slider",
    "min": 0,
    "max": 1.5,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "xmax = -c; xmin = c; ymax = 2*c^3; ymin = -2*c^3",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^3 - 3*c^2*x",
     "label": "f(x)=x³-3c²x",
     "color": "#2563eb"
    },
    {
     "fn": "3*x^2 - 3*c^2",
     "label": "f'(x)=3x²-3c²",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극대점 x = -c",
    "expr": "xmax",
    "digits": 3
   },
   {
    "label": "극댓값 f(-c)",
    "expr": "ymax",
    "digits": 3
   },
   {
    "label": "극소점 x = c",
    "expr": "xmin",
    "digits": 3
   },
   {
    "label": "극솟값 f(c)",
    "expr": "ymin",
    "digits": 3
   },
   {
    "label": "f'(-c) (=0 이면 임계점)",
    "expr": "3*xmax^2 - 3*c^2",
    "digits": 3
   },
   {
    "label": "f''(-c) (음수→극대)",
    "expr": "6*xmax",
    "digits": 3
   },
   {
    "label": "f''(c) (양수→극소)",
    "expr": "6*xmin",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 1
   },
   {
    "c": 0.5
   },
   {
    "c": 1.2
   },
   {
    "c": 1.5
   }
  ],
  "invariants": [
   "3*xmax^2 - 3*c^2",
   "3*xmin^2 - 3*c^2",
   "ymax - (xmax^3 - 3*c^2*xmax)",
   "ymin - (xmin^3 - 3*c^2*xmin)",
   "ymax + ymin"
  ],
  "oracle": [
   {
    "params": {
     "c": 1
    },
    "expect": {
     "xmax": -1,
     "xmin": 1,
     "ymax": 2,
     "ymin": -2
    }
   },
   {
    "params": {
     "c": 0.5
    },
    "expect": {
     "xmax": -0.5,
     "xmin": 0.5,
     "ymax": 0.25,
     "ymin": -0.25
    }
   },
   {
    "params": {
     "c": 1.2
    },
    "expect": {
     "ymax": 3.456,
     "ymin": -3.456
    }
   }
  ],
  "tol": 0.000001
 }
}