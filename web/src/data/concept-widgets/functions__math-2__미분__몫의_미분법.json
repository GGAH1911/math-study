{
 "id": "functions/math-2/미분/몫의_미분법",
 "spec": {
  "title": "몫의 미분법: (u/v)′ = (u′v − uv′)/v²",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (접점)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0.5,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (분모 x²+c)",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "u0 = x0; v0 = x0^2 + c; du = 1; dv = 2*x0; y0 = u0/v0; m = (du*v0 - u0*dv)/v0^2; h = 0.0001; yp = (x0+h)/((x0+h)^2 + c); ym = (x0-h)/((x0-h)^2 + c); numd = (yp - ym)/(2*h)",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -2,
    2
   ],
   "fns": [
    {
     "fn": "x/(x^2 + c)",
     "label": "y = u/v = x/(x²+c)",
     "color": "#2563eb"
    },
    {
     "fn": "y0 + m*(x - x0)",
     "label": "x₀에서의 접선 (기울기=몫의 미분)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "v(x₀) = x₀²+c",
    "expr": "v0",
    "digits": 4
   },
   {
    "label": "u′v = 1·v₀",
    "expr": "du*v0",
    "digits": 4
   },
   {
    "label": "uv′ = u₀·2x₀",
    "expr": "u0*dv",
    "digits": 4
   },
   {
    "label": "기울기 m = (u′v − uv′)/v²",
    "expr": "m",
    "digits": 4
   },
   {
    "label": "수치미분(검증용)",
    "expr": "numd",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 0,
    "c": 1
   },
   {
    "x0": 1,
    "c": 1
   },
   {
    "x0": -1.5,
    "c": 2
   },
   {
    "x0": 2,
    "c": 0.5
   }
  ],
  "invariants": [
   "m*v0 + y0*dv - du",
   "m - (du - y0*dv)/v0",
   "m - numd"
  ],
  "oracle": [
   {
    "params": {
     "x0": 0,
     "c": 1
    },
    "expect": {
     "m": 1,
     "y0": 0
    }
   },
   {
    "params": {
     "x0": 1,
     "c": 1
    },
    "expect": {
     "m": 0,
     "y0": 0.5
    }
   },
   {
    "params": {
     "x0": 1,
     "c": 2
    },
    "expect": {
     "m": 0.1111111111,
     "y0": 0.3333333333
    }
   }
  ],
  "tol": 0.000001
 }
}