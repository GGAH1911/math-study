  "invariants": [
   "f0 - (a*x0^3 + b*x0^2 + c*x0 + d)",
   "df - (3*a*x0^2 + 2*b*x0 + c)",
   "d2f - (6*a*x0 + 2*b)",
   "disc - (4*b^2 - 12*a*c)",
   "max(type*d2f, 0)",
