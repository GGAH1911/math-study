{
 "id": "functions/high-1/함수와_그래프/매개변수의_역할",
 "spec": {
  "title": "매개변수의 역할 — 원 위를 도는 점 x=r·cos t, y=r·sin t",
  "params": [
   {
    "name": "r",
    "label": "반지름 r",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "t",
    "label": "매개변수 t(각도)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad = t*pi/180; px = r*cos(rad); py = r*sin(rad)",
  "geometry": {
   "range": [
    -3.3,
    3.3
   ],
   "yRange": [
    -3.3,
    3.3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=r"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ]
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P(x,y)"
    }
   ]
  },
  "readout": [
   {
    "label": "x = r·cos t",
    "expr": "px",
    "digits": 4
   },
   {
    "label": "y = r·sin t",
    "expr": "py",
    "digits": 4
   },
   {
    "label": "x²+y² (=r²)",
    "expr": "px^2+py^2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "r": 1,
    "t": 0
   },
   {
    "r": 2,
    "t": 90
   },
   {
    "r": 1,
    "t": 30
   },
   {
    "r": 2.5,
    "t": 210
   }
  ],
  "invariants": [
   "px^2+py^2-r^2"
  ],
  "oracle": [
   {
    "params": {
     "r": 1,
     "t": 0
    },
    "expect": {
     "px": 1,
     "py": 0
    }
   },
   {
    "params": {
     "r": 2,
     "t": 90
    },
    "expect": {
     "px": 0,
     "py": 2
    }
   },
   {
    "params": {
     "r": 1,
     "t": 30
    },
    "expect": {
     "px": 0.8660254037844387,
     "py": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}