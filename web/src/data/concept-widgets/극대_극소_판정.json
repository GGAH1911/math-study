{
 "id": "극대_극소_판정",
 "spec": {
  "title": "극대·극소 판정 – $f'$ 의 부호 변화 (일반 삼차 $ax^3+bx^2+cx+d$)",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.5
   }
  ],
  "scope": "as = abs(a) < 0.1 ? (a < 0 ? -0.1 : 0.1) : a; D = 4*b^2 - 12*as*c; sq = D > 0 ? sqrt(D) : 0; r1 = (-2*b - sq)/(6*as); r2 = (-2*b + sq)/(6*as); xl = min(r1, r2); xr = max(r1, r2); xv = -b/(3*as); gap = xr - xl; h = D > 0 ? min(0.2, gap/3) : 0.2; nCrit = D > 1e-9 ? 2 : (D > -1e-9 ? 1 : 0); dLL = 3*as*(xl-h)^2 + 2*b*(xl-h) + c; dLR = 3*as*(xl+h)^2 + 2*b*(xl+h) + c; dRL = 3*as*(xr-h)^2 + 2*b*(xr-h) + c; dRR = 3*as*(xr+h)^2 + 2*b*(xr+h) + c; judgeL = (dLL > 0 and dLR < 0) ? 1 : ((dLL < 0 and dLR > 0) ? -1 : 0); judgeR = (dRL > 0 and dRR < 0) ? 1 : ((dRL < 0 and dRR > 0) ? -1 : 0); xlD = D >= 0 ? xl : 0/0; xrD = D > 1e-9 ? xr : 0/0; pxA = D > 0 ? (as > 0 ? xl : xr) : 50; pyA = as*pxA^3 + b*pxA^2 + c*pxA + d; pxB = D > 0 ? (as > 0 ? xr : xl) : 50; pyB = as*pxB^3 + b*pxB^2 + c*pxB + d",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -10,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "as*x^3 + b*x^2 + c*x + d",
     "label": "$f(x)=ax^3+bx^2+cx+d$",
     "color": "blue"
    },
    {
     "fn": "3*as*x^2 + 2*b*x + c",
     "label": "$f'(x)=3ax^2+2bx+c$",
     "color": "red",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "3*as*x^2 + 2*b*x + c",
     "in": [
      "=-3",
      "=xv"
     ],
     "label": "$f'=0$"
    },
    {
     "fn": "3*as*x^2 + 2*b*x + c",
     "in": [
      "=xv",
      "=3"
     ],
     "label": "$f'=0$"
    }
   ],
   "points": [
    [
     "=pxA",
     "=pyA"
    ],
    [
     "=pxB",
     "=pyB"
    ]
   ],
   "pointsLabel": "$f$ 위의 극대·극소점"
  },
  "readout": [
   {
    "label": "판별식 $D=4b^2-12ac$",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "$f'(x)=0$ 인 $x$ 의 개수",
    "expr": "nCrit",
    "digits": 0
   },
   {
    "label": "왼쪽 후보 $x$",
    "expr": "xlD",
    "digits": 3
   },
   {
    "label": "왼쪽 후보 왼쪽 $f'$",
    "expr": "dLL",
    "digits": 3
   },
   {
    "label": "왼쪽 후보 오른쪽 $f'$",
    "expr": "dLR",
    "digits": 3
   },
   {
    "label": "왼쪽 후보 판정 (+1 극대 · −1 극소 · 0 극값 아님)",
    "expr": "judgeL",
    "digits": 0
   },
   {
    "label": "오른쪽 후보 $x$",
    "expr": "xrD",
    "digits": 3
   },
   {
    "label": "오른쪽 후보 왼쪽 $f'$",
    "expr": "dRL",
    "digits": 3
   },
   {
    "label": "오른쪽 후보 오른쪽 $f'$",
    "expr": "dRR",
    "digits": 3
   },
   {
    "label": "오른쪽 후보 판정 (+1 극대 · −1 극소 · 0 극값 아님)",
    "expr": "judgeR",
    "digits": 0
   }
  ]
 },
 "recipe": {
