   }
  ],
  "invariants": [
   "abs(D - (4*b^2 - 12*as*c))",
   "abs(xl + xr + 2*b/(3*as))",
   "abs(D >= 0 ? (3*as*xl^2 + 2*b*xl + c) : 0)",
   "abs(D >= 0 ? (3*as*xr^2 + 2*b*xr + c) : 0)",
   "abs(D > 0 ? judgeL + judgeR : 0)",
   "abs(D > 0 ? judgeL - sign(as) : 0)",
   "abs(D < 0 ? nCrit : 0)"
  ],
  "oracle": [
   {
