{
 "id": "지수_변환",
 "spec": {
  "title": "지수 변환: (2^n)^x = 2^(nx)",
  "params": [
   {
    "name": "n",
    "label": "n (밑=2^n)",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 1
   },
   {
    "name": "t",
    "label": "t (비교할 x값)",
    "type": "slider",
    "min": -0.6,
    "max": 0.6,
    "init": 0.3,
    "step": 0.05
   }
  ],
  "scope": "base = 2^n; orig = base^t; trans = 2^(n*t); diff = orig - trans",
  "geometry": {
   "range": [
    -0.6,
    0.6
   ],
   "yRange": [
    -0.5,
    8.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -0.6,
    0.6
   ],
   "yRange": [
    -0.5,
    8.5
   ],
   "fns": [
    {
     "fn": "(2^n)^x",
     "label": "(2^n)^x",
     "color": "#e74c3c"
    },
    {
     "fn": "2^(n*x)",
     "label": "2^(nx)",
     "color": "#2980b9"
    }
   ]
  },
  "readout": [
   {
    "label": "원래 식 (2^n)^t",
    "expr": "orig",
    "digits": 6
   },
   {
    "label": "변환 식 2^(nt)",
    "expr": "trans",
    "digits": 6
   },
   {
    "label": "차이",
    "expr": "diff",
    "digits": 8
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 2,
    "t": 0.5
   },
   {
    "n": 4,
    "t": -0.5
   },
   {
    "n": 5,
    "t": 0.4
   },
   {
    "n": 1,
    "t": -0.3
   }
  ],
  "invariants": [
   "orig - trans",
   "base - 2^n"
  ],
  "oracle": [
   {
    "params": {
     "n": 2,
     "t": 0.5
    },
    "expect": {
     "base": 4,
     "orig": 2,
     "trans": 2,
     "diff": 0
    }
   },
   {
    "params": {
     "n": 4,
     "t": -0.5
    },
    "expect": {
     "base": 16,
     "orig": 0.25,
     "trans": 0.25,
     "diff": 0
    }
   },
   {
    "params": {
     "n": 3,
     "t": 0
    },
    "expect": {
     "base": 8,
     "orig": 1,
     "trans": 1,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}