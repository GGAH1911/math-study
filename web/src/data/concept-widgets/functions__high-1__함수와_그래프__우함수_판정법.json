{
 "id": "functions/high-1/함수와_그래프/우함수_판정법",
 "spec": {
  "title": "우함수 판정법: f(-x)=f(x) — y축 대칭",
  "params": [
   {
    "name": "a",
    "label": "a (x² 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (cos x 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "판정점 x₀",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1.5,
    "step": 0.1
   }
  ],
  "scope": "fp = a*x0^2 + b*cos(x0); fm = a*(-x0)^2 + b*cos(-x0); diff = fp - fm",
  "geometry": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -3,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -3,
    10
   ],
   "fns": [
    {
     "fn": "a*x^2 + b*cos(x)",
     "label": "f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "a*(-x)^2 + b*cos(-x)",
     "label": "f(-x)",
     "color": "#dc2626"
    }
   ],
   "points": [
    [
     "=x0",
     "=fp"
    ],
    [
     "=-x0",
     "=fm"
    ]
   ],
   "pointsLabel": "$x_0,\\,-x_0$"
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "fp",
    "digits": 4
   },
   {
    "label": "f(-x₀)",
    "expr": "fm",
    "digits": 4
   },
   {
    "label": "f(x₀)-f(-x₀) (항상 0)",
    "expr": "diff",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 1,
    "x0": 1.5
   },
   {
    "a": 2,
    "b": -1,
    "x0": 2
   },
   {
    "a": -1,
    "b": 1,
    "x0": 0.5
   },
   {
    "a": 0.5,
    "b": 2,
    "x0": -2.5
   }
  ],
  "invariants": [
   "diff",
   "fp - fm",
   "a*x0^2 + b*cos(x0) - (a*(-x0)^2 + b*cos(-x0))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 1,
     "x0": 0
    },
    "expect": {
     "fp": 1,
     "fm": 1,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 2,
     "b": 0,
     "x0": 1.5
    },
    "expect": {
     "fp": 4.5,
     "fm": 4.5,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "x0": 1
    },
    "expect": {
     "fp": 1.5403023059,
     "fm": 1.5403023059,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}