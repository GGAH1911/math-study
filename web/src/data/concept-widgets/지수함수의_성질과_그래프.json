    -2,
    2
   ],
   "yRange": [
    -1,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -1,
    5
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y = a^x",
     "color": "#1f77b4"
    }
   ]
  },
  "readout": [
   {
    "label": "f(0)",
    "expr": "y0",
    "digits": 2
   },
   {
    "label": "f(1)",
    "expr": "y1",
    "digits": 2
   },
   {
    "label": "f(-1)",
