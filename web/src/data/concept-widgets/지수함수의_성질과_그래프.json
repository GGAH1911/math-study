    "params": {
     "a": 0.5
    },
    "expect": {
     "y1": 0.5,
     "ym1": 2,
     "y2": 0.25,
     "y0": 1
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "y1": 2,
     "ym1": 0.5,
     "y2": 4,
     "y0": 1
    }
   },
   {
    "params": {
     "a": 4
    },
    "expect": {
     "y1": 4,
     "ym1": 0.25,
     "y2": 16,
     "y0": 1
    }
   }
  ],
  "tol": 0.000001
 }
}