{
 "id": "functions/calculus/수열의_극한/급수의_선형성",
 "spec": {
  "title": "급수의 선형성: 부분합의 합·상수배",
  "params": [
   {
    "name": "N",
    "label": "항 수 N",
    "type": "slider",
    "min": 1,
    "max": 16,
    "init": 5,
    "step": 1,
    "unit": "항"
   },
   {
    "name": "c",
    "label": "상수 c",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "Sa = 1 - 2^(-N); Sb = (1 - 3^(-N)) / 2; aN = (1/2)^N; bN = (1/3)^N; Sa1 = 1 - 2^(-(N-1)); Sb1 = (1 - 3^(-(N-1))) / 2; Ssum = Sa + Sb; Scal = c * Sa",
  "plot": {
   "range": [
    1,
    16
   ],
   "yRange": [
    -2.2,
    2.2
   ],
   "fns": [
    {
     "fn": "1 - 2^(-x)",
     "label": "Sₙ(aₙ), aₙ=(1/2)ⁿ → 1",
     "color": "#2563eb"
    },
    {
     "fn": "(1 - 3^(-x)) / 2",
     "label": "Sₙ(bₙ), bₙ=(1/3)ⁿ → 1/2",
     "color": "#dc2626"
    },
    {
     "fn": "(1 - 2^(-x)) + (1 - 3^(-x)) / 2",
     "label": "Sₙ(aₙ+bₙ) → 3/2",
     "color": "#16a34a"
    },
    {
     "fn": "c * (1 - 2^(-x))",
     "label": "Sₙ(c·aₙ) → c·1",
     "color": "#9333ea"
    }
   ]
  },
  "readout": [
   {
    "label": "Sₙ(aₙ),  aₙ=(1/2)ⁿ",
    "expr": "Sa",
    "digits": 6
   },
   {
    "label": "Sₙ(bₙ),  bₙ=(1/3)ⁿ",
    "expr": "Sb",
    "digits": 6
   },
   {
    "label": "Sₙ(aₙ) + Sₙ(bₙ)",
    "expr": "Sa+Sb",
    "digits": 6
   },
   {
    "label": "Sₙ(aₙ+bₙ)",
    "expr": "Ssum",
    "digits": 6
   },
   {
    "label": "선형성 오차  Sₙ(aₙ+bₙ) − [Sₙ(aₙ)+Sₙ(bₙ)]",
    "expr": "Ssum-(Sa+Sb)",
    "digits": 6
   },
   {
    "label": "Sₙ(c·aₙ) = c·Sₙ(aₙ)",
    "expr": "Scal",
    "digits": 6
   },
   {
    "label": "극한 ∑(aₙ+bₙ) = ∑aₙ+∑bₙ = 3/2",
    "expr": "1.5",
    "digits": 6
   },
   {
    "label": "극한 ∑c·aₙ = c·∑aₙ = c·1",
    "expr": "c*1",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "N": 1,
    "c": 2
   },
   {
    "N": 4,
    "c": 1
   },
   {
    "N": 9,
    "c": -1.5
   },
   {
    "N": 16,
    "c": 0.5
   }
  ],
  "invariants": [
   "Sa - Sa1 - aN",
   "Sb - Sb1 - bN",
   "Ssum - (Sa1 + Sb1) - (aN + bN)",
   "Scal - c*(Sa1 + aN)"
  ],
  "oracle": [
   {
    "params": {
     "N": 1,
     "c": 2
    },
    "expect": {
     "Sa": 0.5,
     "Sb": 0.3333333333,
     "Ssum": 0.8333333333,
     "Scal": 1
    }
   },
   {
    "params": {
     "N": 2,
     "c": 3
    },
    "expect": {
     "Sa": 0.75,
     "Sb": 0.4444444444,
     "Ssum": 1.1944444444,
     "Scal": 2.25
    }
   },
   {
    "params": {
     "N": 3,
     "c": -2
    },
    "expect": {
     "Sa": 0.875,
     "Sb": 0.4814814815,
     "Ssum": 1.3564814815,
     "Scal": -1.75
    }
   }
  ],
  "tol": 0.000001
 }
}