{
 "id": "functions/high-1/함수와_그래프/함수의_치역과_자연수_조건",
 "spec": {
  "title": "자연수 정의역 함수의 치역: 띄엄띄엄한 점들의 집합",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "b",
    "label": "절편 b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 1
   },
   {
    "name": "k",
    "label": "선택한 자연수 n",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "y1=a*1+b; y2=a*2+b; y3=a*3+b; yk=a*k+b",
  "geometry": {
   "range": [
    0,
    7
   ],
   "yRange": [
    -4,
    16
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      1,
      "=a*1+b"
     ]
    },
    {
     "type": "point",
     "at": [
      2,
      "=a*2+b"
     ]
    },
    {
     "type": "point",
     "at": [
      3,
      "=a*3+b"
     ]
    },
    {
     "type": "point",
     "at": [
      4,
      "=a*4+b"
     ]
    },
    {
     "type": "point",
     "at": [
      5,
      "=a*5+b"
     ]
    },
    {
     "type": "point",
     "at": [
      6,
      "=a*6+b"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=k",
      0
     ],
     "to": [
      "=k",
      "=yk"
     ]
    },
    {
     "type": "point",
     "at": [
      "=k",
      "=yk"
     ],
     "label": "P(n, f(n))"
    }
   ]
  },
  "readout": [
   {
    "label": "선택한 자연수 n",
    "expr": "k",
    "digits": 0
   },
   {
    "label": "함숫값 f(n)=a·n+b (치역의 원소)",
    "expr": "yk",
    "digits": 2
   },
   {
    "label": "이웃 함숫값의 차(공차)",
    "expr": "a",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "k": 3
   },
   {
    "a": 2,
    "b": -1,
    "k": 4
   },
   {
    "a": 0.5,
    "b": 2,
    "k": 2
   },
   {
    "a": 1.5,
    "b": -3,
    "k": 6
   }
  ],
  "invariants": [
   "yk-(a*k+b)",
   "y2-y1-a",
   "y3-y1-2*a"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "k": 3
    },
    "expect": {
     "y1": 1,
     "y2": 2,
     "y3": 3,
     "yk": 3
    }
   },
   {
    "params": {
     "a": 2,
     "b": -1,
     "k": 4
    },
    "expect": {
     "y1": 1,
     "y2": 3,
     "y3": 5,
     "yk": 7
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 2,
     "k": 2
    },
    "expect": {
     "y1": 2.5,
     "y2": 3,
     "y3": 3.5,
     "yk": 3
    }
   }
  ],
  "tol": 0.000001
 }
}