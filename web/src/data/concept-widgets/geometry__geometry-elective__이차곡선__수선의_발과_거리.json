{
 "id": "geometry/geometry-elective/이차곡선/수선의_발과_거리",
 "spec": {
  "title": "수선의 발과 점-직선 거리",
  "params": [
   {
    "name": "px",
    "label": "P의 x좌표",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "py",
    "label": "P의 y좌표",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 4,
    "step": 0.5
   },
   {
    "name": "a",
    "label": "직선 계수 a",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 3,
    "step": 1
   },
   {
    "name": "b",
    "label": "직선 계수 b",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 4,
    "step": 1
   },
   {
    "name": "c",
    "label": "직선 상수 c",
    "type": "slider",
    "min": -20,
    "max": 20,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "den=a^2+b^2; s=a*px+b*py+c; hx=px-a*s/den; hy=py-b*s/den; dist=abs(s)/sqrt(den); ly0=-(a*(-6)+c)/b; ly1=-(a*6+c)/b",
  "geometry": {
   "range": [
    -10,
    10
   ],
   "yRange": [
    -10,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      -6,
      "=ly0"
     ],
     "to": [
      6,
      "=ly1"
     ],
     "label": "ℓ: ax+by+c=0",
     "color": "#2563eb"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P",
     "color": "#dc2626"
    },
    {
     "type": "point",
     "at": [
      "=hx",
      "=hy"
     ],
     "label": "H(수선의 발)",
     "color": "#16a34a"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=hx",
      "=hy"
     ],
     "label": "PH=거리",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "거리 |PH|",
    "expr": "dist",
    "digits": 3
   },
   {
    "label": "수선의 발 H_x",
    "expr": "hx",
    "digits": 3
   },
   {
    "label": "수선의 발 H_y",
    "expr": "hy",
    "digits": 3
   },
   {
    "label": "공식값 |ax₀+by₀+c|/√(a²+b²)",
    "expr": "abs(a*px+b*py+c)/sqrt(a^2+b^2)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "px": 3,
    "py": 4,
    "a": 3,
    "b": 4,
    "c": 0
   },
   {
    "px": 0,
    "py": 0,
    "a": 3,
    "b": 4,
    "c": -10
   },
   {
    "px": -2,
    "py": 5,
    "a": 1,
    "b": 2,
    "c": 3
   },
   {
    "px": 6,
    "py": -1,
    "a": 5,
    "b": 5,
    "c": -5
   }
  ],
  "invariants": [
   "a*hx+b*hy+c",
   "(hx-px)*b-(hy-py)*a",
   "dist-sqrt((px-hx)^2+(py-hy)^2)"
  ],
  "oracle": [
   {
    "params": {
     "px": 3,
     "py": 4,
     "a": 3,
     "b": 4,
     "c": 0
    },
    "expect": {
     "hx": 0,
     "hy": 0,
     "dist": 5
    }
   },
   {
    "params": {
     "px": 0,
     "py": 0,
     "a": 3,
     "b": 4,
     "c": -10
    },
    "expect": {
     "hx": 1.2,
     "hy": 1.6,
     "dist": 2
    }
   }
  ],
  "tol": 0.000001
 }
}