{
 "id": "변위_조건",
 "spec": {
  "title": "변위 조건 — 속도의 정적분(부호 있는 넓이)",
  "params": [
   {
    "name": "v0",
    "label": "초기속도 v₀",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 4,
    "step": 0.5,
    "unit": "m/s"
   },
   {
    "name": "T",
    "label": "시각 T",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 3,
    "step": 0.1,
    "unit": "s"
   }
  ],
  "scope": "vT = v0 - 2*T; disp = v0*T - T^2; xpos = disp",
  "geometry": {
   "range": [
    0,
    6
   ],
   "yRange": [
    -8,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    0,
    6
   ],
   "yRange": [
    -8,
    10
   ],
   "fns": [
    {
     "fn": "v0 - 2*x",
     "label": "v(t)=v₀-2t",
     "color": "#2563eb"
    }
   ],
   "points": [
    [
     "=T",
     "=v0 - 2*T"
    ]
   ],
   "pointsLabel": "$t=T,\\ v(T)$"
  },
  "readout": [
   {
    "label": "변위 ∫₀ᵀ v dt",
    "expr": "disp",
    "digits": 3
   },
   {
    "label": "v(T)",
    "expr": "vT",
    "digits": 3
   },
   {
    "label": "원위치 복귀 시각(변위=0)",
    "expr": "v0",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "v0": 4,
    "T": 2
   },
   {
    "v0": 4,
    "T": 4
   },
   {
    "v0": 6,
    "T": 3
   },
   {
    "v0": 3,
    "T": 1.5
   }
  ],
  "invariants": [
   "disp - (v0 + vT)/2 * T",
   "disp - (v0 - T)*T"
  ],
  "oracle": [
   {
    "params": {
     "v0": 4,
     "T": 2
    },
    "expect": {
     "disp": 4,
     "vT": 0
    }
   },
   {
    "params": {
     "v0": 4,
     "T": 4
    },
    "expect": {
     "disp": 0,
     "vT": -4
    }
   },
   {
    "params": {
     "v0": 6,
     "T": 3
    },
    "expect": {
     "disp": 9,
     "vT": 0
    }
   }
  ],
  "tol": 0.000001
 }
}