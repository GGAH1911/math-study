{
 "id": "algebra/high-1/다항식/미정계수법",
 "spec": {
  "title": "미정계수법",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -2,
    "max": 4,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -10,
    "max": 10,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "d2=a-2; d1=b+3; d0=c-5; x0=0; x1=1; x2=2; P0=a*x0^2+b*x0+c; Q0=2*x0^2-3*x0+5; D0=P0-Q0; P1=a*x1^2+b*x1+c; Q1=2*x1^2-3*x1+5; D1=P1-Q1; P2=a*x2^2+b*x2+c; Q2=2*x2^2-3*x2+5; D2=P2-Q2; rec_d2=(D2-2*D1+D0)/2; rec_d1=D1-D0-rec_d2; rec_d0=D0;",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -30,
    40
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -30,
    40
   ],
   "fns": [
    {
     "fn": "a*x^2+b*x+c",
     "label": "P(x) = ax²+bx+c",
     "color": "blue"
    },
    {
     "fn": "2*x^2-3*x+5",
     "label": "Q(x) = 2x²−3x+5",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "Δa (a−2)",
    "expr": "d2",
    "digits": 2
   },
   {
    "label": "Δb (b+3)",
    "expr": "d1",
    "digits": 2
   },
   {
    "label": "Δc (c−5)",
    "expr": "d0",
    "digits": 2
   },
   {
    "label": "일치 여부",
    "expr": "(abs(d2)<1e-9 and abs(d1)<1e-9 and abs(d0)<1e-9) ? 1 : 0",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 0,
    "c": 0
   },
   {
    "a": 2,
    "b": -3,
    "c": 5
   },
   {
    "a": -1,
    "b": 2,
    "c": -3
   },
   {
    "a": 4,
    "b": 1,
    "c": 7
   }
  ],
  "invariants": [
   "rec_d2-d2",
   "rec_d1-d1",
   "rec_d0-d0"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 0,
     "c": 0
    },
    "expect": {
     "d2": -2,
     "d1": 3,
     "d0": -5
    }
   },
   {
    "params": {
     "a": 2,
     "b": -3,
     "c": 5
    },
    "expect": {
     "d2": 0,
     "d1": 0,
     "d0": 0
    }
   },
   {
    "params": {
     "a": -1,
     "b": 2,
     "c": -3
    },
    "expect": {
     "d2": -3,
     "d1": 5,
     "d0": -8
    }
   }
  ],
  "tol": 0.000001
 }
}