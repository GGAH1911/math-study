{
 "id": "functions/math-2/미분/곡선의_접선",
 "spec": {
  "title": "곡선의 접선: y = x³ - 3x 위의 점 P(a, f(a))",
  "params": [
   {
    "name": "a",
    "label": "접점의 x좌표 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fa = a^3 - 3*a; m = 3*a^2 - 3; b = fa - m*a",
  "plot": {
   "range": [
    -2.2,
    2.2
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x",
     "label": "y = x³ - 3x",
     "color": "#2563eb"
    },
    {
     "fn": "m*x + b",
     "label": "접선 y = f'(a)(x-a)+f(a)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a) (접점의 y좌표)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f'(a) (접선의 기울기)",
    "expr": "m",
    "digits": 3
   },
   {
    "label": "접선의 y절편",
    "expr": "b",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": 2
   },
   {
    "a": 0
   },
   {
    "a": -1.5
   }
  ],
  "invariants": [
   "fa - (a^3 - 3*a)",
   "m - (3*a^2 - 3)",
   "(m*a + b) - (a^3 - 3*a)",
   "b + 2*a^3"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": -2,
     "m": 0,
     "b": -2
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 2,
     "m": 9,
     "b": -16
    }
   },
   {
    "params": {
     "a": 0
    },
    "expect": {
     "fa": 0,
     "m": -3,
     "b": 0
    }
   }
  ],
  "tol": 0.000001
 }
}