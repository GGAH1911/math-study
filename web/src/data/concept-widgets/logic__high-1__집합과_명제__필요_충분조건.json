{
 "id": "logic/high-1/집합과_명제/필요_충분조건",
 "spec": {
  "title": "필요·충분조건: 수직선에서의 포함관계",
  "params": [
   {
    "name": "a",
    "label": "a (p의 경계)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": -1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b (q의 경계)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "x₀ (검사점)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "pImp=a>=b?1:0; qImp=b>=a?1:0; equiv=a==b?1:0; pTest=x0>a?1:0; qTest=x0>b?1:0",
  "geometry": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=a",
      0.5
     ],
     "to": [
      5,
      0.5
     ],
     "color": "blue",
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      "=b",
      -0.5
     ],
     "to": [
      5,
      -0.5
     ],
     "color": "red",
     "label": "Q"
    },
    {
     "type": "point",
     "at": [
      "=x0",
      0
     ],
     "color": "black",
     "label": "x₀"
    }
   ]
  },
  "readout": [
   {
    "label": "p⇒q",
    "expr": "pImp",
    "digits": 0
   },
   {
    "label": "q⇒p",
    "expr": "qImp",
    "digits": 0
   },
   {
    "label": "p⇔q",
    "expr": "equiv",
    "digits": 0
   },
   {
    "label": "x₀∈p",
    "expr": "pTest",
    "digits": 0
   },
   {
    "label": "x₀∈q",
    "expr": "qTest",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1,
    "b": 1,
    "x0": 0
   },
   {
    "a": 1,
    "b": 1,
    "x0": 2
   },
   {
    "a": 2,
    "b": -1,
    "x0": 0
   },
   {
    "a": 0,
    "b": 2,
    "x0": -3
   }
  ],
  "invariants": [
   "equiv - pImp * qImp",
   "pTest * (1 - qTest) * pImp",
   "qTest * (1 - pTest) * qImp"
  ],
  "oracle": [
   {
    "params": {
     "a": -1,
     "b": 1,
     "x0": 0
    },
    "expect": {
     "pImp": 0,
     "qImp": 1,
     "equiv": 0,
     "pTest": 1,
     "qTest": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "x0": 2
    },
    "expect": {
     "pImp": 1,
     "qImp": 1,
     "equiv": 1,
     "pTest": 1,
     "qTest": 1
    }
   },
   {
    "params": {
     "a": 2,
     "b": -1,
     "x0": 0
    },
    "expect": {
     "pImp": 1,
     "qImp": 0,
     "equiv": 0,
     "pTest": 0,
     "qTest": 1
    }
   }
  ],
  "tol": 0.000001
 }
}