{
 "id": "functions/math-2/적분/곡선과_교점",
 "spec": {
  "title": "두 곡선의 교점: y = x² 와 y = ax + b",
  "params": [
   {
    "name": "a",
    "label": "a (직선 기울기)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b (직선 y절편)",
    "type": "slider",
    "min": -4,
    "max": 6,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "D = a^2 + 4*b; x1 = (a - sqrt(D))/2; x2 = (a + sqrt(D))/2; y1 = x1^2; y2 = x2^2",
  "plot": {
   "range": [
    -4.5,
    4.5
   ],
   "yRange": [
    -4,
    18
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y = x²",
     "color": "#2563eb"
    },
    {
     "fn": "a*x + b",
     "label": "y = ax + b",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = a²+4b",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "교점 ①의 x (작은 근)",
    "expr": "x1",
    "digits": 3
   },
   {
    "label": "교점 ①의 y",
    "expr": "y1",
    "digits": 3
   },
   {
    "label": "교점 ②의 x (큰 근)",
    "expr": "x2",
    "digits": 3
   },
   {
    "label": "교점 ②의 y",
    "expr": "y2",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2
   },
   {
    "a": 0,
    "b": 4
   },
   {
    "a": 2,
    "b": 0
   },
   {
    "a": -1,
    "b": 3
   }
  ],
  "invariants": [
   "x1^2 - a*x1 - b",
   "x2^2 - a*x2 - b",
   "y1 - (a*x1 + b)",
   "y2 - (a*x2 + b)",
   "y1 - x1^2",
   "y2 - x2^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "D": 9,
     "x1": -1,
     "y1": 1,
     "x2": 2,
     "y2": 4
    }
   },
   {
    "params": {
     "a": 0,
     "b": 4
    },
    "expect": {
     "D": 16,
     "x1": -2,
     "y1": 4,
     "x2": 2,
     "y2": 4
    }
   },
   {
    "params": {
     "a": 2,
     "b": 0
    },
    "expect": {
     "D": 4,
     "x1": 0,
     "y1": 0,
     "x2": 2,
     "y2": 4
    }
   }
  ],
  "tol": 0.000001
 }
}