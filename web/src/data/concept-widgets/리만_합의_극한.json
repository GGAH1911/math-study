{
 "id": "리만_합의_극한",
 "spec": {
  "title": "리만 합의 극한",
  "params": [
   {
    "name": "n",
    "label": "n (구간 수)",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 10,
    "step": 1
   },
   {
    "name": "m",
    "label": "m (함수 차수)",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "sum = (m==1 ? (n+1)/(2*n) : (m==2 ? (n+1)*(2*n+1)/(6*n^2) : (n+1)^2/(4*n^2))); integral = 1/(m+1); error = abs(sum - integral)",
  "geometry": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1.1
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1.1
   ],
   "fns": [
    {
     "fn": "x^m",
     "label": "f(x) = x^m",
     "color": "blue"
    },
    {
     "fn": "(ceil(x*n - 0.000000001)/n)^m",
     "label": "리만 합 (오른쪽 끝점)",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "리만 합 S_n",
    "expr": "sum",
    "digits": 8
   },
   {
    "label": "정적분 ∫₀¹ x^m dx",
    "expr": "integral",
    "digits": 8
   },
   {
    "label": "오차 |S_n − ∫|",
    "expr": "error",
    "digits": 8
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "m": 1
   },
   {
    "n": 4,
    "m": 2
   },
   {
    "n": 10,
    "m": 3
   },
   {
    "n": 100,
    "m": 2
   }
  ],
  "invariants": [
   "sum - (m==1 ? (n+1)/(2*n) : (m==2 ? (n+1)*(2*n+1)/(6*n^2) : (n+1)^2/(4*n^2)))",
   "error - abs(sum - 1/(m+1))",
   "integral*(m+1) - 1"
  ],
  "oracle": [
   {
    "params": {
     "n": 4,
     "m": 1
    },
    "expect": {
     "sum": 0.625,
     "integral": 0.5,
     "error": 0.125
    }
   },
   {
    "params": {
     "n": 10,
     "m": 2
    },
    "expect": {
     "sum": 0.385,
     "integral": 0.3333333333333333,
     "error": 0.0516666666666667
    }
   },
   {
    "params": {
     "n": 2,
     "m": 3
    },
    "expect": {
     "sum": 0.5625,
     "integral": 0.25,
     "error": 0.3125
    }
   }
  ],
  "tol": 0.000001
 }
}