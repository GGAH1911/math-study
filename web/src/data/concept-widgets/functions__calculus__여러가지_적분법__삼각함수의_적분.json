    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "ph",
    "label": "φ (위상, φ=π/2면 cos x가 된다)",
    "type": "slider",
    "min": 0,
    "max": 3.1416,
    "init": 0,
    "step": 0.01
   },
   {
    "name": "a",
    "label": "a (적분 하한)",
    "type": "slider",
    "min": 0,
    "max": 6.2832,
    "init": 0,
    "step": 0.01
   },
   {
    "name": "b",
    "label": "b (적분 상한)",
    "type": "slider",
    "min": 0,
    "max": 6.2832,
    "init": 1.5708,
    "step": 0.01
   }
  ],
  "scope": "fa = sin(k*a + ph); fb = sin(k*b + ph); area = (cos(k*a + ph) - cos(k*b + ph))/k; amp = 1/k; period = 2*pi/k",
  "plot": {
   "range": [
    0,
    6.2832
   ],
   "yRange": [
    -4.3,
    4.3
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "sin(k*x + ph)",
     "label": "$f(x)=\\sin(kx+\\varphi)$",
     "color": "#2563eb"
    },
    {
     "fn": "(cos(k*a + ph) - cos(k*x + ph))/k",
     "label": "$F(x)=\\int_a^x f\\,dt=-\\frac1k\\bigl[\\cos(kt+\\varphi)\\bigr]_a^x$",
     "color": "#dc2626"
    },
    {
     "fn": "0*x + area",
     "label": "$\\int_a^b f\\,dx$ (현재 넓이)",
     "color": "#9ca3af",
     "dashed": true
    }
   ],
   "points": [
    [
     "=a",
     "=0"
    ],
    [
     "=a",
     "=fa"
    ],
    [
     "=b",
     "=area"
    ],
    [
     "=b",
     "=fb"
    ]
   ],
   "pointsLabel": "$x=a,\\;x=b$"
  },
  "readout": [
   {
    "label": "∫ₐᵇ sin(kx+φ) dx (부호 있는 넓이)",
    "expr": "area",
    "digits": 4
   },
   {
    "label": "f(b) = sin(kb+φ) (상한에서의 높이)",
    "expr": "fb",
    "digits": 4
   },
   {
    "label": "원시함수 계수 1/k (치환적분으로 붙는 값)",
    "expr": "amp",
    "digits": 4
   },
   {
    "label": "한 주기 길이 2π/k (한 주기 적분은 0)",
    "expr": "period",
    "digits": 4
   }
  ]
 },
