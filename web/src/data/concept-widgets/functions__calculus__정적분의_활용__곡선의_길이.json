{
 "id": "functions/calculus/정적분의_활용/곡선의_길이",
 "spec": {
  "title": "곡선의 길이: 현수선 y = c·cosh(x/c) − c + 1의 호의 길이",
  "params": [
   {
    "name": "a",
    "label": "구간 시작 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": -1,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "b",
    "label": "구간 끝 b",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "c",
    "label": "곡선의 휨 정도 c (작을수록 급히 휨)",
    "type": "slider",
    "min": 0.3,
    "max": 3,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "cc = c < 0.3 ? 0.3 : c; a0 = min(a, b); b0 = max(a, b); bb = (b0 - a0) < 0.05 ? a0 + 0.05 : b0; aa = a0; fa = cc*cosh(aa/cc) - cc + 1; fb = cc*cosh(bb/cc) - cc + 1; fpa = sinh(aa/cc); fpb = sinh(bb/cc); integrand_a = sqrt(1 + fpa^2); integrand_b = sqrt(1 + fpb^2); L = cc*(sinh(bb/cc) - sinh(aa/cc)); chord = sqrt((bb - aa)^2 + (fb - fa)^2); ratio = L / chord; avg = L / (bb - aa); slope = (fb - fa) / (bb - aa)",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    0,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "cc*cosh(x/cc) - cc + 1",
     "label": "$y=f(x)$ (현수선)",
     "color": "#1f77b4"
    },
    {
     "fn": "sqrt(1 + sinh(x/cc)^2)",
     "label": "$\\sqrt{1+f'(x)^2}$ — 이 곡선 아래 $[a,b]$ 넓이가 곧 $L$",
     "color": "#2ca02c",
     "dashed": true
    },
    {
     "fn": "fa + slope*(x - aa)",
     "label": "$현\\ \\overline{AB}$",
     "color": "#d62728",
     "dashed": true
    },
    {
     "fn": "1",
     "label": "$y=1$ (최소 피적분값)",
     "color": "#999999",
     "dashed": true
    }
   ],
   "points": [
    [
     "=aa",
     "=fa"
    ],
    [
     "=bb",
     "=fb"
    ],
    [
     "=aa",
     "=integrand_a"
    ],
    [
     "=bb",
     "=integrand_b"
    ]
   ],
   "pointsLabel": "$(a,f(a)),\\ (b,f(b))$ 와 피적분함수 위 대응점"
  },
  "readout": [
   {
    "label": "호의 길이 L = ∫ₐᵇ√(1+f′²)dx",
    "expr": "L",
    "digits": 5
   },
   {
    "label": "현(직선거리)",
    "expr": "chord",
    "digits": 5
   },
   {
    "label": "호 ÷ 현 (항상 1 이상, 직선일수록 1)",
    "expr": "ratio",
    "digits": 5
   },
   {
    "label": "구간 길이 b−a (L 의 최솟값)",
    "expr": "bb - aa",
    "digits": 5
   },
   {
    "label": "평균 피적분값 L/(b−a)",
    "expr": "avg",
    "digits": 5
   },
   {
    "label": "끝점 기울기 f′(b) = sinh(b/c)",
    "expr": "fpb",
    "digits": 5
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 1,
    "c": 1
   },
   {
    "a": -1,
    "b": 1,
    "c": 1
   },
   {
    "a": 0,
    "b": 2,
    "c": 3
   },
   {
