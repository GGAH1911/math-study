    "c": 2
   }
  ],
  "invariants": [
   "integrand_b - cosh(bb/cc)",
   "((fb + cc - 1)/cc)^2 - fpb^2 - 1",
   "L - cc*(sinh(bb/cc) - sinh(aa/cc))",
   "min(L - chord, 0)",
   "min(L - (bb - aa), 0)"
  ],
  "oracle": [
