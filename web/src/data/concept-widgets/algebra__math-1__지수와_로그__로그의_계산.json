{
 "id": "algebra/math-1/지수와_로그/로그의_계산",
 "spec": {
  "title": "로그의 성질: 곱셈을 덧셈으로",
  "params": [
   {
    "name": "x",
    "label": "x",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 10,
    "step": 1
   },
   {
    "name": "y",
    "label": "y",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 20,
    "step": 1
   },
   {
    "name": "b",
    "label": "밑 b",
    "type": "slider",
    "min": 2,
    "max": 10,
    "init": 10,
    "step": 1
   }
  ],
  "scope": "lx = log(x)/log(b); ly = log(y)/log(b); lxy = log(x*y)/log(b); sum = lx + ly; diff = lxy - sum;",
  "geometry": {
   "range": [
    0,
    14
   ],
   "yRange": [
    -0.5,
    0.5
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      14,
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=lx",
      0
     ],
     "label": "log x"
    },
    {
     "type": "point",
     "at": [
      "=ly",
      0
     ],
     "label": "log y"
    },
    {
     "type": "point",
     "at": [
      "=lxy",
      0
     ],
     "label": "log(xy)"
    }
   ]
  },
  "readout": [
   {
    "label": "log_b x",
    "expr": "lx",
    "digits": 4
   },
   {
    "label": "log_b y",
    "expr": "ly",
    "digits": 4
   },
   {
    "label": "log_b (xy)",
    "expr": "lxy",
    "digits": 4
   },
   {
    "label": "log_b x + log_b y",
    "expr": "sum",
    "digits": 4
   },
   {
    "label": "차이 (≈0)",
    "expr": "diff",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x": 10,
    "y": 100,
    "b": 10
   },
   {
    "x": 2,
    "y": 8,
    "b": 2
   },
   {
    "x": 3,
    "y": 27,
    "b": 3
   },
   {
    "x": 5,
    "y": 10,
    "b": 10
   }
  ],
  "invariants": [
   "abs(lxy - (lx+ly))"
  ],
  "oracle": [
   {
    "params": {
     "x": 10,
     "y": 100,
     "b": 10
    },
    "expect": {
     "lx": 1,
     "ly": 2,
     "lxy": 3,
     "sum": 3,
     "diff": 0
    }
   },
   {
    "params": {
     "x": 2,
     "y": 8,
     "b": 2
    },
    "expect": {
     "lx": 1,
     "ly": 3,
     "lxy": 4,
     "sum": 4,
     "diff": 0
    }
   },
   {
    "params": {
     "x": 3,
     "y": 27,
     "b": 3
    },
    "expect": {
     "lx": 1,
     "ly": 3,
     "lxy": 4,
     "sum": 4,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}