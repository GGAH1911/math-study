    ],
    [
     "=as1",
     0
    ],
    [
     "=asm1",
     0
    ],
    [
     "=asm2",
     0
    ]
   ],
   "pointsLabel": "$\\theta$ 위치 · 점근선 발"
  },
  "readout": [
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "cos θ",
    "expr": "cx",
    "digits": 4
   },
   {
    "label": "tan θ = sin θ / cos θ",
    "expr": "ty",
    "digits": 4
   },
   {
    "label": "사분면",
    "expr": "quad",
    "digits": 0
   },
   {
    "label": "tan θ 의 부호 (+1 / −1, 0=정의 안 됨)",
    "expr": "tsign",
    "digits": 0
   },
   {
    "label": "변환 곡선의 주기 (°)",
    "expr": "per",
    "digits": 2
   },
   {
    "label": "가장 가까운 점근선 (°)",
    "expr": "nearAs",
    "digits": 2
   },
   {
    "label": "변환 곡선의 값 y",
    "expr": "yT",
    "digits": 4
   }
  ]
 },
