{
 "id": "tan함수",
 "spec": {
  "title": "tan 함수 탐구",
  "params": [
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": -360,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "a",
    "label": "a (세로 확대)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "b",
    "label": "b (주기 계수)",
    "type": "slider",
    "min": 0.25,
    "max": 3,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "c",
    "label": "c (좌우 이동, °)",
    "type": "slider",
    "min": -180,
    "max": 180,
    "init": 0,
    "step": 5,
    "unit": "°"
   },
   {
    "name": "d",
    "label": "d (위아래 이동)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.5
   }
  ],
  "scope": "rad = theta*pi/180; cx = cos(rad); sy = sin(rad); def = abs(cx) < 1e-9 ? 0 : 1; ty = def == 1 ? sy/cx : NaN; per = 180/b; quad = cx > 0 ? (sy >= 0 ? 1 : 4) : (sy >= 0 ? 2 : 3); tsign = def == 0 ? 0 : (ty > 0 ? 1 : -1); yT = cos(b*(theta-c)*pi/180) == 0 ? NaN : a*tan(b*(theta-c)*pi/180) + d; as0 = c + 90/b; as1 = c + 270/b; asm1 = c - 90/b; asm2 = c - 270/b; nearAs = abs(theta-as0) < abs(theta-asm1) ? as0 : asm1;",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -2,
    2
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ]
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    },
    {
     "type": "line",
     "from": [
      1,
      -2
     ],
     "to": [
      1,
      2
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      0
     ],
     "to": [
      1,
      "=ty"
     ]
    },
    {
     "type": "point",
     "at": [
      1,
      "=ty"
     ],
     "label": "tanθ"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      1,
      "=ty"
     ],
     "dashed": true,
     "color": "gray"
    },
    {
     "type": "text",
     "at": [
      1.15,
      1.85
     ],
     "text": "x = 1 접선",
     "color": "gray"
    }
   ]
  },
  "plot": {
   "range": [
    -360,
    360
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "tan(x*pi/180)",
     "label": "$y=\\tan\\theta$ (기본)",
     "color": "gray",
     "dashed": true
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "label": "$y=a\\tan\\bigl(b(\\theta-c)\\bigr)+d$",
     "color": "blue"
    }
   ],
   "roots": [
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*(-3)-90)/b + 0.5",
      "=c+(180*(-3)+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*(-2)-90)/b + 0.5",
      "=c+(180*(-2)+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*(-1)-90)/b + 0.5",
      "=c+(180*(-1)+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*0-90)/b + 0.5",
      "=c+(180*0+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*1-90)/b + 0.5",
      "=c+(180*1+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*2-90)/b + 0.5",
      "=c+(180*2+90)/b - 0.5"
     ],
     "label": "근"
    },
    {
     "fn": "a*tan(b*(x-c)*pi/180) + d",
     "in": [
      "=c+(180*3-90)/b + 0.5",
      "=c+(180*3+90)/b - 0.5"
     ],
     "label": "근"
    }
   ],
   "points": [
    [
