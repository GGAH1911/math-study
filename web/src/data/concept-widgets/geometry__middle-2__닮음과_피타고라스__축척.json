{
 "id": "geometry/middle-2/닮음과_피타고라스/축척",
 "spec": {
  "title": "축척: 원점 기준 닮음변환 (x,y)→(kx,ky)",
  "params": [
   {
    "name": "k",
    "label": "축척 인수 k",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1.5,
    "step": 0.1,
    "unit": "배"
   }
  ],
  "scope": "a1x=1*k; a1y=1*k; a2x=3*k; a2y=1*k; a3x=1*k; a3y=2*k; lenRatio=abs(k); areaRatio=k^2; distA=sqrt(a1x^2+a1y^2); scaledArea=abs(a1x*(a2y-a3y)+a2x*(a3y-a1y)+a3x*(a1y-a2y))/2",
  "geometry": {
   "range": [
    -7,
    7
   ],
   "yRange": [
    -5,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O(원점)"
    },
    {
     "type": "polygon",
     "points": [
      [
       1,
       1
      ],
      [
       3,
       1
      ],
      [
       1,
       2
      ]
     ],
     "label": "원래 도형",
     "color": "#888"
    },
    {
     "type": "polygon",
     "points": [
      [
       "=a1x",
       "=a1y"
      ],
      [
       "=a2x",
       "=a2y"
      ],
      [
       "=a3x",
       "=a3y"
      ]
     ],
     "label": "축척된 도형",
     "color": "#e04040"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a2x",
      "=a2y"
     ],
     "color": "#4080e0"
    },
    {
     "type": "point",
     "at": [
      "=a2x",
      "=a2y"
     ],
     "label": "B'"
    }
   ]
  },
  "readout": [
   {
    "label": "축척 인수 k",
    "expr": "k",
    "digits": 2
   },
   {
    "label": "길이 배율 |k|",
    "expr": "lenRatio",
    "digits": 2
   },
   {
    "label": "넓이 배율 k²",
    "expr": "areaRatio",
    "digits": 2
   },
   {
    "label": "축척 도형 넓이(원래=1)",
    "expr": "scaledArea",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 2
   },
   {
    "k": 0.5
   },
   {
    "k": -1
   },
   {
    "k": 1.5
   }
  ],
  "invariants": [
   "distA-abs(k)*sqrt(2)",
   "a1x-a1y",
   "scaledArea-k^2",
   "areaRatio-k^2",
   "a2x-3*k",
   "a3y-2*k"
  ],
  "oracle": [
   {
    "params": {
     "k": 2
    },
    "expect": {
     "a1x": 2,
     "a1y": 2,
     "a2x": 6,
     "a2y": 2,
     "a3x": 2,
     "a3y": 4,
     "lenRatio": 2,
     "areaRatio": 4,
     "scaledArea": 4,
     "distA": 2.8284271247461903
    }
   },
   {
    "params": {
     "k": 0.5
    },
    "expect": {
     "a1x": 0.5,
     "a1y": 0.5,
     "a2x": 1.5,
     "a2y": 0.5,
     "a3y": 1,
     "lenRatio": 0.5,
     "areaRatio": 0.25,
     "scaledArea": 0.25
    }
   },
   {
    "params": {
     "k": -1
    },
    "expect": {
     "a1x": -1,
     "a1y": -1,
     "a2x": -3,
     "a3y": -2,
     "lenRatio": 1,
     "areaRatio": 1,
     "scaledArea": 1
    }
   }
  ],
  "tol": 0.000001
 }
}