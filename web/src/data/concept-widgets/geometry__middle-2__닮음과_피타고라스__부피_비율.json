     "from": ["=bx+sB", "=0.4+sB"],
     "to": ["=bx+sB+oB", "=0.4+sB+oB"],
     "color": "#e63946"
    },
    {
     "type": "segment",
     "from": ["=bx", "=0.4+sB"],
     "to": ["=bx+oB", "=0.4+sB+oB"],
     "color": "#e63946"
    },
    {
     "type": "text",
     "at": ["=0.4", "=0.1"],
     "text": "입체 A (닮음비 항 m)",
     "color": "#2a9d8f"
    },
    {
     "type": "text",
     "at": ["=bx", "=0.1"],
     "text": "입체 B (닮음비 항 n)",
     "color": "#e63946"
    }
   ]
  },
  "plot": {
   "range": [
    0,
    4.2
   ],
   "yRange": [
    0,
