     "label": "$x^2$ — 넓이 비 (2차원)",
     "color": "#2a9d8f"
    },
    {
     "fn": "x^3",
     "label": "$x^3$ — 부피 비 (3차원)",
     "color": "#e63946"
    },
    {
     "fn": "x^d",
     "label": "$x^{d}$ — 지금 고른 차원",
     "color": "#1d3557",
     "dashed": true
    }
   ],
   "points": [
    [
     "=r",
     "=r"
    ],
    [
     "=r",
     "=r^2"
    ],
    [
     "=r",
     "=r^3"
    ]
   ],
   "pointsLabel": "$x=\\frac{n}{m}$"
  },
  "readout": [
   {
    "label": "닮음비 배율 n/m",
    "expr": "r",
    "digits": 3
   },
   {
    "label": "넓이 비 (n/m)²",
    "expr": "sr",
    "digits": 3
   },
   {
    "label": "부피 비 (n/m)³",
    "expr": "vr",
    "digits": 3
   },
   {
    "label": "m³ — 부피비 앞항",
    "expr": "mc",
    "digits": 0
   },
   {
    "label": "n³ — 부피비 뒷항",
    "expr": "nc",
    "digits": 0
   },
   {
    "label": "고른 차원에서의 비 (n/m)^d",
    "expr": "dr",
    "digits": 3
   },
   {
    "label": "A는 B의 (부피)",
    "expr": "1/vr",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
