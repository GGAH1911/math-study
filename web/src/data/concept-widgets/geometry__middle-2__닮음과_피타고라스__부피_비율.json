   }
  ],
  "invariants": [
   "r - n/m",
   "sr - r^2",
   "vr - r^3",
   "vr - sr*r",
   "dr - r^d",
   "vr - nc/mc",
   "lr - r"
  ],
  "oracle": [
   {
    "params": {
     "m": 1,
     "n": 2,
     "d": 3
    },
