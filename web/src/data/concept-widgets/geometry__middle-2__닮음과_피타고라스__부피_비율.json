{
 "id": "geometry/middle-2/닮음과_피타고라스/부피_비율",
 "spec": {
  "title": "닮음비와 부피 비율 — 닮음비 m:n이면 부피비 m³:n³",
  "params": [
   {
    "name": "m",
    "label": "닮음비 앞항 m (입체 A)",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 1
   },
   {
    "name": "n",
    "label": "닮음비 뒷항 n (입체 B)",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 3,
    "step": 1
   },
   {
    "name": "d",
    "label": "차원 d (1=길이 · 2=넓이 · 3=부피)",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "mm = m < 1 ? 1 : m; nn = n < 1 ? 1 : n; r = nn / mm; lr = r; sr = r^2; vr = r^3; dr = r^d; mc = mm^3; nc = nn^3; sA = 1.2; sB = 1.2 * r; oA = 0.35 * sA; oB = 0.35 * sB; bx = 0.4 + sA * 1.35 + 1.0",
  "geometry": {
   "range": [
    0,
    11
   ],
   "yRange": [
    0,
    7.5
   ],
   "shapes": [
    {
     "type": "polygon",
     "vertices": [
      ["=0.4", "=0.4"],
      ["=0.4+sA", "=0.4"],
      ["=0.4+sA", "=0.4+sA"],
      ["=0.4", "=0.4+sA"]
     ],
     "fill": "#2a9d8f",
     "fillOpacity": 0.18,
     "stroke": "#2a9d8f",
     "closed": true
    },
    {
     "type": "polygon",
     "vertices": [
      ["=0.4+oA", "=0.4+oA"],
      ["=0.4+sA+oA", "=0.4+oA"],
      ["=0.4+sA+oA", "=0.4+sA+oA"],
      ["=0.4+oA", "=0.4+sA+oA"]
     ],
     "fillOpacity": 0,
     "stroke": "#a8dad8",
     "closed": true
    },
    {
     "type": "segment",
     "from": ["=0.4", "=0.4"],
     "to": ["=0.4+oA", "=0.4+oA"],
     "color": "#2a9d8f"
    },
    {
     "type": "segment",
     "from": ["=0.4+sA", "=0.4"],
     "to": ["=0.4+sA+oA", "=0.4+oA"],
     "color": "#2a9d8f"
    },
    {
     "type": "segment",
     "from": ["=0.4+sA", "=0.4+sA"],
     "to": ["=0.4+sA+oA", "=0.4+sA+oA"],
     "color": "#2a9d8f"
    },
    {
     "type": "segment",
     "from": ["=0.4", "=0.4+sA"],
     "to": ["=0.4+oA", "=0.4+sA+oA"],
     "color": "#2a9d8f"
    },
    {
