     "stroke": "#e63946",
     "closed": true
    },
    {
     "type": "polygon",
     "vertices": [
      ["=bx+oB", "=0.4+oB"],
      ["=bx+sB+oB", "=0.4+oB"],
      ["=bx+sB+oB", "=0.4+sB+oB"],
      ["=bx+oB", "=0.4+sB+oB"]
     ],
     "fillOpacity": 0,
     "stroke": "#f1a3a9",
     "closed": true
    },
    {
     "type": "segment",
     "from": ["=bx", "=0.4"],
     "to": ["=bx+oB", "=0.4+oB"],
     "color": "#e63946"
    },
    {
     "type": "segment",
     "from": ["=bx+sB", "=0.4"],
     "to": ["=bx+sB+oB", "=0.4+oB"],
