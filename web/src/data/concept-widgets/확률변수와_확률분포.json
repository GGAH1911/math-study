  "scope": "p0 = (0 <= n) ? combinations(n,0) * p^0 * (1-p)^(n-0) : 0; p1 = (1 <= n) ? combinations(n,1) * p^1 * (1-p)^(n-1) : 0; p2 = (2 <= n) ? combinations(n,2) * p^2 * (1-p)^(n-2) : 0; p3 = (3 <= n) ? combinations(n,3) * p^3 * (1-p)^(n-3) : 0; p4 = (4 <= n) ? combinations(n,4) * p^4 * (1-p)^(n-4) : 0; p5 = (5 <= n) ? combinations(n,5) * p^5 * (1-p)^(n-5) : 0; p6 = (6 <= n) ? combinations(n,6) * p^6 * (1-p)^(n-6) : 0; p7 = (7 <= n) ? combinations(n,7) * p^7 * (1-p)^(n-7) : 0; p8 = (8 <= n) ? combinations(n,8) * p^8 * (1-p)^(n-8) : 0; p9 = (9 <= n) ? combinations(n,9) * p^9 * (1-p)^(n-9) : 0; p10 = (10 <= n) ? combinations(n,10) * p^10 * (1-p)^(n-10) : 0; total = p0+p1+p2+p3+p4+p5+p6+p7+p8+p9+p10; exp_val = n*p; var_val = n*p*(1-p); mean_calc = 0*p0+1*p1+2*p2+3*p3+4*p4+5*p5+6*p6+7*p7+8*p8+9*p9+10*p10; var_calc = 0^2*p0+1^2*p1+2^2*p2+3^2*p3+4^2*p4+5^2*p5+6^2*p6+7^2*p7+8^2*p8+9^2*p9+10^2*p10-mean_calc^2",
