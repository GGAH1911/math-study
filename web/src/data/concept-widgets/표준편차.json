{
 "id": "표준편차",
 "spec": {
  "title": "표준편차 탐구",
  "params": [
   {
    "name": "center",
    "label": "평균 (center)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "spread",
    "label": "퍼짐 (spread)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "d1=center+spread*(-2); d2=center+spread*(-1); d3=center+spread*0; d4=center+spread*1; d5=center+spread*2; meanVal=(d1+d2+d3+d4+d5)/5; variance=((d1-meanVal)^2+(d2-meanVal)^2+(d3-meanVal)^2+(d4-meanVal)^2+(d5-meanVal)^2)/5; sd=sqrt(variance)",
  "geometry": {
   "range": [
    -7,
    7
   ],
   "yRange": [
    -1.2,
    1.2
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=d1",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=d2",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=d3",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=d4",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=d5",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=meanVal",
      0
     ],
     "label": "mean"
    },
    {
     "type": "segment",
     "from": [
      "=meanVal-sd",
      -0.3
     ],
     "to": [
      "=meanVal+sd",
      -0.3
     ],
     "label": "mean±sd"
    }
   ]
  },
  "readout": [
   {
    "label": "평균",
    "expr": "meanVal",
    "digits": 2
   },
   {
    "label": "분산",
    "expr": "variance",
    "digits": 2
   },
   {
    "label": "표준편차",
    "expr": "sd",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "center": 0,
    "spread": 1
   },
   {
    "center": 0,
    "spread": 2
   },
   {
    "center": -1.3,
    "spread": 0.7
   },
   {
    "center": 2,
    "spread": 0
   }
  ],
  "invariants": [
   "sd^2 - variance",
   "(d1-meanVal)+(d2-meanVal)+(d3-meanVal)+(d4-meanVal)+(d5-meanVal)",
   "meanVal - center"
  ],
  "oracle": [
   {
    "params": {
     "center": 0,
     "spread": 1
    },
    "expect": {
     "meanVal": 0,
     "variance": 2,
     "sd": 1.4142135623730951
    }
   },
   {
    "params": {
     "center": 0,
     "spread": 0
    },
    "expect": {
     "meanVal": 0,
     "variance": 0,
     "sd": 0
    }
   },
   {
    "params": {
     "center": 1.5,
     "spread": 0.5
    },
    "expect": {
     "meanVal": 1.5,
     "variance": 0.5,
     "sd": 0.7071067811865476
    }
   }
  ],
  "tol": 0.000001
 }
}