  "scope": "Ax=-2; Ay=0; Bx=2; By=0; Ox=0; Oy=(cx^2+cy^2-4)/(2*cy); dOA=sqrt((Ox-Ax)^2+(Oy-Ay)^2); dOB=sqrt((Ox-Bx)^2+(Oy-By)^2); dOC=sqrt((Ox-cx)^2+(Oy-cy)^2); R=dOA; Mabx=0; Maby=0; Macx=(Ax+cx)/2; Macy=(Ay+cy)/2; Mbcx=(Bx+cx)/2; Mbcy=(By+cy)/2",
  "geometry": {
