    },
    {
     "type": "segment",
     "from": [
      "=Mabx",
      "=Maby"
     ],
     "to": [
      "=Ox",
      "=Oy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Macx",
      "=Macy"
     ],
     "to": [
      "=Ox",
      "=Oy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Mbcx",
      "=Mbcy"
     ],
     "to": [
      "=Ox",
      "=Oy"
     ]
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
