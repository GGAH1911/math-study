   },
   {
    "label": "|OA|",
    "expr": "dOA",
    "digits": 3
   },
   {
    "label": "|OB|",
    "expr": "dOB",
    "digits": 3
   },
   {
    "label": "|OC|",
    "expr": "dOC",
    "digits": 3
   },
   {
    "label": "외접원 반지름 R",
    "expr": "R",
    "digits": 3
   }
  ]
 },
 "recipe": {
