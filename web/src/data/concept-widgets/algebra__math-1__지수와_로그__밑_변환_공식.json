{
 "id": "algebra/math-1/지수와_로그/밑_변환_공식",
 "spec": {
  "title": "밑 변환 공식",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 4,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": 2,
    "max": 10,
    "init": 10,
    "step": 0.1
   }
  ],
  "scope": "ab=log(b)/log(a); acb=log(b)/log(c); aca=log(a)/log(c); diff=ab-acb/aca",
  "plot": {
   "range": [
    0,
    9
   ],
   "yRange": [
    0,
    4
   ],
   "fns": [
    {
     "fn": "log(x)/log(a)",
     "label": "y=log_a x",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "log_a b",
    "expr": "ab",
    "digits": 6
   },
   {
    "label": "log_c b / log_c a",
    "expr": "acb/aca",
    "digits": 6
   },
   {
    "label": "차이",
    "expr": "diff",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 4,
    "c": 10
   },
   {
    "a": 3,
    "b": 8,
    "c": 10
   },
   {
    "a": 5,
    "b": 1,
    "c": 2
   },
   {
    "a": 2.5,
    "b": 6.3,
    "c": 4.2
   }
  ],
  "invariants": [
   "abs(ab-acb/aca)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 4,
     "c": 10
    },
    "expect": {
     "ab": 2,
     "acb": 0.6020599913,
     "aca": 0.3010299957,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 3,
     "b": 8,
     "c": 10
    },
    "expect": {
     "ab": 1.8927892607,
     "acb": 0.903089987,
     "aca": 0.4771212547,
     "diff": 0
    }
   },
   {
    "params": {
     "a": 5,
     "b": 1,
     "c": 2
    },
    "expect": {
     "ab": 0,
     "acb": 0,
     "aca": 2.3219280949,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}