{
 "id": "극값_조건",
 "spec": {
  "title": "극값 조건",
  "params": [
   {
    "name": "m",
    "label": "지수 m",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 2,
    "step": 1,
    "unit": ""
   },
   {
    "name": "a",
    "label": "점 a",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "h=0.1; h2=0.00001; fa=a^m; da=m*a^(m-1); left=m*(a-h)^(m-1); right=m*(a+h)^(m-1); extremum=(abs(da)<0.001)?(sign(right)-sign(left)):0; num_der=((a+h2)^m-(a-h2)^m)/(2*h2)",
  "plot": {
   "range": [
    -1.5,
    1.5
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "x^m",
     "label": "f(x)=x^m",
     "color": "blue"
    },
    {
     "fn": "m*x^(m-1)",
     "label": "f'(x)",
     "color": "green"
    },
    {
     "fn": "fa + da*(x - a)",
     "label": "접선",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 4
   },
   {
    "label": "f'(a)",
    "expr": "da",
    "digits": 4
   },
   {
    "label": "f'(a-h)",
    "expr": "left",
    "digits": 4
   },
   {
    "label": "f'(a+h)",
    "expr": "right",
    "digits": 4
   },
   {
    "label": "극값(2=극소,-2=극대,0=없음)",
    "expr": "extremum",
    "digits": 0
   },
   {
    "label": "수치미분",
    "expr": "num_der",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m": 2,
    "a": 0
   },
   {
    "m": 3,
    "a": 0
   },
   {
    "m": 2,
    "a": 1
   },
   {
    "m": 5,
    "a": 0
   },
   {
    "m": 4,
    "a": -0.5
   }
  ],
  "invariants": [
   "abs(num_der - da)",
   "abs(extremum - (abs(a)<1e-9 ? (mod(m,2)==0 ? 2 : 0) : 0))"
  ],
  "oracle": [
   {
    "params": {
     "m": 2,
     "a": 0
    },
    "expect": {
     "fa": 0,
     "da": 0,
     "num_der": 0,
     "extremum": 2
    }
   },
   {
    "params": {
     "m": 3,
     "a": 0
    },
    "expect": {
     "fa": 0,
     "da": 0,
     "num_der": 1e-10,
     "extremum": 0
    }
   },
   {
    "params": {
     "m": 2,
     "a": 1
    },
    "expect": {
     "fa": 1,
     "da": 2,
     "num_der": 2,
     "extremum": 0
    }
   }
  ],
  "tol": 0.000001
 }
}