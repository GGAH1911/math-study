   },
   {
    "a": 0.6,
    "gapx": 1,
    "L": -1,
    "R": 3,
    "fa": 0,
    "k": 0
   },
   {
    "a": 1.5,
    "gapx": 0.005,
    "L": 1,
    "R": 1,
    "fa": 1,
    "k": -2
   }
  ],
  "invariants": [
   "xv - (a - gapx)",
   "fx - (L + k*(xv - a) + (xv - a)^2)",
   "d - gapx",
   "gap - (L - fx)",
   "jump - (R - L)",
   "(fx - L) - (gapx^2 - k*gapx)",
   "err - abs(gap)"
  ],
  "oracle": [
