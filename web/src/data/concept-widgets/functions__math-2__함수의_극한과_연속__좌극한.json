{
 "id": "functions/math-2/함수의_극한과_연속/좌극한",
 "spec": {
  "title": "좌극한: $x\\to a^-$ 일 때 $f(x)\\to L$ — 좌극한 $L$·우극한 $R$·함숫값 $f(a)$ 를 직접 움직여 보기",
  "params": [
   {
    "name": "a",
    "label": "접근점 a",
    "type": "slider",
    "min": 0.6,
    "max": 2.4,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "gapx",
    "label": "왼쪽에서의 거리 a − x",
    "type": "slider",
    "min": 0.005,
    "max": 1,
    "init": 0.4,
    "step": 0.005,
    "unit": ""
   },
   {
    "name": "L",
    "label": "좌극한 L (왼쪽 가지가 향하는 값)",
    "type": "slider",
    "min": -1,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "R",
    "label": "우극한 R (오른쪽 가지가 향하는 값)",
    "type": "slider",
    "min": -1,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "fa",
    "label": "함숫값 f(a) (x=a 에서 실제 값)",
    "type": "slider",
    "min": -1,
    "max": 3,
    "init": 0.5,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "k",
    "label": "왼쪽 가지의 접근 방향/기울기 k",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1.5,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "xv = a - gapx; fx = L + k*(xv - a) + (xv - a)^2; d = gapx; gap = L - fx; err = abs(gap); jump = R - L; hasLimit = abs(R - L) < 0.0001 ? 1 : 0; contin = abs(R - L) < 0.0001 ? (abs(fa - L) < 0.0001 ? 1 : 0) : 0",
  "plot": {
   "range": [
    -1.1,
    4.1
   ],
   "yRange": [
    -1.6,
    3.8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "L + k*(x - a) + (x - a)^2",
     "range": [
      "=a - 1.6",
      "=a"
     ],
     "label": "$y=f(x)$ (왼쪽 가지, $x<a$)",
     "color": "#2563eb"
    },
    {
     "fn": "R + 0.6*(x - a)",
     "range": [
      "=a",
      "=a + 1.6"
     ],
     "label": "$y=f(x)$ (오른쪽 가지, $x>a$)",
     "color": "#0891b2"
    },
    {
     "fn": "L",
     "dashed": true,
     "color": "#dc2626",
     "label": "좌극한 $L$"
    },
    {
     "fn": "R",
     "dashed": true,
     "color": "#7c3aed",
     "label": "우극한 $R$"
    }
   ],
   "points": [
    [
     "=a",
     "=L"
    ],
    [
     "=a",
     "=R"
    ],
    [
     "=a",
     "=fa"
    ],
    [
     "=xv",
     "=fx"
    ]
   ],
   "pointsLabel": "$(a,L)$ 좌극한 · $(a,R)$ 우극한 · $(a,f(a))$ 함숫값 · $(x,f(x))$ 움직이는 점"
  },
  "readout": [
   {
    "label": "x (= a − 거리)",
    "expr": "xv",
    "digits": 3
   },
   {
    "label": "f(x)",
    "expr": "fx",
    "digits": 4
   },
   {
    "label": "a − x (왼쪽에서의 거리 δ)",
    "expr": "d",
    "digits": 4
   },
   {
    "label": "$|f(x)-L|$ (좌극한과의 오차 ε)",
    "expr": "err",
    "digits": 5
   },
   {
    "label": "R − L (우극한 − 좌극한)",
    "expr": "jump",
    "digits": 3
   },
   {
    "label": "극한 $\\lim_{x\\to a}f(x)$ 존재? (1=예)",
    "expr": "hasLimit",
    "digits": 0
   },
   {
    "label": "x=a 에서 연속? (1=예)",
    "expr": "contin",
    "digits": 0
   }
  ]
 },
 "recipe": {
