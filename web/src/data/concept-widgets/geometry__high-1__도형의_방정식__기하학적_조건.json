{
 "id": "geometry/high-1/도형의_방정식/기하학적_조건",
 "spec": {
  "title": "기하학적 조건 → 도형의 방정식: 중심에서 거리가 일정한 점의 자취(원)",
  "params": [
   {
    "name": "a",
    "label": "중심 x좌표 a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "b",
    "label": "중심 y좌표 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "r",
    "label": "거리(반지름) r",
    "type": "slider",
    "min": 0.5,
    "max": 6,
    "init": 3,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "theta",
    "label": "점 P의 위치 θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 0,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; px=a+r*cos(rad); py=b+r*sin(rad); dist=sqrt((px-a)^2+(py-b)^2); cond=(px-a)^2+(py-b)^2",
  "geometry": {
   "range": [
    -8,
    8
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      "=a",
      "=b"
     ],
     "radius": "=r",
     "label": "자취: (x-a)²+(y-b)²=r²"
    },
    {
     "type": "point",
     "at": [
      "=a",
      "=b"
     ],
     "label": "중심 C(a,b)"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      "=b"
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "거리 r"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "중심 C에서 P까지 거리",
    "expr": "dist",
    "digits": 4
   },
   {
    "label": "조건식 (px-a)²+(py-b)²",
    "expr": "cond",
    "digits": 4
   },
   {
    "label": "r²",
    "expr": "r^2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 0,
    "r": 3,
    "theta": 0
   },
   {
    "a": 1,
    "b": 2,
    "r": 5,
    "theta": 90
   },
   {
    "a": 2,
    "b": -1,
    "r": 4,
    "theta": 180
   },
   {
    "a": -3,
    "b": 1.5,
    "r": 2.5,
    "theta": 270
   }
  ],
  "invariants": [
   "(px-a)^2+(py-b)^2 - r^2",
   "dist - r",
   "cond - r^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 0,
     "r": 3,
     "theta": 0
    },
    "expect": {
     "px": 3,
     "py": 0,
     "dist": 3,
     "cond": 9
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "r": 5,
     "theta": 90
    },
    "expect": {
     "px": 1,
     "py": 7,
     "dist": 5,
     "cond": 25
    }
   },
   {
    "params": {
     "a": 2,
     "b": -1,
     "r": 4,
     "theta": 180
    },
    "expect": {
     "px": -2,
     "py": -1,
     "dist": 4,
     "cond": 16
    }
   }
  ],
  "tol": 0.000001
 }
}