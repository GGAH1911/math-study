{
 "id": "functions/high-1/함수와_그래프/고정점",
 "spec": {
  "title": "고정점: y=f(x)와 y=x의 교점",
  "params": [
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -2,
    "max": 0.25,
    "init": -2,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "d = 1 - 4*c; xp = (1 + sqrt(d))/2; xm = (1 - sqrt(d))/2",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -3,
    5
   ],
   "fns": [
    {
     "fn": "x^2 + c",
     "label": "y=f(x)=x²+c",
     "color": "#2563eb"
    },
    {
     "fn": "x",
     "label": "y=x",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "큰 고정점 x",
    "expr": "xp",
    "digits": 4
   },
   {
    "label": "작은 고정점 x",
    "expr": "xm",
    "digits": 4
   },
   {
    "label": "f(xp)=xp 검산",
    "expr": "xp^2 + c",
    "digits": 4
   },
   {
    "label": "판별식 1-4c",
    "expr": "d",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": -2
   },
   {
    "c": 0
   },
   {
    "c": -0.75
   },
   {
    "c": 0.25
   }
  ],
  "invariants": [
   "xp^2 + c - xp",
   "xm^2 + c - xm"
  ],
  "oracle": [
   {
    "params": {
     "c": -2
    },
    "expect": {
     "xp": 2,
     "xm": -1
    }
   },
   {
    "params": {
     "c": 0
    },
    "expect": {
     "xp": 1,
     "xm": 0
    }
   },
   {
    "params": {
     "c": -0.75
    },
    "expect": {
     "xp": 1.5,
     "xm": -0.5
    }
   }
  ],
  "tol": 0.000001
 }
}