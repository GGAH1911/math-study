{
 "id": "algebra/middle-2/식의_계산/근호_계산",
 "spec": {
  "title": "n제곱근의 정의",
  "params": [
   {
    "name": "n",
    "label": "n (근호 차수)",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 2,
    "step": 1
   },
   {
    "name": "a",
    "label": "a (근호 안의 수)",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "root=a^(1/n);",
  "plot": {
   "range": [
    0,
    4
   ],
   "yRange": [
    0,
    16
   ],
   "fns": [
    {
     "fn": "x^n",
     "label": "y = x^n",
     "color": "blue"
    },
    {
     "fn": "a",
     "label": "y = a",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "n제곱근 a",
    "expr": "root",
    "digits": 6
   },
   {
    "label": "(n제곱근 a)^n",
    "expr": "root^n",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 2,
    "a": 4
   },
   {
    "n": 3,
    "a": 8
   },
   {
    "n": 4,
    "a": 81
   },
   {
    "n": 5,
    "a": 32
   }
  ],
  "invariants": [
   "abs(root^n - a)"
  ],
  "oracle": [
   {
    "params": {
     "n": 2,
     "a": 4
    },
    "expect": {
     "root": 2
    }
   },
   {
    "params": {
     "n": 3,
     "a": 8
    },
    "expect": {
     "root": 2
    }
   },
   {
    "params": {
     "n": 4,
     "a": 81
    },
    "expect": {
     "root": 3
    }
   }
  ],
  "tol": 0.000001
 }
}