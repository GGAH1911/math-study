{
 "id": "functions/math-1/지수함수와_로그함수/로그함수의_그래프",
 "spec": {
  "title": "로그함수 y = log_a x 의 그래프 (지수함수의 역함수)",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.2,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "la = log(a); y2 = log(2)/log(a); y4 = log(4)/log(a); y_at1 = log(1)/log(a)",
  "plot": {
   "range": [
    -3,
    6
   ],
   "yRange": [
    -3,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "log(x)/log(a)",
     "label": "y = log_a x",
     "color": "#1565c0"
    },
    {
     "fn": "a^x",
     "label": "y = a^x (역함수, 지수함수)",
     "color": "#e53935"
    },
    {
     "fn": "x",
     "label": "y = x (대칭축)",
     "color": "#9e9e9e"
    }
   ]
  },
  "readout": [
   {
    "label": "log_a 2",
    "expr": "y2",
    "digits": 4
   },
   {
    "label": "log_a 4",
    "expr": "y4",
    "digits": 4
   },
   {
    "label": "점 (1,0) 통과 확인: log_a 1",
    "expr": "y_at1",
    "digits": 4
   },
   {
    "label": "증가/감소 (a>1이면 +)",
    "expr": "la",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2
   },
   {
    "a": 0.5
   },
   {
    "a": 3
   },
   {
    "a": 4
   }
  ],
  "invariants": [
   "y_at1",
   "a^y2 - 2",
   "a^y4 - 4"
  ],
  "oracle": [
   {
    "params": {
     "a": 2
    },
    "expect": {
     "y2": 1,
     "y4": 2,
     "y_at1": 0
    }
   },
   {
    "params": {
     "a": 4
    },
    "expect": {
     "y2": 0.5,
     "y4": 1
    }
   },
   {
    "params": {
     "a": 0.5
    },
    "expect": {
     "y2": -1,
     "y4": -2
    }
   }
  ],
  "tol": 0.000001
 }
}