{
 "id": "geometry/middle-1/평면도형/도형의_넓이_계산",
 "spec": {
  "title": "삼각형 넓이는 직사각형의 절반 — 밑변·높이가 같으면 꼭짓점 위치는 무관",
  "params": [
   {
    "name": "a",
    "label": "밑변 a",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 6,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "h",
    "label": "높이 h",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 4,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "px",
    "label": "삼각형 꼭짓점 x위치",
    "type": "slider",
    "min": -5,
    "max": 15,
    "init": 3,
    "step": 0.5,
    "unit": ""
   }
  ],
  "scope": "rectArea = a*h; triShoe = abs(0*(0-h) + a*(h-0) + px*(0-0))/2; triFormula = a*h/2; ratio = triShoe/rectArea",
  "geometry": {
   "range": [
    -6,
    16
   ],
   "yRange": [
    -2,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "label": "직사각형 a×h",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=a",
       0
      ],
      [
       "=a",
       "=h"
      ],
      [
       0,
       "=h"
      ]
     ]
    },
    {
     "type": "polygon",
     "label": "삼각형 ½·a·h",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=a",
       0
      ],
      [
       "=px",
       "=h"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=h"
     ],
     "to": [
      "=px",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=h"
     ],
     "label": "꼭짓점"
    }
   ]
  },
  "readout": [
   {
    "label": "직사각형 넓이 a×h",
    "expr": "rectArea",
    "digits": 2
   },
   {
    "label": "삼각형 넓이(좌표로 계산)",
    "expr": "triShoe",
    "digits": 2
   },
   {
    "label": "삼각형 넓이 ½·a·h",
    "expr": "triFormula",
    "digits": 2
   },
   {
    "label": "삼각형/직사각형 비",
    "expr": "ratio",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 6,
    "h": 4,
    "px": 3
   },
   {
    "a": 8,
    "h": 5,
    "px": 10
   },
   {
    "a": 4,
    "h": 4,
    "px": 0
   },
   {
    "a": 10,
    "h": 3,
    "px": -4
   }
  ],
  "invariants": [
   "triShoe - a*h/2",
   "triShoe - rectArea/2",
   "ratio - 0.5"
  ],
  "oracle": [
   {
    "params": {
     "a": 6,
     "h": 4,
     "px": 3
    },
    "expect": {
     "rectArea": 24,
     "triShoe": 12,
     "triFormula": 12
    }
   },
   {
    "params": {
     "a": 8,
     "h": 5,
     "px": 10
    },
    "expect": {
     "rectArea": 40,
     "triShoe": 20,
     "ratio": 0.5
    }
   },
   {
    "params": {
     "a": 4,
     "h": 4,
     "px": 0
    },
    "expect": {
     "rectArea": 16,
     "triShoe": 8
    }
   }
  ],
  "tol": 1e-06
 }
}
