{
 "id": "probability-stats/prob-stats-elective/확률/확률의_기본_성질",
 "spec": {
  "title": "확률의 기본 성질 탐구",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   },
   {
    "name": "pB",
    "label": "P(B)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.3,
    "step": 0.01
   },
   {
    "name": "pAB",
    "label": "P(A∩B)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.1,
    "step": 0.01
   }
  ],
  "scope": "pAonly = pA - pAB; pBonly = pB - pAB; pUnion = pA + pB - pAB; pNeither = 1 - pUnion; pAc = 1 - pA; pBc = 1 - pB; wBoth = max(0, pAB); wAonly = max(0, pAonly); wBonly = max(0, pBonly); wNeither = max(0, pNeither); x1 = wBoth; x2 = x1 + wAonly; x3 = x2 + wBonly; x4 = x3 + wNeither; mid1 = x1 * 0.5; mid2 = x1 + wAonly * 0.5; mid3 = x2 + wBonly * 0.5; mid4 = x3 + wNeither * 0.5",
  "geometry": {
   "range": [
    0,
    2.2
   ],
   "yRange": [
    -0.3,
    1.3
   ],
   "showAxes": true,
