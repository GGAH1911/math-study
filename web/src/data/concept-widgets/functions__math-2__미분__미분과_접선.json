{
 "id": "functions/math-2/미분/미분과_접선",
 "spec": {
  "title": "미분과 접선: y=x² 위의 점에서의 접선",
  "params": [
   {
    "name": "a",
    "label": "접점 x좌표 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "fa = a^2; fpa = 2*a; b = fa - a*fpa",
  "geometry": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -3,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -3,
    9
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#2563eb"
    },
    {
     "fn": "fpa*x + b",
     "label": "접선 y=f'(a)x+(f(a)-af'(a))",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "접점 P",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "접선 기울기 f'(a)",
    "expr": "fpa",
    "digits": 3
   },
   {
    "label": "접선 y절편",
    "expr": "b",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2
   },
   {
    "a": 1
   },
   {
    "a": -1
   },
   {
    "a": 0.5
   }
  ],
  "invariants": [
   "fpa - 2*a",
   "fa - a^2",
   "fpa*a + b - fa"
  ],
  "oracle": [
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 4,
     "fpa": 4,
     "b": -4
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": 1,
     "fpa": 2,
     "b": -1
    }
   },
   {
    "params": {
     "a": -1
    },
    "expect": {
     "fa": 1,
     "fpa": -2,
     "b": -1
    }
   }
  ],
  "tol": 0.000001
 }
}