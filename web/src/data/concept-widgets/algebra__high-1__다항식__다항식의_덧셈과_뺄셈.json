    {
     "fn": "c2*x^2 + c1*x + c0",
     "label": "P+Q",
     "color": "green"
    },
    {
     "fn": "d2*x^2 + d1*x + d0",
     "label": "P−Q",
     "color": "purple"
    }
   ]
  },
  "readout": [
