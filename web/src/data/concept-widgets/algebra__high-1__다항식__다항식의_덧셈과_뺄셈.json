    "label": "P+Q: x²계수",
    "expr": "c2"
   },
   {
    "label": "P+Q: x계수",
    "expr": "c1"
   },
   {
    "label": "P+Q: 상수",
    "expr": "c0"
   },
   {
    "label": "P−Q: x²계수",
    "expr": "d2"
   },
   {
    "label": "P−Q: x계수",
    "expr": "d1"
   },
   {
    "label": "P−Q: 상수",
    "expr": "d0"
   }
  ]
 },
