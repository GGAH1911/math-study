{
 "id": "functions/high-1/함수와_그래프/함수의_대칭성",
 "spec": {
  "title": "함수의 대칭성: 계수를 바꿔 짝함수·홀함수·어느 쪽도 아닌 함수 만들기",
  "params": [
   {
    "name": "c3",
    "label": "x³ 계수 c₃",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c2",
    "label": "x² 계수 c₂",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c1",
    "label": "x 계수 c₁",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": -3,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c0",
    "label": "상수항 c₀",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "a",
    "label": "기준 x좌표 a",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "fa = c3*a^3+c2*a^2+c1*a+c0; fma = -c3*a^3+c2*a^2-c1*a+c0; evenDiff = fma-fa; oddSum = fma+fa; evenBreak = abs(c3)+abs(c1); oddBreak = abs(c2)+abs(c0); idEven = evenDiff + 2*(c3*a^3+c1*a); idOdd = oddSum - 2*(c2*a^2+c0)",
  "geometry": null,
  "plot": {
   "range": [
    -2.8,
    2.8
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "c3*x^3+c2*x^2+c1*x+c0",
     "label": "$f(x)$",
     "color": "#2563eb"
    },
    {
     "fn": "-c3*x^3+c2*x^2-c1*x+c0",
     "label": "$f(-x)$ — y축으로 뒤집은 그래프",
     "color": "#059669",
     "dashed": true
    },
    {
     "fn": "c3*x^3-c2*x^2+c1*x-c0",
     "label": "$-f(-x)$ — 원점으로 180° 돌린 그래프",
     "color": "#dc2626",
     "dashed": true
    }
   ],
   "points": [
    [
     "=a",
     "=fa"
    ],
    [
     "=-a",
     "=fma"
    ],
    [
     "=-a",
     "=-fa"
    ]
   ],
   "pointsLabel": "$(a,f(a)),\\;(-a,f(-a)),\\;(-a,-f(a))$"
  },
  "readout": [
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f(-a)",
    "expr": "fma",
    "digits": 3
   },
   {
    "label": "f(-a) − f(a)  (짝함수면 0)",
    "expr": "evenDiff",
    "digits": 3
   },
   {
    "label": "f(-a) + f(a)  (홀함수면 0)",
    "expr": "oddSum",
    "digits": 3
   },
   {
    "label": "y축 대칭을 깨는 항 |c₃|+|c₁|  (0이면 짝함수)",
    "expr": "evenBreak",
    "digits": 3
   },
   {
    "label": "원점 대칭을 깨는 항 |c₂|+|c₀|  (0이면 홀함수)",
    "expr": "oddBreak",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c3": 1,
    "c2": 0,
    "c1": -3,
    "c0": 0,
    "a": 1.5
   },
   {
    "c3": 0,
    "c2": 1,
    "c1": 0,
    "c0": -2,
    "a": 1.5
   },
   {
    "c3": 0,
    "c2": 1,
    "c1": 1,
    "c0": 0,
    "a": 2
   },
   {
    "c3": 1,
    "c2": 1,
    "c1": 0,
    "c0": 0,
    "a": 1
   },
   {
    "c3": -1,
    "c2": 0,
    "c1": 0,
    "c0": 0,
    "a": -2
   }
  ],
  "invariants": [
   "idEven",
   "idOdd"
  ],
  "oracle": [
   {
    "params": {
     "c3": 1,
     "c2": 0,
     "c1": -3,
     "c0": 0,
     "a": 1.5
    },
    "expect": {
     "fa": -1.125,
     "fma": 1.125,
     "evenDiff": 2.25,
     "oddSum": 0,
     "evenBreak": 4,
     "oddBreak": 0,
     "idEven": 0,
     "idOdd": 0
    }
   },
   {
    "params": {
     "c3": 0,
     "c2": 1,
     "c1": 0,
     "c0": -2,
     "a": 1.5
    },
    "expect": {
     "fa": 0.25,
     "fma": 0.25,
     "evenDiff": 0,
     "oddSum": 0.5,
     "evenBreak": 0,
     "oddBreak": 3,
     "idEven": 0,
     "idOdd": 0
    }
   },
   {
    "params": {
     "c3": 0,
     "c2": 1,
     "c1": 1,
     "c0": 0,
     "a": 2
    },
    "expect": {
     "fa": 6,
     "fma": 2,
     "evenDiff": -4,
     "oddSum": 8,
     "evenBreak": 1,
     "oddBreak": 1,
     "idEven": 0,
     "idOdd": 0
    }
   }
  ],
  "tol": 0.000001
 }
}