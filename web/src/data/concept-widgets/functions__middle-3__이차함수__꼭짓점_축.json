{
 "id": "functions/middle-3/이차함수/꼭짓점_축",
 "spec": {
  "title": "이차함수 꼭짓점·대칭축 (표준형 y=a(x−p)²+q)",
  "params": [
   {
    "name": "a",
    "label": "a (폭·방향)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "p",
    "label": "p (축 위치)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "q",
    "label": "q (꼭짓점 높이)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -3,
    "step": 0.5
   }
  ],
  "scope": "vx=p; vy=q; b=-2*a*p; c=a*p^2+q; axis_gen=-b/(2*a); fvx=a*(vx-p)^2+q; deriv_v=2*a*(vx-p); symcheck=a*((p+1)-p)^2 - a*((p-1)-p)^2; axis_check=axis_gen-p; fval_check=fvx-vy",
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -9,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*(x-p)^2+q",
     "label": "y=a(x−p)²+q",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "꼭짓점 x = p",
    "expr": "vx",
    "digits": 2
   },
   {
    "label": "꼭짓점 y = q",
    "expr": "vy",
    "digits": 2
   },
   {
    "label": "대칭축 x = −b/2a",
    "expr": "axis_gen",
    "digits": 2
   },
   {
    "label": "일반형 b = −2ap",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "일반형 c = ap²+q",
    "expr": "c",
    "digits": 2
   },
   {
    "label": "극값(a>0 최솟값·a<0 최댓값)",
    "expr": "vy",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "p": 2,
    "q": -3
   },
   {
    "a": 2,
    "p": 2,
    "q": -3
   },
   {
    "a": -1.5,
    "p": -3,
    "q": 4
   },
   {
    "a": 0.5,
    "p": 1,
    "q": 2
   }
  ],
  "invariants": [
   "fval_check",
   "deriv_v",
   "symcheck",
   "axis_check"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "p": 2,
     "q": -3
    },
    "expect": {
     "vx": 2,
     "vy": -3,
     "b": -8,
     "c": 5,
     "axis_gen": 2
    }
   },
   {
    "params": {
     "a": 1,
     "p": 2,
     "q": -3
    },
    "expect": {
     "vx": 2,
     "vy": -3,
     "b": -4,
     "c": 1,
     "axis_gen": 2
    }
   },
   {
    "params": {
     "a": -1.5,
     "p": -3,
     "q": 4
    },
    "expect": {
     "vx": -3,
     "vy": 4,
     "b": -9,
     "c": -9.5,
     "axis_gen": -3
    }
   }
  ],
  "tol": 0.000001
 }
}