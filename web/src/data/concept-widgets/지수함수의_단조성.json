{
 "id": "지수함수의_단조성",
 "spec": {
  "title": "지수함수의 단조성",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.1,
    "max": 3,
    "init": 2,
    "step": 0.01,
    "unit": ""
   }
  ],
  "scope": "f1=a; f2=a^2; diff=f2-f1; trend=sign(a-1)",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    0,
    10
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y=a^x",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "f(1)",
    "expr": "f1",
    "digits": 4
   },
   {
    "label": "f(2)",
    "expr": "f2",
    "digits": 4
   },
   {
    "label": "f(2)-f(1)",
    "expr": "diff",
    "digits": 4
   },
   {
    "label": "증감(+1 증가, -1 감소)",
    "expr": "trend",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   0.5,
   0.75,
   1.5,
   2
  ],
  "invariants": [
   "sign(diff) - trend",
   "sign(log(a)) - trend"
  ],
  "oracle": [
   {
    "params": {
     "a": 0.5
    },
    "expect": {
     "f1": 0.5,
     "f2": 0.25,
     "diff": -0.25,
     "trend": -1
    }
   },
   {
    "params": {
     "a": 1.5
    },
    "expect": {
     "f1": 1.5,
     "f2": 2.25,
     "diff": 0.75,
     "trend": 1
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "f1": 2,
     "f2": 4,
     "diff": 2,
     "trend": 1
    }
   }
  ],
  "tol": 0.000001
 }
}