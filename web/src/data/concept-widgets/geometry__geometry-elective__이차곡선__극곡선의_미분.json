 "spec": {
  "title": "극곡선의 미분 — 리마송 r = 1 + b·cosθ 접선의 기울기",
  "params": [
   {
    "name": "b",
    "label": "b (곡선 모양)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 0.5,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "theta",
    "label": "θ (점의 각도)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; r=1+b*cos(rad); dr=-b*sin(rad); px=r*cos(rad); py=r*sin(rad); num=dr*sin(rad)+r*cos(rad); den=dr*cos(rad)-r*sin(rad); slope=num/den; L=sqrt(num^2+den^2); tnx=den/L; tny=num/L",
