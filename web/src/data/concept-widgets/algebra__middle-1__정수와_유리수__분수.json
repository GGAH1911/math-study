     "from": [
      0,
      0
     ],
     "to": [
      "=value",
      0
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "a/b",
    "expr": "value",
    "digits": 4
   },
   {
    "label": "분자",
    "expr": "a",
    "digits": 0
   },
   {
    "label": "분모",
    "expr": "b",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
