{
 "id": "사면체",
 "spec": {
  "title": "정사면체의 부피",
  "params": [
   {
    "name": "a",
    "label": "한 변의 길이 a",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "h = a * sqrt(2/3); S = sqrt(3)/4 * a^2; V = a^3/(6*sqrt(2)); Ax = -a/2; Ay = -a/(2*sqrt(3)); Bx = a/2; By = Ay; Cx = 0; Cy = a/sqrt(3); Dx = 0; Dy = 0; Az = 0; Bz = 0; Cz = 0; Dz = h",
  "geometry": {
   "range": [
    -1.2,
    1.2
   ],
   "yRange": [
    -0.8,
    1.3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=Ax",
      "=Ay"
     ],
     "to": [
      "=Bx",
      "=By"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Bx",
      "=By"
     ],
     "to": [
      "=Cx",
      "=Cy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Cx",
      "=Cy"
     ],
     "to": [
      "=Ax",
      "=Ay"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Dx",
      "=Dy"
     ],
     "to": [
      "=Ax",
      "=Ay"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Dx",
      "=Dy"
     ],
     "to": [
      "=Bx",
      "=By"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Dx",
      "=Dy"
     ],
     "to": [
      "=Cx",
      "=Cy"
     ]
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    },
    {
     "type": "point",
     "at": [
      "=Dx",
      "=Dy"
     ],
     "label": "D"
    }
   ]
  },
  "readout": [
   {
    "label": "높이 h",
    "expr": "h",
    "digits": 4
   },
   {
    "label": "밑면 넓이 S",
    "expr": "S",
    "digits": 4
   },
   {
    "label": "부피 V",
    "expr": "V",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5
   },
   {
    "a": 1
   },
   {
    "a": 1.5
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "V - (1/3)*S*h",
   "(Ax-Bx)^2 + (Ay-By)^2 - a^2",
   "(Dx-Ax)^2 + (Dy-Ay)^2 + (Dz-Az)^2 - a^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
