{
 "id": "functions/math-2/미분/함수의_증감",
 "spec": {
  "title": "함수의 증감과 접선의 기울기 — f(x)=x³−3x²+1",
  "params": [
   {
    "name": "a",
    "label": "접점 x좌표 a",
    "type": "slider",
    "min": -1,
    "max": 3,
    "init": 0.5,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fa = a^3 - 3*a^2 + 1; fpa = 3*a^2 - 6*a",
  "geometry": {
   "range": [
    -1.2,
    3.2
   ],
   "yRange": [
    -5,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -1.2,
    3.2
   ],
   "yRange": [
    -5,
    4
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x^2 + 1",
     "label": "f(x)=x³−3x²+1",
     "color": "#2563eb"
    },
    {
     "fn": "fa + fpa*(x - a)",
     "label": "x=a에서의 접선 (기울기 f'(a))",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "접점 x = a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f'(a) = 접선 기울기",
    "expr": "fpa",
    "digits": 3
   },
   {
    "label": "부호 sign f'(a) [+1증가 / −1감소 / 0정지]",
    "expr": "sign(fpa)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1
   },
   {
    "a": 0.5
   },
   {
    "a": 1.5
   },
   {
    "a": 3
   }
  ],
  "invariants": [
   "fpa - 3*a*(a-2)",
   "fa - (a^3 - 3*a^2 + 1)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "fa": 1,
     "fpa": 0
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": -1,
     "fpa": -3
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": -3,
     "fpa": 0
    }
   },
   {
    "params": {
     "a": 3
    },
    "expect": {
     "fa": 1,
     "fpa": 9
    }
   }
  ],
  "tol": 0.000001
 }
}