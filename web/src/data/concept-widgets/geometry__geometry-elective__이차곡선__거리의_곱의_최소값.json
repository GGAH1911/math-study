{
 "id": "geometry/geometry-elective/이차곡선/거리의_곱의_최소값",
 "spec": {
  "title": "이차곡선 위 점에서 두 초점까지 거리의 곱 r₁·r₂ (타원)",
  "params": [
   {
    "name": "t",
    "label": "점 P의 위치 θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
