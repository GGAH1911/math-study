{
 "id": "블록묶음",
 "spec": {
  "title": "블록묶음",
  "params": [
   {
    "name": "n",
    "label": "덩어리 크기 n",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 1
   },
   {
    "name": "m",
    "label": "나머지 원소 수 m",
    "type": "slider",
    "min": 0,
    "max": 5,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "int_perm=factorial(n); ext_perm=factorial(m+1); total=ext_perm*int_perm;",
  "geometry": {
   "range": [
    -2,
    8
   ],
   "yRange": [
    -1.2,
    1.2
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
    {
     "type": "polygon",
     "vertices": [
      [
       0.5,
       -0.7
      ],
      [
       1.5,
       -0.7
      ],
      [
       1.5,
       0.7
      ],
      [
       0.5,
       0.7
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      1,
      0
     ],
     "label": "블록"
    },
    {
     "type": "circle",
     "center": [
      "=(1<=n) ? (0.5+1.0*1/(n+1)) : 999",
      "=0"
     ],
     "radius": 0.07
    },
    {
     "type": "circle",
     "center": [
      "=(2<=n) ? (0.5+1.0*2/(n+1)) : 999",
      "=0"
     ],
     "radius": 0.07
    },
    {
     "type": "circle",
     "center": [
      "=(3<=n) ? (0.5+1.0*3/(n+1)) : 999",
      "=0"
     ],
     "radius": 0.07
    },
    {
     "type": "circle",
     "center": [
      "=(4<=n) ? (0.5+1.0*4/(n+1)) : 999",
      "=0"
     ],
     "radius": 0.07
    },
    {
     "type": "circle",
     "center": [
      "=(5<=n) ? (0.5+1.0*5/(n+1)) : 999",
      "=0"
     ],
     "radius": 0.07
    },
    {
     "type": "circle",
     "center": [
      "=(1<=m) ? (1+1) : 999",
      "=0"
     ],
     "radius": 0.1
    },
    {
     "type": "circle",
     "center": [
      "=(2<=m) ? (1+2) : 999",
      "=0"
     ],
     "radius": 0.1
    },
    {
     "type": "circle",
     "center": [
      "=(3<=m) ? (1+3) : 999",
      "=0"
     ],
     "radius": 0.1
    },
    {
     "type": "circle",
     "center": [
      "=(4<=m) ? (1+4) : 999",
      "=0"
     ],
     "radius": 0.1
    },
    {
     "type": "circle",
     "center": [
      "=(5<=m) ? (1+5) : 999",
      "=0"
     ],
     "radius": 0.1
    }
   ]
  },
  "readout": [
   {
    "label": "블록 내부 배열 (n!)",
    "expr": "int_perm"
   },
   {
    "label": "블록 포함 배열 ((m+1)!)",
    "expr": "ext_perm"
   },
   {
    "label": "총 배열 수",
    "expr": "total"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "m": 0
   },
   {
    "n": 2,
    "m": 3
   },
   {
    "n": 3,
    "m": 1
   },
   {
    "n": 5,
    "m": 2
   }
  ],
  "invariants": [
   "ext_perm - (m+1)*factorial(m)",
   "int_perm - n*factorial(n-1)",
   "total - ext_perm*int_perm"
  ],
  "oracle": [
   {
    "params": {
     "n": 2,
     "m": 3
    },
    "expect": {
     "int_perm": 2,
     "ext_perm": 24,
     "total": 48
    }
   },
   {
    "params": {
     "n": 3,
     "m": 1
    },
    "expect": {
     "int_perm": 6,
     "ext_perm": 2,
     "total": 12
    }
   },
   {
    "params": {
     "n": 1,
     "m": 0
    },
    "expect": {
     "int_perm": 1,
     "ext_perm": 1,
     "total": 1
    }
   }
  ],
  "tol": 1e-06
 }
}
