{
 "id": "geometry/geometry-elective/이차곡선/초점과_준선",
 "spec": {
  "title": "포물선의 정의 — 초점과 준선까지의 거리가 같다",
  "params": [
   {
    "name": "p",
    "label": "초점거리 p (F=(0,p), 준선 y=−p)",
    "type": "slider",
    "min": 0.5,
    "max": 2.5,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x",
    "label": "포물선 위 점 P의 x좌표",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "py = x^2/(4*p); PF = sqrt(x^2 + (py-p)^2); PH = py + p",
  "geometry": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -3,
    8.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "label": "포물선",
     "color": "#1f77b4",
     "vertices": [
      [
       -4,
       "=16/(4*p)"
      ],
      [
       -3.5,
       "=12.25/(4*p)"
      ],
      [
       -3,
       "=9/(4*p)"
      ],
      [
       -2.5,
       "=6.25/(4*p)"
      ],
      [
       -2,
       "=4/(4*p)"
      ],
      [
       -1.5,
       "=2.25/(4*p)"
      ],
      [
       -1,
       "=1/(4*p)"
      ],
      [
       -0.5,
       "=0.25/(4*p)"
      ],
      [
       0,
       0
      ],
      [
       0.5,
       "=0.25/(4*p)"
      ],
      [
       1,
       "=1/(4*p)"
      ],
      [
       1.5,
       "=2.25/(4*p)"
      ],
      [
       2,
       "=4/(4*p)"
      ],
      [
       2.5,
       "=6.25/(4*p)"
      ],
      [
       3,
       "=9/(4*p)"
      ],
      [
       3.5,
       "=12.25/(4*p)"
      ],
      [
       4,
       "=16/(4*p)"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      -5,
      "=-p"
     ],
     "to": [
      5,
      "=-p"
     ],
     "label": "준선 l: y=−p",
     "color": "#888888"
    },
    {
     "type": "point",
     "at": [
      0,
      "=p"
     ],
     "label": "F (초점)",
     "color": "#d62728"
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=py"
     ],
     "label": "P",
     "color": "#2ca02c"
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=-p"
     ],
     "label": "H",
     "color": "#888888"
    },
    {
     "type": "segment",
     "from": [
      "=x",
      "=py"
     ],
     "to": [
      0,
      "=p"
     ],
     "label": "|PF|",
     "color": "#d62728"
    },
    {
     "type": "segment",
     "from": [
      "=x",
      "=py"
     ],
     "to": [
      "=x",
      "=-p"
     ],
     "label": "d(P,l)=|PH|",
     "color": "#ff7f0e"
    }
   ]
  },
  "readout": [
   {
    "label": "|PF| (P→초점)",
    "expr": "PF",
    "digits": 3
   },
   {
    "label": "d(P,l) (P→준선)",
    "expr": "PH",
    "digits": 3
   },
   {
    "label": "차이 |PF|−d(P,l)",
    "expr": "PF-PH",
    "digits": 6
   },
   {
    "label": "매개변수 |FH|",
    "expr": "2*p",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 1,
    "x": 2
   },
   {
    "p": 0.5,
    "x": 1
   },
   {
    "p": 2,
    "x": 4
   },
   {
    "p": 1.5,
    "x": -3
   }
  ],
  "invariants": [
   "PF - PH",
   "x^2 - 4*p*py"
  ],
  "oracle": [
   {
    "params": {
     "p": 1,
     "x": 2
    },
    "expect": {
     "py": 1,
     "PF": 2,
     "PH": 2
    }
   },
   {
    "params": {
     "p": 0.5,
     "x": 1
    },
    "expect": {
     "py": 0.5,
     "PF": 1,
     "PH": 1
    }
   },
   {
    "params": {
     "p": 2,
     "x": 4
    },
    "expect": {
     "py": 2,
     "PF": 4,
     "PH": 4
    }
   }
  ],
  "tol": 1e-06
 }
}
