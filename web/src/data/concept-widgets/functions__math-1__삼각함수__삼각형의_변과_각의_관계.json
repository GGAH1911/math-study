{
 "id": "functions/math-1/삼각함수/삼각형의_변과_각의_관계",
 "spec": {
  "title": "삼각형의 변과 각의 관계 — 사인법칙·코사인법칙",
  "params": [
   {
    "name": "b",
    "label": "변 b (=AC)",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 4,
    "step": 0.5
   },
   {
    "name": "c",
    "label": "변 c (=AB)",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 5,
    "step": 0.5
   },
   {
    "name": "A",
    "label": "∠A",
    "type": "slider",
    "min": 20,
    "max": 150,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "Arad=A*pi/180; Ax=0; Ay=0; Bx=c; By=0; Cx=b*cos(Arad); Cy=b*sin(Arad); a=sqrt(b^2+c^2-2*b*c*cos(Arad)); Brad=acos((a^2+c^2-b^2)/(2*a*c)); Crad=acos((a^2+b^2-c^2)/(2*a*b)); Bdeg=Brad*180/pi; Cdeg=Crad*180/pi; Ox=c/2; Oy=(Cx^2+Cy^2-c*Cx)/(2*Cy); R=sqrt(Ox^2+Oy^2)",
  "geometry": {
   "range": [
    -7.5,
    10
   ],
   "yRange": [
    -4,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      "=Ox",
      "=Oy"
     ],
     "radius": "=R",
     "label": "외접원 R"
    },
    {
