   "b/sin(Brad)-c/sin(Crad)",
   "a/sin(Arad)-2*R",
   "Arad+Brad+Crad-pi",
   "(Cx-Ox)^2+(Cy-Oy)^2-R^2",
   "(Bx-Ox)^2+(By-Oy)^2-R^2"
  ],
