     "vertices": [
      [
       "=Ax",
       "=Ay"
      ],
      [
       "=Bx",
       "=By"
      ],
      [
       "=Cx",
       "=Cy"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    },
    {
     "type": "point",
     "at": [
      "=Ox",
      "=Oy"
     ],
     "label": "O"
    }
   ]
  },
  "readout": [
   {
    "label": "a = √(b²+c²−2bc·cosA)",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "∠B",
    "expr": "Bdeg",
    "digits": 1
   },
   {
    "label": "∠C",
    "expr": "Cdeg",
    "digits": 1
   },
   {
    "label": "∠A+∠B+∠C",
    "expr": "A+Bdeg+Cdeg",
    "digits": 1
   },
   {
    "label": "a/sinA",
    "expr": "a/sin(Arad)",
    "digits": 3
   },
   {
    "label": "b/sinB",
    "expr": "b/sin(Brad)",
    "digits": 3
   },
   {
    "label": "2R",
    "expr": "2*R",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 4,
    "c": 5,
    "A": 60
   },
   {
    "b": 3,
    "c": 4,
    "A": 90
   },
   {
    "b": 2,
    "c": 3,
    "A": 120
   },
   {
    "b": 6,
    "c": 6,
