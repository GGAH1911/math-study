{
 "id": "functions/math-2/미분/도함수의_연속성",
 "spec": {
  "title": "도함수의 연속성: 미분가능하지만 f′이 불연속인 함수 f(x)=x²sin(1/x)",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (관찰점)",
    "type": "slider",
    "min": 0.02,
    "max": 1,
    "init": 0.5,
    "step": 0.001
   }
  ],
  "scope": "r=1/x0; f0=x0^2*sin(r); fp0=2*x0*sin(r)-cos(r)",
  "plot": {
   "range": [
    -1,
    1
   ],
   "yRange": [
    -2,
    2
   ],
   "fns": [
    {
     "fn": "x^2*sin(1/x)",
     "label": "f(x)=x²·sin(1/x) (모든 점에서 미분가능)",
     "color": "#2563eb"
    },
    {
     "fn": "2*x*sin(1/x)-cos(1/x)",
     "label": "f'(x)=2x·sin(1/x)−cos(1/x) (x=0에서 불연속)",
     "color": "#dc2626"
    },
    {
     "fn": "f0+fp0*(x-x0)",
     "label": "x₀에서의 접선",
     "color": "#16a34a"
    }
   ]
  },
  "readout": [
   {
    "label": "x₀",
    "expr": "x0",
    "digits": 3
   },
   {
    "label": "f(x₀)",
    "expr": "f0",
    "digits": 4
   },
   {
    "label": "f'(x₀) = 접선 기울기",
    "expr": "fp0",
    "digits": 4
   },
   {
    "label": "1/x₀ (0에 가까울수록 폭증)",
    "expr": "r",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 0.5
   },
   {
    "x0": 0.3
   },
   {
    "x0": 0.8
   },
   {
    "x0": 0.15
   }
  ],
  "invariants": [
   "fp0-(2*f0/x0-cos(r))",
   "f0-sin(r)/r^2"
  ],
  "oracle": [
   {
    "params": {
     "x0": 0.3183098861837907
    },
    "expect": {
     "f0": 0,
     "fp0": 1
    }
   },
   {
    "params": {
     "x0": 0.15915494309189535
    },
    "expect": {
     "f0": 0,
     "fp0": -1
    }
   },
   {
    "params": {
     "x0": 0.6366197723675814
    },
    "expect": {
     "f0": 0.4052847345693511,
     "fp0": 1.2732395447351628
    }
   }
  ],
  "tol": 0.000001
 }
}