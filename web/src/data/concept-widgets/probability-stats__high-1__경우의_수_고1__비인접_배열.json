{
 "id": "probability-stats/high-1/경우의_수_고1/비인접_배열",
 "spec": {
  "title": "비인접 배열",
  "params": [
   {
    "name": "n",
    "label": "n (자리 수)",
    "type": "slider",
    "min": 2,
    "max": 10,
    "init": 8,
    "step": 1
   },
   {
    "name": "r",
    "label": "r (선택 수)",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "possible = r <= n - r + 1 ? 1 : 0; count = possible == 1 ? combinations(n - r + 1, r) : 0",
  "geometry": {
   "range": [
    -0.5,
    10.5
   ],
   "yRange": [
    -0.8,
    0.8
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
