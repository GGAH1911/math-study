     "type": "segment",
     "from": [
      "=1",
      "=0"
     ],
     "to": [
      "=n",
      "=0"
     ]
    },
    {
     "type": "circle",
     "center": [
      1,
      0
     ],
     "radius": "= (1 <= n ? 0.2 : 0)"
    },
    {
     "type": "circle",
     "center": [
      2,
      0
     ],
     "radius": "= (2 <= n ? 0.2 : 0)"
    },
    {
