     ]
    },
    {
     "type": "point",
     "at": [
      "= (possible == 1 and 4 <= 2*r - 1 and mod(4,2)==1) ? 4 : 1000",
      "=0"
     ]
    },
    {
     "type": "point",
     "at": [
      "= (possible == 1 and 5 <= 2*r - 1 and mod(5,2)==1) ? 5 : 1000",
