     ]
    },
    {
     "type": "point",
     "at": [
      "= (possible == 1 and 8 <= 2*r - 1 and mod(8,2)==1) ? 8 : 1000",
      "=0"
     ]
    },
    {
     "type": "point",
     "at": [
      "= (possible == 1 and 9 <= 2*r - 1 and mod(9,2)==1) ? 9 : 1000",
      "=0"
     ]
    },
    {
     "type": "point",
     "at": [
      "= (possible == 1 and 10 <= 2*r - 1 and mod(10,2)==1) ? 10 : 1000",
      "=0"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "r",
    "expr": "r"
   },
   {
    "label": "n-r+1",
    "expr": "n - r + 1"
   },
   {
    "label": "경우의 수",
    "expr": "count"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 8,
    "r": 3
   },
   {
    "n": 5,
    "r": 3
   },
   {
    "n": 4,
    "r": 3
   },
   {
    "n": 2,
    "r": 1
   }
  ],
  "invariants": [
   "count - (r <= n - r ? combinations(n - r, r) : 0) - (r >= 1 ? (r - 1 <= n - r ? combinations(n - r, r - 1) : 0) : 0)"
  ],
  "oracle": [
   {
    "params": {
     "n": 8,
     "r": 3
    },
    "expect": {
     "possible": 1,
     "count": 20
    }
   },
   {
    "params": {
     "n": 5,
     "r": 3
    },
    "expect": {
     "possible": 1,
     "count": 1
    }
   },
   {
    "params": {
     "n": 4,
     "r": 3
    },
    "expect": {
     "possible": 0,
     "count": 0
    }
   },
   {
    "params": {
     "n": 2,
     "r": 1
    },
    "expect": {
     "possible": 1,
     "count": 2
    }
   }
  ],
  "tol": 0.000001
 }
