{
 "id": "algebra/middle-3/인수분해/인수",
 "spec": {
  "title": "인수의 의미 (넓이 모형)",
  "params": [
   {
    "name": "m",
    "label": "m",
    "type": "slider",
    "min": 0,
    "max": 5,
    "init": 2,
    "step": 1
   },
   {
    "name": "n",
    "label": "n",
    "type": "slider",
    "min": 0,
    "max": 5,
    "init": 3,
    "step": 1
   },
   {
    "name": "x",
    "label": "x",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "factor1 = x + m; factor2 = x + n; areaBigSquare = x^2; areaRec1 = m*x; areaRec2 = n*x; areaSmall = m*n; totalArea = factor1 * factor2; expanded = x^2 + (m+n)*x + m*n",
  "geometry": {
   "range": [
    -1,
    11
   ],
   "yRange": [
    -1,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       0,
       0
      ],
      [
       "=factor1",
       0
      ],
      [
       "=factor1",
       "=factor2"
      ],
      [
       0,
       "=factor2"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      "=x",
      0
     ],
     "to": [
      "=x",
      "=factor2"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      "=x"
     ],
     "to": [
      "=factor1",
      "=x"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "한 변의 길이 (x+m)",
    "expr": "factor1",
    "digits": 0
   },
   {
    "label": "다른 변의 길이 (x+n)",
    "expr": "factor2",
    "digits": 0
   },
   {
    "label": "x²",
    "expr": "areaBigSquare",
    "digits": 0
   },
   {
    "label": "mx",
    "expr": "areaRec1",
    "digits": 0
   },
   {
    "label": "nx",
    "expr": "areaRec2",
    "digits": 0
   },
   {
    "label": "mn",
    "expr": "areaSmall",
    "digits": 0
   },
   {
    "label": "총 넓이 = (x+m)(x+n)",
    "expr": "totalArea",
    "digits": 0
   },
   {
    "label": "전개식 = x²+(m+n)x+mn",
    "expr": "expanded",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m": 2,
    "n": 3,
    "x": 4
   },
   {
    "m": 0,
    "n": 2,
    "x": 1
   },
   {
    "m": 5,
    "n": 0,
    "x": 3
   },
   {
    "m": 3,
    "n": 4,
    "x": 2
   }
  ],
  "invariants": [
   "totalArea - expanded",
   "totalArea - (areaBigSquare + areaRec1 + areaRec2 + areaSmall)"
  ],
  "oracle": [
   {
    "params": {
     "m": 2,
     "n": 3,
     "x": 4
    },
    "expect": {
     "totalArea": 42,
     "expanded": 42,
     "areaBigSquare": 16,
     "areaRec1": 8,
     "areaRec2": 12,
     "areaSmall": 6,
     "factor1": 6,
     "factor2": 7
    }
   },
   {
    "params": {
     "m": 1,
     "n": 1,
     "x": 1
    },
    "expect": {
     "totalArea": 4,
     "expanded": 4,
     "areaBigSquare": 1,
     "areaRec1": 1,
     "areaRec2": 1,
     "areaSmall": 1,
     "factor1": 2,
     "factor2": 2
    }
   },
   {
    "params": {
     "m": 3,
     "n": 4,
     "x": 5
    },
    "expect": {
     "totalArea": 72,
     "expanded": 72,
     "areaBigSquare": 25,
     "areaRec1": 15,
     "areaRec2": 20,
     "areaSmall": 12,
     "factor1": 8,
     "factor2": 9
    }
   }
  ],
  "tol": 0.000001
 }
}