{
 "id": "geometry/geometry-elective/평면벡터/직교",
 "spec": {
  "title": "평면벡터의 직교 — 내적이 0",
  "params": [
   {
    "name": "a1",
    "label": "a₁",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "a2",
    "label": "a₂",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b1",
    "label": "b₁",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "b2",
    "label": "b₂",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1
   }
  ],
  "scope": "dot = a1*b1 + a2*b2; na = sqrt(a1^2 + a2^2); nb = sqrt(b1^2 + b2^2); px = -a2; py = a1; perpdot = px*a1 + py*a2; ang = acos(dot/(na*nb))*180/pi",
  "geometry": {
   "range": [
    -5.5,
    5.5
   ],
   "yRange": [
    -5.5,
    5.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a1",
      "=a2"
     ],
     "label": "a",
     "color": "#2563eb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=b1",
      "=b2"
     ],
     "label": "b",
     "color": "#dc2626"
    },
    {
     "type": "point",
     "at": [
      "=a1",
      "=a2"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=b1",
      "=b2"
     ],
     "label": "B"
    }
   ]
  },
  "readout": [
   {
    "label": "a·b (내적)",
    "expr": "dot",
    "digits": 3
   },
   {
    "label": "두 벡터가 이루는 각 θ(°)",
    "expr": "ang",
    "digits": 1
   },
   {
    "label": "|a|",
    "expr": "na",
    "digits": 3
   },
   {
    "label": "|b|",
    "expr": "nb",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a1": 2,
    "a2": 3,
    "b1": 1,
    "b2": -1
   },
   {
    "a1": -1,
    "a2": 4,
    "b1": 2,
    "b2": 2
   },
   {
    "a1": 5,
    "a2": -2,
    "b1": 0,
    "b2": 3
   },
   {
    "a1": 1,
    "a2": 1,
    "b1": -3,
    "b2": 3
   }
  ],
  "invariants": [
   "perpdot",
   "dot - na*nb*cos(ang*pi/180)",
   "dot - (a1*b1 + a2*b2)"
  ],
  "oracle": [
   {
    "params": {
     "a1": 3,
     "a2": 1,
     "b1": -1,
     "b2": 3
    },
    "expect": {
     "dot": 0,
     "perpdot": 0
    }
   },
   {
    "params": {
     "a1": 2,
     "a2": 0,
     "b1": 3,
     "b2": 4
    },
    "expect": {
     "dot": 6,
     "na": 2,
     "nb": 5
    }
   },
   {
    "params": {
     "a1": 1,
     "a2": 2,
     "b1": 2,
     "b2": -1
    },
    "expect": {
     "dot": 0
    }
   }
  ],
  "tol": 0.000001
 }
}