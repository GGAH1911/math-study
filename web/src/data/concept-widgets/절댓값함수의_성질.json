{
 "id": "절댓값함수의_성질",
 "spec": {
  "title": "절댓값함수의 그래프와 성질",
  "params": [
   {
    "name": "a",
    "label": "기준점 a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "점의 x좌표",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "piece = x0 >= a ? x0 - a : a - x0; py = abs(x0 - a);",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -5,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "x - a",
     "label": "y = x - a",
     "color": "gray"
    },
    {
     "fn": "abs(x - a)",
     "label": "y = |x - a|",
     "color": "#2196F3"
    }
   ],
   "points": [
    [
     "=x0",
     "=abs(x0 - a)"
    ]
   ],
   "pointsLabel": "$(x_0,\\ |x_0-a|)$"
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 1
   },
   {
    "label": "x₀",
    "expr": "x0",
    "digits": 1
   },
   {
    "label": "|x₀ - a|",
    "expr": "abs(x0 - a)",
    "digits": 3
   },
   {
    "label": "구간별 값",
    "expr": "piece",
    "digits": 3
   },
   {
    "label": "두 값 일치(0이면 참)",
    "expr": "abs(piece - abs(x0 - a))",
    "digits": 1
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -3,
    "x0": 1
   },
   {
    "a": 0,
    "x0": -2
   },
   {
    "a": 2.5,
    "x0": 4
   },
   {
    "a": -1,
    "x0": -1
   }
  ],
  "invariants": [
   "abs(x0 - a) - piece",
   "py - abs(x0 - a)",
   "abs(x0 - a) - sqrt((x0 - a)^2)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "x0": 2
    },
    "expect": {
     "piece": 2,
     "py": 2
    }
   },
   {
    "params": {
     "a": 0,
     "x0": -2
    },
    "expect": {
     "piece": 2,
     "py": 2
    }
   },
   {
    "params": {
     "a": 3,
     "x0": 1
    },
    "expect": {
     "piece": 2,
     "py": 2
    }
   },
   {
    "params": {
     "a": -1,
     "x0": 4
    },
    "expect": {
     "piece": 5,
     "py": 5
    }
   }
  ],
  "tol": 0.000001
 }
}