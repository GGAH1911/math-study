{
 "id": "geometry/geometry-elective/평면벡터/벡터_방정식과_조건",
 "spec": {
  "title": "직선의 벡터 방정식 OP = OA + t·d",
  "params": [
   {
    "name": "theta",
    "label": "방향벡터 각도 θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "t",
    "label": "매개변수 t",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "rad=theta*pi/180; ax=1; ay=1; dx=cos(rad); dy=sin(rad); px=ax+t*dx; py=ay+t*dy; lenAP=sqrt((px-ax)^2+(py-ay)^2)",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "line",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=ax+dx",
      "=ay+dy"
     ],
     "label": "직선 ℓ"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=ax",
      "=ay"
     ],
     "label": "OA"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "OP"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "t·d"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=ax+dx",
      "=ay+dy"
     ],
     "label": "d (단위방향)"
    }
   ]
  },
  "readout": [
   {
    "label": "t",
    "expr": "t",
    "digits": 2
   },
   {
    "label": "P_x",
    "expr": "px",
    "digits": 3
   },
   {
    "label": "P_y",
    "expr": "py",
    "digits": 3
   },
   {
    "label": "|AP| = |t|",
    "expr": "lenAP",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 0,
    "t": 2
   },
   {
    "theta": 90,
    "t": 3
   },
   {
    "theta": 30,
    "t": 2
   },
   {
    "theta": 45,
    "t": -2
   }
  ],
  "invariants": [
   "dx^2+dy^2-1",
   "(px-ax)*dy-(py-ay)*dx",
   "(px-ax)^2+(py-ay)^2-t^2",
   "lenAP-abs(t)"
  ],
  "oracle": [
   {
    "params": {
     "theta": 0,
     "t": 2
    },
    "expect": {
     "dx": 1,
     "dy": 0,
     "px": 3,
     "py": 1
    }
   },
   {
    "params": {
     "theta": 90,
     "t": 3
    },
    "expect": {
     "dx": 0,
     "dy": 1,
     "px": 1,
     "py": 4
    }
   },
   {
    "params": {
     "theta": 30,
     "t": 2
    },
    "expect": {
     "dx": 0.8660254037844387,
     "dy": 0.5,
     "px": 2.732050807568877,
     "py": 2
    }
   }
  ],
  "tol": 0.000001
 }
}