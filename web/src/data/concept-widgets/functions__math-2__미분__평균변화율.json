{
 "id": "functions/math-2/미분/평균변화율",
 "spec": {
  "title": "평균변화율: 두 점을 잇는 할선의 기울기",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "fa = a^2; fb = b^2; m = (fb - fa)/(b - a)",
  "plot": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -1,
    10
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x) = x²",
     "color": "#2563eb"
    },
    {
     "fn": "m*(x - a) + fa",
     "label": "할선 (기울기 = 평균변화율)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "Δx = b − a",
    "expr": "b - a",
    "digits": 3
   },
   {
    "label": "Δy = f(b) − f(a)",
    "expr": "fb - fa",
    "digits": 3
   },
   {
    "label": "평균변화율 = Δy/Δx",
    "expr": "m",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1,
    "b": 2
   },
   {
    "a": 0,
    "b": 3
   },
   {
    "a": 1,
    "b": 2
   },
   {
    "a": -2,
    "b": 1
   }
  ],
  "invariants": [
   "m*(b - a) - (fb - fa)",
   "m - (a + b)",
   "(m*(a - a) + fa) - fa",
   "(m*(b - a) + fa) - fb"
  ],
  "oracle": [
   {
    "params": {
     "a": -1,
     "b": 2
    },
    "expect": {
     "fa": 1,
     "fb": 4,
     "m": 1
    }
   },
   {
    "params": {
     "a": 0,
     "b": 3
    },
    "expect": {
     "fa": 0,
     "fb": 9,
     "m": 3
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "fa": 1,
     "fb": 4,
     "m": 3
    }
   }
  ],
  "tol": 0.000001
 }
}