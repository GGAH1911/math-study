{
 "id": "functions/high-1/함수와_그래프/구간별_함수",
 "spec": {
  "title": "구간별 함수: f(x) = ⎰ −2 (x<−1) ⎱ 2x (−1≤x<1) ⎰ 2 (x≥1)",
  "params": [
   {
    "name": "x",
    "label": "x (입력값)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0.5,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "fx = x < -1 ? -2 : (x < 1 ? 2*x : 2); piece = x < -1 ? 1 : (x < 1 ? 2 : 3)",
  "geometry": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -3,
    3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "line",
     "from": [
      -1,
      -3
     ],
     "to": [
      -1,
      3
     ],
     "dashed": true,
     "color": "#bbbbbb",
     "label": "x=-1"
    },
    {
     "type": "line",
     "from": [
      1,
      -3
     ],
     "to": [
      1,
      3
     ],
     "dashed": true,
     "color": "#bbbbbb",
     "label": "x=1"
    },
    {
     "type": "segment",
     "from": [
      -3,
      -2
     ],
     "to": [
      -1,
      -2
     ],
     "color": "#1f77b4",
     "label": "구간1: y=-2"
    },
    {
     "type": "segment",
     "from": [
      -1,
      -2
     ],
     "to": [
      1,
      2
     ],
     "color": "#ff7f0e",
     "label": "구간2: y=2x"
    },
    {
     "type": "segment",
     "from": [
      1,
      2
     ],
     "to": [
      3,
      2
     ],
     "color": "#2ca02c",
     "label": "구간3: y=2"
    },
    {
     "type": "segment",
     "from": [
      "=x",
      0
     ],
     "to": [
      "=x",
      "=fx"
     ],
     "dashed": true,
     "color": "#999999"
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=fx"
     ],
     "label": "P(x, f(x))",
     "color": "#d62728"
    }
   ]
  },
  "readout": [
   {
    "label": "x",
    "expr": "x",
    "digits": 2
   },
   {
    "label": "f(x)",
    "expr": "fx",
    "digits": 2
   },
   {
    "label": "활성 구간",
    "expr": "piece",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x": -2
   },
   {
    "x": -0.5
   },
   {
    "x": 0.7
   },
   {
    "x": 2
   }
  ],
  "invariants": [
   "fx - (abs(x+1) - abs(x-1))",
   "fx - max(-2, min(2*x, 2))"
  ],
  "oracle": [
   {
    "params": {
     "x": -2
    },
    "expect": {
     "fx": -2,
     "piece": 1
    }
   },
   {
    "params": {
     "x": 0
    },
    "expect": {
     "fx": 0,
     "piece": 2
    }
   },
   {
    "params": {
     "x": 2
    },
    "expect": {
     "fx": 2,
     "piece": 3
    }
   }
  ],
  "tol": 0.000001
 }
}