{
 "id": "algebra/middle-1/문자와_식/일차식",
 "spec": {
  "title": "일차식 y = ax + b의 그래프",
  "params": [
   {
    "name": "a",
    "label": "계수 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "상수항 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "y0 = a*0 + b; y1 = a*1 + b; slope = (y1-y0)/(1-0)",
  "plot": {
   "range": [
    -10,
    10
   ],
   "yRange": [
    -10,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x + b",
     "label": "y = ax + b",
     "color": "#1f77b4"
    }
   ]
  },
  "readout": [
   {
    "label": "y(0)",
    "expr": "y0",
    "digits": 2
   },
   {
    "label": "y(1)",
    "expr": "y1",
    "digits": 2
   },
   {
    "label": "기울기",
    "expr": "slope",
    "digits": 2
   },
   {
    "label": "일차식 여부(1=예)",
    "expr": "a == 0 ? 0 : 1",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2
   },
   {
    "a": -1,
    "b": 3
   },
   {
    "a": 0,
    "b": -2
   },
   {
    "a": 2,
    "b": -1
   }
  ],
  "invariants": [
   "y1 - y0 - a",
   "y0 - b"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 3
    },
    "expect": {
     "y0": 3,
     "y1": 5,
     "slope": 2
    }
   },
   {
    "params": {
     "a": -1,
     "b": 4
    },
    "expect": {
     "y0": 4,
     "y1": 3,
     "slope": -1
    }
   },
   {
    "params": {
     "a": 0,
     "b": 2
    },
    "expect": {
     "y0": 2,
     "y1": 2,
     "slope": 0
    }
   }
  ],
  "tol": 0.000001
 }
}