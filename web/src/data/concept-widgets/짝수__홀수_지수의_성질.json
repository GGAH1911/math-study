{
 "id": "짝수/홀수_지수의_성질",
 "spec": {
  "title": "홀수 지수의 성질: sqrt[n](a^n) = a",
  "params": [
   {
    "name": "n",
    "label": "n (홀수)",
    "type": "slider",
    "min": 1,
    "max": 9,
    "init": 3,
    "step": 2
   },
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -2,
    "step": 0.1
   }
  ],
  "scope": "p=a^n; root=sign(p)*abs(p)^(1/n); sign_match=(sign(a)==sign(p) or a==0) ? 1 : 0",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -30,
    30
   ],
   "fns": [
    {
     "fn": "x^n",
     "label": "y = x^n",
     "color": "blue"
    }
   ],
   "points": [
    [
     "=a",
     "=p"
    ]
   ],
   "pointsLabel": "$(a,\\ a^n)$"
  },
  "readout": [
   {
    "label": "a^n",
    "expr": "p",
    "digits": 6
   },
   {
    "label": "sqrt[n](a^n)",
    "expr": "root",
    "digits": 6
   },
   {
    "label": "부호 일치",
    "expr": "sign_match",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 3,
    "a": -2
   },
   {
    "n": 5,
    "a": 1
   },
   {
    "n": 1,
    "a": 2.5
   },
   {
    "n": 9,
    "a": -1
   }
  ],
  "invariants": [
   "root - a",
   "sign_match - 1"
  ],
  "oracle": [
   {
    "params": {
     "n": 3,
     "a": -2
    },
    "expect": {
     "p": -8,
     "root": -2,
     "sign_match": 1
    }
   },
   {
    "params": {
     "n": 5,
     "a": 1
    },
    "expect": {
     "p": 1,
     "root": 1,
     "sign_match": 1
    }
   },
   {
    "params": {
     "n": 9,
     "a": -1
    },
    "expect": {
     "p": -1,
     "root": -1,
     "sign_match": 1
    }
   }
  ],
  "tol": 0.000001
 }
}