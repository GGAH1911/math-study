{
 "id": "functions/high-1/함수와_그래프/무리함수",
 "spec": {
  "title": "무리함수 y=√(ax+b)의 정의와 그래프",
  "params": [
   {
    "name": "a",
    "label": "a (a>0)",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "t",
    "label": "관찰점 x",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 4,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "ds=-b/a; yt=sqrt(a*t+b); slope=a/(2*yt)",
  "plot": {
   "range": [
    -5,
    10
   ],
   "yRange": [
    -1,
    6
   ],
   "fns": [
    {
     "fn": "sqrt(a*x+b)",
     "label": "y=√(ax+b)",
     "color": "#2563eb"
    }
   ],
   "points": [
    [
     "=t",
     "=yt"
    ]
   ],
   "pointsLabel": "$(t,\\ f(t))$"
  },
  "readout": [
   {
    "label": "정의역 시작 (x ≥)",
    "expr": "ds",
    "digits": 3
   },
   {
    "label": "f(t)=√(at+b)",
    "expr": "yt",
    "digits": 4
   },
   {
    "label": "접선기울기 f'(t)",
    "expr": "slope",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 2,
    "t": 4
   },
   {
    "a": 1,
    "b": 0,
    "t": 9
   },
   {
    "a": 4,
    "b": -3,
    "t": 3
   },
   {
    "a": 3,
    "b": 1,
    "t": 5
   }
  ],
  "invariants": [
   "a*ds + b",
   "yt^2 - (a*t + b)",
   "2*yt*slope - a"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "t": 9
    },
    "expect": {
     "ds": 0,
     "yt": 3,
     "slope": 0.16666666666666666
    }
   },
   {
    "params": {
     "a": 4,
     "b": -3,
     "t": 3
    },
    "expect": {
     "ds": 0.75,
     "yt": 3,
     "slope": 0.6666666666666666
    }
   },
   {
    "params": {
     "a": 2,
     "b": 2,
     "t": 4
    },
    "expect": {
     "ds": -1,
     "yt": 3.1622776601683795,
     "slope": 0.31622776601683794
    }
   }
  ],
  "tol": 0.000001
 }
}