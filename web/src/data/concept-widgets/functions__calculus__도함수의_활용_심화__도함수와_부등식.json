{
 "id": "functions/calculus/도함수의_활용_심화/도함수와_부등식",
 "spec": {
  "title": "도함수와 부등식: 곡선은 접선 위에 있다 — f(x)=eˣ−(접선) ≥ 0",
  "params": [
   {
    "name": "a",
    "label": "접점 a (접선을 긋는 곳)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "검사점 x₀",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "ea = e^a; tanAtX0 = ea*(x0 - a) + ea; curveAtX0 = e^x0; gap = curveAtX0 - tanAtX0; fAtA = e^a - (ea*(a - a) + ea); fpAtA = e^a - ea",
  "geometry": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -1,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=a",
      "=ea"
     ],
     "label": "접점 (a, eᵃ)"
    },
    {
     "type": "point",
     "at": [
      "=x0",
      "=curveAtX0"
     ],
     "label": "곡선 위 점"
    },
    {
     "type": "point",
     "at": [
      "=x0",
      "=tanAtX0"
     ],
     "label": "접선 위 점"
    },
    {
     "type": "segment",
     "from": [
      "=x0",
      "=tanAtX0"
     ],
     "to": [
      "=x0",
      "=curveAtX0"
     ],
     "label": "f(x₀) ≥ 0"
    }
   ]
  },
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -1,
    8
   ],
   "fns": [
    {
     "fn": "e^x",
     "label": "y = eˣ",
     "color": "#2563eb"
    },
    {
     "fn": "e^a*(x - a) + e^a",
     "label": "x=a 에서의 접선",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(x₀) = eˣ⁰ − 접선값  (항상 ≥ 0)",
    "expr": "gap",
    "digits": 4
   },
   {
    "label": "f(a) = 최솟값 (= 0)",
    "expr": "fAtA",
    "digits": 4
   },
   {
    "label": "f '(a) (= 0, 접점이 임계점)",
    "expr": "fpAtA",
    "digits": 4
   },
   {
    "label": "접선 기울기 = eᵃ = 곡선의 f '(a)",
    "expr": "ea",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "x0": 1
   },
   {
    "a": 1,
    "x0": 0
   },
   {
    "a": -1,
    "x0": 2
   },
   {
    "a": 0.5,
    "x0": -1
   }
  ],
  "invariants": [
   "fAtA",
   "fpAtA",
   "gap - (e^x0 - e^a*(x0 - a) - e^a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "x0": 1
    },
    "expect": {
     "ea": 1,
     "tanAtX0": 2,
     "gap": 0.7182818284590452,
     "fAtA": 0,
     "fpAtA": 0
    }
   },
   {
    "params": {
     "a": 1,
     "x0": 0
    },
    "expect": {
     "ea": 2.718281828459045,
     "tanAtX0": 0,
     "gap": 1,
     "fAtA": 0,
     "fpAtA": 0
    }
   },
   {
    "params": {
     "a": 0,
     "x0": 2
    },
    "expect": {
     "ea": 1,
     "tanAtX0": 3,
     "gap": 4.38905609893065,
     "fAtA": 0,
     "fpAtA": 0
    }
   }
  ],
  "tol": 0.000001
 }
}