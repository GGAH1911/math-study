{
 "id": "probability-stats/prob-stats-elective/경우의_수/분할",
 "spec": {
  "title": "집합의 분할 (패턴별 조각 크기와 방법 수)",
  "params": [
   {
    "name": "pattern",
    "label": "조각 경계 패턴",
    "type": "slider",
    "min": 0,
    "max": 31,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "n=6; b1=mod(pattern,2); b2=mod(floor(pattern/2),2); b3=mod(floor(pattern/4),2); b4=mod(floor(pattern/8),2); b5=mod(floor(pattern/16),2); g1=1; g2=1+b1; g3=1+b1+b2; g4=1+b1+b2+b3; g5=1+b1+b2+b3+b4; g6=1+b1+b2+b3+b4+b5; s1=(g1==1?1:0)+(g2==1?1:0)+(g3==1?1:0)+(g4==1?1:0)+(g5==1?1:0)+(g6==1?1:0); s2=(g1==2?1:0)+(g2==2?1:0)+(g3==2?1:0)+(g4==2?1:0)+(g5==2?1:0)+(g6==2?1:0); s3=(g1==3?1:0)+(g2==3?1:0)+(g3==3?1:0)+(g4==3?1:0)+(g5==3?1:0)+(g6==3?1:0); s4=(g1==4?1:0)+(g2==4?1:0)+(g3==4?1:0)+(g4==4?1:0)+(g5==4?1:0)+(g6==4?1:0); s5=(g1==5?1:0)+(g2==5?1:0)+(g3==5?1:0)+(g4==5?1:0)+(g5==5?1:0)+(g6==5?1:0); s6=(g1==6?1:0)+(g2==6?1:0)+(g3==6?1:0)+(g4==6?1:0)+(g5==6?1:0)+(g6==6?1:0); k=(s1>0?1:0)+(s2>0?1:0)+(s3>0?1:0)+(s4>0?1:0)+(s5>0?1:0)+(s6>0?1:0); count=factorial(6)/(factorial(s1)*factorial(s2)*factorial(s3)*factorial(s4)*factorial(s5)*factorial(s6))",
  "geometry": {
   "range": [
    0.3,
    6.7
   ],
   "yRange": [
    -1.2,
    1.2
   ],
   "showAxes": false,
   "showGrid": false,
   "shapes": [
    {
     "type": "line",
     "from": [1, 0],
     "to": ["=b1==0 ? 2 : NaN", 0],
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": [2, 0],
     "to": ["=b2==0 ? 3 : NaN", 0],
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": [3, 0],
     "to": ["=b3==0 ? 4 : NaN", 0],
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": [4, 0],
     "to": ["=b4==0 ? 5 : NaN", 0],
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": [5, 0],
     "to": ["=b5==0 ? 6 : NaN", 0],
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=b1==1 ? 1.5 : NaN", -0.4],
     "to": ["=b1==1 ? 1.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b2==1 ? 2.5 : NaN", -0.4],
     "to": ["=b2==1 ? 2.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b3==1 ? 3.5 : NaN", -0.4],
     "to": ["=b3==1 ? 3.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b4==1 ? 4.5 : NaN", -0.4],
     "to": ["=b4==1 ? 4.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b5==1 ? 5.5 : NaN", -0.4],
     "to": ["=b5==1 ? 5.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "point",
     "at": [1, 0],
     "label": "=g1",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": [2, 0],
     "label": "=g2",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": [3, 0],
     "label": "=g3",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": [4, 0],
     "label": "=g4",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": [5, 0],
     "label": "=g5",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": [6, 0],
     "label": "=g6",
     "labelDir": "N"
    }
   ]
  },
  "readout": [
   {
    "label": "조각 수",
    "expr": "k",
    "digits": 0
   },
   {
    "label": "나누는 방법 수",
    "expr": "count",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "pattern": 0
   },
   {
    "pattern": 1
   },
   {
    "pattern": 3
   },
   {
    "pattern": 31
   }
  ],
  "invariants": [
   "count*factorial(s1)*factorial(s2)*factorial(s3)*factorial(s4)*factorial(s5)*factorial(s6)-factorial(6)",
   "s1+s2+s3+s4+s5+s6-6"
  ],
  "oracle": [
   {
    "params": {
     "pattern": 0
    },
    "expect": {
     "s1": 6,
     "s2": 0,
     "s3": 0,
     "s4": 0,
     "s5": 0,
     "s6": 0,
     "count": 1
    }
   },
   {
    "params": {
     "pattern": 1
    },
    "expect": {
     "s1": 1,
     "s2": 5,
     "s3": 0,
     "s4": 0,
     "s5": 0,
     "s6": 0,
     "count": 6
    }
   },
   {
    "params": {
     "pattern": 3
    },
    "expect": {
     "s1": 1,
     "s2": 1,
     "s3": 4,
     "s4": 0,
     "s5": 0,
     "s6": 0,
     "count": 30
    }
   }
  ],
  "tol": 0.000001
 }
