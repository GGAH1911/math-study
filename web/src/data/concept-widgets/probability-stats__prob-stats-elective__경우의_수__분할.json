{
 "id": "probability-stats/prob-stats-elective/경우의_수/분할",
 "spec": {
  "title": "집합의 분할 — 칸막이로 조각 만들기 (조를 구별할 때와 안 할 때)",
  "params": [
   {
    "name": "n",
    "label": "원소 개수 n",
    "type": "slider",
    "min": 3,
    "max": 7,
    "init": 6,
    "step": 1
   },
   {
    "name": "pattern",
    "label": "칸막이 패턴 (조각 경계)",
    "type": "slider",
    "min": 0,
    "max": 63,
    "init": 20,
    "step": 1
   },
   {
    "name": "named",
    "label": "조를 구별하는가 (1: 이름 있는 조 / 0: 이름 없는 조)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 1,
    "step": 1
   }
  ],
  "scope": "p=mod(pattern,2^(n-1)); b1=mod(p,2); b2=mod(floor(p/2),2); b3=mod(floor(p/4),2); b4=mod(floor(p/8),2); b5=mod(floor(p/16),2); b6=mod(floor(p/32),2); g1=1; g2=1+b1; g3=1+b1+b2; g4=1+b1+b2+b3; g5=1+b1+b2+b3+b4; g6=1+b1+b2+b3+b4+b5; g7=1+b1+b2+b3+b4+b5+b6; e1=1; e2=(n>=2?1:0); e3=(n>=3?1:0); e4=(n>=4?1:0); e5=(n>=5?1:0); e6=(n>=6?1:0); e7=(n>=7?1:0); s1=e1*(g1==1?1:0)+e2*(g2==1?1:0)+e3*(g3==1?1:0)+e4*(g4==1?1:0)+e5*(g5==1?1:0)+e6*(g6==1?1:0)+e7*(g7==1?1:0); s2=e1*(g1==2?1:0)+e2*(g2==2?1:0)+e3*(g3==2?1:0)+e4*(g4==2?1:0)+e5*(g5==2?1:0)+e6*(g6==2?1:0)+e7*(g7==2?1:0); s3=e1*(g1==3?1:0)+e2*(g2==3?1:0)+e3*(g3==3?1:0)+e4*(g4==3?1:0)+e5*(g5==3?1:0)+e6*(g6==3?1:0)+e7*(g7==3?1:0); s4=e1*(g1==4?1:0)+e2*(g2==4?1:0)+e3*(g3==4?1:0)+e4*(g4==4?1:0)+e5*(g5==4?1:0)+e6*(g6==4?1:0)+e7*(g7==4?1:0); s5=e1*(g1==5?1:0)+e2*(g2==5?1:0)+e3*(g3==5?1:0)+e4*(g4==5?1:0)+e5*(g5==5?1:0)+e6*(g6==5?1:0)+e7*(g7==5?1:0); s6=e1*(g1==6?1:0)+e2*(g2==6?1:0)+e3*(g3==6?1:0)+e4*(g4==6?1:0)+e5*(g5==6?1:0)+e6*(g6==6?1:0)+e7*(g7==6?1:0); s7=e1*(g1==7?1:0)+e2*(g2==7?1:0)+e3*(g3==7?1:0)+e4*(g4==7?1:0)+e5*(g5==7?1:0)+e6*(g6==7?1:0)+e7*(g7==7?1:0); k=(s1>0?1:0)+(s2>0?1:0)+(s3>0?1:0)+(s4>0?1:0)+(s5>0?1:0)+(s6>0?1:0)+(s7>0?1:0); ord=factorial(n)/(factorial(s1)*factorial(s2)*factorial(s3)*factorial(s4)*factorial(s5)*factorial(s6)*factorial(s7)); c1=(s1==1?1:0)+(s2==1?1:0)+(s3==1?1:0)+(s4==1?1:0)+(s5==1?1:0)+(s6==1?1:0)+(s7==1?1:0); c2=(s1==2?1:0)+(s2==2?1:0)+(s3==2?1:0)+(s4==2?1:0)+(s5==2?1:0)+(s6==2?1:0)+(s7==2?1:0); c3=(s1==3?1:0)+(s2==3?1:0)+(s3==3?1:0)+(s4==3?1:0)+(s5==3?1:0)+(s6==3?1:0)+(s7==3?1:0); c4=(s1==4?1:0)+(s2==4?1:0)+(s3==4?1:0)+(s4==4?1:0)+(s5==4?1:0)+(s6==4?1:0)+(s7==4?1:0); c5=(s1==5?1:0)+(s2==5?1:0)+(s3==5?1:0)+(s4==5?1:0)+(s5==5?1:0)+(s6==5?1:0)+(s7==5?1:0); c6=(s1==6?1:0)+(s2==6?1:0)+(s3==6?1:0)+(s4==6?1:0)+(s5==6?1:0)+(s6==6?1:0)+(s7==6?1:0); c7=(s1==7?1:0)+(s2==7?1:0)+(s3==7?1:0)+(s4==7?1:0)+(s5==7?1:0)+(s6==7?1:0)+(s7==7?1:0); dup=factorial(c1)*factorial(c2)*factorial(c3)*factorial(c4)*factorial(c5)*factorial(c6)*factorial(c7); unord=ord/dup; ans=(named==1?ord:unord)",
  "geometry": {
   "range": [
    0.3,
    7.7
   ],
   "yRange": [
    -1.2,
    1.2
   ],
   "showAxes": false,
   "showGrid": false,
   "shapes": [
    {
     "type": "line",
     "from": ["=n>=2 ? 1 : NaN", 0],
     "to": ["=(b1==0 and n>=2) ? 2 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=n>=3 ? 2 : NaN", 0],
     "to": ["=(b2==0 and n>=3) ? 3 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=n>=4 ? 3 : NaN", 0],
     "to": ["=(b3==0 and n>=4) ? 4 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=n>=5 ? 4 : NaN", 0],
     "to": ["=(b4==0 and n>=5) ? 5 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=n>=6 ? 5 : NaN", 0],
     "to": ["=(b5==0 and n>=6) ? 6 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=n>=7 ? 6 : NaN", 0],
     "to": ["=(b6==0 and n>=7) ? 7 : NaN", 0],
     "dashed": "=named==0",
     "color": "#38bdf8"
    },
    {
     "type": "line",
     "from": ["=b1==1 ? 1.5 : NaN", -0.4],
     "to": ["=b1==1 ? 1.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b2==1 ? 2.5 : NaN", -0.4],
     "to": ["=b2==1 ? 2.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b3==1 ? 3.5 : NaN", -0.4],
     "to": ["=b3==1 ? 3.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b4==1 ? 4.5 : NaN", -0.4],
     "to": ["=b4==1 ? 4.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b5==1 ? 5.5 : NaN", -0.4],
     "to": ["=b5==1 ? 5.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "line",
     "from": ["=b6==1 ? 6.5 : NaN", -0.4],
     "to": ["=b6==1 ? 6.5 : NaN", 0.4],
     "color": "#fb7185"
    },
    {
     "type": "point",
     "at": ["=n>=1 ? 1 : NaN", 0],
     "label": "=g1",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=2 ? 2 : NaN", 0],
     "label": "=g2",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=3 ? 3 : NaN", 0],
     "label": "=g3",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=4 ? 4 : NaN", 0],
     "label": "=g4",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=5 ? 5 : NaN", 0],
     "label": "=g5",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=6 ? 6 : NaN", 0],
     "label": "=g6",
     "labelDir": "N"
    },
    {
     "type": "point",
     "at": ["=n>=7 ? 7 : NaN", 0],
     "label": "=g7",
     "labelDir": "N"
    }
   ]
  },
  "readout": [
   {
    "label": "조각(조) 수",
    "expr": "k",
    "digits": 0
   },
   {
    "label": "방법 수 (지금 설정)",
    "expr": "ans",
    "digits": 0
   },
   {
    "label": "이름 있는 조로 나누기  n!/(n₁!n₂!⋯)",
    "expr": "ord",
    "digits": 0
   },
   {
    "label": "같은 크기 조 때문에 겹쳐 센 배수 (m!)",
    "expr": "dup",
    "digits": 0
   },
   {
    "label": "이름 없는 조로 나누기",
    "expr": "unord",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   { "n": 6, "pattern": 20, "named": 1 },
   { "n": 6, "pattern": 10, "named": 0 },
   { "n": 6, "pattern": 0, "named": 1 },
   { "n": 6, "pattern": 31, "named": 0 },
   { "n": 5, "pattern": 4, "named": 1 },
   { "n": 4, "pattern": 5, "named": 0 },
   { "n": 3, "pattern": 3, "named": 1 }
  ],
  "invariants": [
   "s1+s2+s3+s4+s5+s6+s7-n",
   "ord*factorial(s1)*factorial(s2)*factorial(s3)*factorial(s4)*factorial(s5)*factorial(s6)*factorial(s7)-factorial(n)",
   "c1+c2+c3+c4+c5+c6+c7-k",
   "unord*dup-ord",
   "ans-(named==1?ord:unord)"
  ],
  "oracle": [
   {
    "params": { "n": 6, "pattern": 20, "named": 1 },
    "expect": { "k": 3, "s1": 3, "s2": 2, "s3": 1, "ord": 60, "dup": 1, "unord": 60, "ans": 60 }
   },
   {
    "params": { "n": 6, "pattern": 10, "named": 0 },
    "expect": { "k": 3, "s1": 2, "s2": 2, "s3": 2, "ord": 90, "dup": 6, "unord": 15, "ans": 15 }
   },
   {
    "params": { "n": 6, "pattern": 0, "named": 1 },
    "expect": { "k": 1, "s1": 6, "ord": 1, "dup": 1, "unord": 1, "ans": 1 }
   },
   {
    "params": { "n": 6, "pattern": 31, "named": 0 },
    "expect": { "k": 6, "ord": 720, "dup": 720, "unord": 1, "ans": 1 }
   },
   {
    "params": { "n": 5, "pattern": 4, "named": 1 },
    "expect": { "k": 2, "s1": 3, "s2": 2, "ord": 10, "dup": 1, "unord": 10, "ans": 10 }
   },
   {
    "params": { "n": 4, "pattern": 5, "named": 0 },
    "expect": { "k": 3, "s1": 1, "s2": 2, "s3": 1, "ord": 12, "dup": 2, "unord": 6, "ans": 6 }
   }
  ],
  "tol": 0.000001
 }
}
