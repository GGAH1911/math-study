{
 "id": "functions/math-2/미분/사차함수의_미분",
 "spec": {
  "title": "사차함수의 미분: 도함수 f′(x)와 접선의 기울기",
  "params": [
   {
    "name": "a",
    "label": "a (x⁴ 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (x³ 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (x² 계수)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -4,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d (x 계수)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "x₀ (접점)",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 1,
    "step": 0.05
   }
  ],
  "scope": "f0 = a*x0^4 + b*x0^3 + c*x0^2 + d*x0; m = 4*a*x0^3 + 3*b*x0^2 + 2*c*x0 + d; f2 = 12*a*x0^2 + 6*b*x0 + 2*c; h = 0.00001; fp = a*(x0+h)^4 + b*(x0+h)^3 + c*(x0+h)^2 + d*(x0+h); fm = a*(x0-h)^4 + b*(x0-h)^3 + c*(x0-h)^2 + d*(x0-h); dnum = (fp - fm)/(2*h)",
  "plot": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -7,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^4 + b*x^3 + c*x^2 + d*x",
     "label": "f(x)=ax⁴+bx³+cx²+dx (사차함수)",
     "color": "#2563eb"
    },
    {
     "fn": "4*a*x^3 + 3*b*x^2 + 2*c*x + d",
     "label": "f'(x)=4ax³+3bx²+2cx+d (도함수, 삼차함수)",
     "color": "#dc2626"
    },
    {
     "fn": "m*(x-x0)+f0",
     "label": "x₀에서의 접선 (기울기=f'(x₀))",
     "color": "#16a34a"
    }
   ]
  },
  "readout": [
   {
    "label": "x₀",
    "expr": "x0",
    "digits": 2
   },
   {
    "label": "f(x₀)",
    "expr": "f0",
    "digits": 3
   },
   {
    "label": "f'(x₀) = 접선의 기울기",
    "expr": "m",
    "digits": 3
   },
   {
    "label": "f''(x₀) = 곡률 부호",
    "expr": "f2",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": -4,
    "d": 0,
    "x0": 1
   },
   {
    "a": 0.5,
    "b": 1,
    "c": -2,
    "d": 1,
    "x0": -1
   },
   {
    "a": -1,
    "b": 2,
    "c": 0,
    "d": -3,
    "x0": 0.5
   },
   {
    "a": 2,
    "b": -3,
    "c": 1,
    "d": 2,
    "x0": 2
   }
  ],
  "invariants": [
   "m - dnum",
   "f0 - (a*x0^4 + b*x0^3 + c*x0^2 + d*x0)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": -4,
     "d": 0,
     "x0": 1
    },
    "expect": {
     "f0": -3,
     "m": -4,
     "f2": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": -4,
     "d": 0,
     "x0": 2
    },
    "expect": {
     "f0": 0,
     "m": 16,
     "f2": 40
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": -4,
     "d": 0,
     "x0": -1
    },
    "expect": {
     "f0": -3,
     "m": 4,
     "f2": 4
    }
   }
  ],
  "tol": 0.000001
 }
}