{
 "id": "극값의_판정",
 "spec": {
  "title": "이계도함수를 이용한 극값 판정",
  "params": [
   {
    "name": "a",
    "label": "계수 a",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 0.05
   }
  ],
  "scope": "x1=sqrt(a); x2=-x1; y1=x1^3-3*a*x1; y2=x2^3-3*a*x2; d2_1=6*x1; d2_2=6*x2",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -15,
    15
   ],
   "fns": [
    {
     "fn": "x^3 - 3*a*x",
     "label": "f(x) = x³ - 3ax",
     "color": "blue"
    },
    {
     "fn": "3*x^2 - 3*a",
     "label": "f'(x)",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "임계점 x₁",
    "expr": "x1",
    "digits": 3
   },
   {
    "label": "f'(x₁)",
    "expr": "3*x1^2 - 3*a",
    "digits": 6
   },
   {
    "label": "f''(x₁)",
    "expr": "d2_1",
    "digits": 3
   },
   {
    "label": "판정 부호",
    "expr": "sign(d2_1)",
    "digits": 1
   },
   {
    "label": "임계점 x₂",
    "expr": "x2",
    "digits": 3
   },
   {
    "label": "f'(x₂)",
    "expr": "3*x2^2 - 3*a",
    "digits": 6
   },
   {
    "label": "f''(x₂)",
    "expr": "d2_2",
    "digits": 3
   },
   {
    "label": "판정 부호",
    "expr": "sign(d2_2)",
    "digits": 1
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0
   },
   {
    "a": 0.5
   },
   {
    "a": 1
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "x1*x1 - a",
   "x2*x2 - a",
   "3*x1*x1 - 3*a",
   "3*x2*x2 - 3*a",
   "d2_1 - 6*x1",
   "d2_2 - 6*x2",
   "sign(d2_1) - sign(x1)",
   "sign(d2_2) - sign(x2)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "x1": 0,
     "x2": 0,
     "y1": 0,
     "y2": 0,
     "d2_1": 0,
     "d2_2": 0
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "x1": 1,
     "x2": -1,
     "y1": -2,
     "y2": 2,
     "d2_1": 6,
     "d2_2": -6
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "x1": 1.4142135623730951,
     "x2": -1.4142135623730951,
     "y1": -5.656854249492381,
     "y2": 5.656854249492381,
     "d2_1": 8.48528137423857,
     "d2_2": -8.48528137423857
    }
   }
  ],
  "tol": 0.000001
 }
}