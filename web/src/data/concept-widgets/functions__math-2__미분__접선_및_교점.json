{
 "id": "functions/math-2/미분/접선_및_교점",
 "spec": {
  "title": "접선과 교점: y = x³ − 3x",
  "params": [
   {
    "name": "a",
    "label": "접점 x좌표 a",
    "type": "slider",
    "min": -1.3,
    "max": 1.3,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fa = a^3 - 3*a; dfa = 3*a^2 - 3; b = fa - a*dfa; xo = -2*a; yo = xo^3 - 3*xo",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -11,
    11
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x",
     "label": "y = x³ − 3x",
     "color": "#2563eb"
    },
    {
     "fn": "dfa*x + b",
     "label": "접선: y = f'(a)(x−a)+f(a)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "접점 x = a",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "접점 y = f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "접선 기울기 f'(a)",
    "expr": "dfa",
    "digits": 3
   },
   {
    "label": "다른 교점 x",
    "expr": "xo",
    "digits": 3
   },
   {
    "label": "다른 교점 y",
    "expr": "yo",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1
   },
   {
    "a": 0.5
   },
   {
    "a": -1
   },
   {
    "a": 1.3
   }
  ],
  "invariants": [
   "yo - (dfa*xo + b)",
   "fa - (dfa*a + b)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": -2,
     "dfa": 0,
     "b": -2,
     "xo": -2,
     "yo": -2
    }
   },
   {
    "params": {
     "a": 0.5
    },
    "expect": {
     "fa": -1.375,
     "dfa": -2.25,
     "b": -0.25,
     "xo": -1,
     "yo": 2
    }
   }
  ],
  "tol": 0.000001
 }
}