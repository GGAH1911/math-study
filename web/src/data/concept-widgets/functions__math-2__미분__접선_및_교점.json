{
 "id": "functions/math-2/미분/접선_및_교점",
 "spec": {
  "title": "접선과 교점: y = px³ + qx² + rx + s",
  "params": [
   {
    "name": "p",
    "label": "x³ 계수 p",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "q",
    "label": "x² 계수 q",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "r",
    "label": "x 계수 r",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -3,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "s",
    "label": "상수항 s",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "a",
    "label": "접점 x좌표 a",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 1,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fa = p*a^3 + q*a^2 + r*a + s; dfa = 3*p*a^2 + 2*q*a + r; bb = fa - a*dfa; xin = p != 0 ? -q/(3*p) : NaN; xo = p != 0 ? -2*a - q/p : NaN; yo = p != 0 ? p*xo^3 + q*xo^2 + r*xo + s : NaN",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "p*x^3 + q*x^2 + r*x + s",
     "label": "$y=px^3+qx^2+rx+s$",
     "color": "#2563eb"
    },
    {
     "fn": "dfa*x + bb",
     "label": "$y=f'(a)(x-a)+f(a)$",
     "color": "#dc2626"
    }
   ],
   "points": [
    [
     "=a",
     "=fa"
    ]
   ],
   "pointsLabel": "접점 $(a,\\ f(a))$",
   "intersections": [
    {
     "f": "p*x^3 + q*x^2 + r*x + s",
     "g": "dfa*x + bb",
     "in": [
      "=-3",
      "=a-0.02"
     ],
     "label": "다른 교점"
    },
    {
     "f": "p*x^3 + q*x^2 + r*x + s",
     "g": "dfa*x + bb",
     "in": [
      "=a+0.02",
      "=3"
     ],
     "label": "다른 교점"
    }
   ]
  },
  "readout": [
   {
    "label": "접점 y = f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "접선 기울기 f'(a)",
    "expr": "dfa",
    "digits": 3
   },
   {
    "label": "접선 y절편",
    "expr": "bb",
    "digits": 3
   },
   {
    "label": "변곡점 x = −q/(3p)",
    "expr": "xin",
    "digits": 3
   },
   {
    "label": "다른 교점 x = −2a − q/p",
    "expr": "xo",
    "digits": 3
   },
   {
    "label": "다른 교점 y",
    "expr": "yo",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 1,
    "q": 0,
    "r": -3,
    "s": 0,
    "a": 1
   },
   {
    "p": 1,
    "q": -1,
    "r": 0,
    "s": 2,
    "a": 0
   },
   {
    "p": 2,
    "q": 3,
    "r": -1,
    "s": -1,
    "a": -1
   },
   {
    "p": 0,
    "q": 1,
    "r": 0,
    "s": -1,
    "a": 1
   },
   {
    "p": 1,
    "q": 0,
    "r": -3,
    "s": 0,
    "a": 0
   },
   {
    "p": -1,
    "q": 0,
    "r": 0,
    "s": 1,
    "a": 0.5
   }
  ],
  "invariants": [
   "fa - (dfa*a + bb)",
   "p != 0 ? (yo - (dfa*xo + bb)) : 0",
   "p != 0 ? ((p*2^3+q*2^2+r*2+s) - (dfa*2+bb) - p*(2-a)^2*(2-xo)) : 0",
   "p == 0 ? ((q*2^2+r*2+s) - (dfa*2+bb) - q*(2-a)^2) : 0"
  ],
  "oracle": [
   {
    "params": {
     "p": 1,
     "q": 0,
     "r": -3,
     "s": 0,
     "a": 1
    },
    "expect": {
     "fa": -2,
     "dfa": 0,
     "bb": -2,
     "xin": 0,
     "xo": -2,
     "yo": -2
    }
   },
   {
    "params": {
     "p": 1,
     "q": -1,
     "r": 0,
     "s": 2,
     "a": 0
    },
    "expect": {
     "fa": 2,
     "dfa": 0,
     "bb": 2,
     "xo": 1,
     "yo": 2
    }
   },
   {
    "params": {
     "p": 2,
     "q": 3,
     "r": -1,
     "s": -1,
     "a": -1
    },
    "expect": {
     "fa": 1,
     "dfa": -1,
     "bb": 0,
     "xin": -0.5,
     "xo": 0.5,
     "yo": -0.5
    }
   },
   {
    "params": {
     "p": 0,
     "q": 1,
     "r": 0,
     "s": -1,
     "a": 1
    },
    "expect": {
     "fa": 0,
     "dfa": 2,
     "bb": -2
    }
   },
   {
    "params": {
     "p": 1,
     "q": 0,
     "r": -3,
     "s": 0,
     "a": 0
    },
    "expect": {
     "fa": 0,
     "dfa": -3,
     "bb": 0,
     "xin": 0,
     "xo": 0,
     "yo": 0
    }
   }
  ],
  "tol": 0.000001
 }
}