{
 "id": "직선",
 "spec": {
  "title": "직선: 두 점이 정하는 무한 직선",
  "params": [
   {
    "name": "x1",
    "label": "A의 x",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "y1",
    "label": "A의 y",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "x2",
    "label": "B의 x",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "y2",
    "label": "B의 y",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "dx=x2-x1; dy=y2-y1; xc=(x1+x2)/2; yc=(y1+y2)/2",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "line",
     "from": [
      "=x1",
      "=y1"
     ],
     "to": [
      "=x2",
      "=y2"
     ]
    },
    {
     "type": "point",
     "at": [
      "=x1",
      "=y1"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=x2",
      "=y2"
     ],
     "label": "B"
    }
   ]
  },
  "readout": [
   {
    "label": "dx",
    "expr": "dx"
   },
   {
    "label": "dy",
    "expr": "dy"
   },
   {
    "label": "중점 x",
    "expr": "xc"
   },
   {
    "label": "중점 y",
    "expr": "yc"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x1": -2,
    "y1": 1,
    "x2": 3,
    "y2": 2
   },
   {
    "x1": 0,
    "y1": 0,
    "x2": 4,
    "y2": 0
   },
   {
    "x1": 1,
    "y1": 2,
    "x2": 1,
    "y2": 5
   },
   {
    "x1": -1,
    "y1": -1,
    "x2": 2,
    "y2": -3
   }
  ],
  "invariants": [
   "(yc-y1)*dx - dy*(xc-x1)"
  ],
  "oracle": [
   {
    "params": {
     "x1": 1,
     "y1": 2,
     "x2": 4,
     "y2": 6
    },
    "expect": {
     "dx": 3,
     "dy": 4,
     "xc": 2.5,
     "yc": 4
    }
   },
   {
    "params": {
     "x1": -3,
     "y1": -1,
     "x2": -3,
     "y2": 4
    },
    "expect": {
     "dx": 0,
     "dy": 5,
     "xc": -3,
     "yc": 1.5
    }
   }
  ],
  "tol": 0.000001
 }
}