{
 "id": "매개변수에_따른_함수_거동",
 "spec": {
  "title": "매개변수에 따른 함수 거동: f(x)=x^3 - a x^2",
  "params": [
   {
    "name": "a",
    "label": "매개변수 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "x1=0; x2=2*a/3; xi=a/3; y2=x2^3 - a*x2^2; yi=xi^3 - a*xi^2; d2=3*x2^2 - 2*a*x2; di=6*xi - 2*a",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "x^3 - a*x^2",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "3*x^2 - 2*a*x",
     "label": "f'(x)",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "변곡점 x",
    "expr": "xi",
    "digits": 3
   },
   {
    "label": "임계점 x (≠0)",
    "expr": "x2",
    "digits": 3
   },
   {
    "label": "극값 y",
    "expr": "y2",
    "digits": 3
   },
   {
    "label": "극값 개수",
    "expr": "a==0 ? 0 : 2",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -2
   },
   {
    "a": 0
   },
   {
    "a": 1.5
   },
   {
    "a": 2
   }
  ],
  "invariants": [
   "xi - (x1+x2)/2",
   "y2 + 4*a^3/27",
   "d2",
   "di"
  ],
  "oracle": [
   {
    "params": {
     "a": 1.5
    },
    "expect": {
     "x1": 0,
     "x2": 1,
     "xi": 0.5,
     "y2": -0.5,
     "yi": -0.25,
     "d2": 0,
     "di": 0
    }
   },
   {
    "params": {
     "a": -1.5
    },
    "expect": {
     "x1": 0,
     "x2": -1,
     "xi": -0.5,
     "y2": 0.5,
     "yi": 0.25,
     "d2": 0,
     "di": 0
    }
   },
   {
    "params": {
     "a": 0
    },
    "expect": {
     "x1": 0,
     "x2": 0,
     "xi": 0,
     "y2": 0,
     "yi": 0,
     "d2": 0,
     "di": 0
    }
   }
  ],
  "tol": 0.000001
 }
}