{
 "id": "equations/high-1/방정식과_부등식/복소수의_켤레근",
 "spec": {
  "title": "복소수의 켤레근 (x² + bx + 4 = 0)",
  "params": [
   {
    "name": "b",
    "label": "b (실수 계수)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "delta=b^2-16; re=-b/2; imag=sqrt(16-b^2)/2; r1=re+imag*i; r2=re-imag*i; sumr=2*re; prodr=re^2+imag^2",
  "geometry": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -3,
    3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 2
    },
    {
     "type": "point",
     "at": [
      "=re",
      "=imag"
     ],
     "label": "α"
    },
    {
     "type": "point",
     "at": [
      "=re",
      "=-imag"
     ],
     "label": "β"
    },
    {
     "type": "segment",
     "from": [
      "=re",
      "=imag"
     ],
     "to": [
      "=re",
      "=-imag"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 Δ",
    "expr": "delta",
    "digits": 1
   },
   {
    "label": "실수부",
    "expr": "re",
    "digits": 2
   },
   {
    "label": "허수부",
    "expr": "imag",
    "digits": 2
   },
   {
    "label": "근의 합",
    "expr": "sumr",
    "digits": 2
   },
   {
    "label": "근의 곱",
    "expr": "prodr",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 0
   },
   {
    "b": 2
   },
   {
    "b": -2
   },
   {
    "b": 4
   }
  ],
  "invariants": [
   "abs(r1 + r2 + b)",
   "abs(r1 * r2 - 4)",
   "abs(r1^2 + b*r1 + 4)",
   "abs(r2^2 + b*r2 + 4)"
  ],
  "oracle": [
   {
    "params": {
     "b": 0
    },
    "expect": {
     "re": 0,
     "imag": 2,
     "sumr": 0,
     "prodr": 4,
     "delta": -16
    }
   },
   {
    "params": {
     "b": 2
    },
    "expect": {
     "re": -1,
     "imag": 1.7320508075688772,
     "sumr": -2,
     "prodr": 4,
     "delta": -12
    }
   },
   {
    "params": {
     "b": 4
    },
    "expect": {
     "re": -2,
     "imag": 0,
     "sumr": -4,
     "prodr": 4,
     "delta": 0
    }
   }
  ],
  "tol": 0.000001
 }
}