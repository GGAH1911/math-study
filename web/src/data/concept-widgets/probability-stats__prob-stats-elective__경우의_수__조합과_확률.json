    "name": "r",
    "label": "선택 원소 수 r",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "choose=(r>=0 and r<=n)?factorial(n)/(factorial(r)*factorial(n-r)):0; sym=(n-r>=0 and n-r<=n)?factorial(n)/(factorial(n-r)*factorial(r)):0; c0=(0<=n)?factorial(n)/(factorial(0)*factorial(n)):0; c1=(1<=n)?factorial(n)/(factorial(1)*factorial(n-1)):0; c2=(2<=n)?factorial(n)/(factorial(2)*factorial(n-2)):0; c3=(3<=n)?factorial(n)/(factorial(3)*factorial(n-3)):0; c4=(4<=n)?factorial(n)/(factorial(4)*factorial(n-4)):0; c5=(5<=n)?factorial(n)/(factorial(5)*factorial(n-5)):0; c6=(6<=n)?factorial(n)/(factorial(6)*factorial(n-6)):0; c7=(7<=n)?factorial(n)/(factorial(7)*factorial(n-7)):0; c8=(8<=n)?factorial(n)/(factorial(8)*factorial(n-8)):0; c9=(9<=n)?factorial(n)/(factorial(9)*factorial(n-9)):0; c10=(10<=n)?factorial(n)/(factorial(10)*factorial(n-10)):0; sumc=c0+c1+c2+c3+c4+c5+c6+c7+c8+c9+c10; p=choose; q=(r-1>=0 and r-1<=n-1)?factorial(n-1)/(factorial(r-1)*factorial(n-r)):0; s=(r>=0 and r<=n-1)?factorial(n-1)/(factorial(r)*factorial(n-1-r)):0; pascal_diff=p-(q+s);",
