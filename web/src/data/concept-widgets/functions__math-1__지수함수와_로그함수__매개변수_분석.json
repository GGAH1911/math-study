{
 "id": "functions/math-1/지수함수와_로그함수/매개변수_분석",
 "spec": {
  "title": "매개변수 분석: 2^x + 2^(-x) = k 의 실근 개수",
  "params": [
   {
    "name": "k",
    "label": "k (수평선 높이)",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 3,
    "step": 0.1
   }
  ],
  "scope": "disc = k^2 - 4; sq = sqrt(disc); t1 = (k + sq)/2; t2 = (k - sq)/2; x1 = log(t1, 2); x2 = log(t2, 2)",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    0,
    7
   ],
   "fns": [
    {
     "fn": "2^x + 2^(-x)",
     "label": "y = 2^x + 2^(-x)",
     "color": "#2563eb"
    },
    {
     "fn": "k",
     "label": "y = k",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = k² − 4 (치환 t=2^x)",
    "expr": "disc",
    "digits": 3
   },
   {
    "label": "실근의 개수",
    "expr": "(k<2)?0:((k==2)?1:2)",
    "digits": 0
   },
   {
    "label": "y의 최솟값 (x=0): k가 이 값보다 크면 근 2개",
    "expr": "2^0 + 2^(-0)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 2
   },
   {
    "k": 2.5
   },
   {
    "k": 4.25
   },
   {
    "k": 5
   }
  ],
  "invariants": [
   "t1*t2 - 1",
   "t1 + t2 - k",
   "2^x1 + 2^(-x1) - k",
   "2^x2 + 2^(-x2) - k"
  ],
  "oracle": [
   {
    "params": {
     "k": 2.5
    },
    "expect": {
     "disc": 2.25,
     "t1": 2,
     "t2": 0.5,
     "x1": 1,
     "x2": -1
    }
   },
   {
    "params": {
     "k": 4.25
    },
    "expect": {
     "disc": 14.0625,
     "t1": 4,
     "t2": 0.25,
     "x1": 2,
     "x2": -2
    }
   },
   {
    "params": {
     "k": 2
    },
    "expect": {
     "disc": 0,
     "t1": 1,
     "t2": 1,
     "x1": 0,
     "x2": 0
    }
   }
  ],
  "tol": 0.000001
 }
}