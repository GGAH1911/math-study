{
 "id": "부호가_바뀌는_함수의_적분",
 "spec": {
  "title": "부호가 바뀌는 함수의 적분",
  "params": [
   {
    "name": "k",
    "label": "$k$ (계수·뒤집기)",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "r1",
    "label": "근 $r_1$",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": -1.5,
    "step": 0.1
   },
   {
    "name": "r2",
    "label": "근 $r_2$",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "r3",
    "label": "근 $r_3$",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "a",
    "label": "아래끝 $a$",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "위끝 $b$",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 2.2,
    "step": 0.1
   }
  ],
  "scope": "kk=(abs(k)<0.05 ? 0.25 : k); lo=min(a,b); hi=max(a,b); hd=(hi-lo<0.02 ? lo+0.02 : hi); m1=min(min(r1,r2),r3); m3=max(max(r1,r2),r3); m2=r1+r2+r3-m1-m3; s1=r1+r2+r3; s2=r1*r2+r2*r3+r3*r1; s3=r1*r2*r3; c1=min(max(m1,lo),hi); c2=min(max(m2,lo),hi); c3=min(max(m3,lo),hi); FL=kk*(lo^4/4-s1*lo^3/3+s2*lo^2/2-s3*lo); F1=kk*(c1^4/4-s1*c1^3/3+s2*c1^2/2-s3*c1); F2=kk*(c2^4/4-s1*c2^3/3+s2*c2^2/2-s3*c2); F3=kk*(c3^4/4-s1*c3^3/3+s2*c3^2/2-s3*c3); FH=kk*(hi^4/4-s1*hi^3/3+s2*hi^2/2-s3*hi); signed=FH-FL; area=abs(F1-FL)+abs(F2-F1)+abs(F3-F2)+abs(FH-F3); pos=(area+signed)/2; neg=(area-signed)/2; fL=kk*(lo-r1)*(lo-r2)*(lo-r3); fH=kk*(hi-r1)*(hi-r2)*(hi-r3); bd1=(m1+m2)/2; bd2=(m2+m3)/2",
  "plot": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "kk*(x-r1)*(x-r2)*(x-r3)",
     "label": "$y=f(x)$",
     "color": "blue"
    },
    {
     "fn": "kk*(x-r1)*(x-r2)*(x-r3)",
     "range": [
      "=lo",
      "=hd"
     ],
     "label": "$[a,b]$ 적분 구간",
     "color": "orange"
    },
    {
     "fn": "abs(kk*(x-r1)*(x-r2)*(x-r3))",
     "label": "$y=|f(x)|$",
     "color": "gray",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "kk*(x-r1)*(x-r2)*(x-r3)",
     "in": [
      "=-3.05",
      "=bd1"
     ],
     "label": "부호가 바뀌는 점"
    },
    {
     "fn": "kk*(x-r1)*(x-r2)*(x-r3)",
     "in": [
      "=bd1",
      "=bd2"
     ],
     "label": "부호가 바뀌는 점"
    },
    {
     "fn": "kk*(x-r1)*(x-r2)*(x-r3)",
     "in": [
      "=bd2",
      "=3.05"
     ],
     "label": "부호가 바뀌는 점"
    }
   ],
   "points": [
    [
     "=lo",
     "=0"
    ],
    [
     "=hi",
     "=0"
    ],
    [
     "=lo",
     "=fL"
    ],
    [
     "=hi",
     "=fH"
    ]
   ],
   "pointsLabel": "$x=a,\\ x=b$"
  },
  "readout": [
   {
    "label": "정적분 $\\int_a^b f\\,dx$ (부호 포함)",
    "expr": "signed",
    "digits": 4
   },
   {
    "label": "$x$축 위쪽 넓이",
    "expr": "pos",
    "digits": 4
   },
   {
    "label": "$x$축 아래쪽 넓이",
    "expr": "neg",
    "digits": 4
   },
   {
    "label": "실제 넓이 $\\int_a^b |f|\\,dx$",
    "expr": "area",
    "digits": 4
   },
   {
    "label": "상쇄된 양 (실제 넓이 − 정적분)",
    "expr": "area - signed",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 1,
    "r1": -1.5,
    "r2": 0,
    "r3": 1.5,
    "a": -2,
    "b": 2.2
   },
   {
    "k": 1,
    "r1": -1,
    "r2": 0,
    "r3": 1,
    "a": -1,
    "b": 1
   },
   {
    "k": 0.5,
    "r1": -1.5,
    "r2": 0,
    "r3": 1.5,
    "a": 1.2,
    "b": 2.5
   },
   {
    "k": -1,
    "r1": -2,
    "r2": -2,
    "r3": 1,
    "a": -2.5,
    "b": 2.5
   },
   {
    "k": 0,
    "r1": 0,
    "r2": 0,
    "r3": 0,
    "a": -1,
    "b": 1
   }
  ],
  "invariants": [
   "area - (pos + neg)",
   "signed - (pos - neg)",
   "area - abs(signed) - 2*min(pos,neg)"
  ],
  "oracle": [
   {
    "params": {
     "k": 1,
     "r1": -1,
     "r2": 0,
     "r3": 1,
     "a": -1,
     "b": 1
    },
    "expect": {
     "signed": 0,
     "area": 0.5,
     "pos": 0.25,
     "neg": 0.25
    }
   },
   {
    "params": {
     "k": 1,
     "r1": 0,
     "r2": 1,
     "r3": 2,
     "a": 0,
     "b": 2.5
    },
    "expect": {
     "signed": 0.390625,
     "area": 0.890625,
     "neg": 0.25
    }
   },
   {
    "params": {
     "k": 0.5,
     "r1": -1.5,
     "r2": 0,
     "r3": 1.5,
     "a": 1.2,
     "b": 2.5
    },
    "expect": {
     "signed": 1.9179875,
     "area": 2.0820125,
     "neg": 0.0820125
    }
   },
   {
    "params": {
     "k": 1,
     "r1": 1,
     "r2": 1,
     "r3": -1,
     "a": -2,
     "b": 2
    },
    "expect": {
     "signed": -1.3333333333333333,
     "area": 5.833333333333333
    }
   }
  ],
  "tol": 0.000001
 }
}