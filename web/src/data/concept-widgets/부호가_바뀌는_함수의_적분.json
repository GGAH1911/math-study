{
 "id": "부호가_바뀌는_함수의_적분",
 "spec": {
  "title": "부호가 바뀌는 함수의 적분",
  "params": [
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": 0,
    "max": 6.283,
    "init": 4,
    "step": 0.01
   }
  ],
  "scope": "signed=1-cos(b); total=(b<=pi ? signed : 4-signed); sb=sin(b)",
  "plot": {
   "range": [
    0,
    6.283
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "fns": [
    {
     "fn": "sin(x)",
     "label": "y=sin(x)",
     "color": "blue"
    }
   ],
   "points": [
    [
     "=b",
     "=sb"
    ],
    [
     "=b",
     "0"
    ]
   ],
   "pointsLabel": "$x=b$"
  },
  "readout": [
   {
    "label": "정적분 (부호 포함)",
    "expr": "signed",
    "digits": 6
   },
   {
    "label": "실제 넓이 (|sin|)",
    "expr": "total",
    "digits": 6
   },
   {
    "label": "차이",
    "expr": "total - signed",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 1
   },
   {
    "b": 3
   },
   {
    "b": 4
   },
   {
    "b": 6
   }
  ],
  "invariants": [
   "total - signed - (b>pi ? (4 - 2*signed) : 0)",
   "signed - (1 - cos(b))"
  ],
  "oracle": [
   {
    "params": {
     "b": 1.5707963267948966
    },
    "expect": {
     "signed": 1,
     "total": 1
    }
   },
   {
    "params": {
     "b": 3.141592653589793
    },
    "expect": {
     "signed": 2,
     "total": 2
    }
   },
   {
    "params": {
     "b": 4.71238898038469
    },
    "expect": {
     "signed": 1,
     "total": 3
    }
   }
  ],
  "tol": 0.000001
 }
}