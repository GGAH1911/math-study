{
 "id": "확률밀도함수와_대칭성",
 "spec": {
  "title": "확률밀도함수와 대칭성",
  "params": [
   {
    "name": "a",
    "label": "중심 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "k",
    "label": "거리 k",
    "type": "slider",
    "min": 0,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "h=3; f_left=(h-k)/h^2; f_right=(h-k)/h^2; p_left=k/h - k^2/(2*h^2); p_right=((1/h)+f_right)/2*k;",
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    0,
    0.5
   ],
   "fns": [
    {
     "fn": "abs(x-a) <= h ? (h - abs(x-a))/h^2 : 0",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "P(a-k ≤ X ≤ a)",
    "expr": "p_left",
    "digits": 4
   },
   {
    "label": "P(a ≤ X ≤ a+k)",
    "expr": "p_right",
    "digits": 4
   },
   {
    "label": "f(a-k)",
    "expr": "f_left",
    "digits": 4
   },
   {
    "label": "f(a+k)",
    "expr": "f_right",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "k": 1
   },
   {
    "a": 0,
    "k": 2
   },
   {
    "a": -1,
    "k": 0.5
   },
   {
    "a": 1.5,
    "k": 2.5
   }
  ],
  "invariants": [
   "f_left - f_right",
   "p_left - p_right"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "k": 1
    },
    "expect": {
     "f_left": 0.22222222,
     "p_left": 0.27777778
    }
   },
   {
    "params": {
     "a": 0,
     "k": 1.5
    },
    "expect": {
     "f_left": 0.16666667,
     "p_left": 0.375
    }
   }
  ],
  "tol": 0.000001
 }
}