    "r": 3,
    "s": 0
   },
   {
    "t": 1,
    "p": 0,
    "q": 0,
    "r": 2,
    "s": 1
   }
  ],
  "invariants": [
   "a0^2 - 4*q^2 - 12*p*(v0 - r)",
   "3*x0 - t*v0 - 3*s - 2*r*t - q*t^2",
   "2*v0 - t*a0 - 2*r - 2*q*t",
   "spd - abs(v0)",
   "disc - (4*q^2 - 12*p*r)"
  ],
  "oracle": [
   {
    "params": {
     "t": 0,
     "p": 1,
     "q": -6,
     "r": 9,
     "s": 0
    },
    "expect": {
     "x0": 0,
     "v0": 9,
     "a0": -12,
     "nturn": 2,
     "trend": -1
    }
   },
   {
    "params": {
     "t": 2,
     "p": 1,
     "q": -6,
     "r": 9,
     "s": 0
    },
    "expect": {
     "x0": 2,
     "v0": -3,
     "a0": 0,
     "spd": 3,
     "dir": -1
    }
   },
   {
    "params": {
     "t": 1.5,
     "p": 0,
     "q": -3,
     "r": 6,
     "s": 2
    },
    "expect": {
     "x0": 4.25,
     "v0": -3,
     "a0": -6,
     "nturn": 1,
     "trend": 1
    }
   },
   {
    "params": {
     "t": 2,
     "p": 1,
     "q": 0,
     "r": 3,
     "s": 0
    },
    "expect": {
     "x0": 14,
     "v0": 15,
     "a0": 12,
     "nturn": 0
    }
   },
   {
    "params": {
     "t": 1,
     "p": -0.5,
     "q": 2,
     "r": 0,
     "s": -4
    },
    "expect": {
     "x0": -2.5,
     "v0": 2.5,
     "a0": 1,
     "dir": 1
    }
   }
  ],
  "tol": 0.000001
 }
}
