{
 "id": "functions/calculus/정적분의_활용/속도와_가속도_분석",
 "spec": {
  "title": "위치·속도·가속도의 관계  ($x(t)=pt^3+qt^2+rt+s$)",
  "params": [
   {
    "name": "t",
    "label": "시각 t",
    "type": "slider",
    "min": 0,
    "max": 5,
    "init": 1,
    "step": 0.05,
    "unit": "s"
   },
   {
    "name": "p",
    "label": "t³ 계수 p (0이면 등가속도)",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "t² 계수 q",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": -6,
    "step": 0.25
   },
   {
    "name": "r",
    "label": "t 계수 r (= 초기속도 v(0))",
    "type": "slider",
    "min": -15,
    "max": 15,
    "init": 9,
    "step": 0.5
   },
   {
    "name": "s",
    "label": "상수항 s (= 초기위치 x(0))",
    "type": "slider",
    "min": -10,
    "max": 10,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "x0 = p*t^3 + q*t^2 + r*t + s; v0 = 3*p*t^2 + 2*q*t + r; a0 = 6*p*t + 2*q; spd = abs(v0); disc = 4*q^2 - 12*p*r; sq = disc > 0 ? sqrt(disc) : 0; tex1 = abs(p) > 1e-9 ? (disc > 0 ? (-2*q - sq)/(6*p) : 1e9) : (abs(q) > 1e-9 ? -r/(2*q) : 1e9); tex2 = abs(p) > 1e-9 ? (disc > 0 ? (-2*q + sq)/(6*p) : 1e9) : (abs(q) > 1e-9 ? -r/(2*q) : 1e9); tlo = min(tex1, tex2); thi = max(tex1, tex2); c1 = tlo < 0 ? 0 : (tlo > 5 ? 5 : tlo); c2 = thi < 0 ? 0 : (thi > 5 ? 5 : thi); tv = abs(p) > 1e-9 ? -q/(3*p) : 1e9; tvC = tv < 0 ? 0 : (tv > 5 ? 5 : tv); nturn = abs(p) > 1e-9 ? (disc > 0 ? 2 : (disc == 0 ? 1 : 0)) : (abs(q) > 1e-9 ? 1 : 0); dir = v0 > 0 ? 1 : (v0 < 0 ? -1 : 0); trend = v0*a0 > 0 ? 1 : (v0*a0 < 0 ? -1 : 0)",
  "plot": {
   "range": [
    0,
    5
   ],
   "yRange": [
    -25,
    30
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "p*x^3 + q*x^2 + r*x + s",
     "label": "위치 $x(t)$",
     "color": "#2563eb"
    },
    {
     "fn": "3*p*x^2 + 2*q*x + r",
     "label": "속도 $v(t)=x'(t)$",
     "color": "#16a34a"
    },
    {
     "fn": "6*p*x + 2*q",
     "label": "가속도 $a(t)=x''(t)$",
     "color": "#dc2626"
    },
    {
     "fn": "abs(3*p*x^2 + 2*q*x + r)",
     "label": "속력 $|v(t)|$",
     "color": "#9333ea",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "3*p*x^2 + 2*q*x + r",
     "in": [0, "=tvC"],
     "label": "$v=0$ (운동 방향 전환)"
    },
    {
     "fn": "3*p*x^2 + 2*q*x + r",
     "in": ["=tvC", 5],
     "label": "$v=0$ (운동 방향 전환)"
    },
    {
     "fn": "6*p*x + 2*q",
     "in": [0, 5],
     "label": "$a=0$ (속도가 극값)"
    },
    {
     "fn": "p*x^3 + q*x^2 + r*x + s",
     "in": [0, "=c1"],
     "label": "$x=0$ (원점 통과)"
    },
    {
     "fn": "p*x^3 + q*x^2 + r*x + s",
     "in": ["=c1", "=c2"],
     "label": "$x=0$ (원점 통과)"
    },
    {
     "fn": "p*x^3 + q*x^2 + r*x + s",
     "in": ["=c2", 5],
     "label": "$x=0$ (원점 통과)"
    }
   ],
   "points": [
    [
     "=t",
     "=x0"
    ],
    [
     "=t",
     "=v0"
    ],
    [
     "=t",
     "=a0"
    ],
    [
     "=t",
     "=spd"
    ]
   ],
   "pointsLabel": "$t$에서의 위치·속도·가속도·속력, 그리고 $v=0,\\;a=0,\\;x=0$ 인 시각"
  },
  "readout": [
   {
    "label": "시각 t (초)",
    "expr": "t",
    "digits": 2
   },
   {
    "label": "위치 x",
    "expr": "x0",
    "digits": 3
   },
   {
    "label": "속도 v (접선기울기)",
    "expr": "v0",
    "digits": 3
   },
   {
    "label": "가속도 a (v의 변화율)",
    "expr": "a0",
    "digits": 3
   },
   {
    "label": "속력 |v|",
    "expr": "spd",
    "digits": 3
   },
   {
    "label": "운동 방향 (+1 양의 방향 / -1 음의 방향)",
    "expr": "dir",
    "digits": 0
   },
   {
    "label": "속력 변화 (+1 빨라짐 / -1 느려짐, v와 a의 부호 비교)",
    "expr": "trend",
    "digits": 0
   },
   {
    "label": "방향 전환 시각의 개수 (v=0 의 실근)",
    "expr": "nturn",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "t": 0.5,
    "p": 1,
    "q": -6,
    "r": 9,
    "s": 0
   },
   {
    "t": 2.5,
