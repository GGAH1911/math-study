{
 "id": "probability-stats/middle-2/확률_중2/확률의_성질",
 "spec": {
  "title": "확률의 성질 탐구",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.4,
    "step": 0.01
   },
   {
    "name": "pB",
    "label": "P(B)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.3,
    "step": 0.01
   },
   {
    "name": "k",
    "label": "겹침 정도 k",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.2,
    "step": 0.01
   }
  ],
  "scope": "L = max(0, pA + pB - 1); U = min(pA, pB); pI = L + k * (U - L); pUnion = pA + pB - pI; notA = 1 - pA; notB = 1 - pB; notAB = 1 - pUnion;",
  "geometry": {
