  "scope": "pe=min(p,n); qe=min(q,n-pe); free=n-pe-qe; y0=free>=0?combinations(free,0):0; y1=free>=1?combinations(free,1):0; y2=free>=2?combinations(free,2):0; y3=free>=3?combinations(free,3):0; y4=free>=4?combinations(free,4):0; y5=free>=5?combinations(free,5):0; y6=free>=6?combinations(free,6):0; y7=free>=7?combinations(free,7):0; y8=free>=8?combinations(free,8):0; y9=free>=9?combinations(free,9):0; y10=free>=10?combinations(free,10):0; sumc=sum([y0,y1,y2,y3,y4,y5,y6,y7,y8,y9,y10]); free2=2^free; total=2^n; selfok=qe==0?1:0; cnt=pr==1?free2-selfok:free2; ratio=total>0?cnt/total:0",
