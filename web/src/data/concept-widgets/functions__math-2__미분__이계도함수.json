{
 "id": "functions/math-2/미분/이계도함수",
 "spec": {
  "title": "이계도함수와 곡률: f(x)=x³−3x²+2x+1",
  "params": [
   {
    "name": "a",
    "label": "접점 a",
    "type": "slider",
    "min": -0.5,
    "max": 2.5,
    "init": 0.4,
    "step": 0.05
   }
  ],
  "scope": "fa = a^3 - 3*a^2 + 2*a + 1; d1 = 3*a^2 - 6*a + 2; d2 = 6*a - 6",
  "plot": {
   "range": [
    -0.5,
    2.5
   ],
   "yRange": [
    -1,
    3
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x^2 + 2*x + 1",
     "label": "f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "fa + d1*(x - a)",
     "label": "접선: 1차근사 (기울기 f'(a))",
     "color": "#16a34a"
    },
    {
     "fn": "fa + d1*(x - a) + (d2/2)*(x - a)^2",
     "label": "2차근사 포물선 (곡률 f''(a))",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f'(a) 기울기",
    "expr": "d1",
    "digits": 3
   },
   {
    "label": "f''(a) 곡률",
    "expr": "d2",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -0.5
   },
   {
    "a": 0.4
   },
   {
    "a": 1.3
   },
   {
    "a": 2.5
   }
  ],
  "invariants": [
   "d2 - (6*a - 6)",
   "d1 - (d2^2/12 - 1)",
   "fa - ((d2/6)^3 - d2/6 + 1)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "fa": 1,
     "d1": 2,
     "d2": -6
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": 1,
     "d1": -1,
     "d2": 0
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 1,
     "d1": 2,
     "d2": 6
    }
   }
  ],
  "tol": 0.000001
 }
}