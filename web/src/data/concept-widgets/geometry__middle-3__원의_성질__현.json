     "from": [
      "=ax",
      "=d"
     ],
     "to": [
      "=bx",
      "=d"
     ],
     "label": "현 AB"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=d"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=d"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      0,
      "=d"
     ],
     "label": "M"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      0,
      "=d"
     ],
     "label": "d"
    }
   ]
  },
  "readout": [
   {
    "label": "현의 길이 L = 2√(r²−d²)",
    "expr": "L",
    "digits": 3
   },
   {
    "label": "반현 (AM=MB)",
    "expr": "half",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
