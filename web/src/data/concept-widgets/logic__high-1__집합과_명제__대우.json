   },
   {
    "params": {
     "a": 5,
     "b": 3
    },
    "expect": {
     "impl": 1,
     "contra": 1
    }
   },
   {
    "params": {
     "a": 3,
     "b": 3
    },
    "expect": {
     "impl": 1,
     "contra": 1
    }
   },
   {
    "params": {
     "a": 0,
     "b": 10
    },
    "expect": {
     "impl": 0,
     "contra": 0
    }
   }
  ],
  "tol": 0.000001
 }
}