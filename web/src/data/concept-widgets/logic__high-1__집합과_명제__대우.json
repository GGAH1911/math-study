     "type": "point",
     "at": [
      "=a",
      0
     ],
     "label": "a"
    },
    {
     "type": "point",
     "at": [
      "=b",
      0
     ],
     "label": "b"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      1.2
     ],
     "to": [
      10,
      1.2
     ],
     "label": "p: x≥a"
    },
    {
     "type": "segment",
     "from": [
      0,
      0.9
     ],
     "to": [
      "=a",
      0.9
     ],
     "label": "~p: x<a"
    },
    {
     "type": "segment",
     "from": [
      "=b",
      0.6
     ],
     "to": [
      10,
      0.6
     ],
     "label": "q: x≥b"
    },
    {
     "type": "segment",
     "from": [
      0,
      0.3
     ],
     "to": [
      "=b",
      0.3
     ],
     "label": "~q: x<b"
    }
   ]
  },
  "readout": [
   {
    "label": "p→q",
    "expr": "impl",
    "digits": 0
   },
   {
    "label": "~q→~p",
    "expr": "contra",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 3,
    "b": 5
   },
   {
    "a": 5,
    "b": 3
   },
   {
    "a": 3,
    "b": 3
   },
   {
    "a": 0,
    "b": 10
   }
  ],
  "invariants": [
