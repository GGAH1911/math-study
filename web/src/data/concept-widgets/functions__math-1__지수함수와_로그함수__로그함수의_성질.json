    "min": -3,
    "max": 4,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "lx=log(x,a); ly=log(y,a); lxy=log(x*y,a); ldiv=log(x/y,a); lpow=log(x^k,a); sumxy=lx+ly; submxy=lx-ly; kpow=k*lx",
  "plot": {
   "range": [
    0.1,
    17
   ],
   "yRange": [
    -16,
    16
   ],
   "fns": [
    {
     "fn": "log(x,a)",
     "label": "y = log_a(x)",
     "color": "#2563eb"
    },
    {
     "fn": "log(x^k,a)",
     "label": "y = log_a(x^k) = k·log_a(x)",
     "color": "#f59e0b"
    }
   ],
   "points": [
    [
     "=x",
     "=lx"
    ],
    [
     "=y",
     "=ly"
    ],
    [
     "=x",
     "=lpow"
    ]
   ],
   "pointsLabel": "빨간 점: (x, log_a x), (y, log_a y), (x, log_a(x^k))"
  },
  "readout": [
   {
    "label": "log_a x",
    "expr": "lx",
    "digits": 4
   },
   {
    "label": "log_a y",
    "expr": "ly",
    "digits": 4
   },
   {
    "label": "log_a(xy)",
    "expr": "lxy",
    "digits": 4
   },
   {
    "label": "log_a x + log_a y",
    "expr": "sumxy",
    "digits": 4
   },
   {
    "label": "log_a(x/y)",
    "expr": "ldiv",
    "digits": 4
   },
   {
    "label": "log_a x − log_a y",
    "expr": "submxy",
    "digits": 4
   },
   {
    "label": "log_a(x^k)",
    "expr": "lpow",
    "digits": 4
   },
   {
    "label": "k · log_a x",
    "expr": "kpow",
    "digits": 4
   }
  ]
 },
 "recipe": {
