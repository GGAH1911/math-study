{
 "id": "functions/math-1/지수함수와_로그함수/로그함수의_성질",
 "spec": {
  "title": "로그함수의 성질 — 곱셈을 덧셈으로",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 2,
    "max": 10,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "x",
    "label": "x",
    "type": "slider",
    "min": 1,
    "max": 16,
    "init": 4,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "y",
    "label": "y",
    "type": "slider",
    "min": 1,
    "max": 16,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "k",
