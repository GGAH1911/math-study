{
 "id": "geometry/high-1/도형의_방정식/두_원의_교선",
 "spec": {
  "title": "두 원의 교선(공통현) — 두 원의 방정식을 빼면 직선",
  "params": [
   {
    "name": "a2",
    "label": "원2 중심 x",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b2",
    "label": "원2 중심 y",
    "type": "slider",
    "min": -4,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "r1",
    "label": "원1 반지름 r₁",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 2.5,
    "step": 0.1
   },
   {
    "name": "r2",
    "label": "원2 반지름 r₂",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "a1=0; b1=0; D1=-2*a1; E1=-2*b1; F1=a1^2+b1^2-r1^2; D2=-2*a2; E2=-2*b2; F2=a2^2+b2^2-r2^2; A=D1-D2; B=E1-E2; C=F1-F2; den=A^2+B^2; px=-A*C/den; py=-B*C/den; dx=-B; dy=A; nrm=sqrt(dx^2+dy^2); ux=dx/nrm; uy=dy/nrm; Lh=8; x1=px-Lh*ux; y1=py-Lh*uy; x2=px+Lh*ux; y2=py+Lh*uy; dctr=sqrt(a2^2+b2^2)",
  "geometry": {
   "range": [
    -6,
    7
   ],
   "yRange": [
    -6,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=r1",
     "label": "C₁"
    },
    {
     "type": "circle",
     "center": [
      "=a2",
      "=b2"
     ],
     "radius": "=r2",
     "label": "C₂"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O₁"
    },
    {
     "type": "point",
     "at": [
      "=a2",
      "=b2"
     ],
     "label": "O₂"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a2",
      "=b2"
     ],
     "label": "중심선"
    },
    {
     "type": "segment",
     "from": [
      "=x1",
      "=y1"
     ],
     "to": [
      "=x2",
      "=y2"
     ],
     "label": "교선(공통현)"
    }
   ]
  },
  "readout": [
   {
    "label": "교선 x계수 (D₁-D₂)",
    "expr": "A",
    "digits": 3
   },
   {
    "label": "교선 y계수 (E₁-E₂)",
    "expr": "B",
    "digits": 3
   },
   {
    "label": "교선 상수항 (F₁-F₂)",
    "expr": "C",
    "digits": 3
   },
   {
    "label": "중심거리 d",
    "expr": "dctr",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a2": 2,
    "b2": 1,
    "r1": 2.5,
    "r2": 2
   },
   {
    "a2": 2,
    "b2": 0,
    "r1": 2,
    "r2": 1
   },
   {
    "a2": 0,
    "b2": 3,
    "r1": 2,
    "r2": 2
   },
   {
    "a2": 3,
    "b2": 4,
    "r1": 5,
    "r2": 5
   }
  ],
  "invariants": [
   "A*b2 - B*a2",
   "A*px + B*py + C",
   "(x2-x1)*a2 + (y2-y1)*b2"
  ],
  "oracle": [
   {
    "params": {
     "a2": 2,
     "b2": 0,
     "r1": 2,
     "r2": 1
    },
    "expect": {
     "A": 4,
     "B": 0,
     "C": -7,
     "px": 1.75,
     "py": 0
    }
   },
   {
    "params": {
     "a2": 0,
     "b2": 3,
     "r1": 2,
     "r2": 2
    },
    "expect": {
     "A": 0,
     "B": 6,
     "C": -9,
     "px": 0,
     "py": 1.5
    }
   },
   {
    "params": {
     "a2": 3,
     "b2": 4,
     "r1": 5,
     "r2": 5
    },
    "expect": {
     "A": 6,
     "B": 8,
     "C": -25,
     "px": 1.5,
     "py": 2
    }
   }
  ],
  "tol": 0.000001
 }
}