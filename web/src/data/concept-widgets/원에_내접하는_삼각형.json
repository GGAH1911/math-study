{
 "id": "원에_내접하는_삼각형",
 "spec": {
  "title": "원에 내접하는 삼각형",
  "params": [
   {
    "name": "beta",
    "label": "β (도)",
    "type": "slider",
    "min": 1,
    "max": 359,
    "init": 130,
    "step": 1
   },
   {
    "name": "gamma",
    "label": "γ (도)",
    "type": "slider",
    "min": 1,
    "max": 359,
    "init": 230,
    "step": 1
   }
  ],
  "scope": "rad_b = beta * pi / 180; rad_c = gamma * pi / 180; ax = 1; ay = 0; bx = cos(rad_b); by = sin(rad_b); cx = cos(rad_c); cy = sin(rad_c); a_len = sqrt((bx-cx)^2 + (by-cy)^2); b_len = sqrt((cx-ax)^2 + (cy-ay)^2); c_len = sqrt((ax-bx)^2 + (ay-by)^2); ux = bx-ax; uy = by-ay; vx = cx-ax; vy = cy-ay; cross_a = ux*vy - uy*vx; dot_a = ux*vx + uy*vy; angleA = abs(atan2(cross_a, dot_a)); ux = ax-bx; uy = ay-by; vx = cx-bx; vy = cy-by; cross_b = ux*vy - uy*vx; dot_b = ux*vx + uy*vy; angleB = abs(atan2(cross_b, dot_b)); ux = ax-cx; uy = ay-cy; vx = bx-cx; vy = by-cy; cross_c = ux*vy - uy*vx; dot_c = ux*vx + uy*vy; angleC = abs(atan2(cross_c, dot_c)); ratioA = a_len / sin(angleA); ratioB = b_len / sin(angleB); ratioC = c_len / sin(angleC)",
  "geometry": {
   "range": [
    -1.3,
    1.3
   ],
   "yRange": [
    -1.3,
    1.3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "polygon",
     "points": [
      [
       "=ax",
       "=ay"
      ],
      [
       "=bx",
       "=by"
      ],
      [
       "=cx",
       "=cy"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=cy"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "각 A (도)",
    "expr": "angleA*180/pi",
    "digits": 2
   },
   {
    "label": "각 B (도)",
    "expr": "angleB*180/pi",
    "digits": 2
   },
   {
    "label": "각 C (도)",
    "expr": "angleC*180/pi",
    "digits": 2
   },
   {
    "label": "a/sin(A)",
    "expr": "ratioA",
    "digits": 4
   },
   {
    "label": "b/sin(B)",
    "expr": "ratioB",
    "digits": 4
   },
   {
    "label": "c/sin(C)",
    "expr": "ratioC",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "beta": 90,
    "gamma": 180
   },
   {
    "beta": 120,
    "gamma": 240
   },
   {
    "beta": 50,
    "gamma": 150
   },
   {
    "beta": 80,
    "gamma": 200
   }
  ],
  "invariants": [
   "abs(angleA+angleB+angleC - pi)",
   "abs(ratioA - 2)",
   "abs(ratioB - 2)",
   "abs(ratioC - 2)"
  ],
  "oracle": [
   {
    "params": {
     "beta": 90,
     "gamma": 180
    },
    "expect": {
     "angleA": 0.7853981633974483,
     "angleB": 1.5707963267948966,
     "angleC": 0.7853981633974483
    }
   },
   {
    "params": {
     "beta": 120,
     "gamma": 240
    },
    "expect": {
     "angleA": 1.0471975511965976,
     "angleB": 1.0471975511965976,
     "angleC": 1.0471975511965976
    }
   }
  ],
  "tol": 0.000001
 }
}