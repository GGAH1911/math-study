     "type": "segment",
     "from": [
      0.5,
      0
     ],
     "to": [
      0.5,
      "=p"
     ]
    },
    {
     "type": "segment",
     "from": [
      0.5,
      "=p"
     ],
     "to": [
      0.5,
      "=p+q"
     ]
    },
    {
     "type": "point",
     "at": [
      0.5,
      "=p+q"
     ],
     "label": "x²합"
    },
    {
     "type": "segment",
     "from": [
      1.5,
      0
     ],
     "to": [
      1.5,
      "=r"
     ]
    },
    {
     "type": "segment",
     "from": [
      1.5,
      "=r"
     ],
     "to": [
      1.5,
      "=r+s"
     ]
    },
    {
     "type": "point",
     "at": [
      1.5,
      "=r+s"
     ],
     "label": "x합"
    },
    {
     "type": "point",
     "at": [
      0.5,
      -0.5
     ],
     "label": "x²"
    },
    {
     "type": "point",
     "at": [
      1.5,
      -0.5
     ],
     "label": "x"
    }
   ]
  },
  "readout": [
   {
    "label": "x² 계수 합",
    "expr": "p+q",
    "digits": 2
   },
   {
    "label": "x 계수 합",
    "expr": "r+s",
    "digits": 2
   },
   {
    "label": "원래 식 값",
