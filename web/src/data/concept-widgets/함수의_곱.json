{
 "id": "함수의_곱",
 "spec": {
  "title": "함수의 곱",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0.5,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "x",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "fval = x0+1; gval = a*x0+1; pval = fval*gval",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -12,
    12
   ],
   "fns": [
    {
     "fn": "x+1",
     "label": "f(x)=x+1",
     "color": "blue"
    },
    {
     "fn": "a*x+1",
     "label": "g(x)=a x+1",
     "color": "red"
    },
    {
     "fn": "(x+1)*(a*x+1)",
     "label": "(f·g)(x)",
     "color": "green"
    }
   ],
   "points": [
    ["=x0", "=x0+1"],
    ["=x0", "=a*x0+1"],
    ["=x0", "=(x0+1)*(a*x0+1)"]
   ],
   "pointsLabel": "$x=x_0$"
  },
  "readout": [
   {
    "label": "f(x)",
    "expr": "fval",
    "digits": 4
   },
   {
    "label": "g(x)",
    "expr": "gval",
    "digits": 4
   },
   {
    "label": "f(x)·g(x)",
    "expr": "pval",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5,
    "x0": 1
   },
   {
    "a": -1,
    "x0": 2
   },
   {
    "a": 0,
    "x0": -1.5
   },
   {
    "a": 1,
    "x0": -2
   }
  ],
  "invariants": [
   "pval - fval*gval",
   "fval - (x0+1)",
   "gval - (a*x0+1)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "x0": 2
    },
    "expect": {
     "fval": 3,
     "gval": 3,
     "pval": 9
    }
   },
   {
    "params": {
     "a": -1,
     "x0": 0
    },
    "expect": {
     "fval": 1,
     "gval": 1,
     "pval": 1
    }
   },
   {
    "params": {
     "a": 0.5,
     "x0": -1
    },
    "expect": {
     "fval": 0,
     "gval": 0.5,
     "pval": 0
    }
   }
  ],
  "tol": 0.000001
 }
}