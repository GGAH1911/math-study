{
 "id": "functions/calculus/합성함수의_미분/연쇄법칙",
 "spec": {
  "title": "연쇄법칙: y=(2x+1)³의 접선 기울기 분해",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (접점)",
    "type": "slider",
    "min": -1.5,
    "max": 0.5,
    "init": 0,
    "step": 0.01
   }
  ],
  "scope": "u=2*x0+1; dudx=2; dydu=3*u^2; dydx=dydu*dudx; y0=u^3",
  "plot": {
   "range": [
    -1.5,
    0.5
   ],
   "yRange": [
    -9,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "(2*x+1)^3",
     "label": "y=(2x+1)³",
     "color": "#2563eb"
    },
    {
     "fn": "y0 + dydx*(x - x0)",
     "label": "x₀에서의 접선 (기울기=dy/dx)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "u = 2x₀+1",
    "expr": "u",
    "digits": 3
   },
   {
    "label": "du/dx = (안쪽 변화율)",
    "expr": "dudx",
    "digits": 3
   },
   {
    "label": "dy/du = 3u² (바깥 변화율)",
    "expr": "dydu",
    "digits": 3
   },
   {
    "label": "dy/dx = (dy/du)·(du/dx)",
    "expr": "dydx",
    "digits": 3
   },
   {
    "label": "접점 y₀",
    "expr": "y0",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 0
   },
   {
    "x0": 0.5
   },
   {
    "x0": -0.5
   },
   {
    "x0": -1
   }
  ],
  "invariants": [
   "dydx - dydu*dudx",
   "dudx - 2",
   "dydx - (24*x0^2 + 24*x0 + 6)",
   "y0 - (8*x0^3 + 12*x0^2 + 6*x0 + 1)"
  ],
  "oracle": [
   {
    "params": {
     "x0": 0
    },
    "expect": {
     "u": 1,
     "dudx": 2,
     "dydu": 3,
     "dydx": 6,
     "y0": 1
    }
   },
   {
    "params": {
     "x0": 0.5
    },
    "expect": {
     "u": 2,
     "dudx": 2,
     "dydu": 12,
     "dydx": 24,
     "y0": 8
    }
   },
   {
    "params": {
     "x0": -1
    },
    "expect": {
     "u": -1,
     "dudx": 2,
     "dydu": 3,
     "dydx": 6,
     "y0": -1
    }
   }
  ],
  "tol": 0.000001
 }
}