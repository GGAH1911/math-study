     ],
     "label": "Q: 조건이 주는 각"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A(α)"
    }
   ]
  },
  "readout": [
   {
    "label": "조건의 각 θ",
    "expr": "theta",
    "digits": 1
   },
   {
    "label": "f(β)",
    "expr": "fb",
    "digits": 4
   },
   {
    "label": "f(θ)",
    "expr": "ft",
    "digits": 4
   },
   {
    "label": "f(α)",
    "expr": "fa",
    "digits": 4
   },
   {
    "label": "f(α)−f(β)",
    "expr": "gap",
    "digits": 4
   },
   {
    "label": "α도 해인가 (1=예)",
    "expr": "hit",
    "digits": 0
   }
  ]
 },
