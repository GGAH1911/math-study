{
 "id": "functions/math-1/삼각함수/각의_조건",
 "spec": {
  "title": "각의 조건 — 같은 삼각함수 값을 갖는 각 (단위원)",
  "params": [
   {
    "name": "beta",
    "label": "β",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 35,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=beta*pi/180; px=cos(rad); py=sin(rad); qx=-px; qy=py; rx=px; ry=-py",
  "geometry": {
   "range": [
    -1.5,
    1.5
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ],
     "color": "#1d4ed8"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=qx",
      "=qy"
     ],
     "color": "#dc2626"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=rx",
      "=ry"
     ],
     "color": "#16a34a"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=qx",
      "=qy"
     ],
     "color": "#dc2626",
     "label": "y좌표 같음 → sin 같음"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=rx",
      "=ry"
     ],
     "color": "#16a34a",
     "label": "x좌표 같음 → cos 같음"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P(β)"
    },
    {
     "type": "point",
     "at": [
      "=qx",
      "=qy"
     ],
     "label": "Q(180°−β): sin 짝"
    },
    {
     "type": "point",
     "at": [
      "=rx",
      "=ry"
     ],
     "label": "R(−β): cos 짝"
    }
   ]
  },
  "readout": [
   {
    "label": "sin β",
    "expr": "py",
    "digits": 4
   },
   {
    "label": "sin(180°−β)",
    "expr": "qy",
    "digits": 4
   },
   {
    "label": "cos β",
    "expr": "px",
    "digits": 4
   },
   {
    "label": "cos(−β)",
    "expr": "rx",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "beta": 35
   },
   {
    "beta": 120
   },
   {
    "beta": 210
   },
   {
    "beta": 300
   }
  ],
  "invariants": [
   "px^2+py^2-1",
   "qy-py",
   "rx-px",
   "qx+px",
   "ry+py"
  ],
  "oracle": [
   {
    "params": {
     "beta": 30
    },
    "expect": {
     "px": 0.8660254038,
     "py": 0.5,
     "qx": -0.8660254038,
     "qy": 0.5,
     "rx": 0.8660254038,
     "ry": -0.5
    }
   },
   {
    "params": {
     "beta": 60
    },
    "expect": {
     "px": 0.5,
     "py": 0.8660254038,
     "qx": -0.5,
     "qy": 0.8660254038,
     "rx": 0.5,
     "ry": -0.8660254038
    }
   },
   {
    "params": {
     "beta": 90
    },
    "expect": {
     "px": 0,
     "py": 1,
     "qx": 0,
     "qy": 1,
     "rx": 0,
     "ry": -1
    }
   }
  ],
  "tol": 0.000001
 }
}