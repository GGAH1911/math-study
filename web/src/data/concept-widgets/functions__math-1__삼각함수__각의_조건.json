{
 "id": "functions/math-1/삼각함수/각의_조건",
 "spec": {
  "title": "각의 조건 — sin·cos·tan 값이 같아지는 각 (단위원)",
  "params": [
   {
    "name": "beta",
    "label": "β (기준각)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 35,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "alpha",
    "label": "α (내가 찾는 각)",
    "type": "slider",
    "min": -360,
    "max": 720,
    "init": 145,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "pick",
    "label": "비교할 함수 (0: sin · 1: cos · 2: tan)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 0,
    "step": 1
   },
   {
    "name": "branch",
    "label": "해의 갈래 (0: 첫째 · 1: 둘째)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 1,
    "step": 1
   },
   {
    "name": "k",
    "label": "회전수 k",
    "type": "slider",
    "min": -1,
    "max": 2,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "rad=beta*pi/180; px=cos(rad); py=sin(rad); arad=alpha*pi/180; ax=cos(arad); ay=sin(arad);\ntheta=(pick<0.5 ? (branch<0.5 ? beta+360*k : 180-beta+360*k) : (pick<1.5 ? (branch<0.5 ? beta+360*k : -beta+360*k) : (branch<0.5 ? beta+360*k : beta+180+360*k)));\ntrad=theta*pi/180; tx=cos(trad); ty=sin(trad);\nfb=(pick<0.5 ? py : (pick<1.5 ? px : (abs(px)<1e-9 ? 1e12 : py/px)));\nft=(pick<0.5 ? ty : (pick<1.5 ? tx : (abs(tx)<1e-9 ? 1e12 : ty/tx)));\nfa=(pick<0.5 ? ay : (pick<1.5 ? ax : (abs(ax)<1e-9 ? 1e12 : ay/ax)));\nresid=ft-fb; gap=fa-fb; hit=(abs(gap)<0.02 ? 1 : 0);\nhx=(pick<0.5 ? 1.35 : 0); hy=(pick<0.5 ? py : 0);\nvx=(pick>0.5 ? (pick<1.5 ? px : 0) : 0); vy=(pick>0.5 ? (pick<1.5 ? 1.35 : 0) : 0);\ngx=(pick>1.5 ? 1.35*px : 0); gy=(pick>1.5 ? 1.35*py : 0)",
  "geometry": {
   "range": [
    -1.5,
    1.5
   ],
   "yRange": [
    -1.5,
    1.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
