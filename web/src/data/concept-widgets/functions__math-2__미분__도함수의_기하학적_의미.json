{
 "id": "functions/math-2/미분/도함수의_기하학적_의미",
 "spec": {
  "title": "도함수의 기하학적 의미 — 할선이 접선으로",
  "params": [
   {
    "name": "a",
    "label": "접점 x좌표 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "h",
    "label": "두 점 간격 h (→0)",
    "type": "slider",
    "min": 0.1,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "fa=a^2; fah=(a+h)^2; msec=(fah-fa)/h; mtan=2*a",
  "plot": {
   "range": [
    -4,
    6
   ],
   "yRange": [
    -2,
    16
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "#2563eb"
    },
    {
     "fn": "msec*(x-a)+fa",
     "label": "할선: 기울기 (f(a+h)−f(a))/h",
     "color": "#f59e0b"
    },
    {
     "fn": "mtan*(x-a)+fa",
     "label": "접선: 기울기 f'(a)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "할선의 기울기 (f(a+h)−f(a))/h",
    "expr": "msec",
    "digits": 3
   },
   {
    "label": "접선의 기울기 f'(a)=2a",
    "expr": "mtan",
    "digits": 3
   },
   {
    "label": "두 기울기의 차 (h→0이면 0)",
    "expr": "msec-mtan",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "h": 1.5
   },
   {
    "a": -2,
    "h": 0.5
   },
   {
    "a": 0,
    "h": 1
   },
   {
    "a": 3,
    "h": 1
   }
  ],
  "invariants": [
   "msec - mtan - h",
   "mtan - 2*a",
   "fa - a^2",
   "fah - (a+h)^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "h": 1.5
    },
    "expect": {
     "msec": 3.5,
     "mtan": 2,
     "fa": 1,
     "fah": 6.25
    }
   },
   {
    "params": {
     "a": -2,
     "h": 0.5
    },
    "expect": {
     "msec": -3.5,
     "mtan": -4,
     "fa": 4,
     "fah": 2.25
    }
   },
   {
    "params": {
     "a": 3,
     "h": 1
    },
    "expect": {
     "msec": 7,
     "mtan": 6,
     "fa": 9,
     "fah": 16
    }
   }
  ],
  "tol": 0.000001
 }
}