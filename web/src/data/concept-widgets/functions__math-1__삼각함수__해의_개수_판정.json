     "label": "$y=\\sin kx$ (함수 0)",
     "color": "#2563eb"
    },
    {
     "fn": "sel < 0.5 ? 0/0 : (sel < 1.5 ? cos(k*x) : 0/0)",
     "label": "$y=\\cos kx$ (함수 1)",
     "color": "#0891b2"
    },
    {
     "fn": "sel < 1.5 ? 0/0 : tan(k*x)",
     "label": "$y=\\tan kx$ (함수 2)",
     "color": "#7c3aed"
    },
    {
     "fn": "a",
     "label": "$y=a$ (구간 $[0,L\\pi]$)",
     "color": "#dc2626",
     "range": ["=0", "=Lpi"]
    }
   ],
   "intersections": [
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(0)", "=HIx(0)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(1)", "=HIx(1)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(2)", "=HIx(2)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(3)", "=HIx(3)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(4)", "=HIx(4)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(5)", "=HIx(5)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(6)", "=HIx(6)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(7)", "=HIx(7)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(8)", "=HIx(8)"]},
    {"f": "sel < 0.5 ? sin(k*x) : (sel < 1.5 ? cos(k*x) : tan(k*x))", "g": "a", "in": ["=LOx(9)", "=HIx(9)"]}
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "주기",
    "expr": "per",
    "digits": 2
   },
   {
    "label": "구간 길이 $L\\pi$",
