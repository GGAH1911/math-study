{
 "id": "functions/math-1/삼각함수/해의_개수_판정",
 "spec": {
  "title": "삼각방정식 f(kx)=a 의 해의 개수 (함수 0=sin, 1=cos, 2=tan)",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0.5,
    "step": 0.05
   },
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 1,
    "step": 1
   },
   {
    "name": "L",
    "label": "L",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "sel",
    "label": "함수",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "Lpi = L*pi; ep = 0.002/k; per = sel > 1.5 ? pi/k : 2*pi/k; F(t) = sel < 0.5 ? sin(k*t) : (sel < 1.5 ? cos(k*t) : tan(k*t)); C(j) = (sel > 0.5 and sel < 1.5) ? j*pi/k : (j - 0.5)*pi/k; U(j) = j < 1 ? 0 : min(C(j), Lpi); AS(u) = (sel > 1.5 and abs(cos(k*u)) < 1e-6) ? 1 : 0; LOx(j) = min(U(j) + (AS(U(j)) == 1 ? ep : 0), Lpi); HIx(j) = max(U(j+1) - (AS(U(j+1)) == 1 ? ep : 0), LOx(j)); Z(u) = abs(F(u) - a) < 1e-9 ? 0 : F(u) - a; X(j) = (HIx(j) - LOx(j) > 1e-12 and Z(LOx(j))*Z(HIx(j)) < 0) ? 1 : 0; NH(j) = ((j < 1 or U(j) > U(j-1) + 1e-12) and abs(F(U(j)) - a) < 1e-9) ? 1 : 0; n = sum([X(0),X(1),X(2),X(3),X(4),X(5),X(6),X(7),X(8),X(9)]) + sum([NH(0),NH(1),NH(2),NH(3),NH(4),NH(5),NH(6),NH(7),NH(8),NH(9),NH(10)])",
  "plot": {
   "range": [
    -0.2,
    9.6
   ],
   "yRange": [
    -1.7,
    1.7
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
