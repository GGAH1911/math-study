     "fgx0": 4
    }
   },
   {
    "params": {
     "a": 3,
     "b": -1,
     "x0": 2
    },
    "expect": {
     "gx0": 5,
     "fgx0": 25
    }
   }
  ],
  "tol": 0.000001
 }
}