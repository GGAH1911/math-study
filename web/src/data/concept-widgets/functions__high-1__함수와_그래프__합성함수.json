     "color": "#16a34a"
    },
    {
     "fn": "(a*x + b)^2",
     "label": "(f∘g)(x)=(ax+b)²",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "중간값 g(x₀)",
    "expr": "gx0",
    "digits": 3
   },
   {
    "label": "최종값 f(g(x₀))",
    "expr": "fgx0",
    "digits": 3
   },
   {
    "label": "직접 검산 (a·x₀+b)²",
    "expr": "(a*x0+b)^2",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1,
    "x0": 1
   },
   {
    "a": 1,
    "b": 0,
    "x0": 2
   },
   {
    "a": 3,
    "b": -1,
    "x0": 2
