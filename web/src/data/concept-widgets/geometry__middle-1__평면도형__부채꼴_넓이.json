{
 "id": "geometry/middle-1/평면도형/부채꼴_넓이",
 "spec": {
  "title": "부채꼴의 넓이",
  "params": [
   {
    "name": "r",
    "label": "반지름 r",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "theta",
    "label": "중심각 θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 90,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; ex=r*cos(rad); ey=r*sin(rad); area=theta/360*pi*r^2; arc=theta/360*2*pi*r",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=r"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=r",
      0
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=ex",
      "=ey"
     ]
    },
    {
     "type": "point",
     "at": [
      "=r",
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=ex",
      "=ey"
     ],
     "label": "P"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    }
   ]
  },
  "readout": [
   {
    "label": "넓이 S",
    "expr": "area",
    "digits": 4
   },
   {
    "label": "호의 길이 ℓ",
    "expr": "arc",
    "digits": 4
   },
   {
    "label": "S = θ/360 × πr²",
    "expr": "theta/360*pi*r^2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "r": 2,
    "theta": 90
   },
   {
    "r": 1,
    "theta": 180
   },
   {
    "r": 3,
    "theta": 60
   },
   {
    "r": 4,
    "theta": 360
   }
  ],
  "invariants": [
   "area-0.5*arc*r",
   "ex^2+ey^2-r^2",
   "area-theta/360*pi*r^2"
  ],
  "oracle": [
   {
    "params": {
     "r": 2,
     "theta": 90
    },
    "expect": {
     "area": 3.14159265358979,
     "arc": 3.14159265358979
    }
   },
   {
    "params": {
     "r": 1,
     "theta": 180
    },
    "expect": {
     "area": 1.5707963267949,
     "arc": 3.14159265358979
    }
   },
   {
    "params": {
     "r": 3,
     "theta": 60
    },
    "expect": {
     "area": 4.71238898038469,
     "arc": 3.14159265358979
    }
   }
  ],
  "tol": 0.000001
 }
}