{
 "id": "우극한과_좌극한",
 "spec": {
  "title": "우극한과 좌극한",
  "params": [
   {
    "name": "a",
    "label": "접근점 a",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "점프 크기 c",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "h",
    "label": "샘플 간격 h",
    "type": "slider",
    "min": 0.01,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "xl=a-h;xr=a+h;yl=(a-h)^2;yr=(a+h)^2+c;left_limit=a^2;right_limit=a^2+c;diff=abs(right_limit-left_limit);exists=c==0?1:0",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -3,
    7
   ],
   "fns": [
    {
     "fn": "x < a ? (x^2) : (x^2 + c)",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "좌극한",
    "expr": "left_limit",
    "digits": 4
   },
   {
    "label": "우극한",
    "expr": "right_limit",
    "digits": 4
   },
   {
    "label": "좌우 차이",
    "expr": "diff",
    "digits": 4
   },
   {
    "label": "극한 존재",
    "expr": "exists",
    "digits": 0
   },
   {
    "label": "f(a-h)",
    "expr": "yl",
    "digits": 4
   },
   {
    "label": "f(a+h)",
    "expr": "yr",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -1,
    "c": 2,
    "h": 0.2
   },
   {
    "a": 0,
    "c": 0,
    "h": 0.5
   },
   {
    "a": 1,
    "c": -1,
    "h": 0.1
   },
   {
    "a": 0.5,
    "c": 1.5,
    "h": 0.3
   }
  ],
  "invariants": [
   "yl - (a-h)^2",
   "yr - ((a+h)^2 + c)",
   "left_limit - a^2",
   "right_limit - (a^2 + c)",
   "diff - abs(c)",
   "exists - (c == 0 ? 1 : 0)",
   "diff * exists"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "c": 1,
     "h": 0.5
    },
    "expect": {
     "left_limit": 0,
     "right_limit": 1,
     "yl": 0.25,
     "yr": 1.25,
     "diff": 1,
     "exists": 0
    }
   },
   {
    "params": {
     "a": -1,
     "c": 0,
     "h": 0.25
    },
    "expect": {
     "left_limit": 1,
     "right_limit": 1,
     "yl": 1.5625,
     "yr": 0.5625,
     "diff": 0,
     "exists": 1
    }
   },
   {
    "params": {
     "a": 1,
     "c": 2,
     "h": 0.1
    },
    "expect": {
     "left_limit": 1,
     "right_limit": 3,
     "yl": 0.81,
     "yr": 3.21,
     "diff": 2,
     "exists": 0
    }
   }
  ],
  "tol": 0.000001
 }
}