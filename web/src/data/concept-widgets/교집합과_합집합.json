{
 "id": "교집합과_합집합",
 "spec": {
  "title": "교집합과 합집합의 확률",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0,
    "max": 0.5,
    "init": 0.3,
    "step": 0.01
   },
   {
    "name": "pB",
    "label": "P(B)",
    "type": "slider",
    "min": 0,
    "max": 0.5,
    "init": 0.4,
    "step": 0.01
   },
   {
    "name": "k",
    "label": "교집합 비율",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "L=k*min(pA,pB); U=pA+pB-L",
  "geometry": {
