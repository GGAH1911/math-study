{
 "id": "functions/middle-2/일차함수/일차함수의_평행이동",
 "spec": {
  "title": "일차함수의 평행이동 y=ax+b → y=a(x-p)+b+q",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "b",
    "label": "y절편 b",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 1,
    "step": 1
   },
   {
    "name": "p",
    "label": "수평이동 p",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 3,
    "step": 1
   },
   {
    "name": "q",
    "label": "수직이동 q",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "nb = a*(-p) + b + q; slope_t = (a*(1-p)+b+q - (a*(0-p)+b+q))/1",
  "plot": {
   "range": [
    -10,
    10
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "a*x+b",
     "label": "원래 y=ax+b",
     "color": "#888888"
    },
    {
     "fn": "a*(x-p)+b+q",
     "label": "이동 y=a(x-p)+b+q",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "기울기(불변)",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "이동 후 y절편 b-ap+q",
    "expr": "nb",
    "digits": 2
   },
   {
    "label": "이동 후 직선 기울기(검증)",
    "expr": "slope_t",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1,
    "p": 3,
    "q": 2
   },
   {
    "a": 1,
    "b": 0,
    "p": -2,
    "q": 1
   },
   {
    "a": -3,
    "b": 4,
    "p": 2,
    "q": -5
   },
   {
    "a": 0.5,
    "b": -2,
    "p": -4,
    "q": 3
   }
  ],
  "invariants": [
   "slope_t - a",
   "nb - (b + q - a*p)",
   "(a*(0-p)+b+q) - nb"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1,
     "p": 3,
     "q": 2
    },
    "expect": {
     "nb": -3,
     "slope_t": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "p": -2,
     "q": 1
    },
    "expect": {
     "nb": 3,
     "slope_t": 1
    }
   },
   {
    "params": {
     "a": -3,
     "b": 4,
     "p": 2,
     "q": -5
    },
    "expect": {
     "nb": 5,
     "slope_t": -3
    }
   }
  ],
  "tol": 0.000001
 }
}