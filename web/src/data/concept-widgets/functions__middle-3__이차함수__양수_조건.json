{
 "id": "functions/middle-3/이차함수/양수_조건",
 "spec": {
  "title": "이차함수가 항상 양수일 조건 (a>0, D<0)",
  "params": [
   {
    "name": "a",
    "label": "a (이차항 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (일차항 계수)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (상수항)",
    "type": "slider",
    "min": -4,
    "max": 8,
    "init": 5,
    "step": 0.1
   }
  ],
  "scope": "D = b^2 - 4*a*c; vx = -b/(2*a); minval = c - b^2/(4*a)",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -6,
    12
   ],
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "f(x)=ax^2+bx+c",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = b²-4ac",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "꼭짓점 x = -b/2a",
    "expr": "vx",
    "digits": 3
   },
   {
    "label": "최솟값(a>0일 때) = c-b²/4a",
    "expr": "minval",
    "digits": 3
   },
   {
    "label": "항상 양수인가? (a>0 & D<0 → 1)",
    "expr": "(a>0 and D<0)?1:0",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": 1
   },
   {
    "a": 1,
    "b": 2,
    "c": 5
   },
   {
    "a": 1,
    "b": -4,
    "c": 3
   },
   {
    "a": 2,
    "b": 4,
    "c": 5
   }
  ],
  "invariants": [
   "minval*4*a + D",
   "a*vx^2 + b*vx + c - minval",
   "D - (b^2 - 4*a*c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 1
    },
    "expect": {
     "D": -4,
     "vx": 0,
     "minval": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 5
    },
    "expect": {
     "D": -16,
     "vx": -1,
     "minval": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": -4,
     "c": 3
    },
    "expect": {
     "D": 4,
     "vx": 2,
     "minval": -1
    }
   }
  ],
  "tol": 0.000001
 }
}