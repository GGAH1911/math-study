     "ymax": 0.25,
     "ymin": -0.25
    }
   },
   {
    "params": {
     "a": 1.44
    },
    "expect": {
     "xp": 1.2,
     "xm": -1.2,
     "ymax": 3.456,
     "ymin": -3.456
    }
   }
  ],
  "tol": 0.000001
 }
}