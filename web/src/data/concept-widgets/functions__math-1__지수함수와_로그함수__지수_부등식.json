{
 "id": "functions/math-1/지수함수와_로그함수/지수_부등식",
 "spec": {
  "title": "지수 부등식: aˣ > c 의 해 (밑이 부등호 방향을 결정)",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.2,
    "max": 4,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "우변 c",
    "type": "slider",
    "min": 0.5,
    "max": 8,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "x0 = log(c)/log(a)",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    0,
    10
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "y = aˣ",
     "color": "#2563eb"
    },
    {
     "fn": "c",
     "label": "y = c",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "경계 x₀ = logₐc",
    "expr": "x0",
    "digits": 3
   },
   {
    "label": "검증 aˣ⁰ (= c 여야)",
    "expr": "a^x0",
    "digits": 3
   },
   {
    "label": "ln(밑): >0이면 증가→해 x>x₀, <0이면 감소→해 x<x₀",
    "expr": "log(a)",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "c": 4
   },
   {
    "a": 2,
    "c": 8
   },
   {
    "a": 0.5,
    "c": 4
   },
   {
    "a": 3,
    "c": 1
   }
  ],
  "invariants": [
   "a^x0 - c",
   "x0*log(a) - log(c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "c": 4
    },
    "expect": {
     "x0": 2
    }
   },
   {
    "params": {
     "a": 0.5,
     "c": 4
    },
    "expect": {
     "x0": -2
    }
   },
   {
    "params": {
     "a": 3,
     "c": 1
    },
    "expect": {
     "x0": 0
    }
   }
  ],
  "tol": 0.000001
 }
}