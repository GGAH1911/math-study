{
 "id": "geometry/geometry-elective/이차곡선/초점",
 "spec": {
  "title": "타원의 초점 — 두 초점까지 거리의 합은 일정 (|PF₁|+|PF₂|=2a)",
  "params": [
   {
    "name": "a",
    "label": "장반축 a",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 4,
    "step": 0.5
   },
   {
    "name": "e",
    "label": "이심률 e (초점 벌어짐)",
    "type": "slider",
    "min": 0,
    "max": 0.9,
    "init": 0.6,
    "step": 0.05
   },
   {
    "name": "t",
    "label": "점 P 위치각",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 50,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "c=a*e; b=a*sqrt(1-e^2); rad=t*pi/180; Px=a*cos(rad); Py=b*sin(rad); d1=sqrt((Px+c)^2+Py^2); d2=sqrt((Px-c)^2+Py^2); summ=d1+d2; target=2*a",
