{
 "id": "probability-stats/prob-stats-elective/통계/확률변수",
 "spec": {
  "title": "확률변수의 정의: X(s)=as+b",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 0.5,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "절편 b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -2,
    "step": 0.1
   },
   {
    "name": "s",
    "label": "결과 s",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 4,
    "step": 1
   }
  ],
  "scope": "x1=a*1+b; x2=a*2+b; x3=a*3+b; x4=a*4+b; x5=a*5+b; x6=a*6+b; xs=a*s+b;",
  "geometry": {
   "range": [
    0.5,
    6.5
   ],
   "yRange": [
    -10,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      1,
      "=x1"
     ]
    },
    {
     "type": "point",
     "at": [
      2,
      "=x2"
     ]
    },
    {
     "type": "point",
     "at": [
      3,
      "=x3"
     ]
    },
    {
     "type": "point",
     "at": [
      4,
      "=x4"
     ]
    },
    {
     "type": "point",
     "at": [
      5,
      "=x5"
     ]
    },
    {
     "type": "point",
     "at": [
      6,
      "=x6"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=s",
      0
     ],
     "to": [
      "=s",
      "=xs"
     ]
    },
    {
     "type": "point",
     "at": [
      "=s",
      "=xs"
     ],
     "label": "X(s)"
    }
   ]
  },
  "readout": [
   {
    "label": "X(s)",
    "expr": "xs",
    "digits": 2
   },
   {
    "label": "X(s)=a·s+b",
    "expr": "a*s+b",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5,
    "b": -2,
    "s": 4
   },
   {
    "a": -1,
    "b": 3,
    "s": 2
   },
   {
    "a": 0,
    "b": 2,
    "s": 5
   }
  ],
  "invariants": [
   "(x1-(a*1+b))^2+(x2-(a*2+b))^2+(x3-(a*3+b))^2+(x4-(a*4+b))^2+(x5-(a*5+b))^2+(x6-(a*6+b))^2",
   "xs-(a*s+b)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0.5,
     "b": -2,
     "s": 4
    },
    "expect": {
     "xs": 0,
     "x1": -1.5,
     "x6": 1
    }
   },
   {
    "params": {
     "a": -1,
     "b": 3,
     "s": 2
    },
    "expect": {
     "xs": 1,
     "x1": 2,
     "x6": -3
    }
   },
   {
    "params": {
     "a": 0,
     "b": 2,
     "s": 5
    },
    "expect": {
     "xs": 2,
     "x1": 2,
     "x6": 2
    }
   }
  ],
  "tol": 0.000001
 }
}