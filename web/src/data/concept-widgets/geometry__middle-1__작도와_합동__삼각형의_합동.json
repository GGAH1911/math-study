 "spec": {
  "title": "삼각형의 합동 — 이동·회전으로 겹쳐보기",
  "params": [
   {
    "name": "rot",
    "label": "회전각 φ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 90,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "tx",
    "label": "가로 이동",
    "type": "slider",
    "min": -4,
    "max": 6,
    "init": 5,
    "step": 0.1
   },
   {
    "name": "ty",
    "label": "세로 이동",
    "type": "slider",
    "min": -4,
    "max": 6,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "phi=rot*pi/180; Dx=tx; Dy=ty; Ex=3*cos(phi)+tx; Ey=3*sin(phi)+ty; Fx=cos(phi)-2*sin(phi)+tx; Fy=sin(phi)+2*cos(phi)+ty; DE=sqrt((Ex-Dx)^2+(Ey-Dy)^2); EF=sqrt((Fx-Ex)^2+(Fy-Ey)^2); FD=sqrt((Dx-Fx)^2+(Dy-Fy)^2)",
