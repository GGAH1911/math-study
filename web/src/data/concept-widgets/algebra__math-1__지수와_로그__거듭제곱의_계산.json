{
 "id": "algebra/math-1/지수와_로그/거듭제곱의_계산",
 "spec": {
  "title": "거듭제곱의 계산",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.5,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "분자 p",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 1
   },
   {
    "name": "q",
    "label": "분모 q",
    "type": "slider",
    "min": 1,
    "max": 5,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "n = p/q; val = a^n; root = (a^p)^(1/q); alt = (a^(1/q))^p; diff1 = val - root; diff2 = val - alt",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    0,
    7
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    0,
    7
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "a^x",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "a^(p/q)",
    "expr": "val",
    "digits": 6
   },
   {
    "label": "(a^p)^(1/q)",
    "expr": "root",
    "digits": 6
   },
   {
    "label": "차이",
    "expr": "diff1",
    "digits": 8
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1.5,
    "p": 1,
    "q": 2
   },
   {
    "a": 2,
    "p": 2,
    "q": 3
   },
   {
    "a": 0.5,
    "p": -1,
    "q": 2
   },
   {
    "a": 2.5,
    "p": 1,
    "q": 1
   }
  ],
  "invariants": [
   "diff1",
   "diff2",
   "1 - val*(a^(-n))"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "p": 1,
     "q": 2
    },
    "expect": {
     "val": 1.4142135623730951,
     "diff1": 0
    }
   },
   {
    "params": {
     "a": 2,
     "p": 2,
     "q": 2
    },
    "expect": {
