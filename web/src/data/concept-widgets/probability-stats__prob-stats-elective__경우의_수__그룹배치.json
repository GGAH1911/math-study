  "readout": [
   {
    "label": "S(n,k)",
    "expr": "S_nk",
    "digits": 0
   },
   {
    "label": "k·S(n-1,k)",
    "expr": "a*S_n1k",
    "digits": 0
   },
   {
    "label": "S(n-1,k-1)",
    "expr": "S_n1k1",
    "digits": 0
   },
   {
    "label": "재귀 일치",
    "expr": "S_nk - (a*S_n1k + S_n1k1)",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 4,
    "k": 2
   },
   {
    "n": 5,
    "k": 3
   },
   {
    "n": 6,
