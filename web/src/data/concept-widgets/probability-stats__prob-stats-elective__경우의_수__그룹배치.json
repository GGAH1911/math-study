{
 "id": "probability-stats/prob-stats-elective/경우의_수/그룹배치",
 "spec": {
  "title": "그룹배치 (제2종 스털링 수)",
  "params": [
   {
    "name": "n",
    "label": "전체 원소 수 n",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 4,
    "step": 1
   },
   {
    "name": "k",
    "label": "그룹 수 k",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "a = min(k,n); S_nk = (sum([(0<=a ? 1*combinations(a,0)*(a-0)^n : 0), (1<=a ? -1*combinations(a,1)*(a-1)^n : 0), (2<=a ? 1*combinations(a,2)*(a-2)^n : 0), (3<=a ? -1*combinations(a,3)*(a-3)^n : 0), (4<=a ? 1*combinations(a,4)*(a-4)^n : 0), (5<=a ? -1*combinations(a,5)*(a-5)^n : 0), (6<=a ? 1*combinations(a,6)*(a-6)^n : 0)]))/factorial(a); S_n1k = (sum([(0<=a ? 1*combinations(a,0)*(a-0)^(n-1) : 0), (1<=a ? -1*combinations(a,1)*(a-1)^(n-1) : 0), (2<=a ? 1*combinations(a,2)*(a-2)^(n-1) : 0), (3<=a ? -1*combinations(a,3)*(a-3)^(n-1) : 0), (4<=a ? 1*combinations(a,4)*(a-4)^(n-1) : 0), (5<=a ? -1*combinations(a,5)*(a-5)^(n-1) : 0), (6<=a ? 1*combinations(a,6)*(a-6)^(n-1) : 0)]))/factorial(a); S_n1k1 = (sum([(0<=a-1 ? 1*combinations(a-1,0)*(a-1-0)^(n-1) : 0), (1<=a-1 ? -1*combinations(a-1,1)*(a-1-1)^(n-1) : 0), (2<=a-1 ? 1*combinations(a-1,2)*(a-1-2)^(n-1) : 0), (3<=a-1 ? -1*combinations(a-1,3)*(a-1-3)^(n-1) : 0), (4<=a-1 ? 1*combinations(a-1,4)*(a-1-4)^(n-1) : 0), (5<=a-1 ? -1*combinations(a-1,5)*(a-1-5)^(n-1) : 0), (6<=a-1 ? 1*combinations(a-1,6)*(a-1-6)^(n-1) : 0)]))/factorial(a-1)",
