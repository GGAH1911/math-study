{
 "id": "functions/calculus/수열의_극한/반복_구조의_극한",
 "spec": {
  "title": "반복 구조의 극한: 거미집 도형과 고정점",
  "params": [
   {
    "name": "c",
    "label": "c (점화식 상수)",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "a₀ (시작값)",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 0.2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "x1 = sqrt(c + x0); x2 = sqrt(c + x1); x3 = sqrt(c + x2); x4 = sqrt(c + x3); L = (1 + sqrt(1 + 4*c))/2",
  "plot": {
   "range": [
    0,
    4
   ],
   "yRange": [
    0,
    4
   ],
   "fns": [
    {
     "fn": "sqrt(c + x)",
     "label": "y = f(x) = √(c+x)",
     "color": "#2563eb"
    },
    {
     "fn": "x",
     "label": "y = x",
     "color": "#9ca3af"
    }
   ]
  },
  "readout": [
   {
    "label": "극한값 L (고정점, L=f(L))",
    "expr": "L",
    "digits": 4
   },
   {
    "label": "4회 반복값 a₄",
    "expr": "x4",
    "digits": 6
   },
   {
    "label": "오차 |a₄ − L|",
    "expr": "abs(x4 - L)",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 2,
    "x0": 0.2
   },
   {
    "c": 0,
    "x0": 4
   },
   {
    "c": 6,
    "x0": 1
   },
   {
    "c": 2,
    "x0": 3.5
   }
  ],
  "invariants": [
   "sqrt(c + L) - L",
   "L^2 - L - c",
   "sqrt(c + x0) - x1",
   "sqrt(c + x3) - x4"
  ],
  "oracle": [
   {
    "params": {
     "c": 2,
     "x0": 2
    },
    "expect": {
     "L": 2,
     "x1": 2
    }
   },
   {
    "params": {
     "c": 0,
     "x0": 4
    },
    "expect": {
     "L": 1,
     "x1": 2,
     "x2": 1.4142135623730951
    }
   },
   {
    "params": {
     "c": 6,
     "x0": 0
    },
    "expect": {
     "L": 3,
     "x1": 2.449489742783178
    }
   }
  ],
  "tol": 0.000001
 }
}