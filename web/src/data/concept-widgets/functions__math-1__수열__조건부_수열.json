{
 "id": "functions/math-1/수열/조건부_수열",
 "spec": {
  "title": "조건부 수열 — 조건에 따라 규칙이 바뀐다",
  "params": [
   {
    "name": "k",
    "label": "경계 k (n ≤ k 이면 규칙1)",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 5,
    "step": 1,
    "unit": ""
   },
   {
    "name": "p",
    "label": "규칙1의 기울기 p ($a_n = p\\,n+q$)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": -1,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "q",
    "label": "규칙1의 상수 q",
    "type": "slider",
    "min": -4,
    "max": 12,
    "init": 12,
    "step": 1,
    "unit": ""
   },
   {
    "name": "r",
    "label": "규칙2의 기울기 r ($a_n = r\\,n+s$)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "s",
    "label": "규칙2의 상수 s",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -3,
    "step": 1,
    "unit": ""
   },
   {
    "name": "mode",
    "label": "조건 방식 (0: n ≤ k 범위 · 1: 홀수/짝수)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "c1=(mode==0)*(1<=k)+(mode==1)*(mod(1,2)==1); a1=c1*(p*1+q)+(1-c1)*(r*1+s); c2=(mode==0)*(2<=k)+(mode==1)*(mod(2,2)==1); a2=c2*(p*2+q)+(1-c2)*(r*2+s); c3=(mode==0)*(3<=k)+(mode==1)*(mod(3,2)==1); a3=c3*(p*3+q)+(1-c3)*(r*3+s); c4=(mode==0)*(4<=k)+(mode==1)*(mod(4,2)==1); a4=c4*(p*4+q)+(1-c4)*(r*4+s); c5=(mode==0)*(5<=k)+(mode==1)*(mod(5,2)==1); a5=c5*(p*5+q)+(1-c5)*(r*5+s); c6=(mode==0)*(6<=k)+(mode==1)*(mod(6,2)==1); a6=c6*(p*6+q)+(1-c6)*(r*6+s); c7=(mode==0)*(7<=k)+(mode==1)*(mod(7,2)==1); a7=c7*(p*7+q)+(1-c7)*(r*7+s); c8=(mode==0)*(8<=k)+(mode==1)*(mod(8,2)==1); a8=c8*(p*8+q)+(1-c8)*(r*8+s); jump=(r*(k+1)+s)-(p*k+q); meet=(abs(p-r)<1e-9)*0+(abs(p-r)>=1e-9)*((s-q)/((abs(p-r)<1e-9)*1+(abs(p-r)>=1e-9)*(p-r)))",
  "geometry": {
   "range": [
    0,
    9
   ],
   "yRange": [
    -20,
    28
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=0",
      "=q"
     ],
     "to": [
      "=9",
      "=9*p+q"
     ],
     "dashed": true,
     "color": "#2266dd",
     "label": "$a_n=pn+q$ (규칙1)"
    },
    {
     "type": "segment",
     "from": [
      "=0",
      "=s"
     ],
     "to": [
      "=9",
      "=9*r+s"
     ],
     "dashed": true,
     "color": "#22aa55",
     "label": "$a_n=rn+s$ (규칙2)"
    },
    {
     "type": "segment",
     "from": [
      "=(mode==0)*(k+0.5)+(mode==1)*(-1)",
      -20
     ],
     "to": [
      "=(mode==0)*(k+0.5)+(mode==1)*(-1)",
      28
     ],
     "color": "#dd2222",
     "label": "n=k 경계"
    },
    {
     "type": "point",
     "at": [
      1,
      "=a1"
     ],
     "label": "a1"
    },
    {
     "type": "point",
     "at": [
      2,
      "=a2"
     ],
     "label": "a2"
    },
    {
     "type": "point",
     "at": [
      3,
      "=a3"
     ],
     "label": "a3"
    },
    {
     "type": "point",
     "at": [
      4,
      "=a4"
     ],
     "label": "a4"
    },
    {
     "type": "point",
     "at": [
      5,
      "=a5"
     ],
     "label": "a5"
    },
    {
     "type": "point",
     "at": [
      6,
      "=a6"
     ],
     "label": "a6"
    },
    {
     "type": "point",
     "at": [
      7,
      "=a7"
     ],
     "label": "a7"
    },
    {
     "type": "point",
     "at": [
      8,
      "=a8"
     ],
     "label": "a8"
    }
   ]
  },
  "readout": [
   {
    "label": "경계 k",
    "expr": "k",
    "digits": 0
   },
   {
    "label": "경계 앞 항 $a_k$ (규칙1)",
    "expr": "p*k+q",
    "digits": 1
   },
   {
    "label": "경계 뒤 항 $a_{k+1}$ (규칙2)",
    "expr": "r*(k+1)+s",
    "digits": 1
   },
   {
    "label": "경계에서의 점프 $a_{k+1}-a_k$",
    "expr": "jump",
    "digits": 1
   },
   {
    "label": "두 규칙이 만나는 n (평행이면 0)",
    "expr": "meet",
    "digits": 2
   }
  ]
 },
 "recipe": {
