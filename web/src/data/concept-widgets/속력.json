{
 "id": "속력",
 "spec": {
  "title": "속력 = |속도| — a·b·c·d 를 움직이며 방향이 바뀌는 순간을 본다",
  "params": [
   {
    "name": "a",
    "label": "a (t³ 계수)",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (t² 계수)",
    "type": "slider",
    "min": -6,
    "max": 3,
    "init": -6,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (t 계수)",
    "type": "slider",
    "min": -6,
    "max": 12,
    "init": 9,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d (출발 위치)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.5
   },
   {
    "name": "t",
    "label": "시각 t",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 0.5,
    "step": 0.01,
    "unit": "초"
   }
  ],
  "scope": "x = a*t^3 + b*t^2 + c*t + d; v = 3*a*t^2 + 2*b*t + c; sp = abs(v); dir = sign(v); Dv = 4*b^2 - 12*a*c; nturn = a == 0 ? (b == 0 ? 0 : 1) : (Dv > 0.0001 ? 2 : (Dv < -0.0001 ? 0 : 1)); tv = a == 0 ? 0 : -b/(3*a); tvc = tv < 0 ? 0 : (tv > 4 ? 4 : tv)",
  "plot": {
   "range": [
    0,
    4
   ],
   "yRange": [
    -15,
    20
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "$x(t)$ 위치",
     "color": "#888888"
    },
    {
     "fn": "3*a*x^2 + 2*b*x + c",
     "label": "$v(t)=x'(t)$ 속도",
     "color": "#2a7fff"
    },
    {
     "fn": "abs(3*a*x^2 + 2*b*x + c)",
     "label": "$|v(t)|$ 속력",
     "color": "#e0442f"
    }
   ],
   "roots": [
    {
     "fn": "3*a*x^2 + 2*b*x + c",
     "in": [0, "=tvc"],
     "label": "속도 0 (방향 전환)"
    },
    {
     "fn": "3*a*x^2 + 2*b*x + c",
     "in": ["=tvc", 4],
     "label": "속도 0 (방향 전환)"
    }
   ],
   "points": [
    [
     "=t",
     "=a*t^3 + b*t^2 + c*t + d"
    ],
    [
     "=t",
     "=3*a*t^2 + 2*b*t + c"
    ],
    [
     "=t",
     "=abs(3*a*t^2 + 2*b*t + c)"
    ]
   ],
   "pointsLabel": "$t$"
  },
  "readout": [
   {
    "label": "위치 x(t)",
    "expr": "x",
    "digits": 3
   },
   {
    "label": "속도 v(t)",
    "expr": "v",
    "digits": 3
   },
   {
    "label": "속력 |v(t)|",
    "expr": "sp",
    "digits": 3
   },
   {
    "label": "운동 방향 (+1 오른쪽 · −1 왼쪽 · 0 멈춤)",
    "expr": "dir",
    "digits": 0
   },
   {
    "label": "속도가 0이 되는 시각의 개수",
    "expr": "nturn",
    "digits": 0
   },
   {
    "label": "판별식 4b²−12ac",
    "expr": "Dv",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": -6,
    "c": 9,
    "d": 0,
    "t": 0
   },
   {
    "a": 1,
    "b": -6,
    "c": 9,
    "d": 0,
    "t": 2
   },
   {
    "a": 1,
    "b": -6,
    "c": 9,
    "d": 0,
    "t": 3
   },
   {
    "a": 1,
    "b": -3,
    "c": 3,
    "d": 0,
    "t": 1
   },
   {
    "a": 1,
    "b": 0,
    "c": 3,
    "d": 0,
    "t": 1
   },
   {
    "a": 0,
    "b": 1,
    "c": -2,
    "d": 1,
    "t": 1
   },
   {
    "a": 1,
    "b": -6,
    "c": 9,
    "d": 2,
    "t": 0
   }
  ],
  "invariants": [
   "sp - abs(v)",
   "sp*sp - v*v",
   "v - (3*a*t^2 + 2*b*t + c)",
   "x - (a*t^3 + b*t^2 + c*t + d)",
   "Dv - (4*b^2 - 12*a*c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": -6,
     "c": 9,
     "d": 0,
     "t": 0
    },
    "expect": {
     "x": 0,
     "v": 9,
     "sp": 9,
     "dir": 1,
     "Dv": 36,
     "nturn": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": -6,
     "c": 9,
     "d": 0,
     "t": 2
    },
    "expect": {
     "x": 2,
     "v": -3,
     "sp": 3,
     "dir": -1,
     "nturn": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": -6,
     "c": 9,
     "d": 0,
     "t": 3
    },
    "expect": {
     "x": 0,
     "v": 0,
     "sp": 0,
     "dir": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": -3,
     "c": 3,
     "d": 0,
     "t": 1
    },
    "expect": {
     "x": 1,
     "v": 0,
     "sp": 0,
     "Dv": 0,
     "nturn": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 3,
     "d": 0,
     "t": 1
    },
    "expect": {
     "x": 4,
     "v": 6,
     "sp": 6,
     "Dv": -36,
     "nturn": 0
    }
   },
   {
    "params": {
     "a": 0,
     "b": 1,
     "c": -2,
     "d": 1,
     "t": 1
    },
    "expect": {
     "x": 0,
     "v": 0,
     "sp": 0,
     "nturn": 1,
     "tv": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": -6,
     "c": 9,
     "d": 2,
     "t": 0
    },
    "expect": {
     "x": 2,
     "v": 9,
     "sp": 9
    }
   }
  ],
  "tol": 0.000001
 }
}