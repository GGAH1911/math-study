{
 "id": "probability-stats/high-1/경우의_수_고1/회전_대칭",
 "spec": {
  "title": "회전 대칭 - 정n각형의 회전",
  "params": [
   {
    "name": "n",
    "label": "정n각형의 변의 수 n",
    "type": "slider",
    "min": 3,
    "max": 12,
    "init": 4,
    "step": 1
   },
   {
    "name": "turn",
    "label": "몇 칸 회전 (k)",
    "type": "slider",
    "min": 0,
    "max": 12,
    "init": 0,
    "step": 1
   },
   {
    "name": "fine",
    "label": "미세 어긋남",
    "type": "slider",
    "min": -60,
    "max": 60,
    "init": 0,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "N=round(n); stepdeg=360/N; theta=turn*stepdeg+fine; rad=theta*pi/180;\na0=2*pi*min(0,N-1)/N; a1=2*pi*min(1,N-1)/N; a2=2*pi*min(2,N-1)/N; a3=2*pi*min(3,N-1)/N; a4=2*pi*min(4,N-1)/N; a5=2*pi*min(5,N-1)/N; a6=2*pi*min(6,N-1)/N; a7=2*pi*min(7,N-1)/N; a8=2*pi*min(8,N-1)/N; a9=2*pi*min(9,N-1)/N; a10=2*pi*min(10,N-1)/N; a11=2*pi*min(11,N-1)/N;\nbx0=cos(a0); by0=sin(a0); bx1=cos(a1); by1=sin(a1); bx2=cos(a2); by2=sin(a2); bx3=cos(a3); by3=sin(a3); bx4=cos(a4); by4=sin(a4); bx5=cos(a5); by5=sin(a5); bx6=cos(a6); by6=sin(a6); bx7=cos(a7); by7=sin(a7); bx8=cos(a8); by8=sin(a8); bx9=cos(a9); by9=sin(a9); bx10=cos(a10); by10=sin(a10); bx11=cos(a11); by11=sin(a11);\nrx0=cos(rad+a0); ry0=sin(rad+a0); rx1=cos(rad+a1); ry1=sin(rad+a1); rx2=cos(rad+a2); ry2=sin(rad+a2); rx3=cos(rad+a3); ry3=sin(rad+a3); rx4=cos(rad+a4); ry4=sin(rad+a4); rx5=cos(rad+a5); ry5=sin(rad+a5); rx6=cos(rad+a6); ry6=sin(rad+a6); rx7=cos(rad+a7); ry7=sin(rad+a7); rx8=cos(rad+a8); ry8=sin(rad+a8); rx9=cos(rad+a9); ry9=sin(rad+a9); rx10=cos(rad+a10); ry10=sin(rad+a10); rx11=cos(rad+a11); ry11=sin(rad+a11);\nm=mod(theta, stepdeg); sym_dist=min(m, stepdeg-m); match=sym_dist < 0.000001 ? 1 : 0; circ=factorial(N-1)",
