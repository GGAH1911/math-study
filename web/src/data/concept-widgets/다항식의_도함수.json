{
 "id": "다항식의_도함수",
 "spec": {
  "title": "다항식의 도함수 – 이차함수의 미분",
  "params": [
   {
    "name": "a",
    "label": "a (x²의 계수)",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (x의 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (상수항)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "x₀ (접점)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0.5,
    "step": 0.1
   }
  ],
  "scope": "fx0=a*x0^2+b*x0+c; dfx0=2*a*x0+b",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "a*x^2+b*x+c",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "2*a*x+b",
     "label": "f'(x)",
     "color": "red"
    },
    {
     "fn": "dfx0*(x-x0)+fx0",
     "label": "접선",
     "color": "green"
    }
   ]
  },
  "readout": [
   {
    "label": "f(x₀)",
    "expr": "fx0",
    "digits": 3
   },
   {
    "label": "f'(x₀)",
    "expr": "dfx0",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": 0,
    "x0": 0.5
   },
   {
    "a": 1,
    "b": -1,
    "c": 3,
    "x0": -1
   },
   {
    "a": -0.5,
    "b": 1.5,
    "c": 0,
    "x0": 2
   },
   {
    "a": 0,
    "b": 1,
    "c": 4,
    "x0": 0
   }
  ],
  "invariants": [
   "((a*(x0+1)^2 + b*(x0+1)+c) - (a*(x0-1)^2 + b*(x0-1)+c))/2 - (2*a*x0 + b)",
   "fx0 - (a*x0^2 + b*x0 + c)",
   "dfx0 - (2*a*x0 + b)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 0,
     "x0": 0.5
    },
    "expect": {
     "fx0": 0.25,
     "dfx0": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": -1,
     "c": 3,
     "x0": -1
    },
    "expect": {
     "fx0": 5,
     "dfx0": -3
    }
   },
   {
    "params": {
     "a": -0.5,
     "b": 1.5,
     "c": 0,
     "x0": 2
    },
    "expect": {
     "fx0": 1,
     "dfx0": -0.5
    }
   }
  ],
  "tol": 0.000001
 }
}