{
 "id": "geometry/high-1/도형의_방정식/거리_조건과_도형",
 "spec": {
  "title": "타원: 두 초점까지의 거리 합이 일정한 자취",
  "params": [
   {
    "name": "a",
    "label": "a (긴반지름)",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (초점거리)",
    "type": "slider",
    "min": 0.5,
    "max": 4,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
