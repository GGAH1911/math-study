    "name": "theta",
    "label": "θ (점 P 위치)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 40,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "b=sqrt(a^2-c^2); rad=theta*pi/180; px=a*cos(rad); py=b*sin(rad); d1=sqrt((px+c)^2+py^2); d2=sqrt((px-c)^2+py^2); dsum=d1+d2",
