{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/사면체와_공간벡터",
 "spec": {
  "title": "사면체와 공간벡터: P = s·a + t·b + u·c",
  "params": [
   {
    "name": "s",
    "label": "s (AB 방향)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.3,
    "step": 0.01
   },
   {
    "name": "t",
    "label": "t (AC 방향)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.3,
    "step": 0.01
   },
   {
    "name": "u",
    "label": "u (AD 방향)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.2,
    "step": 0.01
   }
  ],
  "scope": "Ax=-1; Ay=-0.8; Bx=1.2; By=-1; Cx=0.1; Cy=-0.1; Dx=-0.2; Dy=1.3; w=1-s-t-u; Px=Ax+s*(Bx-Ax)+t*(Cx-Ax)+u*(Dx-Ax); Py=Ay+s*(By-Ay)+t*(Cy-Ay)+u*(Dy-Ay); sum=s+t+u",
  "geometry": {
   "range": [
    -1.7,
    1.7
   ],
   "yRange": [
    -1.4,
    1.7
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=Ax",
      "=Ay"
     ],
     "to": [
      "=Bx",
      "=By"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Ax",
      "=Ay"
     ],
     "to": [
      "=Cx",
      "=Cy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Ax",
      "=Ay"
     ],
     "to": [
      "=Dx",
      "=Dy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Bx",
      "=By"
     ],
     "to": [
      "=Cx",
      "=Cy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Bx",
      "=By"
     ],
     "to": [
      "=Dx",
      "=Dy"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=Cx",
      "=Cy"
     ],
     "to": [
      "=Dx",
      "=Dy"
     ]
    },
    {
     "type": "point",
     "at": [
      "=Ax",
      "=Ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=Bx",
      "=By"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=Cx",
      "=Cy"
     ],
     "label": "C"
    },
    {
     "type": "point",
     "at": [
      "=Dx",
      "=Dy"
     ],
     "label": "D"
    },
    {
     "type": "point",
     "at": [
      "=Px",
      "=Py"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "s+t+u",
    "expr": "sum",
    "digits": 3
   },
   {
    "label": "w = 1-(s+t+u)  (A의 가중치)",
    "expr": "w",
    "digits": 3
   },
   {
    "label": "판정 (1이면 표면, 1미만이면 내부)",
    "expr": "sum",
    "digits": 3
   },
   {
    "label": "P 좌표(투영)",
    "expr": "Px",
    "digits": 3
   }
  ]
 },
 "recipe": {
