 "spec": {
  "title": "초점현 (타원의 초점을 지나는 현)",
  "params": [
   {
    "name": "a",
    "label": "a (긴반지름)",
    "type": "slider",
    "min": 3,
    "max": 6,
    "init": 5,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (짧은반지름)",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "theta",
    "label": "θ (현의 방향)",
    "type": "slider",
    "min": 0,
    "max": 180,
    "init": 60,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; c=sqrt(a^2-b^2); e=c/a; l=b^2/a; r1=l/(1+e*cos(rad)); r2=l/(1-e*cos(rad)); Px=c+r1*cos(rad); Py=r1*sin(rad); Qx=c-r2*cos(rad); Qy=-r2*sin(rad); L=r1+r2",
