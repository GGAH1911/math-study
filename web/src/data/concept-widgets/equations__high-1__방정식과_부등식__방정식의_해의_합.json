{
 "id": "equations/high-1/방정식과_부등식/방정식의_해의_합",
 "spec": {
  "title": "이차방정식의 근의 합",
  "params": [
   {
    "name": "a",
    "label": "a (최고차항)",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "r1",
    "label": "r₁ (첫 번째 근)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "r2",
    "label": "r₂ (두 번째 근)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "A=a; B=-a*(r1+r2); C=a*r1*r2; rootSum=r1+r2; vietaSum=-B/A",
  "geometry": {},
  "plot": {
   "range": [
    -8,
    8
   ],
   "yRange": [
    -20,
    20
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "A*x^2 + B*x + C",
     "label": "f(x) = ax²+bx+c",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "근의 합 (r₁+r₂)",
    "expr": "rootSum",
    "digits": 4
   },
   {
    "label": "-b/a (Vieta)",
    "expr": "vietaSum",
    "digits": 4
   },
   {
    "label": "b",
    "expr": "B",
    "digits": 4
   },
   {
    "label": "c",
    "expr": "C",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "r1": -2,
    "r2": 3
   },
   {
    "a": 2,
    "r1": 0.5,
    "r2": -1.5
   },
   {
    "a": 0.5,
    "r1": -3,
    "r2": -2
   },
   {
    "a": 1.5,
    "r1": 2.5,
    "r2": -0.5
   }
  ],
  "invariants": [
   "B + a*(r1+r2)",
   "C - a*r1*r2",
   "vietaSum - rootSum",
   "A*r1^2 + B*r1 + C",
   "A*r2^2 + B*r2 + C"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "r1": -2,
     "r2": 3
    },
    "expect": {
     "A": 1,
     "B": -1,
     "C": -6,
     "rootSum": 1,
     "vietaSum": 1
    }
   },
   {
    "params": {
     "a": 2,
     "r1": 0.5,
     "r2": -1.5
    },
    "expect": {
     "A": 2,
     "B": 2,
     "C": -1.5,
     "rootSum": -1,
     "vietaSum": -1
    }
   },
   {
    "params": {
     "a": 0.5,
     "r1": -3,
     "r2": -2
    },
    "expect": {
     "A": 0.5,
     "B": 2.5,
     "C": 3,
     "rootSum": -5,
     "vietaSum": -5
    }
   }
  ],
  "tol": 0.000001
 }
}