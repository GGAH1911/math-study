{
 "id": "계수_구하기",
 "spec": {
  "title": "이항정리의 계수 탐구",
  "params": [
   {
    "name": "n",
    "label": "n",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 5,
    "step": 1
   },
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "c = k<=n ? combinations(n,k) : 0; sym = k<=n ? combinations(n,n-k) : 0; pascal = (k>=1 and k<=n-1) ? combinations(n,k) - combinations(n-1,k-1) - combinations(n-1,k) : 0; maxC = combinations(n, floor(n/2));",
  "plot": {
   "range": [
    0,
    "=n+1"
   ],
   "yRange": [
    0,
    "=maxC*1.1"
   ],
   "fns": [
    {
     "fn": "floor(x)<=n ? combinations(n, floor(x)) : 0",
     "label": "C(n,x)",
     "color": "steelblue"
    },
    {
     "fn": "floor(x)==k ? combinations(n, floor(x)) : 0",
     "label": "선택된 항",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "C(n,k)",
    "expr": "c",
    "digits": 0
   },
   {
    "label": "C(n,n-k)",
    "expr": "sym",
    "digits": 0
   },
   {
    "label": "파스칼 검증",
    "expr": "pascal",
    "digits": 10
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 5,
    "k": 2
   },
   {
    "n": 5,
    "k": 3
   },
   {
    "n": 0,
    "k": 0
   },
   {
    "n": 10,
    "k": 4
   }
  ],
  "invariants": [
   "abs(c-sym)",
   "abs(pascal)"
  ],
  "oracle": [
   {
    "params": {
     "n": 5,
     "k": 2
    },
    "expect": {
     "c": 10,
     "sym": 10,
     "pascal": 0
    }
   },
   {
    "params": {
     "n": 5,
     "k": 3
    },
    "expect": {
     "c": 10,
     "sym": 10,
     "pascal": 0
    }
   },
   {
    "params": {
     "n": 0,
     "k": 0
    },
    "expect": {
     "c": 1,
     "sym": 1,
     "pascal": 0
    }
   },
   {
    "params": {
     "n": 10,
     "k": 4
    },
    "expect": {
     "c": 210,
     "sym": 210,
     "pascal": 0
    }
   }
  ],
  "tol": 0.000001
 }
}