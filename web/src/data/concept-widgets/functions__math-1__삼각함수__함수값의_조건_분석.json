{
 "id": "functions/math-1/삼각함수/함수값의_조건_분석",
 "spec": {
  "title": "삼각방정식 a·sin(bθ+p) = k 의 해 (0° ≤ θ < 360°)",
  "params": [
   {
    "name": "a",
    "label": "진폭 a",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "주기 배수 b",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 1,
    "step": 1,
    "unit": ""
   },
   {
    "name": "k",
    "label": "k (=함수값)",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 0.5,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "p",
    "label": "위상 p (°)",
    "type": "slider",
    "min": 0,
    "max": 180,
    "init": 0,
    "step": 15,
    "unit": "°"
   }
  ],
  "scope": "u = k/a; n = abs(u) > 1 ? 0 : (abs(abs(u) - 1) < 1e-6 ? b : 2*b); T = 360/b; th1 = abs(u) <= 1 ? mod((asin(u)*180/pi - p)/b, T) : NaN; th2 = abs(u) <= 1 ? mod((180 - asin(u)*180/pi - p)/b, T) : NaN; c1 = min(max((90 - p)/b, 0), 359.999); c2 = min(max((270 - p)/b, 0), 359.999); c3 = min(max((450 - p)/b, 0), 359.999); c4 = min(max((630 - p)/b, 0), 359.999); c5 = min(max((810 - p)/b, 0), 359.999); c6 = min(max((990 - p)/b, 0), 359.999); c7 = min(max((1170 - p)/b, 0), 359.999)",
  "plot": {
   "range": [
    0,
    360
   ],
   "yRange": [
    -2.6,
    2.6
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*sin((b*x + p)*pi/180)",
     "label": "$y=a\\sin(b\\theta+p)$",
     "color": "#2563eb"
    },
    {
     "fn": "k",
     "label": "$y=k$",
     "color": "#dc2626",
     "dashed": true
    },
    {
     "fn": "a",
     "label": "$y=a$",
     "color": "#64748b",
     "dashed": true
    },
    {
     "fn": "-a",
     "label": "$y=-a$",
     "color": "#64748b",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": [0, "=c1"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c1", "=c2"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c2", "=c3"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c3", "=c4"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c4", "=c5"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c5", "=c6"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c6", "=c7"],
     "label": "해"
    },
    {
     "fn": "a*sin((b*x + p)*pi/180) - k",
     "in": ["=c7", 359.999],
     "label": "해"
    }
   ]
  },
  "readout": [
   {
    "label": "해의 개수",
    "expr": "n",
    "digits": 0
   },
   {
    "label": "θ₁ (°)",
    "expr": "th1",
    "digits": 2
   },
   {
    "label": "θ₂ (°)",
    "expr": "th2",
    "digits": 2
   },
   {
    "label": "sin 값 (k/a)",
    "expr": "u",
    "digits": 3
   },
   {
    "label": "주기 (°)",
    "expr": "T",
    "digits": 0
   },
   {
    "label": "진폭 a",
    "expr": "a",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 1,
    "k": 0.5,
    "p": 0
   },
   {
    "a": 2,
    "b": 1,
    "k": 1,
    "p": 0
   },
   {
    "a": 1,
    "b": 2,
    "k": 0.5,
    "p": 0
   },
   {
    "a": 1,
    "b": 1,
    "k": 0.5,
    "p": 90
   },
   {
    "a": 1.5,
    "b": 3,
    "k": -1.2,
    "p": 30
   }
  ],
  "invariants": [
   "a*sin((b*th1 + p)*pi/180) - k",
   "a*sin((b*th2 + p)*pi/180) - k",
   "n - 2*b"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 1,
     "k": 0.5,
     "p": 0
    },
    "expect": {
     "th1": 30,
     "th2": 150,
     "n": 2
    }
   },
   {
    "params": {
     "a": 2,
     "b": 1,
     "k": 1,
     "p": 0
    },
    "expect": {
     "th1": 30,
     "th2": 150,
     "n": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "k": 0.5,
     "p": 0
    },
    "expect": {
     "th1": 15,
     "th2": 75,
     "n": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "k": 0.5,
     "p": 90
    },
    "expect": {
     "th1": 300,
     "th2": 60,
     "n": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "k": 1,
     "p": 0
    },
    "expect": {
     "th1": 45,
     "th2": 45,
     "n": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "k": 1.5,
     "p": 0
    },
    "expect": {
     "n": 0
    }
   }
  ],
  "tol": 0.000001
 }
}
