    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.6,
    "step": 0.01
   }
  ],
  "scope": "pAB=pA*pBA; pABc=pA*(1-pBA); pAcB=(1-pA)*pBAc; pAcBc=(1-pA)*(1-pBAc); pB=pAB+pAcB; pBc=1-pB;",
