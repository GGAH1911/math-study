 "spec": {
  "title": "조건부확률 시각화",
  "params": [
   {
    "name": "pA",
    "label": "P(A)",
    "type": "slider",
    "min": 0.01,
    "max": 1,
    "init": 0.4,
    "step": 0.01
   },
   {
    "name": "pBA",
    "label": "P(B|A)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.25,
    "step": 0.01
   },
   {
    "name": "pBAc",
