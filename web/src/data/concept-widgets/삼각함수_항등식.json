{
 "id": "삼각함수_항등식",
 "spec": {
  "title": "삼각함수 항등식",
  "params": [
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 45,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; x=cos(rad); y=sin(rad); tan_t=y/x; sec_t=1/x; cot_t=x/y; csc_t=1/y",
  "geometry": {
   "range": [
    -1.4,
    1.4
   ],
   "yRange": [
    -1.4,
    1.4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=x",
      "=y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=x",
      0
     ],
     "to": [
      "=x",
      "=y"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=x",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=y"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "sinθ",
    "expr": "y",
    "digits": 4
   },
   {
    "label": "cosθ",
    "expr": "x",
    "digits": 4
   },
   {
    "label": "tanθ",
    "expr": "tan_t",
    "digits": 4
   },
   {
    "label": "sin²+cos²",
    "expr": "x^2+y^2",
    "digits": 8
   },
   {
    "label": "tan²+1",
    "expr": "tan_t^2+1",
    "digits": 8
   },
   {
    "label": "sec²",
    "expr": "sec_t^2",
    "digits": 8
   },
   {
    "label": "1+cot²",
    "expr": "1+cot_t^2",
    "digits": 8
   },
   {
    "label": "csc²",
    "expr": "csc_t^2",
    "digits": 8
   }
  ]
 },
 "recipe": {
