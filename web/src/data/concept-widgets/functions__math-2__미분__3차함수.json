  "scope": "D=4*b^2-12*a*c; xi=-b/(3*a); yi=a*xi^3+b*xi^2+c*xi+d; slope_i=3*a*xi^2+2*b*xi+c; ddf_i=6*a*xi+2*b",
  "geometry": null,
