     "color": "#2563eb"
    },
    {
     "fn": "3*a*x^2+2*b*x+c",
     "label": "f'(x)=3ax²+2bx+c",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D=4b²−12ac",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "극값 개수 (D>0:2, D≤0:0)",
    "expr": "D>0 ? 2 : 0",
    "digits": 0
   },
   {
    "label": "변곡점 x좌표 (−b/3a)",
    "expr": "xi",
    "digits": 3
   },
   {
    "label": "변곡점 y좌표",
    "expr": "yi",
    "digits": 3
   },
   {
    "label": "변곡점에서의 접선기울기 f'(xi)",
    "expr": "slope_i",
    "digits": 3
   }
  ]
 },
