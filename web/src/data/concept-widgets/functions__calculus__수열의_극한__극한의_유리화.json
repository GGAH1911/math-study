{
 "id": "functions/calculus/수열의_극한/극한의_유리화",
 "spec": {
  "title": "수열의 극한의 유리화: √(n²+pn) − n → p/2",
  "params": [
   {
    "name": "p",
    "label": "일차항 계수 p",
    "type": "slider",
    "min": -3,
    "max": 5,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "L = p/2",
  "plot": {
   "range": [
    3,
    40
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "fns": [
    {
     "fn": "sqrt(x^2 + p*x) - x",
     "label": "aₙ = √(n²+pn) − n",
     "color": "#2563eb"
    },
    {
     "fn": "L",
     "label": "극한값 p/2 (유리화로 계산)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극한값  lim(n→∞) aₙ = p/2",
    "expr": "L",
    "digits": 3
   },
   {
    "label": "a₁₀ (유한항, 직접대입은 ∞−∞ 부정형)",
    "expr": "sqrt(100+10*p)-10",
    "digits": 4
   },
   {
    "label": "유리화 검산  aₙ·(√(n²+pn)+n) − pn  (n=10, 항등식이므로 ≈0)",
    "expr": "(sqrt(100+10*p)-10)*(sqrt(100+10*p)+10) - 10*p",
    "digits": 1
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 2
   },
   {
    "p": -3
   },
   {
    "p": 4
   },
   {
    "p": 1
   }
  ],
  "invariants": [
   "(sqrt(100+10*p)-10)*(sqrt(100+10*p)+10) - 10*p",
   "(sqrt(100+10*p)-10) - 10*p/(sqrt(100+10*p)+10)"
  ],
  "oracle": [
   {
    "params": {
     "p": 2
    },
    "expect": {
     "L": 1
    }
   },
   {
    "params": {
     "p": -3
    },
    "expect": {
     "L": -1.5
    }
   },
   {
    "params": {
     "p": 4
    },
    "expect": {
     "L": 2
    }
   }
  ],
  "tol": 0.000001
 }
}