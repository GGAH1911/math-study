{
 "id": "직선의_매개변수_방정식",
 "spec": {
  "title": "직선의 매개변수 방정식",
  "params": [
   {
    "name": "ax",
    "label": "점 A의 x좌표",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "ay",
    "label": "점 A의 y좌표",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "ux",
    "label": "방향벡터 u의 x성분",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "uy",
    "label": "방향벡터 u의 y성분",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "매개변수 t",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "px=ax+ux*t; py=ay+uy*t",
  "geometry": {
   "range": [
    -8,
    8
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "line",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=ax+ux",
      "=ay+uy"
     ]
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=px",
      "=py"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "P의 x좌표",
    "expr": "px",
    "digits": 3
   },
   {
    "label": "P의 y좌표",
    "expr": "py",
    "digits": 3
   },
   {
    "label": "AP와 u의 외적(0이어야)",
    "expr": "(px-ax)*uy-(py-ay)*ux",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "ax": 1,
    "ay": 1,
    "ux": 2,
    "uy": 1,
    "t": 1
   },
   {
    "ax": -2,
    "ay": 3,
    "ux": -1,
    "uy": 2,
    "t": -1
   },
   {
    "ax": 0,
    "ay": 0,
    "ux": 1,
    "uy": 1,
    "t": 2
   }
  ],
  "invariants": [
   "(px-ax)*uy-(py-ay)*ux"
  ],
  "oracle": [
   {
    "params": {
     "ax": 1,
     "ay": 1,
     "ux": 2,
     "uy": 1,
     "t": 1
    },
    "expect": {
     "px": 3,
     "py": 2
    }
   },
   {
    "params": {
     "ax": 0,
     "ay": 0,
     "ux": 1,
     "uy": 1,
     "t": 2
    },
    "expect": {
     "px": 2,
     "py": 2
    }
   },
   {
    "params": {
     "ax": -2,
     "ay": 3,
     "ux": -1,
     "uy": 2,
     "t": -1
    },
    "expect": {
     "px": -1,
     "py": 1
    }
   }
  ],
  "tol": 0.000001
 }
}