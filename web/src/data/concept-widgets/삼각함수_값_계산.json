{
 "id": "삼각함수_값_계산",
 "spec": {
  "title": "삼각함수 값 계산",
  "params": [
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 30,
    "step": 1
   }
  ],
  "scope": "rad=theta*pi/180; cx=cos(rad); sy=sin(rad); tan_val=tan(rad)",
  "geometry": {
   "range": [
    -1.3,
    1.3
   ],
   "yRange": [
    -1.3,
    1.3
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "cos θ",
    "expr": "cx",
    "digits": 4
   },
   {
    "label": "tan θ",
    "expr": "tan_val",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "theta": 30
   },
   {
    "theta": 135
   },
   {
    "theta": 240
   },
   {
    "theta": 330
   }
  ],
  "invariants": [
   "cx^2+sy^2-1",
   "tan_val - sy/cx"
  ],
  "oracle": [
   {
    "params": {
     "theta": 30
    },
    "expect": {
     "cx": 0.8660254038,
     "sy": 0.5,
     "tan_val": 0.5773502692
    }
   },
   {
    "params": {
     "theta": 60
    },
    "expect": {
     "cx": 0.5,
     "sy": 0.8660254038,
     "tan_val": 1.7320508076
    }
   },
   {
    "params": {
     "theta": 180
    },
    "expect": {
     "cx": -1,
     "sy": 0,
     "tan_val": 0
    }
   }
  ],
  "tol": 0.000001
 }
}