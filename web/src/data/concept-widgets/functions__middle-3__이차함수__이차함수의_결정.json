{
 "id": "functions/middle-3/이차함수/이차함수의_결정",
 "spec": {
  "title": "이차함수의 결정 — 세 점이 하나의 포물선을 정한다",
  "params": [
   {
    "name": "y1",
    "label": "점 A의 y좌표 (x=-2)",
    "type": "slider",
    "min": -8,
    "max": 12,
    "init": 4,
    "step": 0.5
   },
   {
    "name": "y2",
    "label": "점 B의 y좌표 (x=0)",
    "type": "slider",
    "min": -8,
    "max": 12,
    "init": 0,
    "step": 0.5
   },
   {
    "name": "y3",
    "label": "점 C의 y좌표 (x=2)",
    "type": "slider",
    "min": -8,
    "max": 12,
    "init": 4,
    "step": 0.5
   }
  ],
  "scope": "a=(y1+y3-2*y2)/8; b=(y3-y1)/4; c=y2",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -6,
    13
   ],
   "fns": [
    {
     "fn": "a*x^2+b*x+c",
     "label": "f(x)=ax²+bx+c (세 점을 지나는 유일한 포물선)",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "b",
    "expr": "b",
    "digits": 3
   },
   {
    "label": "c",
    "expr": "c",
    "digits": 3
   },
   {
    "label": "f(-2) (=점A y)",
    "expr": "a*4+b*(-2)+c",
    "digits": 3
   },
   {
    "label": "f(0) (=점B y)",
    "expr": "c",
    "digits": 3
   },
   {
    "label": "f(2) (=점C y)",
    "expr": "a*4+b*2+c",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "y1": 4,
    "y2": 0,
    "y3": 4
   },
   {
    "y1": 1,
    "y2": 2,
    "y3": 9
   },
   {
    "y1": 0,
    "y2": 3,
    "y3": 0
   },
   {
    "y1": -2,
    "y2": 1,
    "y3": 5
   }
  ],
  "invariants": [
   "a*4+b*(-2)+c-y1",
   "c-y2",
   "a*4+b*2+c-y3"
  ],
  "oracle": [
   {
    "params": {
     "y1": 4,
     "y2": 0,
     "y3": 4
    },
    "expect": {
     "a": 1,
     "b": 0,
     "c": 0
    }
   },
   {
    "params": {
     "y1": 1,
     "y2": 2,
     "y3": 9
    },
    "expect": {
     "a": 0.75,
     "b": 2,
     "c": 2
    }
   },
   {
    "params": {
     "y1": 0,
     "y2": 3,
     "y3": 0
    },
    "expect": {
     "a": -0.75,
     "b": 0,
     "c": 3
    }
   }
  ],
  "tol": 0.000001
 }
}