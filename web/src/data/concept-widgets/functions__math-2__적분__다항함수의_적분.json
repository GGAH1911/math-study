{
 "id": "functions/math-2/적분/다항함수의_적분",
 "spec": {
  "title": "다항함수의 적분 — 넓이의 누적과 적분상수",
  "params": [
   {
    "name": "a",
    "label": "a (x² 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (x 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (상수항)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "t",
    "label": "t (적분 상한)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "C",
    "label": "C (적분상수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "ft = a*t^2 + b*t + c; Ft = a/3*t^3 + b/2*t^2 + c*t; F0 = 0; area = Ft - F0; FtC = Ft + C",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "a/3*x^3 + b/2*x^2 + c*x + C",
     "label": "F(x)=∫f dx",
     "color": "#dc2626"
    }
   ],
   "points": [
    [
     "=t",
     "=ft"
    ],
    [
     "=t",
     "=FtC"
    ]
   ],
   "pointsLabel": "$(t,f(t)),\\,(t,F(t){+}C)$"
  },
  "readout": [
   {
    "label": "f(t)",
    "expr": "ft",
    "digits": 3
   },
   {
    "label": "∫₀ᵗ f dx = F(t)",
    "expr": "area",
    "digits": 3
   },
   {
    "label": "F(t)+C",
    "expr": "FtC",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": 1,
    "t": 2,
    "C": 0
   },
   {
    "a": 2,
    "b": -2,
    "c": 1,
    "t": 1,
    "C": 0
   },
   {
    "a": 0,
    "b": 1,
    "c": 0,
    "t": 1.5,
    "C": 2
   },
   {
    "a": -1,
    "b": 1,
    "c": 0.5,
    "t": 1,
    "C": -1
   }
  ],
  "invariants": [
   "(a/3*(t+0.0001)^3 + b/2*(t+0.0001)^2 + c*(t+0.0001) - (a/3*(t-0.0001)^3 + b/2*(t-0.0001)^2 + c*(t-0.0001)))/0.0002 - ft",
   "(t/6)*((a*0^2+b*0+c) + 4*(a*(t/2)^2+b*(t/2)+c) + (a*t^2+b*t+c)) - area",
   "(FtC - C) - area"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 1,
     "t": 2,
     "C": 0
    },
    "expect": {
     "ft": 5,
     "Ft": 4.666666666666667,
     "area": 4.666666666666667
    }
   },
   {
    "params": {
     "a": 2,
     "b": -2,
     "c": 1,
     "t": 1,
     "C": 0
    },
    "expect": {
     "ft": 1,
     "Ft": 0.6666666666666667,
     "area": 0.6666666666666667
    }
   },
   {
    "params": {
     "a": 0,
     "b": 1,
     "c": 0,
     "t": 1.5,
     "C": 2
    },
    "expect": {
     "ft": 1.5,
     "Ft": 1.125,
     "area": 1.125,
     "FtC": 3.125
    }
   }
  ],
  "tol": 0.000001
 }
}