 "spec": {
  "title": "부등식 ax + b ≤ k 의 자연수해 개수",
  "params": [
   {
    "name": "a",
    "label": "a (기울기, >0)",
    "type": "slider",
    "min": 0.5,
    "max": 4,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b (상수항)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -1,
    "step": 1,
    "unit": ""
   },
   {
    "name": "k",
    "label": "k",
    "type": "slider",
    "min": -3,
    "max": 12,
    "init": 3,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "m",
    "label": "m (목표 개수)",
    "type": "slider",
    "min": 0,
    "max": 8,
    "init": 4,
    "step": 1,
    "unit": ""
   }
  ],
  "scope": "A = a == 0 ? 1 : a; B = (k - b)/A; count = max(0, min(floor(B), 12)); kLo = A*m + b; kHi = A*(m+1) + b; hit = (count == m) ? 1 : 0",
