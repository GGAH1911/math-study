{
 "id": "항의_비",
 "spec": {
  "title": "항의 비",
  "params": [
   {
    "name": "a1",
    "label": "첫째항 a₁",
    "type": "slider",
    "min": 0.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "r",
    "label": "비율 r",
    "type": "slider",
    "min": 0.5,
    "max": 1.5,
    "init": 1.2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "상수항 c",
    "type": "slider",
    "min": -0.5,
    "max": 0.5,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "A=a1-c; t1=a1; t2=A*r+c; t3=A*r^2+c; t4=A*r^3+c; t5=A*r^4+c; t6=A*r^5+c; ratio1=t2/t1; ratio2=t3/t2; ratio3=t4/t3; ratio4=t5/t4; ratio5=t6/t5;",
