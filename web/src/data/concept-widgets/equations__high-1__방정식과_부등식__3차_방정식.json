{
 "id": "equations/high-1/방정식과_부등식/3차_방정식",
 "spec": {
  "title": "3차 방정식의 그래프와 극값",
  "params": [
   {
    "name": "p",
    "label": "p",
    "type": "slider",
    "min": -3,
    "max": 0,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "q",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "x1 = -sqrt(-p/3); x2 = sqrt(-p/3); y1 = x1^3 + p*x1 + q; y2 = x2^3 + p*x2 + q; D = -4*p^3 - 27*q^2",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -20,
    20
   ],
   "fns": [
    {
     "fn": "x^3 + p*x + q",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값",
    "expr": "y1",
    "digits": 3
   },
   {
    "label": "극솟값",
    "expr": "y2",
    "digits": 3
   },
   {
    "label": "판별식",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "실근의 개수",
    "expr": "p < 0 ? (y1*y2 < 0 ? 3 : (abs(y1) < 1e-9 or abs(y2) < 1e-9 ? 2 : 1)) : 1",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": -3,
    "q": 2
   },
   {
    "p": -3,
    "q": 0
   },
   {
    "p": -1,
    "q": 1
   },
   {
    "p": 0,
    "q": -2
   }
  ],
  "invariants": [
   "3*x1^2 + p",
   "3*x2^2 + p",
   "y1 + y2 - 2*q"
  ],
  "oracle": [
   {
    "params": {
     "p": -3,
     "q": 2
    },
    "expect": {
     "x1": -1,
     "x2": 1,
     "y1": 4,
     "y2": 0
    }
   },
   {
    "params": {
     "p": -3,
     "q": 0
    },
    "expect": {
     "x1": -1,
     "x2": 1,
     "y1": 2,
     "y2": -2
    }
   },
   {
    "params": {
     "p": 0,
     "q": 1
    },
    "expect": {
     "x1": 0,
     "x2": 0,
     "y1": 1,
     "y2": 1
    }
   }
  ],
  "tol": 0.000001
 }
}