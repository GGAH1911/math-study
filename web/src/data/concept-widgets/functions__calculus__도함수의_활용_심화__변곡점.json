{
 "id": "functions/calculus/도함수의_활용_심화/변곡점",
 "spec": {
  "title": "변곡점: f(x)=x³+bx²+cx",
  "params": [
   {
    "name": "b",
    "label": "b (x² 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1.5,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (x 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -2,
    "step": 0.1
   }
  ],
  "scope": "xi=-b/3; yi=xi^3+b*xi^2+c*xi; fpp=6*xi+2*b; concav_left=6*(xi-0.5)+2*b; concav_right=6*(xi+0.5)+2*b",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -12,
    12
   ],
   "fns": [
    {
     "fn": "x^3+b*x^2+c*x",
     "label": "f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "6*x+2*b",
     "label": "f''(x)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "변곡점 x좌표 (=-b/3)",
    "expr": "xi",
    "digits": 4
   },
   {
    "label": "변곡점 y좌표 = f(xi)",
    "expr": "yi",
    "digits": 4
   },
   {
    "label": "f''(변곡점) (=0이어야)",
    "expr": "fpp",
    "digits": 6
   },
   {
    "label": "왼쪽 f''부호(아래볼록 ∪이면 +)",
    "expr": "concav_left",
    "digits": 3
   },
   {
    "label": "오른쪽 f''부호(위볼록 ∩이면 −)",
    "expr": "concav_right",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 1.5,
    "c": -2
   },
   {
    "b": 3,
    "c": 0
   },
   {
    "b": -2,
    "c": 1
   },
   {
    "b": 0,
    "c": -3
   }
  ],
  "invariants": [
   "fpp",
   "6*xi+2*b",
   "xi+b/3",
   "yi-(xi^3+b*xi^2+c*xi)",
   "concav_left*concav_right+9"
  ],
  "oracle": [
   {
    "params": {
     "b": 3,
     "c": 0
    },
    "expect": {
     "xi": -1,
     "yi": 2,
     "fpp": 0
    }
   },
   {
    "params": {
     "b": -1.5,
     "c": 2
    },
    "expect": {
     "xi": 0.5,
     "yi": 0.75,
     "fpp": 0
    }
   },
   {
    "params": {
     "b": 0,
     "c": -3
    },
    "expect": {
     "xi": 0,
     "yi": 0,
     "fpp": 0
    }
   }
  ],
  "tol": 0.000001
 }
}