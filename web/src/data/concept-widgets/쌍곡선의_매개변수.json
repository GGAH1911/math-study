{
 "id": "쌍곡선의_매개변수",
 "spec": {
  "title": "쌍곡선의 매개변수",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "theta",
    "label": "θ",
    "type": "slider",
    "min": -75,
    "max": 75,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "rad=theta*pi/180; px=a/cos(rad); py=b*tan(rad)",
  "plot": {
   "range": [
    "=-4*a",
    "=4*a"
   ],
   "yRange": [
    "=-4*b",
    "=4*b"
   ],
   "fns": [
    {
     "fn": "b/a*sqrt(x^2 - a^2)",
     "label": "y = (b/a)√(x²-a²)",
     "color": "blue"
    },
    {
     "fn": "-b/a*sqrt(x^2 - a^2)",
     "label": "y = -(b/a)√(x²-a²)",
     "color": "blue"
    }
   ],
   "points": [
    [
     "=px",
     "=py"
    ]
   ],
   "pointsLabel": "$(a\\sec\\theta,\\ b\\tan\\theta)$"
  },
  "readout": [
   {
    "label": "x (px)",
    "expr": "px",
    "digits": 3
   },
   {
    "label": "y (py)",
    "expr": "py",
    "digits": 3
   },
   {
    "label": "x²/a² - y²/b²",
    "expr": "px^2/a^2 - py^2/b^2",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1,
    "theta": 0
   },
   {
    "a": 2,
    "b": 1,
    "theta": 60
   },
   {
    "a": 3,
    "b": 2,
    "theta": 45
   },
   {
    "a": 1,
    "b": 0.5,
    "theta": -30
   }
  ],
  "invariants": [
   "px^2/a^2 - py^2/b^2 - 1"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1,
     "theta": 0
    },
    "expect": {
     "px": 2,
     "py": 0
    }
   },
   {
    "params": {
     "a": 2,
     "b": 1,
     "theta": 60
    },
    "expect": {
     "px": 4,
     "py": 1.7320508075688772
    }
   },
   {
    "params": {
     "a": 3,
     "b": 2,
     "theta": 36.86989764584402
    },
    "expect": {
     "px": 3.75,
     "py": 1.5
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0.5,
     "theta": -45
    },
    "expect": {
     "px": 1.4142135623730951,
     "py": -0.5
    }
   }
  ],
  "tol": 0.000001
 }
}