   "xmax*xmin - c/(3*A)",
   "abs(fppmax) - abs(fppmin)",
   "abs(fppmax) + fppmax",
   "abs(fppmin) - fppmin",
   "abs(fmax - fmin) - (fmax - fmin)"
  ],
  "oracle": [
   {
    "params": {
