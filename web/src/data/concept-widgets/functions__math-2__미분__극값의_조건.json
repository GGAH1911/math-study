{
 "id": "functions/math-2/미분/극값의_조건",
 "spec": {
  "title": "극값의 조건: f(x)=ax³+bx²+cx+d (f'=0은 필요조건, 부호 변화로 판정)",
  "params": [
   {
    "name": "a",
    "label": "a (최고차항)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d (상수항)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 0,
    "step": 0.5
   }
  ],
  "scope": "sgn = a < 0 ? -1 : 1; A = abs(a) < 0.05 ? 0.05*sgn : a; D = 4*b^2 - 12*A*c; xi = -b/(3*A); fi = A*xi^3 + b*xi^2 + c*xi + d; h = D > 0 ? sqrt(D)/(6*abs(A)) : NaN; xL = xi - h; xR = xi + h; xmax = A > 0 ? xL : xR; xmin = A > 0 ? xR : xL; fmax = A*xmax^3 + b*xmax^2 + c*xmax + d; fmin = A*xmin^3 + b*xmin^2 + c*xmin + d; fppmax = 6*A*xmax + 2*b; fppmin = 6*A*xmin + 2*b; nExtrema = D > 0 ? 2 : 0; xmaxP = D > 0 ? xmax : xi; fmaxP = D > 0 ? fmax : fi; xminP = D > 0 ? xmin : xi; fminP = D > 0 ? fmin : fi",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -15,
    15
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "A*x^3 + b*x^2 + c*x + d",
     "label": "$f(x)=ax^3+bx^2+cx+d$",
     "color": "#2563eb"
    },
    {
     "fn": "3*A*x^2 + 2*b*x + c",
     "label": "$f'(x)=3ax^2+2bx+c$",
     "color": "#dc2626",
     "dashed": true
    },
    {
     "fn": "6*A*x + 2*b",
     "label": "$f''(x)=6ax+2b$",
     "color": "#a1a1aa",
     "dashed": true
    }
   ],
   "roots": [
    {
     "fn": "3*A*x^2 + 2*b*x + c",
     "in": ["=xi-40", "=xi"],
     "label": "$f'(x)=0$"
    },
    {
     "fn": "3*A*x^2 + 2*b*x + c",
     "in": ["=xi", "=xi+40"],
     "label": "$f'(x)=0$"
    }
   ],
   "points": [
    ["=xmaxP", "=fmaxP"],
    ["=xminP", "=fminP"],
    ["=xi", "=fi"]
   ],
   "pointsLabel": "극대점 · 극소점 · 변곡점(두 극점의 중점)"
  },
  "readout": [
   {
    "label": "판별식 D = 4b²-12ac (D>0이면 극값 2개)",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "극값의 개수",
    "expr": "nExtrema",
    "digits": 0
   },
   {
    "label": "극대점 x",
    "expr": "xmax",
    "digits": 3
   },
   {
    "label": "극댓값 f(극대점)",
    "expr": "fmax",
    "digits": 3
   },
   {
    "label": "f''(극대점) (<0 → 극대)",
    "expr": "fppmax",
    "digits": 3
   },
   {
    "label": "극소점 x",
    "expr": "xmin",
    "digits": 3
   },
   {
    "label": "극솟값 f(극소점)",
    "expr": "fmin",
    "digits": 3
   },
   {
    "label": "f''(극소점) (>0 → 극소)",
    "expr": "fppmin",
    "digits": 3
   },
   {
    "label": "변곡점 x = -b/3a (극대·극소의 중점)",
    "expr": "xi",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": -3,
    "d": 0
   },
   {
    "a": 1,
    "b": -3,
    "c": 0,
    "d": 2
   },
   {
    "a": -1,
