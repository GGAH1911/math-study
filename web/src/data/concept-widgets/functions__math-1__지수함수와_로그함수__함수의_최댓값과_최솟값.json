{
 "id": "functions/math-1/지수함수와_로그함수/함수의_최댓값과_최솟값",
 "spec": {
  "title": "지수함수의 최댓값과 최솟값 — 폐구간 [p, q] (a>1)",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 1.5,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "왼쪽 끝 p",
    "type": "slider",
    "min": -2,
    "max": 0.5,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "w",
    "label": "구간 폭 q−p",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "q = p + w; fp = a^p; fq = a^q; maxVal = max(fp, fq); minVal = min(fp, fq)",
  "plot": {
   "range": [
    "=p",
    "=q"
   ],
   "yRange": [
    0,
    "=maxVal*1.15"
   ],
   "fns": [
    {
     "fn": "a^x",
     "label": "f(x)=a^x (정의역 [p,q])",
     "color": "#2563eb"
    },
    {
     "fn": "maxVal",
     "label": "최댓값 M=a^q (x=q)",
     "color": "#dc2626"
    },
    {
     "fn": "minVal",
     "label": "최솟값 m=a^p (x=p)",
     "color": "#16a34a"
    }
   ]
  },
  "readout": [
   {
    "label": "오른쪽 끝 q",
    "expr": "q",
    "digits": 2
   },
   {
    "label": "최댓값 M (x=q에서)",
    "expr": "maxVal",
    "digits": 3
   },
   {
    "label": "최솟값 m (x=p에서)",
    "expr": "minVal",
    "digits": 3
   },
   {
    "label": "검산 m·a^(q−p)",
    "expr": "minVal*a^w",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "p": -1,
    "w": 2
   },
   {
    "a": 3,
    "p": 0,
    "w": 1
   },
   {
    "a": 2,
    "p": 0,
    "w": 3
   },
   {
    "a": 1.5,
    "p": -2,
    "w": 2
   }
  ],
  "invariants": [
   "maxVal - a^q",
   "minVal - a^p",
   "maxVal - minVal*a^w",
   "maxVal*minVal - a^(2*p + w)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "p": -1,
     "w": 2
    },
    "expect": {
     "q": 1,
     "minVal": 0.5,
     "maxVal": 2
    }
   },
   {
    "params": {
     "a": 3,
     "p": 0,
     "w": 1
    },
    "expect": {
     "q": 1,
     "minVal": 1,
     "maxVal": 3
    }
   },
   {
    "params": {
     "a": 2,
     "p": 0,
     "w": 3
    },
    "expect": {
     "q": 3,
     "minVal": 1,
     "maxVal": 8
    }
   }
  ],
  "tol": 0.000001
 }
}