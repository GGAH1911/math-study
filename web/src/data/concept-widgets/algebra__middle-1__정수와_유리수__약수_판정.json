{
 "id": "algebra/middle-1/정수와_유리수/약수_판정",
 "spec": {
  "title": "약수 판정",
  "params": [
   {
    "name": "a",
    "label": "a (약수)",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 3,
    "step": 1
   },
   {
    "name": "b",
    "label": "b (피제수)",
    "type": "slider",
    "min": -20,
    "max": 20,
    "init": 15,
    "step": 1
   }
  ],
  "scope": "r = mod(b, a); q = (b - r) / a; divisible = r == 0 ? 1 : 0",
  "geometry": {
   "range": [
    -22,
    22
   ],
   "yRange": [
    -1,
    1
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=b",
      0
     ],
     "label": "b"
    },
    {
     "type": "point",
     "at": [
      "=a*q",
      0
     ],
     "label": "a×q"
    },
    {
     "type": "segment",
     "from": [
      "=a*q",
      0
     ],
     "to": [
      "=b",
      0
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "나머지 r",
    "expr": "r",
    "digits": 0
   },
   {
    "label": "몫 q",
    "expr": "q",
    "digits": 0
   },
   {
    "label": "약수? (1=예)",
    "expr": "divisible",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 3,
    "b": 15
   },
   {
    "a": 4,
    "b": 15
   },
   {
    "a": 7,
    "b": -20
   },
   {
    "a": 5,
    "b": -10
   }
  ],
  "invariants": [
   "b - a*q - r",
   "q - round(q)",
   "divisible - (r == 0 ? 1 : 0)"
  ],
  "oracle": [
   {
    "params": {
     "a": 3,
     "b": 15
    },
    "expect": {
     "r": 0,
     "q": 5,
     "divisible": 1
    }
   },
   {
    "params": {
     "a": 4,
     "b": 15
    },
    "expect": {
     "r": 3,
     "q": 3,
     "divisible": 0
    }
   },
   {
    "params": {
     "a": 7,
     "b": -20
    },
    "expect": {
     "r": 1,
     "q": -3,
     "divisible": 0
    }
   },
   {
    "params": {
     "a": 5,
     "b": -10
    },
    "expect": {
     "r": 0,
     "q": -2,
     "divisible": 1
    }
   }
  ],
  "tol": 0.000001
 }
}