{
 "id": "geometry/middle-1/입체도형/다면체",
 "spec": {
  "title": "다면체의 오일러 공식: 어떤 다면체든 V − E + F = 2",
  "params": [
   {
    "name": "s",
    "label": "입체의 종류 0=각뿔 1=각기둥 2=각뿔대 3=쌍뿔",
    "type": "slider",
    "min": 0,
    "max": 3,
    "init": 1,
    "step": 1
   },
   {
    "name": "n",
    "label": "밑면 다각형의 변의 수 n",
    "type": "slider",
    "min": 3,
    "max": 12,
    "init": 5,
    "step": 1,
    "unit": "각"
   }
  ],
  "scope": "k=round(s); V = k==0 ? n+1 : (k==3 ? n+2 : 2*n); E = k==0 ? 2*n : 3*n; F = k==0 ? n+1 : (k==3 ? 2*n : n+2); av = k==0 ? 1 : (k==3 ? 1 : 2); bv = k==0 ? 1 : (k==3 ? 2 : 0); ae = k==0 ? 2 : 3; af = k==0 ? 1 : (k==3 ? 2 : 1); bf = k==0 ? 1 : (k==3 ? 0 : 2); euler=V-E+F",
  "plot": {
   "range": [
    3,
    12
   ],
   "yRange": [
    0,
    40
   ],
   "fns": [
    {
     "fn": "av*x+bv",
     "label": "꼭짓점 $V$",
     "color": "#2563eb"
    },
    {
     "fn": "ae*x",
     "label": "모서리 $E$",
     "color": "#dc2626"
    },
    {
     "fn": "af*x+bf",
     "label": "면 $F$",
     "color": "#16a34a"
    },
    {
     "fn": "2",
     "label": "$V-E+F=2$ (종류·n 무관하게 항상)",
     "color": "#7c3aed"
    }
   ],
   "points": [
    [
     "=n",
     "=V"
    ],
    [
     "=n",
     "=E"
    ],
    [
     "=n",
     "=F"
    ]
   ],
   "pointsLabel": "$n=\\{n\\}$"
  },
  "readout": [
   {
    "label": "꼭짓점 V",
    "expr": "V",
    "digits": 0
   },
   {
    "label": "모서리 E",
    "expr": "E",
    "digits": 0
   },
   {
    "label": "면 F",
    "expr": "F",
    "digits": 0
   },
   {
    "label": "V − E + F",
    "expr": "euler",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "s": 0,
    "n": 3
   },
   {
    "s": 0,
    "n": 6
   },
   {
    "s": 1,
    "n": 3
   },
   {
    "s": 1,
    "n": 12
   },
   {
    "s": 2,
    "n": 5
   },
   {
    "s": 3,
    "n": 4
   },
   {
    "s": 3,
    "n": 12
   }
  ],
  "invariants": [
   "euler-2",
   "V-E+F-2",
   "F-(E-V+2)"
  ],
  "oracle": [
   {
    "params": {
     "n": 3,
     "s": 0
    },
    "expect": {
     "V": 4,
     "E": 6,
     "F": 4,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 4,
     "s": 0
    },
    "expect": {
     "V": 5,
     "E": 8,
     "F": 5,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 3,
     "s": 1
    },
    "expect": {
     "V": 6,
     "E": 9,
     "F": 5,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 6,
     "s": 1
    },
    "expect": {
     "V": 12,
     "E": 18,
     "F": 8,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 5,
     "s": 2
    },
    "expect": {
     "V": 10,
     "E": 15,
     "F": 7,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 4,
     "s": 3
    },
    "expect": {
     "V": 6,
     "E": 12,
     "F": 8,
     "euler": 2
    }
   },
   {
    "params": {
     "n": 3,
     "s": 3
    },
    "expect": {
     "V": 5,
     "E": 9,
     "F": 6,
     "euler": 2
    }
   }
  ],
  "tol": 0.000001
 }
}