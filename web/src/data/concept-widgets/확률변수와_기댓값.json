{
 "id": "확률변수와_기댓값",
 "spec": {
  "title": "확률변수와 기댓값",
  "params": [
   {
    "name": "p",
    "label": "p (성공 확률)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "p0 = (1-p)^3; p1 = 3*p*((1-p)^2); p2 = 3*(p^2)*(1-p); p3 = p^3; E = 0*p0 + 1*p1 + 2*p2 + 3*p3",
  "geometry": {
   "range": [
    -0.5,
    3.5
   ],
   "yRange": [
    -0.1,
    1.1
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      0,
      "=p0"
     ]
    },
    {
     "type": "segment",
     "from": [
      1,
      0
     ],
     "to": [
      1,
      "=p1"
     ]
    },
    {
     "type": "segment",
     "from": [
      2,
      0
     ],
     "to": [
      2,
      "=p2"
     ]
    },
    {
     "type": "segment",
     "from": [
      3,
      0
     ],
     "to": [
      3,
      "=p3"
     ]
    },
    {
     "type": "point",
     "at": [
      0,
      "=p0"
     ]
    },
    {
     "type": "point",
     "at": [
      1,
      "=p1"
     ]
    },
    {
     "type": "point",
     "at": [
      2,
      "=p2"
     ]
    },
    {
     "type": "point",
     "at": [
      3,
      "=p3"
     ]
    },
    {
     "type": "point",
     "at": [
      "=E",
      0
     ],
     "label": "E(X)"
    }
   ]
  },
  "readout": [
   {
    "label": "기댓값",
    "expr": "E",
    "digits": 4
   },
   {
    "label": "확률 합",
    "expr": "p0+p1+p2+p3",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 0.25
   },
   {
    "p": 0.5
   },
   {
    "p": 0.75
   },
   {
    "p": 0.33
   }
  ],
  "invariants": [
   "p0+p1+p2+p3-1",
   "E-3p"
  ],
  "oracle": [
   {
    "params": {
     "p": 0.25
    },
    "expect": {
     "p0": 0.421875,
     "p1": 0.421875,
     "p2": 0.140625,
     "p3": 0.015625,
     "E": 0.75
    }
   },
   {
    "params": {
     "p": 0.5
    },
    "expect": {
     "p0": 0.125,
     "p1": 0.375,
     "p2": 0.375,
     "p3": 0.125,
     "E": 1.5
    }
   },
   {
    "params": {
     "p": 0.75
    },
    "expect": {
     "p0": 0.015625,
     "p1": 0.140625,
     "p2": 0.421875,
     "p3": 0.421875,
     "E": 2.25
    }
   }
  ],
  "tol": 0.000001
 }
}