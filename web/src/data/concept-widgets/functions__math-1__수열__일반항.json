{
 "id": "functions/math-1/수열/일반항",
 "spec": {
  "title": "수열의 일반항: aₙ = p·n + q",
  "params": [
   {
    "name": "p",
    "label": "p (공차/기울기)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "q",
    "label": "q (절편 = a₀)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": -1,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "k",
    "label": "k (강조할 항 번호)",
    "type": "slider",
    "min": 1,
    "max": 8,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "a1=p*1+q; a2=p*2+q; a3=p*3+q; a4=p*4+q; a5=p*5+q; a6=p*6+q; a7=p*7+q; a8=p*8+q; ak=p*k+q",
  "plot": {
   "range": [
    0,
    9
   ],
   "yRange": [
    -12,
    22
   ],
   "fns": [
    {
     "fn": "p*x+q",
     "label": "aₙ = p·n + q",
     "color": "#3b82f6"
    }
   ],
   "points": [
    [
     "=k",
     "=ak"
    ]
   ],
   "pointsLabel": "$a_k$"
  },
  "readout": [
   {
    "label": "a_k (k번째 항)",
    "expr": "ak",
    "digits": 2
   },
   {
    "label": "a_1 (첫째항)",
    "expr": "a1",
    "digits": 2
   },
   {
    "label": "공차 d (= p)",
    "expr": "p",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 2,
    "q": -1,
    "k": 3
   },
   {
    "p": 1,
    "q": 0,
    "k": 5
   },
   {
    "p": -2,
    "q": 10,
    "k": 4
   },
   {
    "p": 0.5,
    "q": -5,
    "k": 8
   }
  ],
  "invariants": [
   "a2 - a1 - p",
   "a3 - a2 - p",
   "a3 - 2*a2 + a1",
   "ak - (p*k + q)",
   "a5 - (5*p + q)"
  ],
  "oracle": [
   {
    "params": {
     "p": 2,
     "q": -1,
     "k": 3
    },
    "expect": {
     "a1": 1,
     "a3": 5,
     "ak": 5
    }
   },
   {
    "params": {
     "p": 1,
     "q": 0,
     "k": 5
    },
    "expect": {
     "a1": 1,
     "a5": 5,
     "ak": 5
    }
   },
   {
    "params": {
     "p": -2,
     "q": 10,
     "k": 4
    },
    "expect": {
     "a1": 8,
     "a4": 2,
     "ak": 2
    }
   }
  ],
  "tol": 0.000001
 }
}