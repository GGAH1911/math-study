{
 "id": "functions/math-1/수열/등차수열_합",
 "spec": {
  "title": "등차수열의 합 — 사다리꼴 넓이로 보기",
  "params": [
   {
    "name": "a",
    "label": "첫째항 a",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 2,
    "step": 1
   },
   {
    "name": "d",
    "label": "공차 d",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 3,
    "step": 1
   },
   {
    "name": "n",
    "label": "항의 개수 n",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 6,
    "step": 1
   }
  ],
  "scope": "a1 = a; an = a + (n - 1) * d; Sn = n / 2 * (2 * a + (n - 1) * d); Sn2 = n / 2 * (a1 + an); avg = (a1 + an) / 2",
  "geometry": {
   "range": [
    -1,
    11
   ],
   "yRange": [
    -1,
    45
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "label": "Sₙ = 사다리꼴 넓이",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=n",
       0
      ],
      [
       "=n",
       "=an"
      ],
      [
       0,
       "=a1"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      "=avg"
     ],
     "to": [
      "=n",
      "=avg"
     ],
     "label": "평균 (a₁+aₙ)/2"
    },
    {
     "type": "point",
     "at": [
      0,
      "=a1"
     ],
     "label": "a₁"
    },
    {
     "type": "point",
     "at": [
      "=n",
      "=an"
     ],
     "label": "aₙ"
    }
   ]
  },
  "readout": [
   {
    "label": "마지막 항 aₙ",
    "expr": "an",
    "digits": 1
   },
   {
    "label": "Sₙ = n/2·(2a+(n-1)d)",
    "expr": "Sn",
    "digits": 1
   },
   {
    "label": "Sₙ = n/2·(a₁+aₙ)",
    "expr": "Sn2",
    "digits": 1
   },
   {
    "label": "평균 (a₁+aₙ)/2",
    "expr": "avg",
    "digits": 2
   },
   {
    "label": "평균 × n",
    "expr": "avg*n",
    "digits": 1
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "d": 3,
    "n": 6
   },
   {
    "a": 1,
    "d": 2,
    "n": 10
   },
   {
    "a": 5,
    "d": 0,
    "n": 4
   },
   {
    "a": 4,
    "d": 1,
    "n": 8
   }
  ],
  "invariants": [
   "Sn - Sn2",
   "avg * n - Sn",
   "Sn - (d / 2 * n^2 + (a - d / 2) * n)",
   "an - (a + (n - 1) * d)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "d": 3,
     "n": 6
    },
    "expect": {
     "Sn": 57,
     "an": 17,
     "avg": 9.5
    }
   },
   {
    "params": {
     "a": 1,
     "d": 2,
     "n": 10
    },
    "expect": {
     "Sn": 100,
     "an": 19,
     "avg": 10
    }
   },
   {
    "params": {
     "a": 5,
     "d": 0,
     "n": 4
    },
    "expect": {
     "Sn": 20,
     "an": 5,
     "avg": 5
    }
   }
  ],
  "tol": 1e-06
 }
}
