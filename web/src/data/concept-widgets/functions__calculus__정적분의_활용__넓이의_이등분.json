{
 "id": "functions/calculus/정적분의_활용/넓이의_이등분",
 "spec": {
  "title": "넓이의 이등분 — y = x² 아래 넓이를 x = a로 자르기",
  "params": [
   {
    "name": "a",
    "label": "이등분선 x = a",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 0.01,
    "unit": ""
   }
  ],
  "scope": "S = 8/3; areaL = a^3/3; areaR = (8 - a^3)/3; diff = areaL - areaR; half = S/2",
  "plot": {
   "range": [
    0,
    2
   ],
   "yRange": [
    0,
    4
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y = x²",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "전체 넓이 S = ∫₀² x²dx",
    "expr": "S",
    "digits": 4
   },
   {
    "label": "왼쪽 넓이 ∫₀ᵃ x²dx",
    "expr": "areaL",
    "digits": 4
   },
   {
    "label": "오른쪽 넓이 ∫ₐ² x²dx",
    "expr": "areaR",
    "digits": 4
   },
   {
    "label": "절반 목표 S/2",
    "expr": "half",
    "digits": 4
   },
   {
    "label": "왼−오 (0이면 이등분, a=∛4)",
    "expr": "diff",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5
   },
   {
    "a": 1
   },
   {
    "a": 1.587401051968
   },
   {
    "a": 1.8
   }
  ],
  "invariants": [
   "areaL + areaR - S",
   "(areaL + areaR)/2 - half"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "S": 2.6666666667,
     "areaL": 0.3333333333,
     "areaR": 2.3333333333,
     "half": 1.3333333333,
     "diff": -2
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "S": 2.6666666667,
     "areaL": 2.6666666667,
     "areaR": 0,
     "diff": 2.6666666667
    }
   },
   {
    "params": {
     "a": 1.587401051968
    },
    "expect": {
     "areaL": 1.3333333333,
     "areaR": 1.3333333333,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
}