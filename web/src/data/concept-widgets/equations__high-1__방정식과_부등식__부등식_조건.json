{
 "id": "equations/high-1/방정식과_부등식/부등식_조건",
 "spec": {
  "title": "부등식 조건: x≥0, y≥0, x+y≤s",
  "params": [
   {
    "name": "s",
    "label": "경계값 s",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 5,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "u",
    "label": "점의 x좌표",
    "type": "slider",
    "min": -1,
    "max": 11,
    "init": 2,
    "step": 0.5,
    "unit": ""
   },
   {
    "name": "v",
    "label": "점의 y좌표",
    "type": "slider",
    "min": -1,
    "max": 11,
    "init": 3,
    "step": 0.5,
    "unit": ""
   }
  ],
  "scope": "cond1 = u>=0 ? 1 : 0; cond2 = v>=0 ? 1 : 0; cond3 = (u+v<=s) ? 1 : 0; inside = (cond1+cond2+cond3==3) ? 1 : 0; violation = max(0,-u)*inside + max(0,-v)*inside + max(0,u+v-s)*inside",
  "geometry": {
   "range": [
    -1,
    11
   ],
   "yRange": [
    -1,
    11
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=s",
       0
      ],
      [
       0,
       "=s"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      "=u",
      "=v"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "x≥0",
    "expr": "cond1",
    "digits": 0
   },
   {
    "label": "y≥0",
    "expr": "cond2",
    "digits": 0
   },
   {
    "label": "x+y≤s",
    "expr": "cond3",
    "digits": 0
   },
   {
    "label": "모든 조건 만족",
    "expr": "inside",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "s": 5,
    "u": 2,
    "v": 2
   },
   {
    "s": 5,
    "u": 2,
    "v": 1
   },
   {
    "s": 3,
    "u": 4,
    "v": -1
   },
   {
    "s": 1,
    "u": 0,
    "v": 0
   }
  ],
  "invariants": [
   "max(0,-u)*inside + max(0,-v)*inside + max(0,u+v-s)*inside"
  ],
  "oracle": [
   {
    "params": {
     "s": 5,
     "u": 2,
     "v": 1
    },
    "expect": {
     "cond1": 1,
     "cond2": 1,
     "cond3": 1,
     "inside": 1,
     "violation": 0
    }
   },
   {
    "params": {
     "s": 5,
     "u": 5,
     "v": 1
    },
    "expect": {
     "cond1": 1,
     "cond2": 1,
     "cond3": 0,
     "inside": 0,
     "violation": 0
    }
   },
   {
    "params": {
     "s": 3,
     "u": 4,
     "v": -1
    },
    "expect": {
     "cond1": 1,
     "cond2": 0,
     "cond3": 1,
     "inside": 0,
     "violation": 0
    }
   }
  ],
  "tol": 1e-06
 }
}
