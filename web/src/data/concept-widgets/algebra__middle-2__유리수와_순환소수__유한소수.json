{
 "id": "algebra/middle-2/유리수와_순환소수/유한소수",
 "spec": {
  "title": "유한소수의 조건",
  "params": [
   {
    "name": "m",
    "label": "2의 지수 (m)",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 1,
    "step": 1
   },
   {
    "name": "n",
    "label": "5의 지수 (n)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 0,
    "step": 1
   },
   {
    "name": "pp",
    "label": "추가 소인수 (0:없음, 1:3, 2:7)",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "p = pp == 0 ? 1 : (pp == 1 ? 3 : 7); b = (2^m) * (5^n) * p; val = 1 / b; finite = p == 1 ? 1 : 0",
  "geometry": {
   "range": [
    0,
    1
   ],
   "yRange": [
    -0.1,
    0.1
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      1,
      0
     ]
    },
    {
     "type": "segment",
     "from": [
      "=val",
      -0.1
     ],
     "to": [
      "=val",
      0.1
     ]
    },
    {
     "type": "point",
     "at": [
      "=val",
      0
     ],
     "label": "1/b"
    }
   ]
  },
  "readout": [
   {
    "label": "분모 b",
    "expr": "b"
   },
   {
    "label": "1/b의 소수 값",
    "expr": "val",
    "digits": 10
   },
   {
    "label": "유한소수이면 1",
    "expr": "finite"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "m": 1,
    "n": 0,
    "pp": 0
   },
   {
    "m": 2,
    "n": 1,
    "pp": 0
   },
   {
    "m": 0,
    "n": 0,
    "pp": 1
   },
   {
    "m": 1,
    "n": 1,
    "pp": 2
   }
  ],
  "invariants": [
   "val * b - 1",
   "b - (2^m) * (5^n) * p",
   "finite - (p == 1 ? 1 : 0)"
  ],
  "oracle": [
   {
    "params": {
     "m": 1,
     "n": 0,
     "pp": 0
    },
    "expect": {
     "val": 0.5,
     "finite": 1,
     "b": 2
    }
   },
   {
    "params": {
     "m": 2,
     "n": 1,
     "pp": 0
    },
    "expect": {
     "val": 0.05,
     "finite": 1,
     "b": 20
    }
   },
   {
    "params": {
     "m": 0,
     "n": 0,
     "pp": 1
    },
    "expect": {
     "val": 0.3333333333333333,
     "finite": 0,
     "b": 3
    }
   }
  ],
  "tol": 0.000001
 }
}