{
 "id": "probability-stats/prob-stats-elective/확률/독립시행",
 "spec": {
  "title": "독립시행과 이항분포",
  "params": [
   {
    "name": "n",
    "label": "시행 횟수 n",
    "type": "slider",
    "min": 1,
    "max": 20,
    "init": 10,
    "step": 1
   },
   {
    "name": "p",
    "label": "성공 확률 p",
    "type": "slider",
    "min": 0.05,
    "max": 0.95,
    "init": 0.5,
    "step": 0.05
   },
   {
    "name": "k",
    "label": "성공 횟수 k",
    "type": "slider",
    "min": 0,
    "max": 20,
    "init": 5,
    "step": 1
   }
  ],
  "scope": "pmf(t) = t <= n ? combinations(n,t)*p^t*(1-p)^(n-t) : 0; yoff(t) = t <= n ? pmf(t) : -1000; pk = pmf(k); mean = n*p; sd = sqrt(n*p*(1-p))",
  "geometry": {
   "range": [
    -0.5,
    20.5
   ],
   "yRange": [
    0,
    1.1
   ],
   "showAxes": true,
   "showGrid": true,
