{
 "id": "geometry/geometry-elective/평면벡터/벡터의_성분",
 "spec": {
  "title": "벡터의 성분 — 정사영으로 분해",
  "params": [
   {
    "name": "a",
    "label": "x성분 a",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "y성분 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "r=sqrt(a^2+b^2); ang=atan2(b,a); px=r*cos(ang); py=r*sin(ang)",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a",
      "=b"
     ],
     "label": "OA",
     "color": "#1565c0"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=a",
      0
     ],
     "label": "a",
     "color": "#c62828"
    },
    {
     "type": "segment",
     "from": [
      "=a",
      0
     ],
     "to": [
      "=a",
      "=b"
     ],
     "label": "b",
     "color": "#2e7d32"
    },
    {
     "type": "point",
     "at": [
      "=a",
      "=b"
     ],
     "label": "A(a,b)"
    }
   ]
  },
  "readout": [
   {
    "label": "크기 |OA|",
    "expr": "r",
    "digits": 4
   },
   {
    "label": "x성분 (=r·cosθ)",
    "expr": "px",
    "digits": 4
   },
   {
    "label": "y성분 (=r·sinθ)",
    "expr": "py",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 3,
    "b": 4
   },
   {
    "a": 1,
    "b": 1
   },
   {
    "a": -4,
    "b": 3
   },
   {
    "a": 5,
    "b": 0
   }
  ],
  "invariants": [
   "r^2-a^2-b^2",
   "px-a",
   "py-b"
  ],
  "oracle": [
   {
    "params": {
     "a": 3,
     "b": 4
    },
    "expect": {
     "r": 5,
     "px": 3,
     "py": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1
    },
    "expect": {
     "r": 1.4142135623730951,
     "px": 1,
     "py": 1
    }
   },
   {
    "params": {
     "a": -4,
     "b": 3
    },
    "expect": {
     "r": 5,
     "px": -4,
     "py": 3
    }
   }
  ],
  "tol": 0.000001
 }
}