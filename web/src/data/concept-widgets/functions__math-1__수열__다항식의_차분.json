{
 "id": "functions/math-1/수열/다항식의_차분",
 "spec": {
  "title": "다항식의 차분 Δf(x) = f(x+1) − f(x)",
  "params": [
   {
    "name": "a",
    "label": "a (x³ 계수)",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 0.4,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b (x² 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c (x 계수)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0.5,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d (상수항)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "f0 = d; f1 = a + b + c + d; f2 = 8*a + 4*b + 2*c + d; f3 = 27*a + 9*b + 3*c + d; d1a = f1 - f0; d1b = f2 - f1; d1c = f3 - f2; d2a = d1b - d1a; d2b = d1c - d1b; d3a = d2b - d2a",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -10,
    15
   ],
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "f(x) (3차)",
     "color": "#2563eb"
    },
    {
     "fn": "(a*(x+1)^3 + b*(x+1)^2 + c*(x+1) + d) - (a*x^3 + b*x^2 + c*x + d)",
     "label": "Δf(x) (2차)",
     "color": "#16a34a"
    },
    {
     "fn": "(a*(x+2)^3 + b*(x+2)^2 + c*(x+2) + d) - 2*(a*(x+1)^3 + b*(x+1)^2 + c*(x+1) + d) + (a*x^3 + b*x^2 + c*x + d)",
     "label": "Δ²f(x) (1차)",
     "color": "#ea580c"
    },
    {
     "fn": "(a*(x+3)^3 + b*(x+3)^2 + c*(x+3) + d) - 3*(a*(x+2)^3 + b*(x+2)^2 + c*(x+2) + d) + 3*(a*(x+1)^3 + b*(x+1)^2 + c*(x+1) + d) - (a*x^3 + b*x^2 + c*x + d)",
     "label": "Δ³f(x) = 상수",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "Δ³f (모든 x에서 상수)",
    "expr": "d3a",
    "digits": 3
   },
   {
    "label": "3!·a = 6a (이론값)",
    "expr": "6*a",
    "digits": 3
   },
   {
    "label": "Δ²f(0)",
    "expr": "d2a",
    "digits": 3
   },
   {
    "label": "Δf(0)",
    "expr": "d1a",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0,
    "c": 0,
    "d": 0
   },
   {
    "a": 0.5,
    "b": 1,
    "c": 0,
    "d": 0
   },
   {
    "a": 0,
    "b": 1,
    "c": 2,
    "d": -1
   },
   {
    "a": -0.5,
    "b": 0.5,
    "c": 1,
    "d": 2
   }
  ],
  "invariants": [
   "d3a - 6*a",
   "d3a - (f3 - 3*f2 + 3*f1 - f0)",
   "d2a - (6*a + 2*b)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": 0,
     "d": 0
    },
    "expect": {
     "f3": 27,
     "d2a": 6,
     "d3a": 6
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 1,
     "c": 0,
     "d": 0
    },
    "expect": {
     "f2": 8,
     "d2a": 5,
     "d3a": 3
    }
   },
   {
    "params": {
     "a": 0,
     "b": 1,
     "c": 2,
     "d": -1
    },
    "expect": {
     "f3": 14,
     "d2a": 2,
     "d3a": 0
    }
   }
  ],
  "tol": 0.000001
 }
}