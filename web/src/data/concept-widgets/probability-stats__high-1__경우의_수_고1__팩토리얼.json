    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "rr = r > n ? n : r; fact = factorial(n); restf = factorial(n - rr); perm = fact / restf; ratio = factorial(n+1) / fact;",
