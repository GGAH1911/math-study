 "spec": {
  "title": "팩토리얼 (n!)",
  "params": [
   {
    "name": "n",
    "label": "n (물건 수)",
    "type": "slider",
    "min": 0,
    "max": 10,
    "init": 5,
    "step": 1
   },
   {
    "name": "r",
