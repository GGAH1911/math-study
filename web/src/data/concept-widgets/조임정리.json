{
 "id": "조임정리",
 "spec": {
  "title": "조임정리 (Squeeze Theorem)",
  "params": [
   {
    "name": "L",
    "label": "극한값 L",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 1
   },
   {
    "name": "p",
    "label": "수렴 속도 p",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 1,
    "step": 1
   },
   {
    "name": "n",
    "label": "관찰 지점 n",
    "type": "slider",
    "min": 1,
    "max": 10,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "a1 = L - 1/1^p; b1 = L + 0.5*cos(pi*1)/1^p; c1 = L + 1/1^p; a2 = L - 1/2^p; b2 = L + 0.5*cos(pi*2)/2^p; c2 = L + 1/2^p; a3 = L - 1/3^p; b3 = L + 0.5*cos(pi*3)/3^p; c3 = L + 1/3^p; a4 = L - 1/4^p; b4 = L + 0.5*cos(pi*4)/4^p; c4 = L + 1/4^p; a5 = L - 1/5^p; b5 = L + 0.5*cos(pi*5)/5^p; c5 = L + 1/5^p; an = L - 1/n^p; bn = L + 0.5*cos(pi*n)/n^p; cn = L + 1/n^p",
  "plot": {
   "range": [
    1,
    10
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "fns": [
    {
     "fn": "L - 1/x^p",
     "label": "a_n",
     "color": "red"
    },
    {
     "fn": "L + 0.5*cos(pi*x)/x^p",
     "label": "b_n",
     "color": "green"
    },
    {
     "fn": "L + 1/x^p",
     "label": "c_n",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "a_n",
    "expr": "an",
    "digits": 4
   },
   {
    "label": "b_n",
    "expr": "bn",
    "digits": 4
   },
   {
    "label": "c_n",
    "expr": "cn",
    "digits": 4
   },
   {
    "label": "간격 (c_n-a_n)",
    "expr": "cn-an",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "L": 1,
    "p": 1,
    "n": 2
   },
   {
    "L": 0,
    "p": 2,
    "n": 3
   },
   {
    "L": -2,
    "p": 3,
    "n": 5
   },
   {
    "L": 2,
    "p": 1,
    "n": 4
   }
  ],
  "invariants": [
   "max(0, an-bn) + max(0, bn-cn)",
   "c1-a1-2 + c2-a2-2/2^p + c3-a3-2/3^p + c4-a4-2/4^p + c5-a5-2/5^p",
   "max(0, a1-b1) + max(0, b1-c1) + max(0, a2-b2) + max(0, b2-c2) + max(0, a3-b3) + max(0, b3-c3) + max(0, a4-b4) + max(0, b4-c4) + max(0, a5-b5) + max(0, b5-c5)"
  ],
  "oracle": [
   {
    "params": {
     "L": 1,
     "p": 1,
     "n": 2
    },
    "expect": {
     "an": 0.5,
     "bn": 1.25,
     "cn": 1.5
    }
   },
   {
    "params": {
     "L": 2,
     "p": 1,
     "n": 4
    },
    "expect": {
     "an": 1.75,
     "bn": 2.125,
     "cn": 2.25
    }
   },
   {
    "params": {
     "L": -1,
     "p": 2,
     "n": 2
    },
    "expect": {
     "an": -1.25,
     "bn": -0.875,
     "cn": -0.75
    }
   }
  ],
  "tol": 0.000001
 }
}