{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/접기와_공간도형",
 "spec": {
  "title": "접기 = 반사대칭: 접기선은 PP′의 수직이등분선",
  "params": [
   {
    "name": "phi",
    "label": "접기선 각 φ",
    "type": "slider",
    "min": 0,
    "max": 180,
    "init": 30,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "px",
    "label": "점 P의 x",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "py",
    "label": "점 P의 y",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "rad=phi*pi/180; c2=cos(2*rad); s2=sin(2*rad); ppx=c2*px+s2*py; ppy=s2*px-c2*py; mx=(px+ppx)/2; my=(py+ppy)/2",
  "geometry": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=-3.5*cos(rad)",
      "=-3.5*sin(rad)"
     ],
     "to": [
      "=3.5*cos(rad)",
      "=3.5*sin(rad)"
     ],
     "label": "ℓ (접기선)"
    },
    {
     "type": "segment",
     "from": [
      "=px",
      "=py"
     ],
     "to": [
      "=ppx",
      "=ppy"
     ],
     "label": "PP′"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    },
    {
     "type": "point",
     "at": [
      "=ppx",
      "=ppy"
     ],
     "label": "P′"
    },
    {
     "type": "point",
     "at": [
      "=mx",
      "=my"
     ],
     "label": "M(중점)"
    }
   ]
  },
  "readout": [
   {
    "label": "P′ x",
    "expr": "ppx",
    "digits": 3
   },
   {
    "label": "P′ y",
    "expr": "ppy",
    "digits": 3
   },
   {
    "label": "|PP′|",
    "expr": "sqrt((ppx-px)^2+(ppy-py)^2)",
    "digits": 3
   },
   {
    "label": "중점 M이 ℓ 위(≈0)",
    "expr": "mx*sin(rad)-my*cos(rad)",
    "digits": 4
   },
   {
    "label": "PP′⊥ℓ 확인(≈0)",
    "expr": "(ppx-px)*cos(rad)+(ppy-py)*sin(rad)",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "phi": 0,
    "px": 1,
    "py": 2
   },
   {
    "phi": 90,
    "px": 1,
    "py": 2
   },
   {
    "phi": 45,
    "px": 1,
    "py": 0
   },
   {
    "phi": 30,
    "px": 2,
    "py": 1
   }
  ],
  "invariants": [
   "mx*sin(rad)-my*cos(rad)",
   "(ppx-px)*cos(rad)+(ppy-py)*sin(rad)",
   "(px^2+py^2)-(ppx^2+ppy^2)"
  ],
  "oracle": [
   {
    "params": {
     "phi": 0,
     "px": 1,
     "py": 2
    },
    "expect": {
     "ppx": 1,
     "ppy": -2
    }
   },
   {
    "params": {
     "phi": 90,
     "px": 1,
     "py": 2
    },
    "expect": {
     "ppx": -1,
     "ppy": 2
    }
   },
   {
    "params": {
     "phi": 45,
     "px": 1,
     "py": 0
    },
    "expect": {
     "ppx": 0,
     "ppy": 1
    }
   }
  ],
  "tol": 0.000001
 }
}