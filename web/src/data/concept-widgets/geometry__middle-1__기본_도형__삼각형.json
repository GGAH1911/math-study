{
 "id": "geometry/middle-1/기본_도형/삼각형",
 "spec": {
  "title": "삼각형과 세 내각의 합 (△ABC)",
  "params": [
   {
    "name": "alpha",
    "label": "∠A",
    "type": "slider",
    "min": 10,
    "max": 140,
    "init": 60,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "beta",
    "label": "∠B",
    "type": "slider",
    "min": 10,
    "max": 140,
    "init": 60,
    "step": 1,
    "unit": "°"
   },
   {
    "name": "c",
    "label": "변 AB",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "ar=alpha*pi/180; br=beta*pi/180; ta=tan(ar); tb=tan(br); cx=c*tb/(ta+tb); cy=c*ta*tb/(ta+tb); gamma=180-alpha-beta; magAC=sqrt(cx^2+cy^2); angA=acos(cx/magAC); cbx=c-cx; dotC=(-cx)*cbx+cy^2; magBC=sqrt(cbx^2+cy^2); angC=acos(dotC/(magAC*magBC))",
  "geometry": {
   "range": [
    -1,
    4
   ],
   "yRange": [
    -1,
    3.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "label": "△ABC",
     "vertices": [
      [
       0,
       0
      ],
      [
       "=c",
       0
      ],
      [
       "=cx",
       "=cy"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=c",
      0
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=cy"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "∠C",
    "expr": "gamma",
    "digits": 0
   },
   {
    "label": "∠A+∠B+∠C",
    "expr": "alpha+beta+gamma",
    "digits": 0
   },
   {
    "label": "변 AC",
    "expr": "magAC",
    "digits": 3
   },
   {
    "label": "변 BC",
    "expr": "magBC",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "alpha": 60,
    "beta": 60,
    "c": 1
   },
   {
    "alpha": 45,
    "beta": 45,
    "c": 2
   },
   {
    "alpha": 60,
    "beta": 30,
    "c": 1
   },
   {
    "alpha": 50,
    "beta": 70,
    "c": 1.5
   }
  ],
  "invariants": [
   "alpha+beta+gamma-180",
   "angA-ar",
   "angC-gamma*pi/180"
  ],
  "oracle": [
   {
    "params": {
     "alpha": 60,
     "beta": 60,
     "c": 1
    },
    "expect": {
     "cx": 0.5,
     "cy": 0.8660254037844386,
     "gamma": 60
    }
   },
   {
    "params": {
     "alpha": 45,
     "beta": 45,
     "c": 2
    },
    "expect": {
     "cx": 1,
     "cy": 1,
     "gamma": 90
    }
   },
   {
    "params": {
     "alpha": 60,
     "beta": 30,
     "c": 1
    },
    "expect": {
     "cx": 0.25,
     "cy": 0.4330127018922193,
     "gamma": 90
    }
   }
  ],
  "tol": 1e-06
 }
}
