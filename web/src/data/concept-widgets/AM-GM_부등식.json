     "b": 2
    },
    "expect": {
     "am": 1.25,
     "gm": 1,
     "diff": 0.25
    }
   },
   {
    "params": {
     "a": 2,
     "b": 2
    },
    "expect": {
     "am": 2,
     "gm": 2,
     "diff": 0
    }
   }
  ],
  "tol": 0.000001
 }
