{
 "id": "방정식의_실근_조건",
 "spec": {
  "title": "삼차방정식의 실근 조건 탐구",
  "params": [
   {
    "name": "a",
    "label": "계수 a",
    "type": "slider",
    "min": 0,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "상수 b",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "sq=sqrt(a); x1=-sq; x2=sq; y1=b+2*(sq^3); y2=b-2*(sq^3); D=108*(a^3)-27*(b^2); numRoots=D>0?3:(D==0?2:1)",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -12,
    12
   ],
   "fns": [
    {
     "fn": "x^3 - 3*a*x + b",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "극대값 f(x₁)",
    "expr": "y1",
    "digits": 3
   },
   {
    "label": "극소값 f(x₂)",
    "expr": "y2",
    "digits": 3
   },
   {
    "label": "판별식 D",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "실근의 개수",
    "expr": "numRoots",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 3
   },
   {
    "a": 0.5,
    "b": 0
   },
   {
    "a": 1,
    "b": -2
   },
   {
    "a": 1.2,
    "b": 1.5
   }
  ],
  "invariants": [
   "3*x1^2 - 3*a",
   "3*x2^2 - 3*a",
   "D + 27*y1*y2",
   "y1 + y2 - 2*b",
   "y1 - y2 - 4*sq^3"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0
    },
    "expect": {
     "y1": 2,
     "y2": -2,
     "D": 108,
     "numRoots": 3
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "y1": 4,
     "y2": 0,
     "D": 0,
     "numRoots": 2
    }
   },
   {
    "params": {
     "a": 0.25,
     "b": 0
    },
    "expect": {
     "y1": 0.25,
     "y2": -0.25,
     "D": 1.6875,
     "numRoots": 3
    }
   }
  ],
  "tol": 0.000001
 }
}