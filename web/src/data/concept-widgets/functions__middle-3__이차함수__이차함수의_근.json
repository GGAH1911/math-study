{
 "id": "functions/middle-3/이차함수/이차함수의_근",
 "spec": {
  "title": "이차함수의 근 — 판별식과 x축 교점",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -3,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "D = b^2 - 4*a*c; r1 = (-b - sqrt(D))/(2*a); r2 = (-b + sqrt(D))/(2*a)",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -8,
    8
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "y = ax²+bx+c",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D = b²-4ac",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "근1 (D≥0일 때)",
    "expr": "r1",
    "digits": 4
   },
   {
    "label": "근2 (D≥0일 때)",
    "expr": "r2",
    "digits": 4
   },
   {
    "label": "근의 합 (=-b/a)",
    "expr": "r1+r2",
    "digits": 4
   },
   {
    "label": "근의 곱 (=c/a)",
    "expr": "r1*r2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": -3,
    "c": 2
   },
   {
    "a": 1,
    "b": 0,
    "c": -4
   },
   {
    "a": 1,
    "b": -2,
    "c": -3
   },
   {
    "a": 2,
    "b": -4,
    "c": -6
   }
  ],
  "invariants": [
   "a*r1^2 + b*r1 + c",
   "a*r2^2 + b*r2 + c",
   "r1 + r2 + b/a",
   "r1*r2 - c/a"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": -3,
     "c": 2
    },
    "expect": {
     "D": 1,
     "r1": 1,
     "r2": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "c": -4
    },
    "expect": {
     "D": 16,
     "r1": -2,
     "r2": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": -2,
     "c": -3
    },
    "expect": {
     "D": 16,
     "r1": -1,
     "r2": 3
    }
   }
  ],
  "tol": 0.000001
 }
}