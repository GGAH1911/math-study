{
 "id": "functions/calculus/정적분의_활용/넓이의_비",
 "spec": {
  "title": "넓이의 비 — 곡선 $y=x^n$ 이 직사각형을 언제나 $1:n$ 으로 가른다",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0.5,
    "max": 2.5,
    "init": 1.5,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "n",
    "label": "n",
    "type": "slider",
    "min": 1,
    "max": 3,
    "init": 2,
    "step": 0.5,
    "unit": ""
   }
  ],
  "scope": "n1 = n + 1; an = a^n; ap = a^(n+1); S1 = ap/n1; rect = ap; S2 = rect - S1; ratio = S1/S2; slope = a^(n-1); S3 = ap*(1/2 - 1/n1); ratio3 = S3/S1",
  "geometry": null,
  "plot": {
   "range": [
    0,
    2.7
   ],
   "yRange": [
    0,
    16
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "x^n",
     "label": "$y=x^n$",
     "color": "#2563eb"
    },
    {
     "fn": "an",
     "label": "$y=a^n$ (직사각형 윗변)",
     "color": "#9ca3af",
     "dashed": true
    },
    {
     "fn": "slope*x",
     "label": "$y=a^{n-1}x$ (원점과 끝점을 잇는 직선)",
     "color": "#f59e0b",
     "dashed": true,
     "range": [
      0,
      "=a"
     ]
    }
   ],
   "intersections": [
    {
     "f": "x^n",
     "g": "an",
     "in": [
      0,
      2.7
     ],
     "label": "$(a,\\ a^n)$"
    }
   ]
  },
  "readout": [
   {
    "label": "S₁ = 곡선 아래 넓이 $\\int_0^a x^n dx$",
    "expr": "S1",
    "digits": 4
   },
   {
    "label": "S₂ = 곡선 위 넓이 (직사각형 − S₁)",
    "expr": "S2",
    "digits": 4
   },
   {
    "label": "직사각형 넓이 $a\\cdot a^n$",
    "expr": "rect",
    "digits": 4
   },
   {
    "label": "S₁:S₂ 비 — 언제나 $1:n$",
    "expr": "ratio",
    "digits": 4
   },
   {
    "label": "S₃ = 곡선과 직선 사이 넓이",
    "expr": "S3",
    "digits": 4
   },
   {
    "label": "S₃:S₁ 비 $=(n-1)/2$",
    "expr": "ratio3",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "n": 2
   },
   {
    "a": 1.5,
    "n": 1
   },
   {
    "a": 2,
    "n": 3
   },
   {
    "a": 2.5,
    "n": 2.5
   },
   {
    "a": 0.5,
    "n": 1.5
   }
  ],
  "invariants": [
   "ratio - 1/n",
   "S1 + S2 - rect",
   "S2 - n*S1",
   "S1 - a^(n+1)/(n+1)",
   "S3 - a^(n+1)*(1/2 - 1/(n+1))",
   "ratio3 - (n-1)/2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "n": 2
    },
    "expect": {
     "S1": 0.3333333333,
     "S2": 0.6666666667,
     "rect": 1,
     "ratio": 0.5,
     "S3": 0.1666666667,
     "ratio3": 0.5
    }
   },
   {
    "params": {
     "a": 2,
     "n": 2
    },
    "expect": {
     "S1": 2.6666666667,
     "S2": 5.3333333333,
     "rect": 8,
     "ratio": 0.5,
     "S3": 1.3333333333,
     "ratio3": 0.5
    }
   },
   {
    "params": {
     "a": 2,
     "n": 3
    },
    "expect": {
     "S1": 4,
     "S2": 12,
     "rect": 16,
     "ratio": 0.3333333333,
     "S3": 4,
     "ratio3": 1
    }
   },
   {
    "params": {
     "a": 1.5,
     "n": 1
    },
    "expect": {
     "S1": 1.125,
     "S2": 1.125,
     "rect": 2.25,
     "ratio": 1,
     "S3": 0,
     "ratio3": 0
    }
   }
  ],
  "tol": 0.000001
 }
}