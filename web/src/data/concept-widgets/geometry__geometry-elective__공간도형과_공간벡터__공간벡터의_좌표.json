    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "c30=sqrt(3)/2; mag=sqrt(a^2+b^2+c^2); p1x=-c30*a; p1y=-a/2; p2x=-c30*a+b; p2y=-a/2; px=-c30*a+b; py=-a/2+c",
  "geometry": {
