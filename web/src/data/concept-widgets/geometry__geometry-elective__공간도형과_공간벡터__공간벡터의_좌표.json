    -6,
    6
   ],
   "yRange": [
    -5,
    5
   ],
   "showAxes": false,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=-c30*3",
      "=-3/2"
     ],
     "label": "x",
     "color": "#bbbbbb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      3,
      0
     ],
     "label": "y",
     "color": "#bbbbbb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      0,
      3
     ],
     "label": "z",
     "color": "#bbbbbb"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=p1x",
      "=p1y"
     ],
     "label": "a·i",
     "color": "#e07a5f"
    },
    {
     "type": "segment",
     "from": [
      "=p1x",
      "=p1y"
     ],
     "to": [
      "=p2x",
      "=p2y"
     ],
     "label": "b·j",
     "color": "#81b29a"
    },
    {
     "type": "segment",
     "from": [
      "=p2x",
      "=p2y"
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "c·k",
     "color": "#3d5a80"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "v",
     "color": "#d62828"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "v=(a,b,c)"
    }
   ]
  },
  "readout": [
   {
    "label": "a",
    "expr": "a",
    "digits": 2
   },
   {
    "label": "b",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "c",
    "expr": "c",
    "digits": 2
   },
   {
    "label": "|v|",
    "expr": "mag",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "c": 2
   },
