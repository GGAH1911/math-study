{
 "id": "geometry/geometry-elective/공간도형과_공간벡터/공간벡터의_좌표",
 "spec": {
  "title": "공간벡터의 좌표 v=(a,b,c)",
  "params": [
   {
    "name": "a",
    "label": "a (i방향, x)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b (j방향, y)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c",
    "label": "c (k방향, z)",
