{
 "id": "functions/math-2/적분/급수와_적분의_관계",
 "spec": {
  "title": "급수(리만 합)와 정적분의 관계: ∫₀¹ x² dx",
  "params": [
   {
    "name": "n",
    "label": "분할 수 n",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 4,
    "step": 1,
    "unit": "개"
   },
   {
    "name": "t",
    "label": "표본점 위치 t (0=왼끝, 0.5=중점, 1=오른끝)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 1,
    "step": 0.5
   }
  ],
  "scope": "dx = 1/n; xstar = ((0:(n-1)) + t)/n; S = sum(xstar.^2)*dx; exact = 1/3; err = abs(S - exact)",
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1.05
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y = x²",
     "color": "#2563eb"
    },
    {
     "fn": "((floor(min(x,0.999999)*n)+t)/n)^2",
     "label": "직사각형 높이 f(xᵢ*) (n분할, 표본점 t)",
     "color": "#f97316"
    }
   ],
   "points": [
    [
     "=t/n",
     "=(t/n)^2"
    ],
    [
     "=((n-1)+t)/n",
     "=(((n-1)+t)/n)^2"
    ]
   ],
   "pointsLabel": "$x_i^*$ (첫·끝 표본점)"
  },
  "readout": [
   {
    "label": "Δx = (b−a)/n",
    "expr": "dx",
    "digits": 4
   },
   {
    "label": "리만 합 S_n = Σ f(xᵢ*)Δx",
    "expr": "S",
    "digits": 6
   },
   {
    "label": "정적분 값 ∫₀¹ x² dx",
    "expr": "exact",
    "digits": 6
   },
   {
    "label": "오차 |S_n − I|",
    "expr": "err",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "t": 1
   },
   {
    "n": 2,
    "t": 0
   },
   {
    "n": 4,
    "t": 1
   },
   {
    "n": 2,
    "t": 0.5
   }
  ],
  "invariants": [
   "dx*n - 1",
   "S - ((n-1)*n*(2*n-1)/6 + t*n*(n-1) + n*t^2)/n^3"
  ],
  "oracle": [
   {
    "params": {
     "n": 1,
     "t": 1
    },
    "expect": {
     "S": 1,
     "dx": 1
    }
   },
   {
    "params": {
     "n": 2,
     "t": 0
    },
    "expect": {
     "S": 0.125
    }
   },
   {
    "params": {
     "n": 4,
     "t": 1
    },
    "expect": {
     "S": 0.46875
    }
   }
  ],
  "tol": 0.000001
 }
}