{
 "id": "사면체_부피",
 "spec": {
  "title": "사면체 부피",
  "params": [
   {
    "name": "a",
    "label": "모서리 a",
    "type": "slider",
    "min": 0.5,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "모서리 b",
    "type": "slider",
    "min": 0.5,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "모서리 c",
    "type": "slider",
    "min": 0.5,
    "max": 5,
    "init": 4,
    "step": 0.1
   }
  ],
  "scope": "ca=cos(pi/4); O2x=0; O2y=0; A2x=a; A2y=0; B2x=-ca*b; B2y=-ca*b; C2x=0; C2y=c; S=0.5*a*b; h=c; triple=a*b*c; V_vec=abs(triple)/6; V_base=(1/3)*S*h",
  "geometry": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -5,
    5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=O2x",
      "=O2y"
     ],
     "to": [
      "=A2x",
      "=A2y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=O2x",
      "=O2y"
     ],
     "to": [
      "=B2x",
      "=B2y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=O2x",
      "=O2y"
     ],
     "to": [
      "=C2x",
      "=C2y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=A2x",
      "=A2y"
     ],
     "to": [
      "=B2x",
      "=B2y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=A2x",
      "=A2y"
     ],
     "to": [
      "=C2x",
      "=C2y"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=B2x",
      "=B2y"
     ],
     "to": [
      "=C2x",
      "=C2y"
     ]
    },
    {
     "type": "point",
     "at": [
      "=O2x",
      "=O2y"
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=A2x",
      "=A2y"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=B2x",
      "=B2y"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=C2x",
      "=C2y"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "밑면 넓이 S",
    "expr": "S",
    "digits": 3
   },
   {
    "label": "높이 h",
    "expr": "h",
    "digits": 3
   },
   {
    "label": "부피 V=Sh/3",
    "expr": "V_base",
    "digits": 4
   },
   {
    "label": "부피 V=|a·(b×c)|/6",
    "expr": "V_vec",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 3,
    "c": 4
   },
   {
    "a": 1,
    "b": 1,
    "c": 1
   },
   {
    "a": 2.5,
    "b": 4,
    "c": 1.5
   },
   {
    "a": 0.5,
    "b": 2,
    "c": 3
   }
  ],
  "invariants": [
   "abs(V_base - V_vec)",
   "abs(V_base - a*b*c/6)",
   "abs(S - 0.5*a*b)",
   "abs(h - c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 3,
     "c": 4
    },
    "expect": {
     "S": 3,
     "h": 4,
     "V_base": 4,
     "V_vec": 4
    }
   },
   {
    "params": {
     "a": 1,
     "b": 1,
     "c": 1
    },
    "expect": {
     "S": 0.5,
     "h": 1,
     "V_base": 0.16666666666666666,
     "V_vec": 0.16666666666666666
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 2,
     "c": 3
    },
    "expect": {
     "S": 0.5,
     "h": 3,
     "V_base": 0.5,
     "V_vec": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
