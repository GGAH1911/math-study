{
 "id": "이차함수의_대칭축",
 "spec": {
  "title": "이차함수의 대칭축",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "p (대칭축)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "q (꼭짓점 y좌표)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "d (대칭점 거리)",
    "type": "slider",
    "min": 0.1,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "axis=p; x1=p-d; x2=p+d; y1=a*(x1-p)^2+q; y2=a*(x2-p)^2+q",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -12,
    12
   ],
   "fns": [
    {
     "fn": "a*(x-p)^2+q",
     "label": "y=a(x-p)²+q",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "대칭축 x",
    "expr": "axis",
    "digits": 2
   },
   {
    "label": "f(p-d)",
    "expr": "y1",
    "digits": 3
   },
   {
    "label": "f(p+d)",
    "expr": "y2",
    "digits": 3
   },
   {
    "label": "y1-y2",
    "expr": "y1-y2",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "p": 0,
    "q": 0,
    "d": 1
   },
   {
    "a": 2,
    "p": 1,
    "q": -3,
    "d": 0.5
   },
   {
    "a": -1,
    "p": -2,
    "q": 4,
    "d": 1.5
   },
   {
    "a": 0.5,
    "p": 0.5,
    "q": 1,
    "d": 1
   }
  ],
  "invariants": [
   "abs(y1-y2)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "p": 0,
     "q": 0,
     "d": 1
    },
    "expect": {
     "axis": 0,
     "x1": -1,
     "x2": 1,
     "y1": 1,
     "y2": 1
    }
   },
   {
    "params": {
     "a": -1,
     "p": -2,
     "q": 4,
     "d": 1.5
    },
    "expect": {
     "axis": -2,
     "x1": -3.5,
     "x2": -0.5,
     "y1": 1.75,
     "y2": 1.75
    }
   }
  ],
  "tol": 0.000001
 }
}