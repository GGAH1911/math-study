{
 "id": "functions/math-1/삼각함수/초월방정식",
 "spec": {
  "title": "A sin x = mx + b — 두 곡선의 교점이 해다 (해의 개수는 기울기가 정한다)",
  "params": [
   {
    "name": "A",
    "label": "좌변 진폭 A ($y=A\\sin x$)",
    "type": "slider",
    "min": 0.2,
    "max": 3,
    "init": 1,
    "step": 0.05
   },
   {
    "name": "m",
    "label": "우변 직선 기울기 m",
    "type": "slider",
    "min": -1.5,
    "max": 1.5,
    "init": 0.5,
    "step": 0.01
   },
   {
    "name": "b",
    "label": "우변 직선 절편 b",
    "type": "slider",
    "min": -2.5,
    "max": 2.5,
    "init": 0,
    "step": 0.01
   },
   {
    "name": "t",
    "label": "검사값 x (수치로 더듬기)",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 1.895,
    "step": 0.001
   }
  ],
  "scope": "s = A*sin(t); rhs = m*t + b; diff = s - rhs; k = abs(m)/A; r = m/A; p = (abs(r) <= 1) ? acos(r) : 0; e1 = max(-8, min(8, -p - 2*pi)); e2 = max(-8, min(8, p - 2*pi)); e3 = max(-8, min(8, -p)); e4 = max(-8, min(8, p)); e5 = max(-8, min(8, -p + 2*pi)); e6 = max(-8, min(8, p + 2*pi)); ys = map(range(-8, 8, 0.02), f(u) = A*sin(u) - (m*u + b)); n = size(ys)[1]; pr = ys[1:(n-1)] .* ys[2:n]; cnt = sum(map(pr, q(v) = (v < 0) ? 1 : 0))",
