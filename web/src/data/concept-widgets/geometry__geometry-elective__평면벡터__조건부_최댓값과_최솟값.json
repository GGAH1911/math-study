{
 "id": "geometry/geometry-elective/평면벡터/조건부_최댓값과_최솟값",
 "spec": {
  "title": "조건부 최댓값·최솟값: 원 위에서 f(x,y)=ax+by 최적화",
  "params": [
   {
    "name": "a",
    "label": "목적함수 계수 a  (f = a·x + b·y)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "목적함수 계수 b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "r",
    "label": "제약 원의 반지름 r  (x²+y²=r²)",
    "type": "slider",
    "min": 0.5,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "theta",
    "label": "θ (원 위 점 P의 각)",
    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 45,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad=theta*pi/180; px=r*cos(rad); py=r*sin(rad); f=a*px+b*py; gnorm=sqrt(a^2+b^2); ux=gnorm>0 ? a/gnorm : 0; uy=gnorm>0 ? b/gnorm : 0; qx=r*ux; qy=r*uy; fmax=r*gnorm; fmin=-r*gnorm; tx=gnorm>0 ? -b/gnorm : 1; ty=gnorm>0 ? a/gnorm : 0; L=2*r+2; gap=fmax-f",
  "geometry": {
   "range": [
    -3.4,
    3.4
   ],
   "yRange": [
    -3.4,
    3.4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": "=r",
     "label": "제약 g: x²+y²=r²"
    },
    {
     "type": "vector",
     "from": [
      0,
      0
     ],
     "to": [
      "=a",
      "=b"
     ],
     "label": "$\\vec n=(a,b)$ (등고선의 법선)",
     "color": "#e07a5f"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=px",
      "=py"
     ],
     "label": "$\\overrightarrow{OP}$"
    },
    {
     "type": "segment",
     "from": [
      "=px+tx*L",
      "=py+ty*L"
     ],
     "to": [
      "=px-tx*L",
      "=py-ty*L"
     ],
     "label": "$ax+by=f$"
    },
    {
     "type": "segment",
     "from": [
      "=qx+tx*L",
      "=qy+ty*L"
     ],
     "to": [
      "=qx-tx*L",
      "=qy-ty*L"
     ],
     "dashed": true,
     "label": "최댓값 등고선(접선)"
    },
    {
     "type": "segment",
     "from": [
      "=-qx+tx*L",
      "=-qy+ty*L"
     ],
     "to": [
      "=-qx-tx*L",
      "=-qy-ty*L"
     ],
     "dashed": true,
     "label": "최솟값 등고선(접선)"
    },
    {
     "type": "point",
     "at": [
      "=qx",
      "=qy"
     ],
     "label": "$Q_{max}$"
    },
    {
     "type": "point",
     "at": [
      "=-qx",
      "=-qy"
     ],
     "label": "$Q_{min}$"
    },
    {
     "type": "point",
     "at": [
      "=px",
      "=py"
     ],
     "label": "P"
    }
   ]
  },
  "readout": [
   {
    "label": "f = ax+by",
    "expr": "f",
    "digits": 4
   },
   {
    "label": "최댓값 r·√(a²+b²)",
    "expr": "fmax",
    "digits": 4
   },
   {
    "label": "최솟값 −r·√(a²+b²)",
    "expr": "fmin",
    "digits": 4
   },
   {
    "label": "|n| = √(a²+b²)",
    "expr": "gnorm",
    "digits": 4
   },
   {
    "label": "최댓값까지 남은 양 (fmax−f)",
    "expr": "gap",
    "digits": 4
   },
   {
    "label": "제약 검증 x²+y²",
    "expr": "px^2+py^2",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 1,
    "r": 1,
    "theta": 45
   },
   {
    "a": 3,
    "b": 4,
    "r": 1,
    "theta": 0
   },
   {
    "a": 1,
    "b": 0,
    "r": 2,
    "theta": 90
   },
   {
    "a": -2,
    "b": 1,
    "r": 1.5,
    "theta": 200
   },
   {
    "a": 0,
    "b": 0,
    "r": 1,
    "theta": 45
   }
  ],
  "invariants": [
   "px^2+py^2-r^2",
   "f-(a*px+b*py)",
   "fmax-r*sqrt(a^2+b^2)",
   "fmax+fmin",
   "a*qx+b*qy-fmax",
   "a*tx+b*ty",
   "qx^2+qy^2-(gnorm>0 ? r^2 : 0)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 1,
     "r": 1,
     "theta": 45
    },
    "expect": {
     "f": 1.4142135623730951,
     "fmax": 1.4142135623730951,
     "fmin": -1.4142135623730951,
     "gnorm": 1.4142135623730951
    }
   },
   {
    "params": {
     "a": 3,
     "b": 4,
     "r": 1,
     "theta": 0
    },
    "expect": {
     "f": 3,
     "fmax": 5,
     "fmin": -5,
     "qx": 0.6,
     "qy": 0.8
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0,
     "r": 2,
     "theta": 90
    },
    "expect": {
     "f": 0,
     "fmax": 2,
     "fmin": -2,
     "qx": 2,
     "qy": 0
    }
   },
   {
    "params": {
     "a": 0,
     "b": 0,
     "r": 1,
     "theta": 45
    },
    "expect": {
     "f": 0,
     "fmax": 0,
     "fmin": 0,
     "qx": 0,
     "qy": 0
    }
   }
  ],
  "tol": 0.000001
 }
}
