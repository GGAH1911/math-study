{
 "id": "algebra/high-1/다항식/최고차_항",
 "spec": {
  "title": "최고차항과 다항식의 장기적 행동",
  "params": [
   {
    "name": "n",
    "label": "차수 n",
    "type": "slider",
    "min": 1,
    "max": 4,
    "init": 2,
    "step": 1
   },
   {
    "name": "a",
    "label": "최고차 계수 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1.5,
    "step": 0.1
   }
  ],
  "scope": "PX = a*10^n + 0.8*10 - 1.5; LX = a*10^n; P0 = a*0^n + 0.8*0 - 1.5",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -60,
    60
   ],
   "fns": [
    {
     "fn": "a*x^n + 0.8*x - 1.5",
     "label": "P(x) = a·x^n + 0.8x − 1.5",
     "color": "#1f77b4"
    },
    {
     "fn": "a*x^n",
     "label": "최고차항 a·x^n",
     "color": "#ff7f0e"
    },
    {
     "fn": "0.8*x - 1.5",
     "label": "하위항 0.8x − 1.5",
     "color": "#2ca02c"
    }
   ]
  },
  "readout": [
   {
    "label": "x=10에서 P(10)",
    "expr": "PX",
    "digits": 6
   },
   {
    "label": "x=10에서 최고차항 a·10^n",
    "expr": "LX",
    "digits": 6
   },
   {
    "label": "x=10에서 하위항 합",
    "expr": "PX - LX",
    "digits": 6
   },
   {
    "label": "P(0)",
    "expr": "P0",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "a": -2
   },
   {
    "n": 2,
    "a": 3
   },
   {
    "n": 3,
    "a": 0.5
   },
   {
    "n": 4,
    "a": -1.2
   }
  ],
  "invariants": [
   "abs(PX - LX - 6.5)",
   "abs(P0 + 1.5)",
   "abs(PX - (a*10^n + 0.8*10 - 1.5))"
  ],
  "oracle": [
   {
    "params": {
     "n": 2,
     "a": 3
    },
    "expect": {
     "PX": 306.5,
     "LX": 300,
     "P0": -1.5
    }
   },
   {
    "params": {
     "n": 1,
     "a": -2
    },
    "expect": {
     "PX": -13.5,
     "LX": -20,
     "P0": -1.5
    }
   },
   {
    "params": {
     "n": 4,
     "a": 0.5
    },
    "expect": {
     "PX": 5006.5,
     "LX": 5000,
     "P0": -1.5
    }
   }
  ],
  "tol": 0.000001
 }
}