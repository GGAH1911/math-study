{
 "id": "다항식의미분",
 "spec": {
  "title": "다항식의 미분",
  "params": [
   {
    "name": "a",
    "label": "a 계수",
    "type": "slider",
    "min": -1,
    "max": 1,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b 계수",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c 계수",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "d",
    "label": "상수항",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "x0",
    "label": "접점 x₀",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "slope = 3*a*x0^2 + 2*b*x0 + c; y0 = a*x0^3 + b*x0^2 + c*x0 + d; dx = 1.5; x1 = x0 - dx; y1 = y0 - slope*dx; x2 = x0 + dx; y2 = y0 + slope*dx; d1 = 3*a*x0^2; d2 = 2*b*x0; d3 = c; dsum = d1+d2+d3",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -30,
    30
   ],
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "f(x)",
     "color": "blue"
    },
    {
     "fn": "3*a*x^2 + 2*b*x + c",
     "label": "f'(x)",
     "color": "red"
    },
    {
     "fn": "y0 + slope*(x - x0)",
     "label": "접선",
     "color": "green"
    }
   ],
   "points": [
    [
     "=x0",
     "=y0"
    ]
   ],
   "pointsLabel": "$(x_0, f(x_0))$"
  },
  "readout": [
   {
    "label": "f'(x₀)",
    "expr": "slope",
    "digits": 4
   },
   {
    "label": "f(x₀)",
    "expr": "y0",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 1,
    "c": 1,
    "d": 0,
    "x0": 1
   },
   {
    "a": 1,
    "b": -2,
    "c": 3,
    "d": 0.5,
    "x0": -1
   },
   {
    "a": -1,
    "b": 2,
    "c": -2,
    "d": 0,
    "x0": 0.5
   }
  ],
  "invariants": [
   "dsum - slope",
   "y0 - (a*x0^3 + b*x0^2 + c*x0 + d)",
   "y1 - (y0 + slope*(x1-x0))",
   "y2 - (y0 + slope*(x2-x0))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 1,
     "c": 1,
     "d": 0,
     "x0": 1
    },
    "expect": {
     "slope": 6,
     "y0": 3
    }
   },
   {
    "params": {
     "a": 1,
     "b": -2,
     "c": 3,
     "d": 0.5,
     "x0": -1
    },
    "expect": {
     "slope": 10,
     "y0": -5.5
    }
   },
   {
    "params": {
     "a": -1,
     "b": 2,
     "c": -2,
     "d": 0,
     "x0": 0.5
    },
    "expect": {
     "slope": -0.75,
     "y0": -0.625
    }
   }
  ],
  "tol": 0.000001
 }
}