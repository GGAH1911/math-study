{
 "id": "functions/middle-3/이차함수/최솟값",
 "spec": {
  "title": "이차함수의 최솟값 — 꼭짓점 탐구",
  "params": [
   {
    "name": "a",
    "label": "a (폭·볼록)",
    "type": "slider",
    "min": 0.2,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "p (축의 위치)",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "q (최솟값)",
    "type": "slider",
    "min": -4,
    "max": 6,
    "init": 3,
    "step": 0.1
   }
  ],
  "scope": "xv = p; yv = q; fv = a*(xv - p)^2 + q; slope = 2*a*(xv - p)",
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    10
   ],
   "fns": [
    {
     "fn": "a*(x - p)^2 + q",
     "label": "y = a(x-p)²+q",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "최솟값 (꼭짓점 y좌표)",
    "expr": "yv",
    "digits": 2
   },
   {
    "label": "최솟값을 주는 x (축)",
    "expr": "xv",
    "digits": 2
   },
   {
    "label": "꼭짓점에서의 접선 기울기",
    "expr": "slope",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "p": 2,
    "q": 3
   },
   {
    "a": 2,
    "p": -1,
    "q": 0
   },
   {
    "a": 0.5,
    "p": 0,
    "q": -2
   },
   {
    "a": 3,
    "p": 3.5,
    "q": 5
   }
  ],
  "invariants": [
   "fv - yv",
   "slope",
   "a*(xv - p)^2"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "p": 2,
     "q": 3
    },
    "expect": {
     "xv": 2,
     "yv": 3,
     "slope": 0
    }
   },
   {
    "params": {
     "a": 2,
     "p": -1,
     "q": 0
    },
    "expect": {
     "xv": -1,
     "yv": 0,
     "slope": 0
    }
   },
   {
    "params": {
     "a": 0.5,
     "p": 0,
     "q": -2
    },
    "expect": {
     "xv": 0,
     "yv": -2,
     "slope": 0
    }
   }
  ],
  "tol": 0.000001
 }
}