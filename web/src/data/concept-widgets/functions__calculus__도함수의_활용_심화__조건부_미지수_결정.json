{
 "id": "functions/calculus/도함수의_활용_심화/조건부_미지수_결정",
 "spec": {
  "title": "조건부 미지수 결정: 극값과 지나는 점으로 삼차함수 정하기",
  "params": [
   {
    "name": "a",
    "label": "최고차항 계수 a",
    "type": "slider",
    "min": 0.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "p",
    "label": "극대점 x좌표 p",
    "type": "slider",
    "min": -1.5,
    "max": -0.5,
    "init": -1,
    "step": 0.1
   },
   {
    "name": "q",
    "label": "극소점 x좌표 q",
    "type": "slider",
    "min": 0.5,
    "max": 1.5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "b = -3*a*(p+q)/2; c = 3*a*p*q; d = 0; ymax = a*p^3 + b*p^2 + c*p + d; ymin = a*q^3 + b*q^2 + c*q + d; fpp = 3*a*p^2 + 2*b*p + c; fpq = 3*a*q^2 + 2*b*q + c",
  "geometry": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -13,
    13
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=p",
      0
     ],
     "to": [
      "=p",
      "=ymax"
     ]
    },
    {
     "type": "segment",
     "from": [
      "=q",
      0
     ],
     "to": [
      "=q",
      "=ymin"
     ]
    },
    {
     "type": "point",
     "at": [
      "=p",
      "=ymax"
     ],
     "label": "극대"
    },
    {
     "type": "point",
     "at": [
      "=q",
      "=ymin"
     ],
     "label": "극소"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "원점 통과"
    }
   ]
  },
  "plot": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -13,
    13
   ],
   "fns": [
    {
     "fn": "a*x^3 + b*x^2 + c*x + d",
     "label": "y=ax³+bx²+cx+d",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "결정된 b",
    "expr": "b",
    "digits": 3
   },
   {
    "label": "결정된 c",
    "expr": "c",
    "digits": 3
   },
   {
    "label": "결정된 d",
    "expr": "d",
    "digits": 3
   },
   {
    "label": "극댓값 f(p)",
    "expr": "ymax",
    "digits": 3
   },
   {
    "label": "극솟값 f(q)",
    "expr": "ymin",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "p": -1,
    "q": 1
   },
   {
    "a": 1,
    "p": -1.5,
    "q": 0.5
   },
   {
    "a": 0.5,
    "p": -1,
    "q": 1
   },
   {
    "a": 1.5,
    "p": -0.5,
    "q": 1.5
   }
  ],
  "invariants": [
   "3*a*p^2 + 2*b*p + c",
   "3*a*q^2 + 2*b*q + c",
   "d",
   "fpp",
   "fpq"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "p": -1,
     "q": 1
    },
    "expect": {
     "b": 0,
     "c": -3,
     "d": 0,
     "ymax": 2,
     "ymin": -2
    }
   },
   {
    "params": {
     "a": 1,
     "p": -1.5,
     "q": 0.5
    },
    "expect": {
     "b": 1.5,
     "c": -2.25,
     "d": 0,
     "ymax": 3.375,
     "ymin": -0.625
    }
   },
   {
    "params": {
     "a": 0.5,
     "p": -1,
     "q": 1
    },
    "expect": {
     "b": 0,
     "c": -1.5,
     "d": 0,
     "ymax": 1,
     "ymin": -1
    }
   }
  ],
  "tol": 0.000001
 }
}