{
 "id": "functions/calculus/도함수의_활용_심화/법선",
 "spec": {
  "title": "법선 (Normal Line) — y=x² 위의 점에서",
  "params": [
   {
    "name": "a",
    "label": "a (접점의 x좌표)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "fa = a^2; mt = 2*a; mn = -1/(2*a); prod = mt*mn",
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -1,
    5
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y=x²",
     "color": "#1f77b4"
    },
    {
     "fn": "a^2 + 2*a*(x - a)",
     "label": "접선 (기울기 f'(a))",
     "color": "#ff7f0e"
    },
    {
     "fn": "a^2 - 1/(2*a)*(x - a)",
     "label": "법선 (기울기 -1/f'(a))",
     "color": "#2ca02c"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "접선 기울기 f'(a)",
    "expr": "mt",
    "digits": 3
   },
   {
    "label": "법선 기울기 -1/f'(a)",
    "expr": "mn",
    "digits": 3
   },
   {
    "label": "두 기울기의 곱",
    "expr": "prod",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0.5
   },
   {
    "a": 1
   },
   {
    "a": 1.5
   },
   {
    "a": -1
   }
  ],
  "invariants": [
   "mt*mn + 1",
   "mn + 1/mt",
   "prod + 1"
  ],
  "oracle": [
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": 1,
     "mt": 2,
     "mn": -0.5
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 4,
     "mt": 4,
     "mn": -0.25
    }
   },
   {
    "params": {
     "a": -1
    },
    "expect": {
     "fa": 1,
     "mt": -2,
     "mn": 0.5
    }
   }
  ],
  "tol": 0.000001
 }
}