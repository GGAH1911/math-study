{
 "id": "functions/middle-1/좌표평면과_그래프/좌표평면_기하",
 "spec": {
  "title": "좌표평면 위 두 점 사이의 거리",
  "params": [
   {
    "name": "x1",
    "label": "A의 x좌표",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 1
   },
   {
    "name": "y1",
    "label": "A의 y좌표",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 1
   },
   {
    "name": "x2",
    "label": "B의 x좌표",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 4,
    "step": 1
   },
   {
    "name": "y2",
    "label": "B의 y좌표",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 5,
    "step": 1
   }
  ],
  "scope": "dx=x2-x1; dy=y2-y1; d=sqrt(dx^2+dy^2)",
  "geometry": {
   "range": [
    -5.5,
    5.5
   ],
   "yRange": [
    -5.5,
    5.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=x1",
      "=y1"
     ],
     "to": [
      "=x2",
      "=y1"
     ],
     "color": "#888",
     "label": "밑변 |Δx|"
    },
    {
     "type": "segment",
     "from": [
      "=x2",
      "=y1"
     ],
     "to": [
      "=x2",
      "=y2"
     ],
     "color": "#888",
     "label": "높이 |Δy|"
    },
    {
     "type": "segment",
     "from": [
      "=x1",
      "=y1"
     ],
     "to": [
      "=x2",
      "=y2"
     ],
     "color": "#d33",
     "label": "거리 d"
    },
    {
     "type": "point",
     "at": [
      "=x1",
      "=y1"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=x2",
      "=y2"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=x2",
      "=y1"
     ],
     "label": "C"
    }
   ]
  },
  "readout": [
   {
    "label": "Δx = x₂ - x₁",
    "expr": "dx",
    "digits": 0
   },
   {
    "label": "Δy = y₂ - y₁",
    "expr": "dy",
    "digits": 0
   },
   {
    "label": "거리 d = √(Δx²+Δy²)",
    "expr": "d",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x1": 1,
    "y1": 1,
    "x2": 4,
    "y2": 5
   },
   {
    "x1": -2,
    "y1": -1,
    "x2": 1,
    "y2": 3
   },
   {
    "x1": 0,
    "y1": 0,
    "x2": 5,
    "y2": 0
   },
   {
    "x1": -3,
    "y1": 2,
    "x2": 3,
    "y2": 2
   }
  ],
  "invariants": [
   "d^2-dx^2-dy^2",
   "dx-(x2-x1)",
   "dy-(y2-y1)",
   "d-sqrt((x2-x1)^2+(y2-y1)^2)"
  ],
  "oracle": [
   {
    "params": {
     "x1": 1,
     "y1": 1,
     "x2": 4,
     "y2": 5
    },
    "expect": {
     "dx": 3,
     "dy": 4,
     "d": 5
    }
   },
   {
    "params": {
     "x1": -2,
     "y1": -1,
     "x2": 1,
     "y2": 3
    },
    "expect": {
     "dx": 3,
     "dy": 4,
     "d": 5
    }
   },
   {
    "params": {
     "x1": 0,
     "y1": 0,
     "x2": 5,
     "y2": 0
    },
    "expect": {
     "dx": 5,
     "dy": 0,
     "d": 5
    }
   }
  ],
  "tol": 0.000001
 }
}