    "min": 0.5,
    "max": 8,
    "init": 3,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "base=pi*r^2; V=base*h; d=2*r",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -1,
    9
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "label": "원기둥 축단면",
     "vertices": [
      [
       "=-r",
       0
      ],
      [
       "=r",
       0
      ],
      [
       "=r",
       "=h"
      ],
      [
       "=-r",
       "=h"
      ]
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=r",
      0
     ],
     "label": "r"
    },
    {
     "type": "segment",
     "from": [
      "=-r",
      "=h"
     ],
     "to": [
      "=-r",
      0
     ],
     "label": "h"
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "중심"
    }
   ]
  },
  "readout": [
   {
    "label": "밑넓이 πr²",
    "expr": "base",
    "digits": 3
   },
   {
    "label": "부피 V=πr²h",
    "expr": "V",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
