{
 "id": "복소수_근",
 "spec": {
  "title": "복소수 근 (이차방정식)",
  "params": [
   {
    "name": "k",
    "label": "상수항 k",
    "type": "slider",
    "min": -2,
    "max": 5,
    "init": 5,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "d=4-4*k; half=sqrt(abs(d))/2; r1_re=d < 0 ? 1 : 1-half; r1_im=d < 0 ? half : 0; r2_re=d < 0 ? 1 : 1+half; r2_im=d < 0 ? -half : 0",
  "geometry": {
   "range": [
    -3.5,
    3.5
   ],
   "yRange": [
    -3.5,
    3.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      "=r1_re",
      "=r1_im"
     ],
     "label": "r1"
    },
    {
     "type": "point",
     "at": [
      "=r2_re",
      "=r2_im"
     ],
     "label": "r2"
    },
    {
     "type": "segment",
     "from": [
      "=r1_re",
      "=r1_im"
     ],
     "to": [
      "=r2_re",
      "=r2_im"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=r1_re",
      "=r1_im"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=r2_re",
      "=r2_im"
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D",
    "expr": "d",
    "digits": 2
   },
   {
    "label": "r1 실수부",
    "expr": "r1_re",
    "digits": 3
   },
   {
    "label": "r1 허수부",
    "expr": "r1_im",
    "digits": 3
   },
   {
    "label": "r2 실수부",
    "expr": "r2_re",
    "digits": 3
   },
   {
    "label": "r2 허수부",
    "expr": "r2_im",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "k": 0
   },
   {
    "k": 0.75
   },
   {
    "k": 1
   },
   {
    "k": 2
   },
   {
    "k": 5
   }
  ],
  "invariants": [
   "r1_re + r2_re - 2",
   "r1_im + r2_im",
   "r1_re*r2_re - r1_im*r2_im - k",
   "r1_re*r2_im + r1_im*r2_re"
  ],
  "oracle": [
   {
    "params": {
     "k": 0
    },
    "expect": {
     "r1_re": 0,
     "r1_im": 0,
     "r2_re": 2,
     "r2_im": 0
    }
   },
   {
    "params": {
     "k": 2
    },
    "expect": {
     "r1_re": 1,
     "r1_im": 1,
     "r2_re": 1,
     "r2_im": -1
    }
   },
   {
    "params": {
     "k": 5
    },
    "expect": {
     "r1_re": 1,
     "r1_im": 2,
     "r2_re": 1,
     "r2_im": -2
    }
   }
  ],
  "tol": 0.000001
 }
}