    "min": 1,
    "max": 3,
    "init": 2,
    "step": 1,
    "unit": "제곱"
   }
  ],
  "scope": "h1=(1<=n)*1^k; h2=(2<=n)*2^k; h3=(3<=n)*3^k; h4=(4<=n)*4^k; h5=(5<=n)*5^k; h6=(6<=n)*6^k; S=h1+h2+h3+h4+h5+h6; f1=n*(n+1)/2; f2=n*(n+1)*(2*n+1)/6; f3=(n*(n+1)/2)^2; F=(k==1)*f1+(k==2)*f2+(k==3)*f3; ymax=1.1*max(h1,h2,h3,h4,h5,h6)",
