{
 "id": "probability-stats/prob-stats-elective/통계/표본분포",
 "spec": {
  "title": "표본분포 (표본평균)",
  "params": [
   {
    "name": "n",
    "label": "표본 크기 n",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 1,
    "step": 1
   },
   {
    "name": "mu",
    "label": "모평균 μ",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "sigma",
    "label": "모표준편차 σ",
    "type": "slider",
    "min": 0.5,
    "max": 5,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "se=sigma/sqrt(n); density_ratio=(1/(se*sqrt(2*pi)))/(1/(sigma*sqrt(2*pi))); max_y=1.2*sqrt(n)/(sigma*sqrt(2*pi))",
  "geometry": {},
  "plot": {
   "range": [
    "=mu-4*sigma",
    "=mu+4*sigma"
   ],
   "yRange": [
    "0",
    "=max_y"
   ],
   "fns": [
    {
     "fn": "1/(sigma*sqrt(2*pi))*exp(-0.5*((x-mu)/sigma)^2)",
     "label": "모집단 분포",
     "color": "gray"
    },
    {
     "fn": "1/(se*sqrt(2*pi))*exp(-0.5*((x-mu)/se)^2)",
     "label": "표본평균의 분포",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "모평균 μ",
    "expr": "mu",
    "digits": 2
   },
   {
    "label": "표준오차 σ/√n",
    "expr": "se",
    "digits": 4
   },
   {
    "label": "중심 밀도비",
    "expr": "density_ratio",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "mu": 0,
    "sigma": 1
   },
   {
    "n": 4,
    "mu": 0,
    "sigma": 2
   },
   {
    "n": 9,
    "mu": 1,
    "sigma": 3
   },
   {
    "n": 16,
    "mu": -2,
    "sigma": 0.5
   }
  ],
  "invariants": [
   "abs(density_ratio - sqrt(n))",
   "abs(se - sigma/sqrt(n))"
  ],
  "oracle": [
   {
    "params": {
     "n": 1,
     "mu": 0,
     "sigma": 1
    },
    "expect": {
     "se": 1,
     "density_ratio": 1
    }
   },
   {
    "params": {
     "n": 4,
     "mu": 0,
     "sigma": 2
    },
    "expect": {
     "se": 1,
     "density_ratio": 2
    }
   },
   {
    "params": {
     "n": 9,
     "mu": 1,
     "sigma": 3
    },
    "expect": {
     "se": 1,
     "density_ratio": 3
    }
   },
   {
    "params": {
     "n": 16,
     "mu": -2,
     "sigma": 0.5
    },
    "expect": {
     "se": 0.125,
     "density_ratio": 4
    }
   }
  ],
  "tol": 0.000001
 }
}