{
 "id": "functions/math-2/미분/함수의_개형",
 "spec": {
  "title": "함수의 개형 — 도함수의 부호로 증가·감소와 극값 읽기",
  "params": [
   {
    "name": "a",
    "label": "a (개형: f(x)=x³−3a·x)",
    "type": "slider",
    "min": 0,
    "max": 3,
    "init": 1,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "x0",
    "label": "관찰점 x₀ (접선)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0.5,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "xc = sqrt(a); fmax = 2*a*xc; fmin = -2*a*xc; m0 = 3*x0^2 - 3*a; y0 = x0^3 - 3*a*x0",
  "plot": {
   "range": [
    -2.5,
    2.5
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "x^3 - 3*a*x",
     "label": "f(x)=x³−3a·x",
     "color": "#2563eb"
    },
    {
     "fn": "3*x^2 - 3*a",
     "label": "f'(x)=3x²−3a (부호=증감)",
     "color": "#dc2626"
    },
    {
     "fn": "(3*x0^2-3*a)*(x-x0) + (x0^3-3*a*x0)",
     "label": "x₀에서의 접선",
     "color": "#16a34a"
    }
   ]
  },
  "readout": [
   {
    "label": "극점 위치 ±√a",
    "expr": "xc",
    "digits": 3
   },
   {
    "label": "극댓값 f(−√a)",
    "expr": "fmax",
    "digits": 3
   },
   {
    "label": "극솟값 f(√a)",
    "expr": "fmin",
    "digits": 3
   },
   {
    "label": "접선 기울기 f'(x₀)  (+면 증가·−면 감소)",
    "expr": "m0",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "x0": 0.5
   },
   {
    "a": 1,
    "x0": -1
   },
   {
    "a": 0.25,
    "x0": 0
   },
   {
    "a": 2.25,
    "x0": 1.5
   }
  ],
  "invariants": [
   "3*xc^2 - 3*a",
   "fmax + fmin",
   "fmin - (xc^3 - 3*a*xc)",
   "fmax - ((-xc)^3 - 3*a*(-xc))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "x0": 0.5
    },
    "expect": {
     "xc": 1,
     "fmax": 2,
     "fmin": -2,
     "m0": -2.25,
     "y0": -1.375
    }
   },
   {
    "params": {
     "a": 0.25,
     "x0": 0
    },
    "expect": {
     "xc": 0.5,
     "fmax": 0.25,
     "fmin": -0.25,
     "m0": -0.75,
     "y0": 0
    }
   },
   {
    "params": {
     "a": 2.25,
     "x0": 1.5
    },
    "expect": {
     "xc": 1.5,
     "fmax": 6.75,
     "fmin": -6.75,
     "m0": 0,
     "y0": -6.75
    }
   }
  ],
  "tol": 0.000001
 }
}