{
 "id": "무리함수_미분",
 "spec": {
  "title": "무리함수의 미분: f(x)=√(x²+3)와 접선의 기울기",
  "params": [
   {
    "name": "x0",
    "label": "x₀ (접점)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "f0=sqrt(x0^2+3); d0=x0/sqrt(x0^2+3)",
  "plot": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -1,
    6
   ],
   "fns": [
    {
     "fn": "sqrt(x^2+3)",
     "label": "f(x)=√(x²+3)",
     "color": "#2563eb"
    },
    {
     "fn": "f0 + d0*(x - x0)",
     "label": "x₀에서의 접선 (기울기 f'(x₀))",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(x₀)=√(x₀²+3)",
    "expr": "f0",
    "digits": 4
   },
   {
    "label": "f'(x₀)=x₀/√(x₀²+3)",
    "expr": "d0",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "x0": 1
   },
   {
    "x0": 0
   },
   {
    "x0": 2
   },
   {
    "x0": -1.5
   }
  ],
  "invariants": [
   "f0^2 - (x0^2+3)",
   "d0*f0 - x0",
   "d0 - x0/sqrt(x0^2+3)"
  ],
  "oracle": [
   {
    "params": {
     "x0": 1
    },
    "expect": {
     "f0": 2,
     "d0": 0.5
    }
   },
   {
    "params": {
     "x0": 0
    },
    "expect": {
     "f0": 1.7320508076,
     "d0": 0
    }
   },
   {
    "params": {
     "x0": 2
    },
    "expect": {
     "f0": 2.6457513111,
     "d0": 0.7559289474
    }
   }
  ],
  "tol": 0.000001
 }
}