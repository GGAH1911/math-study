{
 "id": "극한값_계산",
 "spec": {
  "title": "극한값 계산",
  "params": [
   {
    "name": "xs",
    "label": "x 값",
    "type": "slider",
    "min": 0,
    "max": 4,
    "init": 0.5,
    "step": 0.01,
    "unit": ""
   }
  ],
  "scope": "a=2; L=a^2; fxs=xs^2; dist=abs(fxs-L); cx=xs; cy=fxs; rad=0.15;",
  "geometry": {
   "range": [
    -0.3,
    4.3
   ],
   "yRange": [
    -1,
    17
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      "=cx",
      "=cy"
     ],
     "radius": "=rad"
    },
    {
     "type": "circle",
     "center": [
      "=a",
      "=L"
     ],
     "radius": "=rad"
    },
    {
     "type": "segment",
     "from": [
      "=cx",
      "=cy"
     ],
     "to": [
      "=a",
      "=L"
     ]
    }
   ]
  },
  "plot": {
   "range": [
    -0.3,
    4.3
   ],
   "yRange": [
    -1,
    17
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "blue"
    },
    {
     "fn": "L",
     "label": "L=4",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "x 값",
    "expr": "xs",
    "digits": 2
   },
   {
    "label": "f(x) 값",
    "expr": "fxs",
    "digits": 4
   },
   {
    "label": "극한값 L",
    "expr": "L",
    "digits": 4
   },
   {
    "label": "오차 |f(x)-L|",
    "expr": "dist",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "xs": 0.5
   },
   {
    "xs": 1
   },
   {
    "xs": 3
   },
   {
    "xs": 3.5
   }
  ],
  "invariants": [
   "fxs - xs^2",
   "dist - abs(fxs - L)",
   "cx - xs",
   "cy - fxs"
  ],
  "oracle": [
   {
    "params": {
     "xs": 1
    },
    "expect": {
     "fxs": 1,
     "dist": 3,
     "cx": 1,
     "cy": 1
    }
   },
   {
    "params": {
     "xs": 3
    },
    "expect": {
     "fxs": 9,
     "dist": 5,
     "cx": 3,
     "cy": 9
    }
   },
   {
    "params": {
     "xs": 2
    },
    "expect": {
     "fxs": 4,
     "dist": 0,
     "cx": 2,
     "cy": 4
    }
   }
  ],
  "tol": 0.000001
 }
}