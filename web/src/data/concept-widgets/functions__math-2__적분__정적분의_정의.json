{
 "id": "functions/math-2/적분/정적분의_정의",
 "spec": {
  "title": "정적분의 정의 — 리만 합의 극한",
  "params": [
   {
    "name": "n",
    "label": "분할 수 n",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 4,
    "step": 1,
    "unit": "개"
   }
  ],
  "scope": "dx = 1/n; Rn = (n+1)*(2*n+1)/(6*n^2); Ln = (n-1)*(2*n-1)/(6*n^2); exact = 1/3; err = abs(Rn - exact)",
  "plot": {
   "range": [
    0,
    1
   ],
   "yRange": [
    0,
    1.05
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "y = x²",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "Δx = (b−a)/n",
    "expr": "dx",
    "digits": 4
   },
   {
    "label": "왼쪽합 Lₙ",
    "expr": "Ln",
    "digits": 5
   },
   {
    "label": "오른쪽합 Rₙ",
    "expr": "Rn",
    "digits": 5
   },
   {
    "label": "정적분 ∫₀¹ x² dx",
    "expr": "exact",
    "digits": 5
   },
   {
    "label": "오차 |Rₙ − 정적분|",
    "expr": "err",
    "digits": 5
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1
   },
   {
    "n": 4
   },
   {
    "n": 10
   },
   {
    "n": 50
   }
  ],
  "invariants": [
   "Rn - Ln - 1/n",
   "Rn - (1/3 + 1/(2*n) + 1/(6*n^2))",
   "Ln - (1/3 - 1/(2*n) + 1/(6*n^2))"
  ],
  "oracle": [
   {
    "params": {
     "n": 1
    },
    "expect": {
     "Rn": 1,
     "Ln": 0,
     "exact": 0.3333333333333
    }
   },
   {
    "params": {
     "n": 2
    },
    "expect": {
     "Rn": 0.625,
     "Ln": 0.125
    }
   },
   {
    "params": {
     "n": 4
    },
    "expect": {
     "Rn": 0.46875,
     "Ln": 0.21875
    }
   }
  ],
  "tol": 0.000001
 }
}