    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "B",
    "label": "x 계수 B",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.25
   },
   {
    "name": "C",
