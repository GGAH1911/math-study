    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.25
   },
   {
    "name": "a",
    "label": "아래끝 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.25
   },
   {
    "name": "w",
    "label": "구간 길이 b−a",
    "type": "slider",
    "min": 0.5,
    "max": 4,
    "init": 1,
    "step": 0.25
   },
   {
    "name": "p",
    "label": "표본점 위치 p (0=왼끝, 0.5=중점, 1=오른끝)",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 1,
    "step": 0.05
   },
   {
    "name": "n",
    "label": "분할 수 n",
    "type": "slider",
    "min": 1,
    "max": 20,
    "init": 4,
    "step": 1
   }
  ],
  "scope": "b = a + w; h = (b - a)/n; f(x) = A*x^2 + B*x + C; Ssum(q) = h*(A*(n*a^2 + 2*a*h*(n*(n-1)/2 + n*q) + h^2*((n-1)*n*(2*n-1)/6 + q*n*(n-1) + n*q^2)) + B*(n*a + h*(n*(n-1)/2 + n*q)) + C*n); Sn = Ssum(p); Ln = Ssum(0); Rn = Ssum(1); Mn = Ssum(0.5); exact = A*(b^3 - a^3)/3 + B*(b^2 - a^2)/2 + C*(b - a); err = abs(Sn - exact); xv = (A != 0 ? min(max(-B/(2*A), a), b) : a); ylo = min(min(f(a), f(b)), min(f(xv), 0)); yhi = max(max(f(a), f(b)), max(f(xv), 0)); pad = 0.12*(yhi - ylo) + 0.08 + 0*C; g = (b - a)/32; u1 = (1 <= n ? a + 0*h : a); v1 = (1 <= n ? a + 1*h : a); y1 = (1 <= n ? f(a + (0 + p)*h) : 0); u2 = (2 <= n ? a + 1*h : a); v2 = (2 <= n ? a + 2*h : a); y2 = (2 <= n ? f(a + (1 + p)*h) : 0); u3 = (3 <= n ? a + 2*h : a); v3 = (3 <= n ? a + 3*h : a); y3 = (3 <= n ? f(a + (2 + p)*h) : 0); u4 = (4 <= n ? a + 3*h : a); v4 = (4 <= n ? a + 4*h : a); y4 = (4 <= n ? f(a + (3 + p)*h) : 0); u5 = (5 <= n ? a + 4*h : a); v5 = (5 <= n ? a + 5*h : a); y5 = (5 <= n ? f(a + (4 + p)*h) : 0); u6 = (6 <= n ? a + 5*h : a); v6 = (6 <= n ? a + 6*h : a); y6 = (6 <= n ? f(a + (5 + p)*h) : 0); u7 = (7 <= n ? a + 6*h : a); v7 = (7 <= n ? a + 7*h : a); y7 = (7 <= n ? f(a + (6 + p)*h) : 0); u8 = (8 <= n ? a + 7*h : a); v8 = (8 <= n ? a + 8*h : a); y8 = (8 <= n ? f(a + (7 + p)*h) : 0); u9 = (9 <= n ? a + 8*h : a); v9 = (9 <= n ? a + 9*h : a); y9 = (9 <= n ? f(a + (8 + p)*h) : 0); u10 = (10 <= n ? a + 9*h : a); v10 = (10 <= n ? a + 10*h : a); y10 = (10 <= n ? f(a + (9 + p)*h) : 0); u11 = (11 <= n ? a + 10*h : a); v11 = (11 <= n ? a + 11*h : a); y11 = (11 <= n ? f(a + (10 + p)*h) : 0); u12 = (12 <= n ? a + 11*h : a); v12 = (12 <= n ? a + 12*h : a); y12 = (12 <= n ? f(a + (11 + p)*h) : 0); u13 = (13 <= n ? a + 12*h : a); v13 = (13 <= n ? a + 13*h : a); y13 = (13 <= n ? f(a + (12 + p)*h) : 0); u14 = (14 <= n ? a + 13*h : a); v14 = (14 <= n ? a + 14*h : a); y14 = (14 <= n ? f(a + (13 + p)*h) : 0); u15 = (15 <= n ? a + 14*h : a); v15 = (15 <= n ? a + 15*h : a); y15 = (15 <= n ? f(a + (14 + p)*h) : 0); u16 = (16 <= n ? a + 15*h : a); v16 = (16 <= n ? a + 16*h : a); y16 = (16 <= n ? f(a + (15 + p)*h) : 0); u17 = (17 <= n ? a + 16*h : a); v17 = (17 <= n ? a + 17*h : a); y17 = (17 <= n ? f(a + (16 + p)*h) : 0); u18 = (18 <= n ? a + 17*h : a); v18 = (18 <= n ? a + 18*h : a); y18 = (18 <= n ? f(a + (17 + p)*h) : 0); u19 = (19 <= n ? a + 18*h : a); v19 = (19 <= n ? a + 19*h : a); y19 = (19 <= n ? f(a + (18 + p)*h) : 0); u20 = (20 <= n ? a + 19*h : a); v20 = (20 <= n ? a + 20*h : a); y20 = (20 <= n ? f(a + (19 + p)*h) : 0)",
