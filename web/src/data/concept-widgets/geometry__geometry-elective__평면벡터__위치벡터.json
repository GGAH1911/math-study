{
 "id": "geometry/geometry-elective/평면벡터/위치벡터",
 "spec": {
  "title": "위치벡터와 두 점을 잇는 벡터 AB",
  "params": [
   {
    "name": "ax",
    "label": "A의 x₁",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 3,
    "step": 0.5
   },
   {
    "name": "ay",
    "label": "A의 y₁",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "bx",
    "label": "B의 x₂",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 1,
    "step": 0.5
   },
   {
    "name": "by",
    "label": "B의 y₂",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 4,
    "step": 0.5
   }
  ],
  "scope": "abx=bx-ax; aby=by-ay; mx=(ax+bx)/2; my=(ay+by)/2; lenOA=sqrt(ax^2+ay^2); lenOB=sqrt(bx^2+by^2); lenAB=sqrt(abx^2+aby^2)",
  "geometry": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -6,
    6
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      "=ax",
      "=ay"
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=bx",
      "=by"
     ],
     "label": "B"
    },
    {
     "type": "point",
     "at": [
      "=mx",
      "=my"
     ],
     "label": "M"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=ax",
      "=ay"
     ],
     "label": "a=OA"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "b=OB"
    },
    {
     "type": "segment",
     "from": [
      "=ax",
      "=ay"
     ],
     "to": [
      "=bx",
      "=by"
     ],
     "label": "AB=b-a"
    }
   ]
  },
  "readout": [
   {
    "label": "|OA|",
    "expr": "lenOA",
    "digits": 3
   },
   {
    "label": "|OB|",
    "expr": "lenOB",
    "digits": 3
   },
   {
    "label": "AB의 x성분 (x₂-x₁)",
    "expr": "abx",
    "digits": 2
   },
   {
    "label": "AB의 y성분 (y₂-y₁)",
    "expr": "aby",
    "digits": 2
   },
   {
    "label": "|AB|",
    "expr": "lenAB",
    "digits": 3
   },
   {
    "label": "중점 M의 x",
    "expr": "mx",
    "digits": 2
   },
   {
    "label": "중점 M의 y",
    "expr": "my",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "ax": 3,
    "ay": 1,
    "bx": 1,
    "by": 4
   },
   {
    "ax": 2,
    "ay": 0,
    "bx": 0,
    "by": 4
   },
   {
    "ax": -2,
    "ay": 3,
    "bx": 4,
    "by": -1
   },
   {
    "ax": 3,
    "ay": 4,
    "bx": 0,
    "by": 0
   }
  ],
  "invariants": [
   "abx-(bx-ax)",
   "aby-(by-ay)",
   "mx-(ax+bx)/2",
   "my-(ay+by)/2",
   "(mx-ax)^2+(my-ay)^2-((bx-mx)^2+(by-my)^2)",
   "lenAB^2-((bx-ax)^2+(by-ay)^2)"
  ],
  "oracle": [
   {
    "params": {
     "ax": 2,
     "ay": 0,
     "bx": 0,
     "by": 4
    },
    "expect": {
     "abx": -2,
     "aby": 4,
     "mx": 1,
     "my": 2,
     "lenAB": 4.47213595499958
    }
   },
   {
    "params": {
     "ax": 3,
     "ay": 4,
     "bx": 0,
     "by": 0
    },
    "expect": {
     "lenOA": 5,
     "abx": -3,
     "aby": -4,
     "lenAB": 5,
     "mx": 1.5,
     "my": 2
    }
   }
  ],
  "tol": 0.000001
 }
}