{
 "id": "functions/high-1/함수와_그래프/역함수_존재_조건",
 "spec": {
  "title": "역함수 존재 조건 — 수평선 검사",
  "params": [
   {
    "name": "a",
    "label": "형태 a (f(x)=x³−a·x)",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "수평선 y=c",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "crit = a > 0 ? sqrt(a/3) : 0; ymax = crit*(2*a/3); ymin = -ymax; gap = ymax - ymin; fpc = 3*crit^2 - a; zone = (c - ymin)*(ymax - c)",
  "plot": {
   "range": [
    -2.3,
    2.3
   ],
   "yRange": [
    -6,
    6
   ],
   "fns": [
    {
     "fn": "x^3 - a*x",
     "label": "y=f(x)",
     "color": "#2563eb"
    },
    {
     "fn": "c",
     "label": "y=c (수평선)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값 ymax",
    "expr": "ymax",
    "digits": 3
   },
   {
    "label": "극솟값 ymin",
    "expr": "ymin",
    "digits": 3
   },
   {
    "label": "일대일 여부 (gap=0이면 일대일→역함수 O)",
    "expr": "gap",
    "digits": 3
   },
   {
    "label": "수평선 교점 판별 (>0: 3개→역함수 X, <0: 1개)",
    "expr": "zone",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 3,
    "c": 0
   },
   {
    "a": 0.75,
    "c": 1
   },
   {
    "a": 1.5,
    "c": -0.5
   },
   {
    "a": 2.4,
    "c": 0.7
   }
  ],
  "invariants": [
   "fpc",
   "crit^2 - a/3",
   "ymax + ymin",
   "((1.3)^3 - a*1.3) + ((-1.3)^3 - a*(-1.3))"
  ],
  "oracle": [
   {
    "params": {
     "a": 3,
     "c": 0
    },
    "expect": {
     "crit": 1,
     "ymax": 2,
     "ymin": -2,
     "gap": 4,
     "zone": 4
    }
   },
   {
    "params": {
     "a": 0.75,
     "c": 1
    },
    "expect": {
     "crit": 0.5,
     "ymax": 0.25,
     "ymin": -0.25,
     "gap": 0.5,
     "zone": -0.9375
    }
   },
   {
    "params": {
     "a": 3,
     "c": 3
    },
    "expect": {
     "ymax": 2,
     "zone": -5
    }
   }
  ],
  "tol": 0.000001
 }
}