    "label": "a·xⁿ (x₀=2)",
    "expr": "v1",
    "digits": 6
   },
   {
    "label": "b·xᵐ (x₀=2)",
    "expr": "v2",
    "digits": 6
   },
   {
    "label": "합 (a·xⁿ + b·xᵐ)",
    "expr": "vSum",
    "digits": 6
   },
   {
    "label": "동류항 결합 ((a+b)·xⁿ)",
