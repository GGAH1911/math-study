{
 "id": "equations/high-1/방정식과_부등식/중근과_판별식",
 "spec": {
  "title": "중근과 판별식 — a·b·c 를 움직이며 D = b²−4ac 의 부호가 근을 가르는 것을 본다",
  "params": [
   {
    "name": "a",
    "label": "a (x² 계수)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "b (x 계수)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 2,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "c",
    "label": "c (상수항)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "D = b^2 - 4*a*c; nroot = a == 0 ? 0 : (D > 0.0001 ? 2 : (D < -0.0001 ? 0 : 1)); vx = a == 0 ? 0 : -b/(2*a); vy = a == 0 ? 0 : c - b^2/(4*a)",
  "plot": {
   "range": [
    -6,
    6
   ],
   "yRange": [
    -12,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
    {
     "fn": "a*x^2 + b*x + c",
     "label": "$y = ax^2+bx+c$",
     "color": "#1f77b4"
    }
   ],
   "roots": [
    {
     "fn": "a*x^2 + b*x + c",
     "in": [
      -6,
      "=vx"
     ],
     "label": "근"
    },
    {
     "fn": "a*x^2 + b*x + c",
     "in": [
      "=vx",
      6
     ],
     "label": "근"
    }
   ],
   "points": [
    [
     "=vx",
     "=vy"
    ]
   ],
   "pointsLabel": "꼭짓점 $\\left(-\\frac{b}{2a},\\ c-\\frac{b^2}{4a}\\right)$"
  },
  "readout": [
   {
    "label": "판별식 D = b²−4ac",
    "expr": "D",
    "digits": 2
   },
   {
    "label": "서로 다른 실근의 개수",
    "expr": "nroot",
    "digits": 0
   },
   {
    "label": "꼭짓점 y (축과의 거리)",
    "expr": "vy",
    "digits": 2
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "c": 1
   },
   {
    "a": 1,
    "b": 2,
    "c": 0
   },
   {
    "a": 1,
    "b": 2,
    "c": 3
   },
   {
    "a": -1,
    "b": 2,
    "c": 1
   }
  ],
  "invariants": [
   "D - (b^2 - 4*a*c)"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 1
    },
    "expect": {
     "D": 0,
     "nroot": 1
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 0
    },
    "expect": {
     "D": 4,
     "nroot": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 3
    },
    "expect": {
     "D": -8,
     "nroot": 0
    }
   }
  ],
  "tol": 1e-06
 }
}
