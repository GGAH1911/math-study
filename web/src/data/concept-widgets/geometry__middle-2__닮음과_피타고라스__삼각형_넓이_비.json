     "S2": 6
    }
   },
   {
    "params": {
     "b": 4,
     "h": 2,
     "px": 5
    },
    "expect": {
     "baseRatio": 2,
     "areaRatio": 2,
     "S1": 4,
     "S2": 2
    }
   },
   {
    "params": {
     "b": 3,
     "h": 4,
     "px": 3
    },
    "expect": {
     "baseRatio": 1,
     "areaRatio": 1,
     "S1": 6,
     "S2": 6
    }
   }
