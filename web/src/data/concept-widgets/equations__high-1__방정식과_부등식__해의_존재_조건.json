{
 "id": "equations/high-1/방정식과_부등식/해의_존재_조건",
 "spec": {
  "title": "해의 존재 조건",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "c",
    "label": "c",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": -3,
    "step": 0.1
   }
  ],
  "scope": "D=b^2-4*a*c; vx=-b/(2*a); vy=a*vx^2+b*vx+c; r1=((a != 0) and (D >= 0)) ? (-b + sqrt(D))/(2*a) : NaN; r2=((a != 0) and (D >= 0)) ? (-b - sqrt(D))/(2*a) : NaN",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -10,
    10
   ],
   "fns": [
    {
     "fn": "a*x^2+b*x+c",
     "label": "y = ax² + bx + c",
     "color": "#2196F3"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D",
    "expr": "D",
    "digits": 2
   },
   {
    "label": "실근 개수",
    "expr": "a == 0 ? (b == 0 ? 0 : 1) : (D > 0 ? 2 : (D == 0 ? 1 : 0))",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "c": -3
   },
   {
    "a": 1,
    "b": 2,
    "c": 1
   },
   {
    "a": 2,
    "b": -3,
    "c": 1
   },
   {
    "a": 0,
    "b": 1,
    "c": 2
   }
  ],
  "invariants": [
   "((a != 0) and (D >= 0)) ? abs(r1 + r2 + b/a) + abs(r1 * r2 - c/a) : 0",
   "(a != 0) ? abs(vy + D/(4*a)) : 0"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": -3
    },
    "expect": {
     "D": 16,
     "r1": 1,
     "r2": -3
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2,
     "c": 1
    },
    "expect": {
     "D": 0,
     "r1": -1,
     "r2": -1
    }
   },
   {
    "params": {
     "a": 2,
     "b": -4,
     "c": 2
    },
    "expect": {
     "D": 0,
     "r1": 1,
     "r2": 1
    }
   }
  ],
  "tol": 0.000001
 }
}