{
 "id": "함수의_교점_판정",
 "spec": {
  "title": "함수의 교점 판정",
  "params": [
   {
    "name": "a",
    "label": "기울기 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   },
   {
    "name": "b",
    "label": "y절편 b",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "D = a^2 + 4*b; n = D>0 ? 2 : (D==0 ? 1 : 0); x1 = D>=0 ? (a+sqrt(D))/2 : 0; x2 = D>=0 ? (a-sqrt(D))/2 : 0;",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -6,
    10
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -6,
    10
   ],
   "fns": [
    {
     "fn": "x^2",
     "label": "f(x)=x²",
     "color": "blue"
    },
    {
     "fn": "a*x+b",
     "label": "g(x)=ax+b",
     "color": "red"
    },
    {
     "fn": "x^2 - a*x - b",
     "label": "h(x)=f(x)-g(x)",
     "color": "green"
    }
   ]
  },
  "readout": [
   {
    "label": "판별식 D",
    "expr": "D",
    "digits": 3
   },
   {
    "label": "교점(=실근) 개수",
    "expr": "n",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 1
   },
   {
    "a": 0,
    "b": 0
   },
   {
    "a": 1,
    "b": 0
   },
   {
    "a": 0,
    "b": -1
   }
  ],
  "invariants": [
   "abs(D - (a^2 + 4*b))",
   "abs(n - (D>0 ? 2 : (D<0 ? 0 : 1)))",
   "n>0 ? abs(x1^2 - a*x1 - b) : 0",
   "n>0 ? abs(x2^2 - a*x2 - b) : 0",
   "n>0 ? abs(x1 + x2 - a) : 0",
   "n>0 ? abs(x1 * x2 + b) : 0",
   "n>1 ? abs((x1 - x2) - sqrt(D)) : 0"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 1
    },
    "expect": {
     "D": 4,
     "n": 2,
     "x1": 1,
     "x2": -1
    }
   },
   {
    "params": {
     "a": 0,
     "b": 0
    },
    "expect": {
     "D": 0,
     "n": 1,
     "x1": 0,
     "x2": 0
    }
   },
   {
    "params": {
     "a": 1,
     "b": 0
    },
    "expect": {
     "D": 1,
     "n": 2,
     "x1": 1,
     "x2": 0
    }
   }
  ],
  "tol": 0.000001
 }
}