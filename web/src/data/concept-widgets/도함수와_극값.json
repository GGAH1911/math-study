{
 "id": "도함수와_극값",
 "spec": {
  "title": "도함수와 극값",
  "params": [
   {
    "name": "p",
    "label": "p (극값 간격)",
    "type": "slider",
    "min": 0.2,
    "max": 2,
    "init": 1,
    "step": 0.05,
    "unit": ""
   },
   {
    "name": "q",
    "label": "q (세로 이동)",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "max_x=-sqrt(p); max_y=max_x^3 - 3*p*max_x + q; min_x=sqrt(p); min_y=min_x^3 - 3*p*min_x + q",
  "geometry": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -9,
    12
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -9,
    12
   ],
   "fns": [
    {
     "fn": "x^3 - 3*p*x + q",
     "label": "f(x)",
     "color": "#1f77b4"
    },
    {
     "fn": "3*x^2 - 3*p",
     "label": "f'(x)",
     "color": "#d62728"
    }
   ]
  },
  "readout": [
   {
    "label": "극대 x",
    "expr": "max_x",
    "digits": 4
   },
   {
    "label": "극대 y",
    "expr": "max_y",
    "digits": 4
   },
   {
    "label": "극소 x",
    "expr": "min_x",
    "digits": 4
   },
   {
    "label": "극소 y",
    "expr": "min_y",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 0.25,
    "q": -1
   },
   {
    "p": 1,
    "q": 0
   },
   {
    "p": 1.5,
    "q": 0.5
   },
   {
    "p": 0.7,
    "q": 1.2
   }
  ],
  "invariants": [
   "max_x^2 - p",
   "min_x^2 - p",
   "max_x + min_x",
   "max_y - (2*p*sqrt(p) + q)",
   "min_y - (-2*p*sqrt(p) + q)",
   "max_y - min_y - 4*p*sqrt(p)"
  ],
  "oracle": [
   {
    "params": {
     "p": 0.25,
     "q": -1
    },
    "expect": {
     "max_x": -0.5,
     "max_y": -0.75,
     "min_x": 0.5,
     "min_y": -1.25
    }
   },
   {
    "params": {
     "p": 1,
     "q": 0
    },
    "expect": {
     "max_x": -1,
     "max_y": 2,
     "min_x": 1,
     "min_y": -2
    }
   },
   {
    "params": {
     "p": 1,
     "q": 0.5
    },
    "expect": {
     "max_x": -1,
     "max_y": 2.5,
     "min_x": 1,
     "min_y": -1.5
    }
   }
  ],
  "tol": 0.000001
 }
}