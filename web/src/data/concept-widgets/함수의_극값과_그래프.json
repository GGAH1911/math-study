{
 "id": "함수의_극값과_그래프",
 "spec": {
  "title": "함수의 극값과 그래프",
  "params": [
   {
    "name": "a",
    "label": "a",
    "type": "slider",
    "min": 0.1,
    "max": 5,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "b",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 1
   }
  ],
  "scope": "max_x=-sqrt(a); min_x=sqrt(a); max_y=2*a^(3/2)+b; min_y=-2*a^(3/2)+b",
  "plot": {
   "range": [
    -5,
    5
   ],
   "yRange": [
    -30,
    30
   ],
   "fns": [
    {
     "fn": "x^3 - 3*a*x + b",
     "label": "f(x)",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "극대점 x",
    "expr": "max_x",
    "digits": 3
   },
   {
    "label": "극대점 y",
    "expr": "max_y",
    "digits": 3
   },
   {
    "label": "극소점 x",
    "expr": "min_x",
    "digits": 3
   },
   {
    "label": "극소점 y",
    "expr": "min_y",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 0
   },
   {
    "a": 1,
    "b": 2
   },
   {
    "a": 4,
    "b": -1
   },
   {
    "a": 4,
    "b": 2
   }
  ],
  "invariants": [
   "abs(max_y - (max_x^3 - 3*a*max_x + b))",
   "abs(min_y - (min_x^3 - 3*a*min_x + b))",
   "abs(3*max_x^2 - 3*a)",
   "abs(3*min_x^2 - 3*a)",
   "abs((max_y - min_y) - 4*a^(3/2))"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 0
    },
    "expect": {
     "max_x": -1,
     "max_y": 2,
     "min_x": 1,
     "min_y": -2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "max_x": -1,
     "max_y": 4,
     "min_x": 1,
     "min_y": 0
    }
   },
   {
    "params": {
     "a": 4,
     "b": -1
    },
    "expect": {
     "max_x": -2,
     "max_y": 15,
     "min_x": 2,
     "min_y": -17
    }
   },
   {
    "params": {
     "a": 4,
     "b": 2
    },
    "expect": {
     "max_x": -2,
     "max_y": 18,
     "min_x": 2,
     "min_y": -14
    }
   }
  ],
  "tol": 0.000001
 }
}