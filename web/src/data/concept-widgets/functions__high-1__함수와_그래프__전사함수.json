{
 "id": "functions/high-1/함수와_그래프/전사함수",
 "spec": {
  "title": "전사함수 탐구: 공역의 모든 값이 원상을 가진다 (f(x)=x³, ℝ→ℝ)",
  "params": [
   {
    "name": "b",
    "label": "공역에서 고른 값 b",
    "type": "slider",
    "min": -8,
    "max": 8,
    "init": 3,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "a = sign(b)*abs(b)^(1/3); fa = a^3; gap = fa - b",
  "geometry": {
   "range": [
    -2.1,
    2.1
   ],
   "yRange": [
    -9.5,
    9.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=a",
      0
     ],
     "to": [
      "=a",
      "=b"
     ]
    },
    {
     "type": "point",
     "at": [
      "=a",
      "=b"
     ],
     "label": "P(a, b)"
    },
    {
     "type": "point",
     "at": [
      "=a",
      0
     ],
     "label": "a (정의역)"
    },
    {
     "type": "point",
     "at": [
      0,
      "=b"
     ],
     "label": "b (공역)"
    }
   ]
  },
  "plot": {
   "range": [
    -2.1,
    2.1
   ],
   "yRange": [
    -9.5,
    9.5
   ],
   "fns": [
    {
     "fn": "x^3",
     "label": "f(x)=x³",
     "color": "#2563eb"
    },
    {
     "fn": "b",
     "label": "y = b (공역에서 고른 높이)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "공역 값 b",
    "expr": "b",
    "digits": 2
   },
   {
    "label": "원상 a = ∛b",
    "expr": "a",
    "digits": 3
   },
   {
    "label": "f(a) = a³ (b와 일치해야)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "오차 f(a) − b (항상 0)",
    "expr": "gap",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": 8
   },
   {
    "b": -8
   },
   {
    "b": 2
   },
   {
    "b": 0
   }
  ],
  "invariants": [
   "fa - b",
   "a^3 - b"
  ],
  "oracle": [
   {
    "params": {
     "b": 8
    },
    "expect": {
     "a": 2,
     "fa": 8
    }
   },
   {
    "params": {
     "b": -1
    },
    "expect": {
     "a": -1,
     "fa": -1
    }
   },
   {
    "params": {
     "b": 0.125
    },
    "expect": {
     "a": 0.5,
     "fa": 0.125
    }
   }
  ],
  "tol": 0.000001
 }
}