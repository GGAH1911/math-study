{
 "id": "functions/high-1/함수와_그래프/대칭이동",
 "spec": {
  "title": "대칭이동: x축·y축·원점 대칭",
  "params": [
   {
    "name": "b",
    "label": "일차항 계수 b",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1,
    "unit": ""
   }
  ],
  "scope": "x0=1; yorig=0.4*x0^2+b*x0; fm=0.4*x0^2-b*x0; yxax=-(0.4*x0^2+b*x0); yyax=0.4*x0^2-b*x0; yori=-(0.4*x0^2-b*x0)",
  "geometry": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -4,
    4
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    -3,
    3
   ],
   "yRange": [
    -4,
    4
   ],
   "fns": [
    {
     "fn": "0.4*x^2 + b*x",
     "label": "y=f(x) (원본)",
     "color": "#2563eb"
    },
    {
     "fn": "-(0.4*x^2 + b*x)",
     "label": "x축 대칭 y=-f(x)",
     "color": "#dc2626"
    },
    {
     "fn": "0.4*x^2 - b*x",
     "label": "y축 대칭 y=f(-x)",
     "color": "#16a34a"
    },
    {
     "fn": "-(0.4*x^2 - b*x)",
     "label": "원점 대칭 y=-f(-x)",
     "color": "#9333ea"
    }
   ]
  },
  "readout": [
   {
    "label": "f(1)",
    "expr": "yorig",
    "digits": 3
   },
   {
    "label": "x축대칭 값(1) = -f(1)",
    "expr": "yxax",
    "digits": 3
   },
   {
    "label": "y축대칭 값(1) = f(-1)",
    "expr": "yyax",
    "digits": 3
   },
   {
    "label": "원점대칭 값(1) = -f(-1)",
    "expr": "yori",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "b": -2
   },
   {
    "b": 0
   },
   {
    "b": 1
   },
   {
    "b": 2
   }
  ],
  "invariants": [
   "yxax + yorig",
   "yyax - fm",
   "yori + fm",
   "yori + yyax"
  ],
  "oracle": [
   {
    "params": {
     "b": 1
    },
    "expect": {
     "yorig": 1.4,
     "fm": -0.6,
     "yxax": -1.4,
     "yyax": -0.6,
     "yori": 0.6
    }
   },
   {
    "params": {
     "b": 2
    },
    "expect": {
     "yorig": 2.4,
     "fm": -1.6,
     "yxax": -2.4,
     "yyax": -1.6,
     "yori": 1.6
    }
   },
   {
    "params": {
     "b": 0
    },
    "expect": {
     "yorig": 0.4,
     "fm": 0.4,
     "yxax": -0.4,
     "yyax": 0.4,
     "yori": -0.4
    }
   }
  ],
  "tol": 0.000001
 }
}