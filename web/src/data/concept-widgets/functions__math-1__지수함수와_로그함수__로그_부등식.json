{
 "id": "functions/math-1/지수함수와_로그함수/로그_부등식",
 "spec": {
  "title": "로그 부등식: 밑 a에 따른 부등호 방향",
  "params": [
   {
    "name": "a",
    "label": "밑 a",
    "type": "slider",
    "min": 0.2,
    "max": 5,
    "init": 2,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "기준값 b",
    "type": "slider",
    "min": -2,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "xc = a^b; incr = a - 1",
  "plot": {
   "range": [
    0.01,
    8
   ],
   "yRange": [
    -3.2,
    3.2
   ],
   "fns": [
    {
     "fn": "log(x, a)",
     "label": "y = log_a x",
     "color": "#2563eb"
    },
    {
     "fn": "b",
     "label": "y = b",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "임계값 x₀ = aᵇ",
    "expr": "xc",
    "digits": 4
   },
   {
    "label": "log_a(x₀) — b와 같은지 확인",
    "expr": "log(xc, a)",
    "digits": 4
   },
   {
    "label": "증가함수(+1)/감소함수(−1)",
    "expr": "sign(incr)",
    "digits": 0
   },
   {
    "label": "log_a x > b 의 해: x>x₀(+) / 0<x<x₀(−)",
    "expr": "sign(incr)",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": 1
   },
   {
    "a": 2,
    "b": 3
   },
   {
    "a": 0.5,
    "b": 1
   },
   {
    "a": 3,
    "b": 0
   }
  ],
  "invariants": [
   "log(xc, a) - b",
   "log(xc, a) - log(xc)/log(a)"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": 1
    },
    "expect": {
     "xc": 2
    }
   },
   {
    "params": {
     "a": 0.5,
     "b": 1
    },
    "expect": {
     "xc": 0.5
    }
   },
   {
    "params": {
     "a": 3,
     "b": 0
    },
    "expect": {
     "xc": 1
    }
   }
  ],
  "tol": 0.000001
 }
}