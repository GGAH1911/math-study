{
 "id": "기하를_이용한_극한",
 "spec": {
  "title": "기하를 이용한 극한: 단위원과 끼인 정리",
  "params": [
   {
    "name": "deg",
    "label": "θ (도)",
    "type": "slider",
    "min": 0.5,
    "max": 60,
    "init": 30,
    "step": 0.5,
    "unit": "°"
   },
   {
    "name": "r",
    "label": "반지름 r",
    "type": "slider",
    "min": 0.5,
    "max": 2,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "L",
    "label": "목표 비율 L",
    "type": "slider",
    "min": 0.7,
    "max": 0.999,
    "init": 0.99,
    "step": 0.001
   }
  ],
  "scope": "rad = deg * pi / 180; cx = cos(rad); sy = sin(rad); ty = tan(rad); ratio = rad > 0 ? sy / rad : 1; px = r * cx; py = r * sy; qy = r * ty; area_small = 0.5 * r^2 * sy; area_sector = 0.5 * r^2 * rad; area_large = 0.5 * r^2 * ty",
