   "rad - deg*pi/180",
   "px - r*cx",
   "py - r*sy",
   "qy - r*ty",
   "area_small - 0.5*r^2*sy",
   "area_sector - 0.5*r^2*rad",
   "area_large - 0.5*r^2*ty",
   "ratio - sy/rad",
   "(area_small - area_sector) + abs(area_small - area_sector)",
   "(area_sector - area_large) + abs(area_sector - area_large)",
   "(cx - ratio) + abs(cx - ratio)",
   "(ratio - 1) + abs(ratio - 1)"
  ],
