{
 "id": "기하를_이용한_극한",
 "spec": {
  "title": "기하를 이용한 극한: 단위원과 끼인 정리",
  "params": [
   {
    "name": "deg",
    "label": "θ (도)",
    "type": "slider",
    "min": 0,
    "max": 60,
    "init": 30,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "rad = deg * pi / 180; cx = cos(rad); sy = sin(rad); ty = tan(rad); area_small = 0.5 * sy; area_sector = 0.5 * rad; area_large = 0.5 * ty",
  "geometry": {
   "range": [
    -1.5,
    1.5
   ],
   "yRange": [
    -1.5,
    2
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "circle",
     "center": [
      0,
      0
     ],
     "radius": 1
    },
    {
     "type": "polygon",
     "vertices": [
      [
       0,
       0
      ],
      [
       1,
       0
      ],
      [
       "=cx",
       "=sy"
      ]
     ]
    },
    {
     "type": "polygon",
     "vertices": [
      [
       0,
       0
      ],
      [
       1,
       0
      ],
      [
       1,
       "=ty"
      ]
     ]
    },
    {
     "type": "point",
     "at": [
      0,
      0
     ],
     "label": "O"
    },
    {
     "type": "point",
     "at": [
      1,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "at": [
      "=cx",
      "=sy"
     ],
     "label": "P"
    },
    {
     "type": "point",
     "at": [
      1,
      "=ty"
     ],
     "label": "T"
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      1,
      0
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      "=cx",
      "=sy"
     ]
    },
    {
     "type": "segment",
     "from": [
      0,
      0
     ],
     "to": [
      1,
      "=ty"
     ]
    }
   ]
  },
  "plot": {
   "range": [
    0,
    1.2
   ],
   "yRange": [
    0,
    2
   ],
   "fns": [
    {
     "fn": "sin(x)",
     "label": "sin x",
     "color": "blue"
    },
    {
     "fn": "x",
     "label": "x",
     "color": "red"
    },
    {
     "fn": "tan(x)",
     "label": "tan x",
     "color": "green"
    }
   ]
  },
  "readout": [
   {
    "label": "sin θ",
    "expr": "sy",
    "digits": 4
   },
   {
    "label": "θ (rad)",
    "expr": "rad",
    "digits": 4
   },
   {
    "label": "tan θ",
    "expr": "ty",
    "digits": 4
   },
   {
    "label": "sin θ / θ",
    "expr": "sy / rad",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "deg": 5
   },
   {
    "deg": 20
   },
   {
    "deg": 40
   },
   {
    "deg": 60
   }
  ],
  "invariants": [
   "cx^2 + sy^2 - 1",
   "ty - sy/cx",
   "rad - deg*pi/180",
   "area_small - 0.5*sy",
   "area_sector - 0.5*rad",
   "area_large - 0.5*ty"
  ],
  "oracle": [
   {
    "params": {
     "deg": 30
    },
    "expect": {
     "rad": 0.5235987755982988,
     "sy": 0.5,
     "cx": 0.8660254037844386,
     "ty": 0.5773502691896257,
