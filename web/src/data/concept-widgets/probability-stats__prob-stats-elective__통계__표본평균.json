{
 "id": "probability-stats/prob-stats-elective/통계/표본평균",
 "spec": {
  "title": "표본평균의 표집분포",
  "params": [
   {
    "name": "n",
    "label": "표본 크기 n",
    "type": "slider",
    "min": 1,
    "max": 100,
    "init": 10,
    "step": 1
   },
   {
    "name": "mu",
    "label": "모평균 μ",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "sigma",
    "label": "모표준편차 σ",
    "type": "slider",
    "min": 0.1,
    "max": 3,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "se=sigma/sqrt(n); var_xbar=sigma^2/n; density_at_mu=1/(se*sqrt(2*pi))*exp(-0.5*((mu-mu)/se)^2); f_plus=1/(se*sqrt(2*pi))*exp(-0.5*((mu+1-mu)/se)^2); f_minus=1/(se*sqrt(2*pi))*exp(-0.5*((mu-1-mu)/se)^2)",
  "plot": {
   "range": [
    "=mu-4*sigma",
    "=mu+4*sigma"
   ],
   "yRange": [
    0,
    "=1.2/(se*sqrt(2*pi))"
   ],
   "fns": [
    {
     "fn": "1/(se*sqrt(2*pi))*exp(-0.5*((x-mu)/se)^2)",
     "label": "표본평균 x̄의 분포",
     "color": "blue"
    },
    {
     "fn": "1/(sigma*sqrt(2*pi))*exp(-0.5*((x-mu)/sigma)^2)",
     "label": "모집단 분포",
     "color": "red"
    }
   ]
  },
  "readout": [
   {
    "label": "모평균 μ",
    "expr": "mu",
    "digits": 2
   },
   {
    "label": "표본평균의 기댓값 E(x̄)",
    "expr": "mu",
    "digits": 2
   },
   {
    "label": "표본평균의 분산 V(x̄)",
    "expr": "var_xbar",
    "digits": 4
   },
   {
    "label": "표준오차 σ/√n",
    "expr": "se",
    "digits": 4
   },
   {
    "label": "분포의 최댓값 (x=μ)",
    "expr": "density_at_mu",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 1,
    "mu": 0,
    "sigma": 1
   },
   {
    "n": 4,
    "mu": 0,
    "sigma": 1
   },
   {
    "n": 10,
    "mu": 2,
    "sigma": 0.5
   },
   {
    "n": 25,
    "mu": -1,
    "sigma": 2
   }
  ],
  "invariants": [
   "f_plus - f_minus",
   "se^2*n - sigma^2"
  ],
  "oracle": [
   {
    "params": {
     "n": 1,
     "mu": 0,
     "sigma": 1
    },
    "expect": {
     "se": 1,
     "var_xbar": 1,
     "density_at_mu": 0.3989422804014327
    }
   },
   {
    "params": {
     "n": 4,
     "mu": 0,
     "sigma": 1
    },
    "expect": {
     "se": 0.5,
     "var_xbar": 0.25,
     "density_at_mu": 0.7978845608028654
    }
   },
   {
    "params": {
     "n": 2,
     "mu": 2,
     "sigma": 1
    },
    "expect": {
     "se": 0.7071067811865476,
     "var_xbar": 0.5,
     "density_at_mu": 0.5641895835477563
    }
   }
  ],
  "tol": 0.000001
 }
}