     "color": "#4a90d9"
    },
    {
     "fn": "x",
     "label": "$y = x$",
     "color": "#8a8a8a",
     "dashed": true
    }
   ],
   "intersections": [
    {
     "f": "n/x",
     "g": "x",
     "in": [
      0.5,
      13
     ],
     "label": "$x=\\sqrt{n}$"
    }
   ],
   "points": [
    ["=p2x", "=p2y"],
    ["=p3x", "=p3y"],
    ["=p4x", "=p4y"],
    ["=p5x", "=p5y"],
    ["=p6x", "=p6y"],
    ["=p7x", "=p7y"],
    ["=p8x", "=p8y"],
    ["=p9x", "=p9y"],
    ["=p10x", "=p10y"],
    ["=dx", "=dy"],
    ["=prx", "=pry"]
   ],
   "pointsLabel": "$(a,\\ n/a)$ — 격자점이면 $a$ 는 약수"
  },
  "readout": [
   {
    "label": "n",
    "expr": "n"
   },
   {
    "label": "⌊√n⌋",
    "expr": "s",
    "digits": 0
   },
   {
    "label": "n ÷ d",
    "expr": "q",
    "digits": 3
   },
   {
    "label": "d로 나누어떨어짐 (1=예)",
    "expr": "isDivD",
    "digits": 0
   },
   {
    "label": "√n 이하 약수 개수",
    "expr": "sumDiv",
    "digits": 0
   },
   {
    "label": "소수 여부 (1=소수)",
    "expr": "isPrime",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
