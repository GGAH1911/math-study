    "max": 12,
    "init": 2,
    "step": 1
   }
  ],
  "scope": "s=floor(sqrt(n)); i2=(2<=s and mod(n,2)==0)?1:0; i3=(3<=s and mod(n,3)==0)?1:0; i4=(4<=s and mod(n,4)==0)?1:0; i5=(5<=s and mod(n,5)==0)?1:0; i6=(6<=s and mod(n,6)==0)?1:0; i7=(7<=s and mod(n,7)==0)?1:0; i8=(8<=s and mod(n,8)==0)?1:0; i9=(9<=s and mod(n,9)==0)?1:0; i10=(10<=s and mod(n,10)==0)?1:0; sumDiv=i2+i3+i4+i5+i6+i7+i8+i9+i10; isPrime=(n>=2 and sumDiv==0)?1:0; p2x=(i2==1)?2:999; p2y=(i2==1)?n/2:999; p3x=(i3==1)?3:999; p3y=(i3==1)?n/3:999; p4x=(i4==1)?4:999; p4y=(i4==1)?n/4:999; p5x=(i5==1)?5:999; p5y=(i5==1)?n/5:999; p6x=(i6==1)?6:999; p6y=(i6==1)?n/6:999; p7x=(i7==1)?7:999; p7y=(i7==1)?n/7:999; p8x=(i8==1)?8:999; p8y=(i8==1)?n/8:999; p9x=(i9==1)?9:999; p9y=(i9==1)?n/9:999; p10x=(i10==1)?10:999; p10y=(i10==1)?n/10:999; q=n/d; isDivD=(mod(n,d)==0)?1:0; dLE=(d<=s)?1:0; dx=d; dy=n/d; prx=(isDivD==1 and n/d<=12)?n/d:999; pry=(isDivD==1 and n/d<=12)?d:999",
  "plot": {
   "range": [
    0.5,
    13
   ],
   "yRange": [
    0,
    65
   ],
   "showAxes": true,
   "showGrid": true,
   "fns": [
