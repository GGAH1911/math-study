{
 "id": "logic/high-1/집합과_명제/원소_조건",
 "spec": {
  "title": "원소 조건 탐구: A = {x | |x-a| ≤ b}",
  "params": [
   {
    "name": "a",
    "label": "중심 a",
    "type": "slider",
    "min": -3,
    "max": 3,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "반지름 b",
    "type": "slider",
    "min": 0,
    "max": 3,
    "init": 1,
    "step": 0.1
   },
   {
    "name": "x",
    "label": "검사 원소 x",
    "type": "slider",
    "min": -4,
    "max": 4,
    "init": 0,
    "step": 0.1
   }
  ],
  "scope": "left = a - b; right = a + b; d = abs(x - a) - b; inside = (d <= 0) ? 1 : 0; inside_interval = ((x >= left and x <= right) ? 1 : 0)",
  "geometry": {
   "range": [
    -4,
    4
   ],
   "yRange": [
    -1,
    1
   ],
   "showAxes": true,
   "showGrid": false,
   "shapes": [
    {
     "type": "segment",
     "from": [
      "=left",
      0
     ],
     "to": [
      "=right",
      0
     ]
    },
    {
     "type": "point",
     "at": [
      "=left",
      0
     ],
     "label": "a-b"
    },
    {
     "type": "point",
     "at": [
      "=right",
      0
     ],
     "label": "a+b"
    },
    {
     "type": "point",
     "at": [
      "=x",
      "=inside*0.6-0.3"
     ],
     "label": "x"
    }
   ]
  },
  "readout": [
   {
    "label": "|x-a|-b",
    "expr": "d"
   },
   {
    "label": "x∈A? (1=예,0=아니오)",
    "expr": "inside"
   },
   {
    "label": "좌측 경계",
    "expr": "left"
   },
   {
    "label": "우측 경계",
    "expr": "right"
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 1,
    "b": 2,
    "x": 0
   },
   {
    "a": -1,
    "b": 0.5,
    "x": 2
   },
   {
    "a": 0,
    "b": 3,
    "x": -3
   },
   {
    "a": 2,
    "b": 1,
    "x": 2
   }
  ],
  "invariants": [
   "inside - inside_interval"
  ],
  "oracle": [
   {
    "params": {
     "a": 1,
     "b": 2,
     "x": 0
    },
    "expect": {
     "inside": 1,
     "left": -1,
     "right": 3
    }
   },
   {
    "params": {
     "a": 0,
     "b": 1,
     "x": 2
    },
    "expect": {
     "inside": 0,
     "left": -1,
     "right": 1
    }
   },
   {
    "params": {
     "a": -2,
     "b": 2,
     "x": -2
    },
    "expect": {
     "inside": 1,
     "left": -4,
     "right": 0
    }
   }
  ],
  "tol": 0.000001
 }
}