      ]
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "n",
    "expr": "n",
    "digits": 0
   },
   {
    "label": "r",
    "expr": "r_eff",
    "digits": 0
   },
   {
    "label": "nPr",
    "expr": "P",
    "digits": 0
   },
   {
    "label": "곱의 계산",
    "expr": "prod",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "n": 5,
    "r": 3
   },
   {
    "n": 4,
    "r": 2
   },
   {
    "n": 6,
    "r": 6
   },
   {
    "n": 2,
    "r": 1
   },
   {
    "n": 3,
    "r": 0
   }
  ],
  "invariants": [
   "abs(P-prod)"
  ],
  "oracle": [
   {
    "params": {
     "n": 5,
     "r": 3
    },
    "expect": {
     "P": 60,
     "prod": 60,
     "r_eff": 3
    }
   },
   {
