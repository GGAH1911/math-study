{
 "id": "probability-stats/high-1/경우의_수_고1/순열",
 "spec": {
  "title": "순열 nPr의 기하적 의미: 선택 단계별 경우의 수",
  "params": [
   {
    "name": "n",
    "label": "n (전체 원소 수)",
    "type": "slider",
    "min": 1,
    "max": 6,
    "init": 5,
    "step": 1
   },
   {
    "name": "r",
    "label": "r (선택 개수)",
    "type": "slider",
    "min": 0,
    "max": 6,
    "init": 3,
    "step": 1
   }
  ],
  "scope": "r_eff = min(r,n); P = factorial(n) / factorial(n - r_eff); prod = 1; prod = r_eff>=1 ? prod*n : prod; prod = r_eff>=2 ? prod*(n-1) : prod; prod = r_eff>=3 ? prod*(n-2) : prod; prod = r_eff>=4 ? prod*(n-3) : prod; prod = r_eff>=5 ? prod*(n-4) : prod; prod = r_eff>=6 ? prod*(n-5) : prod; w1 = r_eff>=1 ? n : 0; w2 = r_eff>=2 ? max(0,n-1) : 0; w3 = r_eff>=3 ? max(0,n-2) : 0; w4 = r_eff>=4 ? max(0,n-3) : 0; w5 = r_eff>=5 ? max(0,n-4) : 0; w6 = r_eff>=6 ? max(0,n-5) : 0;",
  "geometry": {
   "range": [
    -0.5,
    7.5
   ],
   "yRange": [
    -0.5,
    7.5
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
