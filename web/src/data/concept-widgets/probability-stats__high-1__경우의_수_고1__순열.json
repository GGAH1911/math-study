      [
       "=1",
       "=0.6"
      ],
      [
       "=1+w1",
       "=0.6"
      ],
      [
       "=1+w1",
       "=1.4"
      ],
      [
       "=1",
       "=1.4"
      ]
     ]
    },
    {
