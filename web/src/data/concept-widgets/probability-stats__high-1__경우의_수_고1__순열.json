     "vertices": [
      [
       "=1",
       "=1.6"
      ],
      [
       "=1+w2",
       "=1.6"
      ],
      [
       "=1+w2",
       "=2.4"
      ],
      [
       "=1",
       "=2.4"
      ]
     ]
    },
    {
     "type": "polygon",
     "vertices": [
      [
       "=1",
       "=2.6"
      ],
      [
       "=1+w3",
       "=2.6"
      ],
      [
