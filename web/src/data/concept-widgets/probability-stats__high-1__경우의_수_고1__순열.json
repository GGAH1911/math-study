      [
       "=1+w5",
       "=4.6"
      ],
      [
       "=1+w5",
       "=5.4"
      ],
      [
       "=1",
       "=5.4"
      ]
     ]
    },
    {
     "type": "polygon",
     "vertices": [
      [
       "=1",
       "=5.6"
      ],
      [
       "=1+w6",
