{
 "id": "functions/calculus/도함수의_활용_심화/절댓값함수의_극값",
 "spec": {
  "title": "절댓값함수의 극값: f(x)=|x²−c|",
  "params": [
   {
    "name": "c",
    "label": "c (원래 함수 g=x²−c의 아래로 내린 정도)",
    "type": "slider",
    "min": 0.2,
    "max": 4,
    "init": 2,
    "step": 0.1
   }
  ],
  "scope": "xc = sqrt(c); g0 = -c; fmax = abs(g0); fcusp = abs(xc^2 - c)",
  "plot": {
   "range": [
    -2.6,
    2.6
   ],
   "yRange": [
    -4.5,
    5
   ],
   "fns": [
    {
     "fn": "x^2 - c",
     "label": "g(x)=x²−c (원래 함수)",
     "color": "#9ca3af"
    },
    {
     "fn": "abs(x^2 - c)",
     "label": "f(x)=|x²−c|",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "극댓값 f(0)=c",
    "expr": "fmax",
    "digits": 3
   },
   {
    "label": "극솟값(첨점) f(±√c)",
    "expr": "fcusp",
    "digits": 3
   },
   {
    "label": "첨점 x좌표 √c",
    "expr": "xc",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "c": 1
   },
   {
    "c": 4
   },
   {
    "c": 0.25
   },
   {
    "c": 2
   }
  ],
  "invariants": [
   "xc^2 - c",
   "fcusp",
   "fmax - c"
  ],
  "oracle": [
   {
    "params": {
     "c": 1
    },
    "expect": {
     "xc": 1,
     "fmax": 1,
     "fcusp": 0
    }
   },
   {
    "params": {
     "c": 4
    },
    "expect": {
     "xc": 2,
     "fmax": 4,
     "fcusp": 0
    }
   },
   {
    "params": {
     "c": 0.25
    },
    "expect": {
     "xc": 0.5,
     "fmax": 0.25,
     "fcusp": 0
    }
   }
  ],
  "tol": 0.000001
 }
}