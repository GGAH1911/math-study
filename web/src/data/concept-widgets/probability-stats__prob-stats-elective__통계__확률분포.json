{
 "id": "probability-stats/prob-stats-elective/통계/확률분포",
 "spec": {
  "title": "이산확률분포 (이항분포 n=3)",
  "params": [
   {
    "name": "p",
    "label": "성공확률 p",
    "type": "slider",
    "min": 0,
    "max": 1,
    "init": 0.5,
    "step": 0.01
   }
  ],
  "scope": "q=1-p; p0=q^3; p1=3*p*q^2; p2=3*p^2*q; p3=p^3; sump=p0+p1+p2+p3; mean=0*p0+1*p1+2*p2+3*p3",
  "geometry": {
   "range": [
    -1,
    4
   ],
   "yRange": [
    0,
    1.2
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": [
    {
     "type": "polygon",
     "points": [
      [
       -0.35,
       0
      ],
      [
       -0.35,
       "=p0"
      ],
      [
       0.35,
       "=p0"
      ],
      [
       0.35,
       0
      ]
     ]
    },
    {
     "type": "polygon",
     "points": [
      [
       0.65,
       0
      ],
      [
       0.65,
       "=p1"
      ],
      [
       1.35,
       "=p1"
      ],
      [
       1.35,
       0
      ]
     ]
    },
    {
     "type": "polygon",
     "points": [
      [
       1.65,
       0
      ],
      [
       1.65,
       "=p2"
      ],
      [
       2.35,
       "=p2"
      ],
      [
       2.35,
       0
      ]
     ]
    },
    {
     "type": "polygon",
     "points": [
      [
       2.65,
       0
      ],
      [
       2.65,
       "=p3"
      ],
      [
       3.35,
       "=p3"
      ],
      [
       3.35,
       0
      ]
     ]
    }
   ]
  },
  "readout": [
   {
    "label": "P(X=0)",
    "expr": "p0",
    "digits": 6
   },
   {
    "label": "P(X=1)",
    "expr": "p1",
    "digits": 6
   },
   {
    "label": "P(X=2)",
    "expr": "p2",
    "digits": 6
   },
   {
    "label": "P(X=3)",
    "expr": "p3",
    "digits": 6
   },
   {
    "label": "합계",
    "expr": "sump",
    "digits": 6
   },
   {
    "label": "기대값",
    "expr": "mean",
    "digits": 6
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "p": 0.2
   },
   {
    "p": 0.5
   },
   {
    "p": 0.7
   },
   {
    "p": 0.9
   }
  ],
  "invariants": [
   "sump - 1",
   "(0*p0 + 1*p1 + 2*p2 + 3*p3) - 3*p"
  ],
  "oracle": [
   {
    "params": {
     "p": 0.5
    },
    "expect": {
     "p0": 0.125,
     "p1": 0.375,
     "p2": 0.375,
     "p3": 0.125,
     "sump": 1,
     "mean": 1.5
    }
   },
   {
    "params": {
     "p": 0.3
    },
    "expect": {
     "p0": 0.343,
     "p1": 0.441,
     "p2": 0.189,
     "p3": 0.027,
     "sump": 1,
     "mean": 0.9
    }
   }
  ],
  "tol": 0.000001
 }
}