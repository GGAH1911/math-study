 "spec": {
  "title": "타원의 초점과 꼭짓점",
  "params": [
   {
    "name": "a",
    "label": "a (장반경)",
    "type": "slider",
    "min": 2,
    "max": 5,
    "init": 3,
    "step": 0.1
   },
