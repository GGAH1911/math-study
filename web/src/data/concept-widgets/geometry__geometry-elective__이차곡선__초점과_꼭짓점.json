    "type": "slider",
    "min": 0,
    "max": 360,
    "init": 90,
    "step": 1,
    "unit": "°"
   }
  ],
  "scope": "b=a*sqrt(1-e^2); c=a*e; t=theta*pi/180; px=a*cos(t); py=b*sin(t); d1=sqrt((px-c)^2+py^2); d2=sqrt((px+c)^2+py^2); sumd=d1+d2",
