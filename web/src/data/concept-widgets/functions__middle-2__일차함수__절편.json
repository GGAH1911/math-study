{
 "id": "functions/middle-2/일차함수/절편",
 "spec": {
  "title": "일차함수의 절편 y=ax+b",
  "params": [
   {
    "name": "a",
    "label": "a (기울기)",
    "type": "slider",
    "min": -5,
    "max": 5,
    "init": 2,
    "step": 0.5
   },
   {
    "name": "b",
    "label": "b (상수항)",
    "type": "slider",
    "min": -6,
    "max": 6,
    "init": -4,
    "step": 0.5
   }
  ],
  "scope": "yint=b; xint=-b/a",
  "plot": {
   "range": [
    -8,
    8
   ],
   "yRange": [
    -8,
    8
   ],
   "fns": [
    {
     "fn": "a*x+b",
     "label": "y=ax+b",
     "color": "#2563eb"
    }
   ]
  },
  "readout": [
   {
    "label": "y절편 (x=0일 때 y)",
    "expr": "yint",
    "digits": 3
   },
   {
    "label": "x절편 (y=0일 때 x)",
    "expr": "xint",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 2,
    "b": -4
   },
   {
    "a": 1,
    "b": 3
   },
   {
    "a": -2,
    "b": 6
   },
   {
    "a": -3,
    "b": -3
   }
  ],
  "invariants": [
   "yint-b",
   "a*xint+b"
  ],
  "oracle": [
   {
    "params": {
     "a": 2,
     "b": -4
    },
    "expect": {
     "yint": -4,
     "xint": 2
    }
   },
   {
    "params": {
     "a": 1,
     "b": 3
    },
    "expect": {
     "yint": 3,
     "xint": -3
    }
   },
   {
    "params": {
     "a": -2,
     "b": 6
    },
    "expect": {
     "yint": 6,
     "xint": 3
    }
   }
  ],
  "tol": 0.000001
 }
}