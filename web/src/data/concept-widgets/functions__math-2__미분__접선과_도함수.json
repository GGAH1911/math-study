{
 "id": "functions/math-2/미분/접선과_도함수",
 "spec": {
  "title": "접선과 도함수: f'(a)는 점 (a, f(a))에서의 접선의 기울기",
  "params": [
   {
    "name": "a",
    "label": "접점의 x좌표 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1.5,
    "step": 0.05,
    "unit": ""
   }
  ],
  "scope": "fa = a^3 - 3*a; m = 3*a^2 - 3; b = fa - m*a",
  "plot": {
   "range": [
    -2.4,
    2.4
   ],
   "yRange": [
    -5,
    5
   ],
   "fns": [
    {
     "fn": "x^3 - 3*x",
     "label": "f(x) = x³ - 3x",
     "color": "#2563eb"
    },
    {
     "fn": "m*(x - a) + fa",
     "label": "접선 y = f'(a)(x - a) + f(a)",
     "color": "#dc2626"
    }
   ]
  },
  "readout": [
   {
    "label": "f(a) (접점의 y좌표)",
    "expr": "fa",
    "digits": 3
   },
   {
    "label": "f'(a) = 접선의 기울기",
    "expr": "m",
    "digits": 3
   },
   {
    "label": "접선의 y절편",
    "expr": "b",
    "digits": 3
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": -2
   },
   {
    "a": -1
   },
   {
    "a": 0.5
   },
   {
    "a": 1.5
   }
  ],
  "invariants": [
   "fa - (a^3 - 3*a)",
   "m - (3*a^2 - 3)",
   "(m*a + b) - fa",
   "m - (((a+0.0001)^3 - 3*(a+0.0001)) - ((a-0.0001)^3 - 3*(a-0.0001)))/(2*0.0001)"
  ],
  "oracle": [
   {
    "params": {
     "a": 0
    },
    "expect": {
     "fa": 0,
     "m": -3,
     "b": 0
    }
   },
   {
    "params": {
     "a": 1
    },
    "expect": {
     "fa": -2,
     "m": 0,
     "b": -2
    }
   },
   {
    "params": {
     "a": 2
    },
    "expect": {
     "fa": 2,
     "m": 9,
     "b": -16
    }
   }
  ],
  "tol": 0.000001
 }
}