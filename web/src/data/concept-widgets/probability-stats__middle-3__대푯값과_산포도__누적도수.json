{
 "id": "probability-stats/middle-3/대푯값과_산포도/누적도수",
 "spec": {
  "title": "누적도수 그래프 탐구",
  "params": [
   {
    "name": "f1",
    "label": "0~20 도수",
    "type": "slider",
    "min": 0,
    "max": 15,
    "init": 3,
    "step": 1
   },
   {
    "name": "f2",
    "label": "20~40 도수",
    "type": "slider",
    "min": 0,
    "max": 15,
    "init": 7,
    "step": 1
   },
   {
    "name": "f3",
    "label": "40~60 도수",
    "type": "slider",
    "min": 0,
    "max": 15,
    "init": 10,
    "step": 1
   },
   {
    "name": "f4",
    "label": "60~80 도수",
    "type": "slider",
    "min": 0,
    "max": 15,
    "init": 6,
    "step": 1
   },
   {
    "name": "f5",
    "label": "80~100 도수",
    "type": "slider",
    "min": 0,
    "max": 15,
    "init": 4,
    "step": 1
   }
  ],
  "scope": "c1=f1; c2=f1+f2; c3=f1+f2+f3; c4=f1+f2+f3+f4; c5=f1+f2+f3+f4+f5; n=c5; m1=f1/20; m2=(c2-c1)/20; m3=(c3-c2)/20; m4=(c4-c3)/20; m5=(c5-c4)/20",
  "geometry": {
   "range": [
    0,
    100
   ],
   "yRange": [
    0,
    "=n+1"
   ],
   "showAxes": true,
   "showGrid": true,
   "shapes": []
  },
  "plot": {
   "range": [
    0,
    100
   ],
   "yRange": [
    0,
    "=n+1"
   ],
   "fns": [
    {
     "fn": "x<=20 ? m1*x : (x<=40 ? c1+m2*(x-20) : (x<=60 ? c2+m3*(x-40) : (x<=80 ? c3+m4*(x-60) : c4+m5*(x-80))))",
     "label": "누적도수",
     "color": "blue"
    }
   ]
  },
  "readout": [
   {
    "label": "~20 누적도수",
    "expr": "c1",
    "digits": 0
   },
   {
    "label": "~40 누적도수",
    "expr": "c2",
    "digits": 0
   },
   {
    "label": "~60 누적도수",
    "expr": "c3",
    "digits": 0
   },
   {
    "label": "~80 누적도수",
    "expr": "c4",
    "digits": 0
   },
   {
    "label": "~100 누적도수",
    "expr": "c5",
    "digits": 0
   },
   {
    "label": "전체 n",
    "expr": "n",
    "digits": 0
   }
  ]
 },
 "recipe": {
  "samples": [
