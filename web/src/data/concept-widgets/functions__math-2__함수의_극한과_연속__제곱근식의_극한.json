    "c": 1,
    "p": 1
   },
   {
    "a": 0,
    "b": 0,
    "c": -2,
    "p": 1
   }
  ],
  "invariants": [
   "L - (a*p^2 + b*p + c)",
   "D - (b^2 - 4*a*c)",
   "L >= 0 ? rootL^2 - L : 0",
   "L >= 0 ? rootL - limRootF : 0",
   "ok - (L >= 0 ? 1 : 0)",
   "a != 0 ? a*(2*xv) + b : 0"
  ],
  "oracle": [
   {
    "params": {
