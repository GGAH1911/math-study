{
 "id": "functions/math-2/적분/정적분_계산",
 "spec": {
  "title": "정적분 계산: 부호 있는 넓이 F(b) − F(a)",
  "params": [
   {
    "name": "a",
    "label": "아래끝 a",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 0,
    "step": 0.1
   },
   {
    "name": "b",
    "label": "위끝 b",
    "type": "slider",
    "min": -2,
    "max": 2,
    "init": 1,
    "step": 0.1
   }
  ],
  "scope": "Fa = a^3/3 - a; Fb = b^3/3 - b; integral = Fb - Fa; integralRev = Fa - Fb; integralAlt = (b^3 - a^3)/3 - (b - a); fa = a^2 - 1; fb = b^2 - 1",
  "plot": {
   "range": [
    -2,
    2
   ],
   "yRange": [
    -1.5,
    3.5
   ],
   "fns": [
    {
     "fn": "x^2 - 1",
     "label": "f(x) = x² − 1",
     "color": "#2563eb"
    }
   ],
   "points": [
    [
     "=a",
     "=fa"
    ],
    [
     "=b",
     "=fb"
    ]
   ],
   "pointsLabel": "$x=a,\\,x=b$"
  },
  "readout": [
   {
    "label": "F(a) = a³/3 − a",
    "expr": "Fa",
    "digits": 4
   },
   {
    "label": "F(b) = b³/3 − b",
    "expr": "Fb",
    "digits": 4
   },
   {
    "label": "∫ₐᵇ f(x)dx = F(b) − F(a)",
    "expr": "integral",
    "digits": 4
   }
  ]
 },
 "recipe": {
  "samples": [
   {
    "a": 0,
    "b": 1
   },
   {
    "a": -1,
    "b": 1
   },
   {
    "a": 1,
    "b": 2
   },
   {
    "a": -2,
    "b": 0
   }
  ],
  "invariants": [
   "integral - integralAlt",
   "integral + integralRev",
   "Fb - Fa - integral"
  ],
  "oracle": [
   {
    "params": {
     "a": 0,
     "b": 1
    },
    "expect": {
     "Fb": -0.6666666666666667,
     "Fa": 0,
     "integral": -0.6666666666666667
    }
   },
   {
    "params": {
     "a": -1,
     "b": 1
    },
    "expect": {
     "Fb": -0.6666666666666667,
     "Fa": 0.6666666666666667,
     "integral": -1.3333333333333333
    }
   },
   {
    "params": {
     "a": 1,
     "b": 2
    },
    "expect": {
     "Fb": 0.6666666666666667,
     "Fa": -0.6666666666666667,
     "integral": 1.3333333333333333
    }
   }
  ],
  "tol": 0.000001
 }
}