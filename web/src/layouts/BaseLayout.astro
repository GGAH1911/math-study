---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import { StickyGraphPanel } from '../components/Graph.tsx';
import { FONT_HREFS, DEFAULT_FONT_ID } from '../lib/fonts.ts';
// Phase 3 — 클라이언트 라우팅(View Transitions). 페이지 전환이 서버 왕복 없이 일어난다.
// ★★`is:inline` 스크립트는 **전환 후 다시 돌지 않는다.** 첫 로드는 멀쩡하고 이동한 뒤에만
//   깨지므로 라우트 스냅샷(매번 새 로드)으로는 못 잡는다 — 전부 `astro:page-load` 로 감쌌다.
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  containerClass?: string;
}

const { title = 'Math Study', description = 'LWIP 기반 한국 수능 학습 신경망', containerClass = '' } = Astro.props;
// 개념지도(/graph)는 튜터 그래프가 없고, StickyGraphPanel 닫힘 탭(우상단)이 노드 상세
// 카드의 닫기 버튼과 겹쳐 간섭 → /graph 에선 마운트하지 않는다.
const showStickyGraph = !Astro.url.pathname.startsWith('/graph');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- 테마 프리페인트 — FOUC 방지를 위해 CSS·title 보다 먼저 실행(계약 §6-A).
         localStorage['ms-theme'] 우선, 없으면 OS prefers-color-scheme 추종. -->
    <script is:inline>
(function(){function __run(){
        try {
          var t = localStorage.getItem('ms-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.classList.toggle('dark', t === 'dark');
        } catch (e) {}
      }__run();document.addEventListener('astro:page-load',__run);})();
</script>
    <meta name="description" content={description} />
    <title>{title} · Math Study</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {/* 폰트 프리페인트 — 설정에서 고른 프리셋(localStorage['ms-font'])을 html[data-font] 로
        적용하고 그 프리셋의 Google Fonts 만 동적 로드(전 프리셋을 미리 받지 않아 가볍다).
        프리셋 정의는 lib/fonts.ts 단일 진실원천. FOUC 방지로 <head> 상단. */}
    <script is:inline define:vars={{ FONT_HREFS, DEFAULT_FONT_ID }}>
(function(){function __run(){
        var f = DEFAULT_FONT_ID;
        try {
          var saved = localStorage.getItem('ms-font');
          if (saved && FONT_HREFS[saved]) f = saved;
        } catch (e) {}
        document.documentElement.setAttribute('data-font', f);
        var l = document.createElement('link');
        l.rel = 'stylesheet'; l.id = 'ms-font-link'; l.href = FONT_HREFS[f];
        document.head.appendChild(l);
      }__run();document.addEventListener('astro:page-load',__run);})();
</script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex">
    <Sidebar />
    <div class="flex-1 min-w-0 flex flex-col">
      <Header />
      {/* 하단 도크 폐지(메뉴는 상단 ☰). 하단 패딩 불필요 — safe-area 만 약간 확보. */}
      <main class={`flex-1 min-w-0 pb-[env(safe-area-inset-bottom)] ${containerClass}`}>
        <slot />
      </main>
    </div>

    {/* Floating most-recent-graph panel (desktop only, hidden on mobile).
         client:only="react" — SSR로 렌더하면 안 된다: 트리에 Geometry3D
         (@react-three/fiber, WebGL) + localStorage 의존이 있어 서버 렌더 시
         "Invalid hook call"로 깨졌다(매 페이지 SSR 에러의 원인). client:only 은
         SSR을 건너뛰고 load 시점에 클라이언트에서만 마운트 — 여전히 일찍 떠서
         ChatPanel graph 컴포넌트의 첫 broadcast 를 잡는다(client:idle 처럼 늦지
         않음). 초기 패널은 비어 있으므로 SSR HTML 부재로 인한 시각적 손실 없음. */}
    {showStickyGraph && <StickyGraphPanel client:only="react" />}


    <!-- Auto-enhance any ```python code block with a Run button (sympy via /api/sympy) -->
    <script is:inline>
(function(){function __run(){
      (function () {
        const RUNNABLE_LANGS = ['python', 'py'];
        function enhance() {
          const blocks = document.querySelectorAll('pre > code');
          blocks.forEach((code) => {
            const pre = code.parentElement;
            if (!pre || pre.dataset.sympyEnhanced) return;
            const cls = code.className || '';
            const m = cls.match(/language-(\w+)/);
            if (!m || !RUNNABLE_LANGS.includes(m[1].toLowerCase())) return;
            pre.dataset.sympyEnhanced = '1';
            pre.style.position = 'relative';

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = '▶ 실행';
            btn.className = 'sympy-run-btn';
            btn.title = 'sympy로 이 코드 실행';
            pre.appendChild(btn);

            const out = document.createElement('div');
            out.className = 'sympy-out';
            out.hidden = true;
            pre.insertAdjacentElement('afterend', out);

            btn.addEventListener('click', async () => {
              if (btn.disabled) return;
              btn.disabled = true;
              btn.textContent = '⏳ 실행 중…';
              out.hidden = false;
              out.className = 'sympy-out running';
              out.textContent = '...';
              try {
                const res = await fetch('/api/sympy', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ code: code.textContent || '' }),
                });
                const j = await res.json();
                if (j.ok) {
                  out.className = 'sympy-out success';
                  out.textContent = j.stdout || '(no output)';
                } else {
                  out.className = 'sympy-out error';
                  out.textContent = (j.stderr || j.error || `exit ${j.exit_code}`).trim();
                }
                if (j.truncated) out.textContent += '\n... (truncated)';
              } catch (e) {
                out.className = 'sympy-out error';
                out.textContent = '요청 실패: ' + (e instanceof Error ? e.message : String(e));
              } finally {
                btn.disabled = false;
                btn.textContent = '▶ 다시 실행';
              }
            });
          });
        }
        enhance();
        // Astro view transitions / SPA navigation
        document.addEventListener('astro:page-load', enhance);
        // Streaming markdown in ChatPanel — observe DOM mutations
        const obs = new MutationObserver(() => enhance());
        obs.observe(document.body, { childList: true, subtree: true });
      })();
    }__run();document.addEventListener('astro:page-load',__run);})();
</script>
  </body>
</html>
