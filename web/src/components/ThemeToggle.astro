{/* 라이트/다크 테마 토글 — 클릭 시 html.dark 토글 + localStorage['ms-theme'] 갱신.
     이벤트 위임(document 1회 바인딩)이라 인스턴스가 여러 개(헤더 + 모바일 시트)여도 안전.
     차트류는 html class MutationObserver 로 추종하므로 커스텀 이벤트 불필요(계약 §14-C). */}
<button
  type="button"
  data-theme-toggle
  class="inline-flex items-center justify-center min-w-11 min-h-11 size-11 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-[color:var(--color-muted)] hover:text-[color:var(--color-text)] hover:border-[color:var(--color-border-strong)] transition"
  aria-label="라이트/다크 테마 전환" title="테마 전환">
  {/* 현재 상태를 직관적으로: 라이트=해(☀), 다크=달(☾). currentColor 라 잉크색 추종(흑백 일관). */}
  <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg class="hidden dark:inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>
<script is:inline>
  (function () {
    if (window.__msThemeBound) return;
    window.__msThemeBound = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-theme-toggle]');
      if (!btn) return;
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('ms-theme', dark ? 'dark' : 'light'); } catch (err) {}
    });
  })();
</script>
