---
// 우측 컨텍스트 서랍 — 태블릿·모바일(<xl)에서 본문 풀폭을 확보하면서, 우측 가장자리에
// 항상 보이는 peek 손잡이로 보조 정보(기출·개념지도·노트 등)의 존재·내용을 알린다.
// 데스크탑(xl+)에서는 손잡이/오버레이가 사라지고 기존 인라인 sticky 컬럼으로 복귀(회귀 0).
// 스타일은 global.css 의 .ctx-drawer* (unlayered). 페이지는 aside 내용을 이 컴포넌트로 감싼다.
interface Props {
  label?: string;       // 손잡이 세로 라벨 (예: '기출 · 지도 · 노트')
  icon?: string;        // 손잡이 상단 아이콘
  class?: string;       // aside 추가 클래스
}
const { label = '학습 정보', icon = '📑', class: extra = '' } = Astro.props;
---
<button
  type="button"
  class="ctx-drawer-handle"
  data-ctx-handle
  aria-expanded="false"
  aria-controls="ctx-drawer"
  aria-label={`${label} 패널 열기`}
>
  <span class="ctx-drawer-handle-icon" aria-hidden="true">{icon}</span>
  <span>{label}</span>
</button>

<div class="ctx-drawer-backdrop" data-ctx-backdrop hidden></div>

<aside id="ctx-drawer" class:list={["ctx-drawer self-start space-y-4", extra]} data-open="false" aria-label="학습 정보 패널">
  <button type="button" class="ctx-drawer-close" data-ctx-close aria-label="패널 닫기">✕</button>
  <slot />
</aside>

<script>
  // 한 페이지에 서랍은 하나. data-* 로 요소를 찾아 개폐를 배선한다.
  const handle = document.querySelector<HTMLButtonElement>('[data-ctx-handle]');
  const drawer = document.getElementById('ctx-drawer');
  const backdrop = document.querySelector<HTMLElement>('[data-ctx-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-ctx-close]');

  if (handle && drawer && backdrop) {
    const setOpen = (open: boolean, refocus = true) => {
      drawer.dataset.open = String(open);
      backdrop.hidden = !open;
      handle.setAttribute('aria-expanded', String(open));
      if (open) closeBtn?.focus();
      else if (refocus) handle.focus();
    };
    const open = () => setOpen(true);
    const close = (refocus = true) => setOpen(false, refocus);

    // ── 드래그-당겨열기 ───────────────────────────────────────────────
    // 손잡이를 잡고 왼쪽으로 끌면 서랍이 손가락을 따라온다(transform 직접 제어).
    // 놓을 때 절반 이상 끌렸거나 빠르게 휙 끌면 열림, 아니면 닫힘으로 스냅.
    let dragging = false;
    let startX = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let width = 300;

    const onDown = (e: PointerEvent) => {
      // 데스크탑(xl+)에선 손잡이가 display:none 이라 이 경로 자체가 안 옴.
      width = drawer.getBoundingClientRect().width || 300;
      dragging = true;
      startX = lastX = e.clientX;
      lastT = e.timeStamp;
      velocity = 0;
      handle.setPointerCapture(e.pointerId);
      // 드래그 중엔 CSS 트랜지션 끄고 손가락에 1:1 추종.
      drawer.style.transition = 'none';
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      const startOpen = drawer.dataset.open === 'true';
      // 닫힘 상태: 왼쪽으로 끈 만큼(dx<0) 열림 진행. 열림 상태: 오른쪽으로 끈 만큼 닫힘.
      const dx = e.clientX - startX;
      const base = startOpen ? 0 : width; // 닫힘=translateX(width), 열림=0
      let tx = base + dx;
      tx = Math.max(0, Math.min(width, tx)); // [0, width] 클램프
      drawer.style.transform = `translateX(${tx}px)`;
      backdrop.hidden = false; // 끄는 동안 backdrop 노출(진행 피드백)
      velocity = (e.clientX - lastX) / Math.max(1, e.timeStamp - lastT); // px/ms
      lastX = e.clientX;
      lastT = e.timeStamp;
    };
    const onUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try { handle.releasePointerCapture(e.pointerId); } catch {}
      drawer.style.transition = ''; // CSS 트랜지션 복원(스냅 애니메이션)
      drawer.style.transform = '';  // data-open 기반 CSS 값으로 환원
      const curTx = width === 0 ? 0 : Math.max(0, Math.min(width, (drawer.dataset.open === 'true' ? 0 : width) + (e.clientX - startX)));
      // 속도 우선(휙 끌면 방향대로), 아니면 절반 임계.
      let willOpen: boolean;
      if (velocity < -0.35) willOpen = true;       // 왼쪽으로 빠르게 → 열림
      else if (velocity > 0.35) willOpen = false;  // 오른쪽으로 빠르게 → 닫힘
      else willOpen = curTx < width / 2;           // 절반 넘게 열렸으면 열림
      setOpen(willOpen, false);
      if (!willOpen) backdrop.hidden = true;
    };

    // 탭(클릭): 드래그가 아니면 토글로 열기. pointerup 에서 거의 안 움직였으면 클릭으로 간주.
    handle.addEventListener('pointerdown', onDown);
    handle.addEventListener('pointermove', onMove);
    handle.addEventListener('pointerup', onUp);
    handle.addEventListener('pointercancel', onUp);
    // 키보드/마우스 클릭(드래그 없이) 보조 — pointer 미지원/접근성.
    handle.addEventListener('click', (e) => {
      // 드래그 직후의 합성 click 은 무시(거의 안 움직였을 때만 토글).
      if (Math.abs(lastX - startX) > 6) { e.preventDefault(); return; }
      if (drawer.dataset.open !== 'true') open();
    });

    closeBtn?.addEventListener('click', () => close());
    backdrop.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.dataset.open === 'true') close();
    });
  }
</script>
