---
// 우측 컨텍스트 서랍 — 태블릿·모바일(<xl)에서 본문 풀폭을 확보하면서, 우측 가장자리에
// 항상 보이는 peek 손잡이로 보조 정보(기출·개념지도·노트 등)의 존재·내용을 알린다.
// 손잡이는 서랍(wrap)의 자식이라 드래그/열림 시 서랍과 함께 움직인다("따라오는 핸들").
// 데스크탑(xl+)에서는 손잡이/오버레이가 사라지고 인라인 sticky 컬럼으로 복귀(회귀 0).
// 스타일: global.css .ctx-drawer* (unlayered).
interface Props {
  label?: string;       // 손잡이 세로 라벨 (예: '기출 · 지도 · 노트')
  icon?: string;        // 손잡이 상단 아이콘
}
const { label = '학습 정보', icon = '📑' } = Astro.props;
---
<div class="ctx-drawer-backdrop" data-ctx-backdrop hidden></div>

<div id="ctx-drawer" class="ctx-drawer" data-open="false">
  <button
    type="button"
    class="ctx-drawer-handle"
    data-ctx-handle
    aria-expanded="false"
    aria-controls="ctx-drawer"
    aria-label={`${label} 패널 열기`}
  >
    <span class="ctx-drawer-handle-icon" aria-hidden="true">{icon}</span>
    <span>{label}</span>
  </button>

  <div class="ctx-drawer-body space-y-4" aria-label="학습 정보 패널">
    <button type="button" class="ctx-drawer-close" data-ctx-close aria-label="패널 닫기">✕</button>
    <slot />
  </div>
</div>

<script>
  // 한 페이지에 서랍은 하나. data-* 로 요소를 찾아 개폐를 배선한다.
  const handle = document.querySelector<HTMLButtonElement>('[data-ctx-handle]');
  const drawer = document.getElementById('ctx-drawer'); // = wrap (transform 대상)
  const backdrop = document.querySelector<HTMLElement>('[data-ctx-backdrop]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-ctx-close]');

  if (handle && drawer && backdrop) {
    const setOpen = (open: boolean, refocus = true) => {
      drawer.dataset.open = String(open);
      backdrop.hidden = !open;
      handle.setAttribute('aria-expanded', String(open));
      if (open) closeBtn?.focus();
      else if (refocus) handle.focus();
    };
    const open = () => setOpen(true);
    const close = (refocus = true) => setOpen(false, refocus);

    // ── 개폐 인터랙션 (축 인식) ─────────────────────────────────────────
    // 태블릿(md~xl): 우측 서랍 → 가로 드래그(왼쪽 당기면 열림, 오른쪽 밀면 닫힘) + 탭 토글.
    // 모바일(<md): 하단 바텀시트 → **탭으로도 열고, 위로 스와이프로도 연다**. 손잡이를 OS
    //   제스처 영역(홈 인디케이터) 위로 띄웠기에 위로-스와이프 시작점이 그 위라 더 이상
    //   홈/앱전환 제스처에 가로채이지 않는다(사용자 확인: "저 높이면 스와이프 OK"). 닫기는
    //   아래로 스와이프 + ✕ + 배경 탭. 즉 탭=토글, 드래그=따라오며 절반/플릭으로 스냅.
    const isBottom = () => window.matchMedia('(max-width: 767px)').matches;
    let dragging = false;
    let moved = false;
    let vertical = false;   // true=세로(모바일), false=가로(태블릿)
    let start = 0;          // 드래그 시작 좌표(축에 맞는 client 좌표)
    let last = 0;
    let lastT = 0;
    let velocity = 0;
    let span = 300;         // 서랍 이동 거리(가로=폭, 세로=높이)
    let suppressClick = false; // 드래그 직후 따라오는 합성 click 억제용

    const coord = (e: PointerEvent) => (vertical ? e.clientY : e.clientX);

    const onDown = (e: PointerEvent) => {
      // 데스크탑(xl+)은 손잡이 display:none → 이 경로 자체가 안 옴.
      vertical = isBottom();
      const r = drawer.getBoundingClientRect();
      span = (vertical ? r.height : r.width) || 300;
      dragging = true;
      moved = false;
      start = last = coord(e);
      lastT = e.timeStamp;
      velocity = 0;
      handle.setPointerCapture(e.pointerId);
      drawer.style.transition = 'none'; // 드래그 중 손가락 1:1 추종
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      // d>0 = 닫는 방향(가로=오른쪽, 세로=아래쪽). 닫힘에서 당기면(d<0) 열림 진행.
      const d = coord(e) - start;
      if (Math.abs(d) > 4) moved = true;
      const startOpen = drawer.dataset.open === 'true';
      const base = startOpen ? 0 : span;                 // 닫힘=translate(span), 열림=0
      const t = Math.max(0, Math.min(span, base + d));
      drawer.style.transform = vertical ? `translateY(${t}px)` : `translateX(${t}px)`;
      backdrop.hidden = false;
      velocity = (coord(e) - last) / Math.max(1, e.timeStamp - lastT);
      last = coord(e);
      lastT = e.timeStamp;
    };
    const onUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try { handle.releasePointerCapture(e.pointerId); } catch {}
      drawer.style.transition = '';  // CSS 트랜지션 복원(스냅)
      drawer.style.transform = '';   // data-open 기반 CSS 값으로 환원
      if (!moved) return;            // 탭 → click 핸들러가 토글 처리
      suppressClick = true;          // 드래그였으니 뒤따르는 합성 click 무시
      setTimeout(() => { suppressClick = false; }, 60);
      const startOpen = drawer.dataset.open === 'true';
      const cur = Math.max(0, Math.min(span, (startOpen ? 0 : span) + (coord(e) - start)));
      let willOpen: boolean;
      if (velocity < -0.35) willOpen = true;       // 당기는 플릭(왼/위) → 열림
      else if (velocity > 0.35) willOpen = false;  // 미는 플릭(오/아래) → 닫힘
      else willOpen = cur < span / 2;              // 절반 임계
      setOpen(willOpen, false);
      if (!willOpen) backdrop.hidden = true;
    };

    handle.addEventListener('pointerdown', onDown);
    handle.addEventListener('pointermove', onMove);
    handle.addEventListener('pointerup', onUp);
    handle.addEventListener('pointercancel', onUp);
    // 탭 → 토글(열기/닫기). 드래그 직후 합성 click 은 무시한다.
    handle.addEventListener('click', () => {
      if (suppressClick) return;
      setOpen(drawer.dataset.open !== 'true', false);
    });

    closeBtn?.addEventListener('click', () => close());
    backdrop.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.dataset.open === 'true') close();
    });
  }
</script>
