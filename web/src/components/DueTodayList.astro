---
import { getCollection } from 'astro:content';
import { MASTERY_LABEL_KO } from '../lib/concept-meta';
import { STATUS_LABEL_KO } from '../lib/srs.ts';

// 오답 유형 표시 라벨(코드 키는 유지).
const ERROR_TYPE_LABEL_KO: Record<string, string> = {
  concept_gap: '개념 부족', careless: '실수', wrong_approach: '접근 오류', unknown_method: '풀이법 모름',
};

const today = new Date();
today.setHours(0, 0, 0, 0);

type Row = { href: string; title: string; collection: string; chip: string; chipClass: string };

const rows: Row[] = [];

const concepts = await getCollection('concepts');
for (const c of concepts) {
  if (c.data.next_review && new Date(c.data.next_review) <= today) {
    rows.push({
      href: `/concepts/${c.id}`,
      title: c.id.split('/').pop() ?? c.id,
      collection: 'concept',
      chip: MASTERY_LABEL_KO[c.data.mastery] ?? c.data.mastery,
      chipClass: `chip-mastery-${c.data.mastery}`,
    });
  }
}
const problems = await getCollection('problems');
for (const p of problems) {
  if (p.data.next_review && new Date(p.data.next_review) <= today) {
    rows.push({
      href: `/problems/${p.id}`,
      title: p.id.split('/').pop() ?? p.id,
      collection: 'problem',
      chip: STATUS_LABEL_KO[p.data.status] ?? p.data.status,
      chipClass: `chip-status-${p.data.status}`,
    });
  }
}
const mistakes = await getCollection('mistakes');
for (const m of mistakes) {
  if (m.data.next_review && new Date(m.data.next_review) <= today) {
    rows.push({
      href: `/mistakes/${encodeURIComponent(m.id)}`,
      title: m.id,
      collection: 'mistake',
      chip: ERROR_TYPE_LABEL_KO[m.data.error_type] ?? m.data.error_type,
      chipClass: `chip-error-${m.data.error_type}`,
    });
  }
}
---
<section class="card">
  <header class="flex items-center justify-between mb-3">
    <div>
      <h2 class="text-sm font-semibold">오늘 복습</h2>
      <p class="text-xs text-[color:var(--color-muted)]">오늘 복습할 페이지 (간격 반복)</p>
    </div>
    <span class="stat-num text-lg">{rows.length}</span>
  </header>
  {rows.length === 0 ? (
    <p class="text-sm text-[color:var(--color-subtle)] py-4 text-center">
      ✨ 모두 일정대로 진행 중입니다. 새 자료를 추가하거나 다음 단계로 진행하세요.
    </p>
  ) : (
    <ul class="space-y-1.5">
      {rows.map((r) => (
        <li>
          <a href={r.href} class="flex items-center justify-between gap-2 px-2 py-1.5 -mx-2 rounded-md hover:bg-[color:var(--color-surface-2)] transition">
            <span class="text-sm truncate">{r.title}</span>
            <span class={`chip ${r.chipClass}`}>{r.chip}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
