---
import { readLog, cleanLogSubject, USER_ACTIVITY_OPS } from '../lib/health.ts';

const isAdmin = !!Astro.locals.user?.is_admin;
// 관리자: 전체 운영 로그(promote·prune·restructure·ingest…). 사용자: 학습 관련(노트 promote)만 —
// prune/restructure/LWIP/ingest 등 개발·운영 작업은 비관리자 피드에서 제외.
const all = readLog(isAdmin ? 8 : 40);
const entries = (isAdmin ? all : all.filter((e) => USER_ACTIVITY_OPS.some((op) => e.operation.startsWith(op)))).slice(0, 8);

const heading = isAdmin ? 'Recent Activity' : '최근 학습 활동';
const subtitle = isAdmin ? '최근 작업 기록 (docs/log.md)' : '내가 정리한 학습 노트 활동';
const moreHref = isAdmin ? '/log' : '/syntheses';
const moreLabel = isAdmin ? '전체 기록 보기 →' : '학습 노트 전체 →';

// 사용자에겐 'promote' 같은 내부 op 명을 친화적으로.
const opLabel = (op: string): string => (!isAdmin && op.startsWith('promote') ? '학습 노트' : op);

// 사용자 뷰 subject 간결화: 'chat → synthesis: "[요청]…" from 논리' → 개념 '논리'.
// (op 라벨이 이미 "학습 노트"라 개념만 보이면 충분.) from 없으면 dev 접두만 제거.
const friendlySubject = (subject: string): string => {
  const s = cleanLogSubject(subject);
  const i = s.lastIndexOf(' from ');
  if (i >= 0) return s.slice(i + 6).trim();
  return s.replace(/^\s*chat\s*→\s*synthesis:\s*/i, '').trim();
};

const iconFor = (op: string): string => {
  if (op.startsWith('promote')) return '✎';
  if (op.startsWith('init')) return '✦';
  if (op.startsWith('smoke')) return '⌬';
  if (op.startsWith('ingest')) return '↧';
  if (op.startsWith('prune')) return '✂';
  if (op.startsWith('restructure') || op.startsWith('merge')) return '⇄';
  if (op.startsWith('env')) return '⚙';
  return '·';
};
---
<section class="card">
  <header class="mb-3">
    <h2 class="text-sm font-semibold">{heading}</h2>
    <p class="text-xs text-[color:var(--color-muted)]">{subtitle}</p>
  </header>
  {entries.length === 0 ? (
    <p class="text-sm text-[color:var(--color-subtle)]">{isAdmin ? '기록 없음.' : '아직 학습 노트 활동이 없습니다.'}</p>
  ) : (
    <ol class="space-y-3 relative">
      {entries.map((e) => (
        <li class="flex gap-3 items-start">
          <span class="mt-0.5 inline-flex items-center justify-center size-6 rounded-full bg-[color:var(--color-surface-2)] border border-[color:var(--color-border)] text-xs text-[color:var(--color-accent)]">{iconFor(e.operation)}</span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <time class="font-mono text-[11px] text-[color:var(--color-subtle)]">{e.date}</time>
              <span class="text-xs font-medium text-[color:var(--color-muted)]">{opLabel(e.operation)}</span>
            </div>
            <div class="text-xs text-[color:var(--color-muted)] mt-0.5 line-clamp-2">{isAdmin ? cleanLogSubject(e.subject) : friendlySubject(e.subject)}</div>
          </div>
        </li>
      ))}
    </ol>
  )}
  <a href={moreHref} class="block mt-3 text-center text-xs text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition">{moreLabel}</a>
</section>
