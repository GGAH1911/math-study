---
// '기출' 회차별 — 한 회차를 접이식(<details>)으로. summary=회차헤더+시험모드 진입,
// 내용=문제 **리스트**(번호·단원·난이도, 썸네일 X). 기본 접힘.
// ProblemFilters 가 .problem-card-wrap 을 필터(.filtered-out 토글)하되 자동 펼침은 안 함.
import { roundTitle, TIER_BADGE } from '../lib/problem-meta';
import { cardProps, dataAttrs, subjectBreakdown, type RoundGroup } from '../lib/problem-card';

type Props = { round: RoundGroup };
const { round: r } = Astro.props;
---
<details class="problem-group rounded-lg border border-[color:var(--color-border)]">
  <summary class="flex items-center justify-between gap-3 px-3 py-2 cursor-pointer list-none rounded-lg hover:bg-[color:var(--color-surface-2)]/40">
    <span class="flex items-center gap-2 min-w-0">
      <span class="round-marker text-[color:var(--color-subtle)] text-xs select-none transition-transform">▸</span>
      <span class="font-medium text-sm truncate">{roundTitle(r.meta)}</span>
      <span class="text-[11px] text-[color:var(--color-subtle)] whitespace-nowrap">{subjectBreakdown(r.problems)}</span>
    </span>
    <a
      href={`/exam/round/${r.year}/${r.round}`}
      onclick="event.stopPropagation()"
      class="chip text-[11px] hover:border-[color:var(--color-accent)] shrink-0"
    >▶ 시험 모드</a>
  </summary>
  <ul class="px-2 pb-2 pt-1 divide-y divide-[color:var(--color-border)]/30">
    {r.problems.map((p) => {
      const cp = cardProps(p);
      const unit = String(p.data.unit ?? '').trim().replace(/_/g, ' ');
      const badge = cp.tier ? TIER_BADGE[cp.tier] : null;
      return (
        <li class="problem-card-wrap" {...dataAttrs(p)}>
          <a
            href={cp.href}
            class="flex items-center gap-3 py-1.5 px-2 text-sm rounded hover:bg-[color:var(--color-surface-2)]/50"
          >
            <span class="w-20 shrink-0 font-medium tabular-nums">{cp.title}</span>
            <span class="flex-1 min-w-0 truncate text-[color:var(--color-subtle)]">{unit || '—'}</span>
            {badge && <span class={`chip text-[10px] shrink-0 ${badge.cls}`}>{badge.text}</span>}
            {cp.score != null && cp.score !== '' && (
              <span class="text-[11px] text-[color:var(--color-subtle)] tabular-nums shrink-0">{cp.score}점</span>
            )}
            {cp.solved && <span class="text-emerald-400 text-xs shrink-0" title="해결">✓</span>}
          </a>
        </li>
      );
    })}
  </ul>
</details>

<style>
  details[open] > summary .round-marker { transform: rotate(90deg); }
</style>
