---
// 문제 카드 — 썸네일 + 제목 + 난이도 배지 + 메타. 회차별/단원별 렌즈 공용.
import { TIER_BADGE, FORMAT_LABEL } from '../lib/problem-meta';
interface Props {
  href: string;
  thumb: string;
  title: string;
  tier?: string | null;
  format?: string | null;
  score?: string | number | null;
  cognitive?: string | null;
  solved?: boolean;
}
const { href, thumb, title, tier, format, score, cognitive, solved = false } = Astro.props;
const badge = tier ? TIER_BADGE[tier] : null;
---
<a href={href} class="problem-card block overflow-hidden">
  <div class="thumb-wrap">
    <img src={thumb} alt={title} loading="lazy" decoding="async" class="thumb" />
    {solved && (
      <span class="absolute top-1.5 left-1.5 text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-500/25 text-emerald-200 border border-emerald-500/40">✓</span>
    )}
  </div>
  <div class="p-2.5 space-y-1">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold truncate">{title}</h3>
      {badge && (
        <span class={`text-[10px] px-1.5 py-0.5 rounded-full border shrink-0 ${badge.cls}`}>{badge.text}</span>
      )}
    </div>
    <div class="flex items-center gap-1.5 text-[10px] text-[color:var(--color-subtle)]">
      {format && <span>{FORMAT_LABEL[format] ?? format}</span>}
      {score && <span>· {score}점</span>}
      {cognitive && <span>· {cognitive}</span>}
    </div>
  </div>
</a>

<style>
  .problem-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: border-color 150ms ease;
  }
  .problem-card:hover {
    border-color: var(--color-accent);
  }
  .thumb-wrap {
    position: relative;
    height: 150px;
    overflow: hidden;
    background: white;
    border-bottom: 1px solid var(--color-border);
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    /* 다크모드 가독성 — global.css 의 .problem-image 와 동일 invert */
    filter: invert(0.92) hue-rotate(180deg);
  }
</style>
