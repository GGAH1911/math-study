---
const { pathname } = Astro.url;
const links: Array<{ href: string; label: string; icon: string; match?: string[] }> = [
  { href: '/',          label: '홈',         icon: '◉' },
  { href: '/graph',     label: '개념 지도', icon: '◈' },
  { href: '/concepts',  label: '개념',       icon: '⊕' },
  { href: '/problems',  label: '기출',       icon: '∎', match: ['/problems', '/exam'] },
  { href: '/mistakes',  label: '오답노트',   icon: '✕' },
  { href: '/tools',     label: '학습 자료',  icon: '⚒' },
  { href: '/paths',     label: '학습 경로',  icon: '↝' },
  { href: '/syntheses', label: '학습 노트', icon: '🗒' },
  { href: '/log',       label: '기록',       icon: '☴' },
  { href: '/settings',  label: '설정',       icon: '⚙' },
];
function active(l: { href: string; match?: string[] }): string {
  if (l.href === '/') return pathname === '/' ? 'active' : '';
  return (l.match ?? [l.href]).some((p) => pathname.startsWith(p)) ? 'active' : '';
}
---

<aside class="sticky top-0 h-screen w-60 lg:w-52 xl:w-60 shrink-0 border-r border-[color:var(--color-border)] bg-[color:var(--color-bg)] px-4 py-5 hidden lg:flex flex-col gap-1">
  <a href="/" class="flex items-center gap-2 px-2 py-1 mb-4 group">
    {/* 브랜드 인장 — 모바일 헤더·favicon 과 동일한 빨간 작도 곡선 한 획(삼각자 이모지 폐지, 통일). */}
    <svg width="26" height="26" viewBox="0 0 28 28" aria-hidden="true" class="shrink-0">
      <rect x="1.5" y="1.5" width="25" height="25" rx="3" fill="none" stroke="var(--pen-red)" stroke-width="2"/>
      <path d="M6 21 Q 14 -2 22 21" fill="none" stroke="var(--pen-red)" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
    <span>
      <div class="text-sm font-semibold tracking-tight">Math Study</div>
      <div class="text-[10px] tracking-[0.12em] text-[color:var(--color-subtle)]">수능 수학 학습</div>
    </span>
  </a>

  <nav class="flex flex-col gap-0.5">
    {links.map((link) => (
      <a href={link.href} class={`nav-link ${active(link)}`}>
        <span class="inline-block w-4 text-center text-[color:var(--color-subtle)] text-xs">{link.icon}</span>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

  <div class="mt-auto pt-4 border-t border-[color:var(--color-border)] text-[11px] text-[color:var(--color-subtle)]">
    <div class="flex items-center justify-end">
      <span class="font-mono">v1.2</span>
    </div>
    <div class="mt-1">정답률 0%부터 다시 시작.</div>
  </div>
</aside>
