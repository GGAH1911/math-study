---
import { readHealth, unitSummary, type UnitStatus } from '../lib/health.ts';
import { getMasteryMap } from '../lib/mastery.ts';
import { getDueProblemCount } from '../lib/activity.ts';
import ThemeToggle from './ThemeToggle.astro';
const health = readHealth(); // dagIntegrity(라이브 실측)용 — dueToday(박제)는 안 씀.
// 단원 통계·Due 는 사용자별 라이브로. unitSummary()(인자 없음)는 전역 frontmatter
// 기준이라 멀티유저에서 부정확 → mof 주입. Due 는 readHealth.dueToday(단일유저 시절
// 전역 next_review 집계, 예: 390) 대신 사용자 problem_state 큐로(홈·DueTodayListDb 와 동일).
const masteryMap = Astro.locals.user ? await getMasteryMap(Astro.locals.user.id) : new Map<string, string>();
const mof = (id: string): UnitStatus => (masteryMap.get(id) ?? 'unknown') as UnitStatus;
const u = unitSummary(mof);
const s = u.byStatus;
const dueCount = Astro.locals.user ? await getDueProblemCount(Astro.locals.user.id) : 0;
const { pathname } = Astro.url; // 모바일 도크 active 판정용
---

{/* 높이 계약: 정확히 h-14(3.5rem) — graph.astro 의 h-[calc(100vh-3.5rem)] 와 결합.
     border-b 대신 손그림 괘선 SVG(마지막 자식)가 하단 경계를 담당한다. */}
<header class="sticky top-0 z-30 flex items-center gap-4 px-6 h-14 relative bg-[color:var(--color-bg)]/85 backdrop-blur">
  <div class="lg:hidden flex items-center gap-2">
    {/* 브랜드 인장 — 모눈 위 빨간 곡선 한 획(작도 모티프). 한자 사용 금지(사용자 지침). */}
    <svg width="26" height="26" viewBox="0 0 28 28" aria-hidden="true">
      <rect x="1.5" y="1.5" width="25" height="25" rx="3" fill="none" stroke="var(--pen-red)" stroke-width="2"/>
      <path d="M6 21 Q 14 -2 22 21" fill="none" stroke="var(--pen-red)" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
    <span class="text-sm font-serif font-bold">Math Study</span>
  </div>

  <div class="ml-auto flex items-center gap-3 text-xs">
    <span class="hidden sm:inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[color:var(--color-surface)] border border-[color:var(--color-border)] font-mono"
          title={`단원 진행 ${u.started}/${u.total} 착수 — 미착수·학습중·능숙·숙달`}>
      <span class="font-sans text-[10px] text-[color:var(--color-subtle)] mr-0.5">단원</span>
      <span class="inline-block size-1.5 rounded-full bg-[color:var(--color-mastery-unknown)]"></span>
      <span class="stat-num">{s.unknown}</span>
      <span class="inline-block size-1.5 rounded-full bg-[color:var(--color-mastery-learning)]"></span>
      <span class="stat-num">{s.learning}</span>
      <span class="inline-block size-1.5 rounded-full bg-[color:var(--color-mastery-proficient)]"></span>
      <span class="stat-num">{s.proficient}</span>
      <span class="inline-block size-1.5 rounded-full bg-[color:var(--color-mastery-mastered)]"></span>
      <span class="stat-num">{s.mastered}</span>
    </span>

    {/* Due 칩 — 모바일에도 상시 노출(hidden md: 제거, 계약 §8-A) */}
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
      <span class={`size-1.5 rounded-full ${dueCount > 0 ? 'bg-[color:var(--color-mastery-learning)]' : 'bg-[color:var(--color-subtle)]'}`}></span>
      <span class="stat-num">Due {dueCount}</span>
    </span>

    <span class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
      <span class={`size-1.5 rounded-full ${health.dagIntegrity === 'ok' ? 'bg-[color:var(--color-mastery-proficient)]' : 'bg-[color:var(--color-mastery-unknown)]'}`}></span>
      <span>DAG {health.dagIntegrity}</span>
    </span>

    <ThemeToggle />
  </div>

  {/* 손그림 괘선 — 미세하게 흔들리는 펜선(wobble 예산 1/3, 계약 §15) */}
  <svg class="absolute left-0 right-0 bottom-0 w-full h-[3px] pointer-events-none" viewBox="0 0 1200 3" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,1.6 C200,0.9 400,2.2 600,1.4 C800,0.7 1000,2.1 1200,1.5" fill="none" stroke="var(--color-border-strong)" stroke-width="1" vector-effect="non-scaling-stroke"/>
  </svg>
</header>

{/* 모바일 하단 도크(<lg 전용) — fixed 라 header 밖 형제로 렌더
     (header 의 backdrop-blur 가 fixed 자손의 containing block 을 만들기 때문).
     링크 9종 전부 보존: 도크 4 + 시트 6(Dashboard=홈) + /progress 신규 노출.
     스타일(.mobile-dock/.dock-sheet)은 global.css 공급(계약 §8-B). */}
<nav class="mobile-dock lg:hidden" aria-label="모바일 내비게이션">
  <a href="/"         class={pathname === '/' ? 'active' : ''}><span class="icon">◉</span><span>홈</span></a>
  <a href="/problems" class={(pathname.startsWith('/problems') || pathname.startsWith('/exam')) ? 'active' : ''}><span class="icon">∎</span><span>기출</span></a>
  <a href="/concepts" class={pathname.startsWith('/concepts') ? 'active' : ''}><span class="icon">⊕</span><span>개념</span></a>
  <a href="/graph"    class={pathname.startsWith('/graph') ? 'active' : ''}><span class="icon">◈</span><span>지도</span></a>
  <button type="button" data-dock-more aria-expanded="false" aria-controls="dock-sheet"><span class="icon">☰</span><span>더보기</span></button>
</nav>
<div id="dock-sheet" hidden class="dock-sheet lg:hidden" role="navigation" aria-label="더보기 메뉴">
  <a href="/mistakes">✕ Mistakes</a>
  <a href="/syntheses">🗒 학습 노트</a>
  <a href="/paths">↝ Paths</a>
  <a href="/progress">∿ 진행</a>
  <a href="/tools">⚒ Tools</a>
  <a href="/log">☴ Log</a>
  <button type="button" data-theme-toggle>◐ 테마 전환</button>
  <button type="button" data-logout>→ 로그아웃</button>
</div>
<script is:inline>
  (function () {
    if (window.__msDockBound) return;
    window.__msDockBound = true;
    // 시트 개폐 — hidden 토글 + aria-expanded 동기화(스크린리더 개폐 인지)
    function setSheet(sheet, open) {
      sheet.hidden = !open;
      var btn = document.querySelector('[data-dock-more]');
      if (btn) btn.setAttribute('aria-expanded', String(open));
    }
    // 더보기 시트 토글 + 바깥 탭 시 닫기
    document.addEventListener('click', function (e) {
      var sheet = document.getElementById('dock-sheet');
      if (!sheet) return;
      if (e.target.closest('[data-dock-more]')) {
        setSheet(sheet, sheet.hidden);
        if (!sheet.hidden) {
          // 열릴 때 첫 항목으로 포커스 이동(키보드·스크린리더)
          var first = sheet.querySelector('a, button');
          if (first) first.focus();
        }
        return;
      }
      if (!sheet.hidden && !e.target.closest('#dock-sheet')) {
        // 클릭스루 차단 — 시트를 닫는 탭이 밑의 링크를 동시에 활성화하지 않게
        e.preventDefault();
        e.stopPropagation();
        setSheet(sheet, false);
      }
    });
    // Esc 로 닫기 + 더보기 버튼으로 포커스 복귀
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var sheet = document.getElementById('dock-sheet');
      if (!sheet || sheet.hidden) return;
      setSheet(sheet, false);
      var btn = document.querySelector('[data-dock-more]');
      if (btn) btn.focus();
    });
    // 로그아웃 — 고아 API /api/auth/logout 수습(감사 §2.3)
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-logout]')) return;
      fetch('/api/auth/logout', { method: 'POST' })
        .catch(function () {})
        .then(function () { location.href = '/login'; });
    });
  })();
</script>
