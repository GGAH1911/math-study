---
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  graphHref?: string;
  chips?: Array<{ label: string; class: string }>;
  meta?: Array<{ key: string; value: string }>;
  description?: string;
  emphasized?: boolean;
  progress?: { percent: number; status: string };
  practice?: { count: number; href: string };
}
const { href, title, subtitle, graphHref, chips = [], meta = [], description, emphasized = false, progress, practice } = Astro.props;
// 요약의 `$...$` 를 KaTeX 로 렌더(SSOT: katex-normalize 의 공유 renderMathSegments,
// 마크다운 rehype·클라이언트 mathish 와 동일 정규화·정책). 서버라 katex 직접 주입.
import katex from 'katex';
import { renderMathSegments } from '../lib/katex-normalize.mjs';
const descHtml = description ? renderMathSegments(description, katex) : '';
---
<article class:list={["concept-card card relative", emphasized && "concept-card-unit"]}>
  <a href={href} class="block">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <h3 class={`font-semibold leading-snug ${emphasized ? 'text-lg' : 'text-base'}`}>{title}</h3>
        {subtitle && (
          <p class="text-[10px] font-mono text-[color:var(--color-subtle)] mt-0.5 truncate">{subtitle}</p>
        )}
      </div>
      <div class="flex flex-wrap gap-1 justify-end shrink-0">
        {chips.map((c) => <span class={`chip ${c.class}`}>{c.label}</span>)}
      </div>
    </div>
    {progress && (
      <div class="mt-2 flex items-center gap-2">
        <div class="flex-1 h-1.5 rounded-full bg-[color:var(--color-surface-2)] overflow-hidden">
          <div class="h-full rounded-full" style={`width:${Math.max(2, progress.percent)}%;background:var(--color-mastery-${progress.status})`}></div>
        </div>
        <span class="text-[10px] tabular-nums text-[color:var(--color-subtle)] shrink-0">{progress.percent}%</span>
      </div>
    )}
    {description && (
      <p class="text-sm text-[color:var(--color-muted)] mt-2 line-clamp-2" set:html={descHtml}></p>
    )}
    {meta.length > 0 && (
      <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-[11px] text-[color:var(--color-subtle)]">
        {meta.map((m) => (
          <div class="flex justify-between gap-2">
            <dt class="uppercase tracking-wider">{m.key}</dt>
            <dd class="text-[color:var(--color-muted)] truncate text-right">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </a>
  {practice && (
    <a href={practice.href}
       class="mt-2 flex items-center gap-1 text-[11px] text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition w-fit"
       title="이 단원 기출 풀기">
      📝 {practice.count} 기출 풀기 →
    </a>
  )}
  {graphHref && (
    <a
      href={graphHref}
      class="absolute top-2 right-2 size-6 rounded-md grid place-items-center text-[color:var(--color-subtle)] hover:text-[color:var(--color-fg)] hover:bg-[color:var(--color-surface)] transition"
      title="그래프에서 보기"
      aria-label="그래프에서 보기"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="4" cy="4" r="2"/><circle cx="12" cy="8" r="2"/><circle cx="4" cy="12" r="2"/>
        <path d="M6 5l4 2M6 11l4-2"/>
      </svg>
    </a>
  )}
</article>

<style>
.concept-card {
  --hover-border: color-mix(in oklab, var(--color-primary, #3b82f6) 50%, transparent);
}
.concept-card:hover {
  border-color: var(--hover-border);
}
.concept-card-unit {
  border-left-width: 3px;
}
</style>
