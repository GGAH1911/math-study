---
// 회원정보("내 정보") 페이지 — 인증 필수(SSR). 계정 정보 + 로그아웃 + 학습 현황 +
// 학습자 프로필(정성) 편집. 약점 패턴은 튜터가 자동 누적한 것을 읽기 전용으로 노출.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import sql from '../lib/db.ts';
import { AccountMastery, AccountWeakness } from '../components/AccountStats.tsx';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?returnTo=/account');

// ★표시용 집계·프로필은 `/api/account` 로 갔다(아래 섬). 여기 남은 쿼리는 **탈퇴 모달용**
//   `hasPassword` 하나뿐이다 — 탈퇴는 파괴적 흐름이라 인라인 스크립트째 서버에 둔다.
// 비밀번호 계정 여부 — 탈퇴 모달에서 비번 재확인 요구 여부 결정(OAuth 전용은 비번 없음).
const pwRows = await sql<{ has_password: boolean }[]>`
  SELECT (password_hash IS NOT NULL) AS has_password FROM users WHERE id = ${user.id} LIMIT 1
`;
const hasPassword = pwRows[0]?.has_password ?? false;

---

<BaseLayout title="내 정보">
  <div class="max-w-3xl mx-auto px-6 py-8 space-y-8">
    <h1 class="text-2xl font-semibold">내 정보</h1>

    {/* ── 계정 ── */}
    <section class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-sm font-semibold text-[color:var(--color-subtle)] mb-3 flex items-center gap-2">
            계정
            {user.is_admin && (
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold tracking-wide bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent)] border border-[color:var(--color-accent)]/40">관리자</span>
            )}
          </h2>
          <dl class="space-y-1.5 text-sm">
            <div class="flex gap-3">
              <dt class="w-20 shrink-0 text-[color:var(--color-muted)]">이메일</dt>
              <dd class="font-mono truncate">{user.email}</dd>
            </div>
            {user.display_name && (
              <div class="flex gap-3">
                <dt class="w-20 shrink-0 text-[color:var(--color-muted)]">이름</dt>
                <dd>{user.display_name}</dd>
              </div>
            )}
            <div class="flex gap-3">
              <dt class="w-20 shrink-0 text-[color:var(--color-muted)]">유형</dt>
              <dd class="text-[color:var(--color-muted)]">{user.is_admin ? '관리자 계정' : user.is_legacy ? '기존 학습 데이터 상속 계정' : '일반 계정'}</dd>
            </div>
          </dl>
        </div>
        <button id="logout-btn" type="button"
          class="shrink-0 px-3 py-1.5 rounded-md border border-[color:var(--color-border)] text-sm text-[color:var(--color-muted)] hover:border-rose-500/50 hover:text-rose-300 transition">
          로그아웃
        </button>
      </div>
    </section>

    {/* ── 학습 현황 ── */}
    <section class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-[color:var(--color-subtle)]">학습 현황 (개념 숙달)</h2>
        <a href="/" class="text-xs text-[color:var(--color-accent)] hover:underline">대시보드 →</a>
      </div>
      <AccountMastery client:load />
    </section>

    {/* ── 학습자 프로필 (정성, 편집 가능) ── */}
    <section class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5">
      <h2 class="text-sm font-semibold text-[color:var(--color-subtle)] mb-1">학습자 프로필</h2>
      <p class="text-xs text-[color:var(--color-muted)] mb-4">튜터가 이 정보로 설명 깊이를 맞춥니다. 직접 적어두셔도 되고, 대화하다 보면 자동으로 채워집니다.</p>

      <form id="profile-form" class="space-y-4">
        <div>
          <label class="block text-xs text-[color:var(--color-muted)] mb-1" for="self_reported_level">현재 수준 (자기 보고)</label>
          <input id="self_reported_level" name="self_reported_level" type="text" maxlength="200"
            placeholder="예: 수학Ⅰ까지 봤고 미적분은 처음"
            value={profile?.self_reported_level ?? ''}
            class="w-full px-3 py-2 rounded-md bg-[color:var(--color-bg)] border border-[color:var(--color-border)] focus:border-[color:var(--color-accent)] outline-none text-sm" />
        </div>
        <div>
          <label class="block text-xs text-[color:var(--color-muted)] mb-1" for="goals">학습 목표</label>
          <textarea id="goals" name="goals" rows="2" maxlength="500"
            placeholder="예: 6월 모평 미적분 4등급 → 2등급"
            class="w-full px-3 py-2 rounded-md bg-[color:var(--color-bg)] border border-[color:var(--color-border)] focus:border-[color:var(--color-accent)] outline-none text-sm resize-y">{profile?.goals ?? ''}</textarea>
        </div>
        <div>
          <label class="block text-xs text-[color:var(--color-muted)] mb-1" for="learning_pace">학습 페이스</label>
          <input id="learning_pace" name="learning_pace" type="text" maxlength="200"
            placeholder="예: 하루 2시간, 주말 집중"
            value={profile?.learning_pace ?? ''}
            class="w-full px-3 py-2 rounded-md bg-[color:var(--color-bg)] border border-[color:var(--color-border)] focus:border-[color:var(--color-accent)] outline-none text-sm" />
        </div>
        <div>
          <label class="block text-xs text-[color:var(--color-muted)] mb-1" for="notes">메모</label>
          <textarea id="notes" name="notes" rows="3" maxlength="2000"
            placeholder="자유 메모 (튜터에게 전하고 싶은 것 등)"
            class="w-full px-3 py-2 rounded-md bg-[color:var(--color-bg)] border border-[color:var(--color-border)] focus:border-[color:var(--color-accent)] outline-none text-sm resize-y">{profile?.notes ?? ''}</textarea>
        </div>

        <div class="flex items-center gap-3">
          <button type="submit"
            class="px-4 py-2 rounded-md bg-indigo-500/20 border border-indigo-500/40 text-indigo-200 hover:bg-indigo-500/30 transition text-sm font-medium disabled:opacity-50">
            저장
          </button>
          <span id="profile-status" class="text-xs min-h-[1rem]" role="status" aria-live="polite"></span>
        </div>
      </form>

      {/* 자동 감지된 약점 — 튜터가 누적 기록(읽기 전용) */}
      <div class="mt-5 pt-4 border-t border-[color:var(--color-border)]">
        <h3 class="text-xs font-semibold text-[color:var(--color-subtle)] mb-2">튜터가 감지한 약점 패턴</h3>
        <AccountWeakness client:load />
      </div>
    </section>

    {/* ── 위험 구역: 회원 탈퇴 ── */}
    <section class="rounded-lg border border-rose-500/30 bg-rose-500/[0.03] p-5">
      <h2 class="text-sm font-semibold text-rose-300 mb-1">회원 탈퇴</h2>
      <p class="text-xs text-[color:var(--color-muted)] mb-4">
        계정과 모든 학습 데이터(개념 숙달·문제 풀이 기록·대화 이력·학습자 프로필)가 영구히 삭제됩니다.
        이 작업은 되돌릴 수 없습니다.
      </p>
      <button id="delete-account-btn" type="button" data-has-password={hasPassword ? '1' : '0'}
        class="px-3 py-1.5 rounded-md border border-rose-500/40 text-sm text-rose-300 hover:bg-rose-500/10 transition">
        회원 탈퇴하기
      </button>
    </section>
  </div>

  {/* ── 탈퇴 확인 모달 ── */}
  <div id="delete-modal" hidden
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
    role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <div class="w-full max-w-md rounded-lg border border-rose-500/30 bg-[color:var(--color-surface)] p-6 shadow-xl">
      <h3 id="delete-modal-title" class="text-lg font-semibold text-rose-300 mb-2">정말 탈퇴하시겠어요?</h3>
      <p class="text-sm text-[color:var(--color-muted)] mb-4">
        계정과 모든 학습 데이터가 <strong class="text-rose-300">영구히 삭제</strong>되며, 복구할 수 없습니다.
      </p>
      {hasPassword && (
        <div class="mb-4">
          <label class="block text-xs text-[color:var(--color-muted)] mb-1" for="delete-password">비밀번호 확인</label>
          <input id="delete-password" type="password" autocomplete="current-password"
            placeholder="현재 비밀번호"
            class="w-full px-3 py-2 rounded-md bg-[color:var(--color-bg)] border border-[color:var(--color-border)] focus:border-rose-500/60 outline-none text-sm" />
        </div>
      )}
      <p id="delete-error" class="text-xs text-rose-400 min-h-[1rem] mb-3" role="alert" aria-live="polite"></p>
      <div class="flex items-center justify-end gap-3">
        <button id="delete-cancel" type="button"
          class="px-3 py-1.5 rounded-md border border-[color:var(--color-border)] text-sm text-[color:var(--color-muted)] hover:border-[color:var(--color-subtle)] transition">
          취소
        </button>
        <button id="delete-confirm" type="button"
          class="px-3 py-1.5 rounded-md bg-rose-500/20 border border-rose-500/50 text-sm font-medium text-rose-200 hover:bg-rose-500/30 transition disabled:opacity-50">
          영구 삭제
        </button>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('profile-form') as HTMLFormElement | null;
    const status = document.getElementById('profile-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      status.textContent = '저장 중…';
      status.className = 'text-xs min-h-[1rem] text-[color:var(--color-muted)]';
      const fd = new FormData(form);
      try {
        const r = await fetch('/api/profile-update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            self_reported_level: String(fd.get('self_reported_level') ?? ''),
            goals: String(fd.get('goals') ?? ''),
            learning_pace: String(fd.get('learning_pace') ?? ''),
            notes: String(fd.get('notes') ?? ''),
          }),
        });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.ok) {
          status.textContent = '저장되었습니다.';
          status.className = 'text-xs min-h-[1rem] text-emerald-400';
        } else {
          status.textContent = d.error || '저장에 실패했습니다.';
          status.className = 'text-xs min-h-[1rem] text-rose-400';
        }
      } catch {
        status.textContent = '네트워크 오류가 발생했습니다.';
        status.className = 'text-xs min-h-[1rem] text-rose-400';
      }
      btn.disabled = false;
    });

    const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;
    logoutBtn?.addEventListener('click', async () => {
      logoutBtn.disabled = true;
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch { /* 무시하고 로그인으로 */ }
      location.href = '/login';
    });

    // ── 회원 탈퇴 ──
    const modal = document.getElementById('delete-modal');
    const openBtn = document.getElementById('delete-account-btn') as HTMLButtonElement | null;
    const hasPassword = openBtn?.dataset.hasPassword === '1';
    const cancelBtn = document.getElementById('delete-cancel') as HTMLButtonElement | null;
    const confirmBtn = document.getElementById('delete-confirm') as HTMLButtonElement | null;
    const pwInput = document.getElementById('delete-password') as HTMLInputElement | null;
    const errEl = document.getElementById('delete-error');

    function closeModal() {
      if (!modal) return;
      modal.hidden = true;
      if (pwInput) pwInput.value = '';
      if (errEl) errEl.textContent = '';
    }
    openBtn?.addEventListener('click', () => {
      if (!modal) return;
      modal.hidden = false;
      if (errEl) errEl.textContent = '';
      pwInput?.focus();
    });
    cancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal && !modal.hidden) closeModal(); });

    confirmBtn?.addEventListener('click', async () => {
      if (!errEl) return;
      if (hasPassword && !(pwInput?.value)) {
        errEl.textContent = '비밀번호를 입력해 주세요.';
        pwInput?.focus();
        return;
      }
      confirmBtn.disabled = true;
      errEl.textContent = '';
      try {
        const r = await fetch('/api/account/delete', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(hasPassword ? { password: pwInput?.value ?? '' } : {}),
        });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.ok) {
          location.href = '/';
          return;
        }
        errEl.textContent = d.error || '탈퇴에 실패했습니다.';
      } catch {
        errEl.textContent = '네트워크 오류가 발생했습니다.';
      }
      confirmBtn.disabled = false;
    });
  </script>
</BaseLayout>
