---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { groupByRound } from '../../lib/problem-card';
import RoundGrid from '../../components/RoundGrid.astro';

const problems = await getCollection('problems');
const byYear = groupByRound(problems);
// 연도 desc로 평탄화 (각 연도 내부는 roundRank: 수능>평가원>교육청 → 학년 → 월 정렬됨)
const allRounds = [...byYear.values()].flat();

const ofType = (t: string) => allRounds.filter((r) => r.meta.exam_type === t);
// 2022 예시문항은 exam_type이 '수능'이나 실제 시행이 아닌 평가원 통합형 예시 → 분리.
const isYeshi = (r: { meta: { session: string } }) => /예시/.test(r.meta.session ?? '');
const suneung = ofType('수능').filter((r) => !isYeshi(r)); // 실제 시행 본수능
const yeshi = ofType('수능').filter(isYeshi);             // 평가원 예시문항 (시행 아님)
const mopyeong = ofType('모의평가'); // 평가원 6·9월 (고3)
const mock = ofType('모의고사');     // 교육청 학력평가 (고1·고2·고3)

// 모의고사는 학년 소분류 (고3 먼저 — 수능 대비 우선)
const MOCK_GRADES = ['고3', '고2', '고1'];
const mockByGrade = MOCK_GRADES
  .map((grade) => ({ grade, rounds: mock.filter((r) => r.meta.grade === grade) }))
  .filter((x) => x.rounds.length > 0);

const sectionH2 = 'text-lg font-semibold border-b border-[color:var(--color-border)] pb-1.5';
const hint = 'text-xs font-normal text-[color:var(--color-subtle)] ml-1.5';
---
<BaseLayout title="모의시험">
  <div class="max-w-4xl mx-auto px-6 py-6 space-y-8">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">모의시험 모드</h1>
      <p class="text-sm text-[color:var(--color-muted)]">
        실제 기출 회차를 시험지처럼 — 타이머·답안 입력·자동 채점. 고3 회차는 공통 22 + 선택 1과목 8 = 30문항으로 응시합니다(선택과목은 시험 안에서 전환).
      </p>
    </header>

    <section class="card flex items-center justify-between gap-3">
      <div>
        <h2 class="font-semibold">🎲 랜덤 모의시험</h2>
        <p class="text-xs text-[color:var(--color-muted)] mt-0.5">
          코퍼스 전체에서 공통 22 + 선택 8을 난이도 분포 맞춰 무작위 조합
        </p>
      </div>
      <a href="/exam/random" class="chip hover:border-[color:var(--color-accent)] whitespace-nowrap">▶ 시작</a>
    </section>

    {suneung.length > 0 && (
      <section class="space-y-2">
        <h2 class={sectionH2}>수능<span class={hint}>대학수학능력시험</span></h2>
        <RoundGrid rounds={suneung} />
      </section>
    )}

    {yeshi.length > 0 && (
      <section class="space-y-2">
        <h2 class={sectionH2}>예시문항<span class={hint}>평가원 통합형 수능 예시 · 실제 시행 아님</span></h2>
        <RoundGrid rounds={yeshi} />
      </section>
    )}

    {mopyeong.length > 0 && (
      <section class="space-y-2">
        <h2 class={sectionH2}>모의평가<span class={hint}>모평 · 평가원 6·9월</span></h2>
        <RoundGrid rounds={mopyeong} />
      </section>
    )}

    {mock.length > 0 && (
      <section class="space-y-3">
        <h2 class={sectionH2}>모의고사<span class={hint}>교육청 학력평가</span></h2>
        {mockByGrade.map((g) => (
          <div class="space-y-2">
            <h3 class="text-sm font-medium text-[color:var(--color-muted)]">{g.grade}</h3>
            <RoundGrid rounds={g.rounds} />
          </div>
        ))}
      </section>
    )}
  </div>
</BaseLayout>
