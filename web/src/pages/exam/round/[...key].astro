---
// Phase 3 전환 5호 — 구성은 `/api/exam/round/<key>` 가 하고 여기는 껍데기만.
//
// ★`<title>` 은 회차명을 데이터에서 알아야 하므로 서버가 채울 수 없다. 일반 제목으로 두고
//   로더가 받은 뒤 `document.title` 을 갱신한다. 라우트 스냅샷은 그래도 title 로 신호를 낸다.
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExamRoundLoader from '../../../components/ExamRoundLoader.tsx';

const key = String(Astro.params.key ?? '');
if (!key) return Astro.redirect('/problems');
---
<BaseLayout title="모의시험">
  <ExamRoundLoader client:load examKey={key} />
</BaseLayout>
