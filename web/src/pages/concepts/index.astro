---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import { getCollection } from 'astro:content';

const DOMAIN_ORDER = ['수와식', '방정식', '함수', '도형', '확률통계', '논리'];
const DOMAIN_COLOR: Record<string, string> = {
  '수와식':   '#f59e0b',
  '방정식':   '#ef4444',
  '함수':     '#3b82f6',
  '도형':     '#22d3ee',
  '확률통계': '#ec4899',
  '논리':     '#a78bfa',
};
const GRADE_COLOR: Record<string, string> = {
  '중1': '#94a3b8', '중2': '#64748b', '중3': '#475569',
  '고1': '#a78bfa', '수학1': '#8b5cf6', '수학2': '#7c3aed',
  '미적분': '#6d28d9', '기하': '#22d3ee', '확률과통계': '#ec4899',
};

const concepts = await getCollection('concepts');

// Group by domain (학습 본질) — grade is shown as secondary chip
const byDomain: Record<string, typeof concepts> = {};
for (const c of concepts) {
  const d = c.data.domain ?? 'misc';
  (byDomain[d] ??= []).push(c);
}
for (const d of Object.keys(byDomain)) {
  byDomain[d].sort((a, b) => {
    // units first, then alphabetical
    const au = a.data.concept_type === 'unit' ? 0 : 1;
    const bu = b.data.concept_type === 'unit' ? 0 : 1;
    if (au !== bu) return au - bu;
    return a.id.localeCompare(b.id, 'ko-KR');
  });
}

const byMastery = { unknown: 0, learning: 0, proficient: 0, mastered: 0 } as Record<string, number>;
for (const c of concepts) byMastery[c.data.mastery]++;
const byType = { unit: 0, definition: 0, theorem: 0, lemma: 0, example: 0 } as Record<string, number>;
for (const c of concepts) byType[c.data.concept_type]++;

const orderedDomains = [
  ...DOMAIN_ORDER.filter((d) => byDomain[d]),
  ...Object.keys(byDomain).filter((d) => !DOMAIN_ORDER.includes(d)),
];
---
<BaseLayout title="Concepts">
  <div class="max-w-6xl mx-auto px-6 py-8 space-y-6">
    <header class="space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight">Concepts <span class="text-xs text-[color:var(--color-muted)] font-normal">— 도메인별</span></h1>
      <p class="text-sm text-[color:var(--color-muted)]">
        {concepts.length}개 노드 · unit {byType.unit} / definition {byType.definition} / theorem {byType.theorem} / example {byType.example}
      </p>
      <div class="flex items-center gap-2 text-xs flex-wrap">
        <span class="chip chip-mastery-unknown">unknown {byMastery.unknown}</span>
        <span class="chip chip-mastery-learning">learning {byMastery.learning}</span>
        <span class="chip chip-mastery-proficient">proficient {byMastery.proficient}</span>
        <span class="chip chip-mastery-mastered">mastered {byMastery.mastered}</span>
      </div>
    </header>

    {concepts.length === 0 ? (
      <p class="text-sm text-[color:var(--color-muted)] py-12 text-center">아직 개념이 없습니다.</p>
    ) : (
      orderedDomains.map((d) => (
        <section class="space-y-3">
          <header class="flex items-baseline gap-3 sticky top-16 bg-[color:var(--color-bg)]/85 backdrop-blur py-2 -mx-6 px-6 z-10 border-b border-[color:var(--color-border)]">
            <h2 class="text-base font-semibold flex items-center gap-2">
              <span class="size-2.5 rounded-full inline-block" style={`background:${DOMAIN_COLOR[d] ?? '#71717a'}`}></span>
              {d}
            </h2>
            <span class="text-xs text-[color:var(--color-muted)]">{byDomain[d].length}개 노드 ({byDomain[d].filter(c => c.data.concept_type === 'unit').length} units)</span>
          </header>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {byDomain[d].map((c) => (
              <li>
                <ConceptCard
                  href={`/concepts/${c.id}`}
                  title={c.id.replace(/_/g, ' ')}
                  chips={[
                    { label: c.data.mastery, class: `chip-mastery-${c.data.mastery}` },
                    { label: c.data.concept_type, class: '' },
                    ...(c.data.grade ? [{ label: c.data.grade, class: '' }] : []),
                  ]}
                  meta={[
                    { key: '선수', value: c.data.prerequisites.length > 0 ? c.data.prerequisites.map((p) => p.split('/').pop()?.replace(/\.md$/, '').replace(/_/g, ' ')).join(', ') : '—' },
                    { key: '다음', value: c.data.enables.length > 0 ? c.data.enables.map((p) => p.split('/').pop()?.replace(/\.md$/, '').replace(/_/g, ' ')).join(', ') : '—' },
                  ]}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</BaseLayout>
