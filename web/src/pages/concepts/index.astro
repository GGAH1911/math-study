---
// Phase 3 전환 8호(B그룹 마지막) — 껍데기는 서버, 나머지는 `/api/concepts-overview`.
//
// ★이 화면은 목록이 아니라 대시보드다. 계산(사용자별 mastery·단원 진행도·추천·요약·기출 수·
//   단원↔스포크 매칭)은 전부 `lib/concepts-overview.ts` 에 있고 API 가 완성된 트리를 준다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptsOverview from '../../components/ConceptsOverview.tsx';
---
<BaseLayout title="개념">
  <div class="max-w-6xl mx-auto px-6 py-6 space-y-5">
    <header class="space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight">
        개념
        <span class="text-xs text-[color:var(--color-muted)] font-normal">— 과목 → 단원 → 하위 개념</span>
      </h1>
    </header>

    <ConceptsOverview client:load />
  </div>
</BaseLayout>

<style is:global>
  /* ★`ConceptCard.astro` 의 스코프 스타일과 이 페이지의 스타일을 전역으로 옮겼다 —
     React 아일랜드는 Astro 의 스코프 `<style>` 을 못 쓴다. */
  .concept-card { --hover-border: color-mix(in oklab, var(--color-primary, #3b82f6) 50%, transparent); }
  .concept-card:hover { border-color: var(--hover-border); }
  .concept-card-unit { border-left-width: 3px; }

  /* 펼쳐진 도메인 본문만 content-visibility 로 오프스크린 페인트 스킵.
     접힌 본문은 display:none 이라 공간을 차지하지 않는다(섹션에 걸면 접혀도 예약돼 빈 공간). */
  .concept-domain-body { content-visibility: auto; contain-intrinsic-size: 800px 2000px; }

  /* 필터가 숨길 때 — DOM 은 남기고 흐름에서만 뺀다. */
  .concept-card-wrap.filtered-out,
  .concept-domain-section.filtered-out,
  .concept-unit-group.filtered-out { display: none !important; }

  /* 도메인(과목) 접기 + 단원 접기 — ConceptFilters 가 .collapsed 토글. */
  .concept-domain-body.collapsed,
  .concept-spokes.collapsed { display: none !important; }
</style>
