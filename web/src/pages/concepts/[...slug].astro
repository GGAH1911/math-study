---
// SSR (prerender=false) — mastery 승급 같은 frontmatter 변경이 즉시 페이지에
// 반영되도록. Astro content collection은 내부 캐시가 있어 외부에서 file을
// write해도 SSR 시 stale 값을 반환할 수 있으므로, mastery 같은 빠르게
// 변하는 필드는 fs에서 직접 다시 읽어 override한다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import TutorChat from '../../components/TutorChat.astro';
import ContextDrawer from '../../components/ContextDrawer.astro';
import RegenerateBodyButton from '../../components/RegenerateBodyButton.tsx';
import LearningNoteButton from '../../components/LearningNoteButton.tsx';
import { getMastery } from '../../lib/mastery.ts';

const slug = Astro.params.slug as string;
const entry = await getEntry('concepts', slug);
if (!entry) {
  // flat-leaf → 정식(nested) 경로 폴백. 문제·본문 링크가 `/concepts/<leaf>` 로 걸려도
  // 개념이 nested 경로(domain/grade/unit/<leaf>)에만 있으면 404 나던 것을, leaf 가
  // 같은 정식 노드로 302 리다이렉트해 살린다. (노드 다이어트로 flat→nested 이동 다수.)
  const leafKey = (s: string) => (s.split('/').pop() ?? s).normalize('NFC').replace(/[\s_]/g, '').toLowerCase();
  const leaf = leafKey(slug);
  const all = await getCollection('concepts');
  const match = all.find((c) => leafKey(c.id) === leaf);
  // Location 헤더는 ASCII만 허용 → 한글 경로 URL 인코딩(/ 는 보존).
  if (match) return Astro.redirect(encodeURI(`/concepts/${match.id}`), 302);
  return new Response('Not found', { status: 404 });
}
const { Content } = await render(entry);
const fm = { ...entry.data } as typeof entry.data;

// 멀티유저: mastery 는 frontmatter(전역)가 아니라 로그인 사용자의 concept_mastery
// 에서 읽는다. (페이지는 미들웨어 게이팅 하 SSR → Astro.locals.user 존재.)
const um = Astro.locals.user ? await getMastery(Astro.locals.user.id, entry.id) : null;
fm.mastery = (um?.mastery ?? 'unknown') as typeof fm.mastery;
if (um?.mastery_updated) {
  const d = new Date(um.mastery_updated);
  if (!isNaN(d.getTime())) fm.mastery_updated = d;
}

// sub-dir 호환: 'docs/concepts/algebra/근의_공식.md' → 'algebra/근의_공식'
const fmtPath = (p: string) => p.replace(/^docs\/concepts\//, '').replace(/\.md$/, '');
// 표시용 라벨은 마지막 segment 만
const prettySlug = (s: string) => (s.split('/').pop() ?? s).replace(/_/g, ' ');

// 타입별 그루핑 — 노드 맵의 라벨/순서와 동일.
import { TYPE_LABEL_KO as TYPE_LABEL, TYPE_ORDER, MASTERY_LABEL_KO } from '../../lib/concept-meta';
import { REVIEW_STATE_LABEL_KO } from '../../lib/srs.ts';

// 모든 concept frontmatter를 한 번에 로드해 link slug → concept_type 매핑.
const all = await getCollection('concepts');
const typeBySlug = new Map<string, string>();
for (const c of all) typeBySlug.set(c.id, c.data.concept_type ?? 'other');

// flat leaf → full 중첩 slug. prerequisites/enables 가 flat slug(`이차함수`)로 저장돼
// `/concepts/이차함수` 가 404 나는 것을, 실제 c.id(`functions/middle-3/이차함수`)로
// 해석해 고친다. (readdir NFD 대비 NFC 정규화. 같은 leaf 중복 시 첫 매칭 우선.)
const leafToFull = new Map<string, string>();
for (const c of all) {
  const leaf = (c.id.split('/').pop() ?? c.id).normalize('NFC');
  if (!leafToFull.has(leaf)) leafToFull.set(leaf, c.id);
}

function groupByType(paths: string[]): { type: string; label: string; items: { slug: string; label: string }[] }[] {
  const buckets: Record<string, { slug: string; label: string }[]> = {};
  for (const p of paths) {
    let slug = fmtPath(p);
    // flat slug 면 실제 중첩 slug 로 해석(prerequisites/enables 가 flat 저장 → 404 보정).
    if (!typeBySlug.has(slug)) {
      const full = leafToFull.get((slug.split('/').pop() ?? slug).normalize('NFC'));
      if (full) slug = full;
    }
    const t = typeBySlug.get(slug) ?? 'other';
    buckets[t] = buckets[t] ?? [];
    buckets[t].push({ slug, label: prettySlug(slug) });
  }
  // 알려진 type 순서대로 + 그 외 type을 알파벳 순으로
  const knownOrder = TYPE_ORDER.filter((t) => buckets[t]?.length);
  const otherTypes = Object.keys(buckets).filter((t) => !(TYPE_ORDER as readonly string[]).includes(t)).sort();
  return [...knownOrder, ...otherTypes].map((t) => ({
    type: t,
    label: TYPE_LABEL[t] ?? t,
    items: buckets[t].sort((a, b) => a.label.localeCompare(b.label, 'ko')),
  }));
}

const prereqGroups = groupByType(fm.prerequisites);
const enablesGroups = groupByType(fm.enables);

// 개념 도식 — gen_concept_figures.mjs 가 haiku(단계별·sympy 검증)로 생성·캐시한 좌표정확
// Geometry spec. 축·눈금 숨김으로 본문 위에 교과서 도식처럼 렌더. 없으면(미생성·도식불필요) 생략.
import conceptFigures from '../../data/concept-figures.json';
import Geometry from '../../components/Geometry.tsx';
import Geometry3D from '../../components/Geometry3D.tsx';
const _figEntry = (conceptFigures as any).figures?.[entry.id];
const conceptFigure = _figEntry?.figure ?? null;
// 3D(입체) 개념은 Geometry3D(R3F) 로 — gen_concept_figures --include-3d 가 figure3d 키로 캐시.
const conceptFigure3d = _figEntry?.figure3d ?? null;

// "이 개념의 기출 문제" — predev로 빌드된 problems-by-concept 인덱스에서 로드.
import problemIndex from '../../data/problems-by-concept.json';
type ProblemBrief = {
  slug: string; year: number | null; exam_type: string | null; session: string | null;
  grade: string | null; subject: string | null; number: number | null; score: number | null;
  killer_tier: string | null; format: string | null; has_image: boolean;
};
const linkedProblemsRaw: ProblemBrief[] = (problemIndex as any).byConcept?.[slug] ?? [];

// 진도(학년 수준) 근접 정렬 — 개념 수준에 가까운 기출이 먼저, 진도 한참 앞선 문제는 뒤로.
// (기존엔 killer 우선이라 중1 개념에도 수능 킬러가 맨 위에 떠 "너무 앞선 문제" 문제 발생.)
// 개념 수준은 경로(.../middle-1/.., /calculus/..)에서 산출 → frontmatter grade → 기본 고1.
function levelFromPath(id: string): number {
  if (/\/middle-1\//.test(id)) return 1;
  if (/\/middle-2\//.test(id)) return 2;
  if (/\/middle-3\//.test(id)) return 3;
  if (/\/high-1\//.test(id)) return 4;
  if (/\/math-[12]\//.test(id)) return 5;
  if (/\/(calculus|geometry-elective|prob-stats-elective)\//.test(id)) return 6;
  const GL: Record<string, number> = { '중1': 1, '중2': 2, '중3': 3, '고1': 4, '수학1': 5, '수학2': 5, '미적분': 6, '기하': 6, '확률과통계': 6 };
  return GL[fm.grade ?? ''] ?? 4;
}
const conceptLevel = levelFromPath(entry.id);
function problemLevel(p: ProblemBrief): number {
  if (p.exam_type === '수능' || p.exam_type === '평가원') return 6; // 고3 수준
  const g = p.grade ?? '';
  if (g.includes('고3')) return 6;
  if (g.includes('고2')) return 5;
  if (g.includes('고1')) return 4;
  if (g.includes('중3')) return 3;
  if (g.includes('중2')) return 2;
  if (g.includes('중1')) return 1;
  return 5;
}
const TIER_RANK: Record<string, number> = { early: 0, mid: 1, high: 2, killer: 3 };
const linkedProblems: ProblemBrief[] = [...linkedProblemsRaw].sort((a, b) => {
  const da = Math.abs(problemLevel(a) - conceptLevel), db = Math.abs(problemLevel(b) - conceptLevel);
  if (da !== db) return da - db;                                  // 1) 학년 근접
  const ta = TIER_RANK[a.killer_tier ?? ''] ?? 1, tb = TIER_RANK[b.killer_tier ?? ''] ?? 1;
  if (ta !== tb) return ta - tb;                                  // 2) 쉬운 것부터
  return (b.year ?? 0) - (a.year ?? 0);                           // 3) 최신순
});

// 이 페이지에서 promote 된 학습 노트 목록 (build-syntheses-index.mjs 산출물).
import synthesesIndex from '../../data/syntheses-by-concept.json';
type SynthesisBrief = { slug: string; title: string; created: string | null; review_state: string | null; excerpt: string | null };
const linkedSyntheses: SynthesisBrief[] = (synthesesIndex as any).byConcept?.[slug] ?? [];

const TIER_LABEL: Record<string, { text: string; cls: string }> = {
  killer: { text: '상', cls: 'bg-rose-500/20 text-rose-300 border-rose-500/40' },
  high:   { text: '상', cls: 'bg-amber-500/20 text-amber-300 border-amber-500/40' },
  mid:    { text: '중',  cls: 'bg-sky-500/20 text-sky-300 border-sky-500/40' },
  early:  { text: '하', cls: 'bg-zinc-600/30 text-zinc-300 border-zinc-600' },
};
function tierBadge(t: string | null) {
  return TIER_LABEL[t ?? ''] ?? { text: '기타', cls: 'bg-zinc-700/30 text-zinc-400 border-zinc-700' };
}
function problemLabel(p: ProblemBrief): string {
  const yearShort = p.year ? String(p.year).slice(2) : '';
  const subj = p.subject && p.subject !== '단일' && p.subject !== '공통' ? ` ${p.subject}` : '';
  const session = p.session ? ` ${p.session}` : '';
  const exam = p.exam_type ?? '';
  const grade = p.grade && p.exam_type !== '수능' ? ` ${p.grade}` : '';
  return `${yearShort}${grade}${session} ${exam}${subj} ${p.number ?? '?'}번`.trim();
}
const PREVIEW_COUNT = 8;
---
<BaseLayout title={entry.id}>
  <div class="max-w-6xl mx-auto px-6 md:max-xl:pr-14 py-8 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-8">
    <article class="max-w-none min-w-0">
      {(conceptFigure || conceptFigure3d) && (
        // 도식 슬롯 — 3D(입체)와 2D(평면) 둘 다 있으면 둘 다 보여준다(사장님 지시): 3D 먼저(입체가
        // 개념의 핵심), 2D 보조. relocate 스크립트가 conceptFigureSlot 을 본문 직전으로 옮긴다.
        <figure id="conceptFigureSlot" class="not-prose my-6 flex flex-col items-center gap-3">
          {conceptFigure3d && (
            // 3D: Geometry3D(R3F). client:only(SSR 불가). 드래그로 회전.
            <div class="w-full flex justify-center rounded-lg border border-zinc-700/60 bg-zinc-950/40 p-3">
              <Geometry3D client:only="react" spec={conceptFigure3d} width={720} height={480} hideCaption />
            </div>
          )}
          {conceptFigure && (
            // 2D: 평면 단면/투영 도식. width 크게 줘 컨테이너 폭이 실효폭 결정(Geometry 부모폭 측정).
            <div class="w-full flex justify-center rounded-lg border border-zinc-700/60 bg-zinc-950/40 p-3">
              <Geometry client:load spec={conceptFigure} width={1400} height={760} hideCaption />
            </div>
          )}
        </figure>
      )}
      <div class="prose prose-invert max-w-none" id="conceptBody">
        <Content />
      </div>
      {(conceptFigure || conceptFigure3d) && (
        // 도식을 본문 적절한 위치로 이동 — 제목/요약 다음, 상세 본문(## 본문) 직전.
        // island 하이드레이션 전(파싱 중)에 실행돼 깜빡임/하이드레이션-이동 문제 없음.
        // 대상 없으면 breadcrumb 다음, 그것도 없으면 상단 그대로(폴백).
        <script is:inline>
          (function () {
            var fig = document.getElementById('conceptFigureSlot');
            var body = document.getElementById('conceptBody');
            if (!fig || !body) return;
            var h2 = Array.prototype.find.call(body.querySelectorAll('h2'), function (h) {
              return (h.textContent || '').trim().indexOf('본문') === 0;
            });
            if (h2) { body.insertBefore(fig, h2); return; }
            var bq = body.querySelector('blockquote');
            if (bq) { bq.parentNode.insertBefore(fig, bq.nextSibling); }
          })();
        </script>
      )}
    </article>

    {/* 튜터 대화 — 본문 하단 인라인 폐지. 모든 화면에서 우측 하단 FAB → 큰 대화창. */}
    <TutorChat slug={entry.id} unitTitle={fm.unit ?? entry.id} collection="concepts" fab="always" />


    <ContextDrawer label="기출 · 개념지도 · 노트" icon="📑">
      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">메타정보</h3>
        <dl class="text-sm space-y-1.5">
          <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">유형</dt><dd>{TYPE_LABEL[fm.concept_type] ?? fm.concept_type}</dd></div>
          {fm.domain && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">과목</dt><dd>{fm.domain}</dd></div>}
          {fm.grade && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">학년·과정</dt><dd>{fm.grade}</dd></div>}
          {fm.unit && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">단원</dt><dd>{fm.unit}</dd></div>}
          {fm.subunit && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">소단원</dt><dd>{fm.subunit}</dd></div>}
          <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">숙련도</dt><dd><span id="masteryChip" class={`chip chip-mastery-${fm.mastery}`}>{MASTERY_LABEL_KO[fm.mastery] ?? fm.mastery}</span></dd></div>
          {fm.review_state && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">복습 상태</dt><dd>{REVIEW_STATE_LABEL_KO[fm.review_state] ?? fm.review_state}</dd></div>}
          {fm.next_review && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">다음 복습</dt><dd>{fm.next_review.toISOString().slice(0,10)}</dd></div>}
          {fm.updated && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">수정일</dt><dd>{fm.updated.toISOString().slice(0,10)}</dd></div>}
        </dl>
      </section>

      {prereqGroups.length > 0 && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">선수 개념</h3>
          <div class="space-y-3 text-sm">
            {prereqGroups.map((g) => (
              <div>
                <div class="text-[10px] uppercase tracking-wider text-[color:var(--color-muted)] mb-1">{g.label}</div>
                <ul class="space-y-1 pl-1">
                  {g.items.map((it) => (
                    <li><a class="text-[color:var(--color-accent)] hover:underline" href={`/concepts/${it.slug}`}>← {it.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}

      {enablesGroups.length > 0 && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">후속 개념</h3>
          <div class="space-y-3 text-sm">
            {enablesGroups.map((g) => (
              <div>
                <div class="text-[10px] uppercase tracking-wider text-[color:var(--color-muted)] mb-1">{g.label}</div>
                <ul class="space-y-1 pl-1">
                  {g.items.map((it) => (
                    <li><a class="text-[color:var(--color-accent)] hover:underline" href={`/concepts/${it.slug}`}>{it.label} →</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}

      {linkedProblems.length > 0 && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">
            {fm.concept_type === 'unit' ? `이 단원의 기출 (${linkedProblems.length})` : `이 개념의 기출 (${linkedProblems.length})`}
          </h3>
          <ul class="space-y-1.5 text-sm">
            {linkedProblems.slice(0, PREVIEW_COUNT).map((p) => {
              const t = tierBadge(p.killer_tier);
              return (
                <li class="flex items-center gap-2">
                  <span class={`text-[10px] px-1.5 py-0.5 rounded border ${t.cls} shrink-0`}>{t.text}</span>
                  <a class="text-[color:var(--color-accent)] hover:underline truncate flex-1" href={`/problems/${p.slug}`}>
                    {problemLabel(p)}
                  </a>
                  {p.score && <span class="text-[10px] text-zinc-500 tabular-nums">{p.score}점</span>}
                </li>
              );
            })}
          </ul>
          {linkedProblems.length > PREVIEW_COUNT && (
            <details class="mt-2">
              <summary class="text-xs text-[color:var(--color-muted)] cursor-pointer hover:text-zinc-300">+ {linkedProblems.length - PREVIEW_COUNT}개 더 보기</summary>
              <ul class="mt-2 space-y-1.5 text-sm">
                {linkedProblems.slice(PREVIEW_COUNT).map((p) => {
                  const t = tierBadge(p.killer_tier);
                  return (
                    <li class="flex items-center gap-2">
                      <span class={`text-[10px] px-1.5 py-0.5 rounded border ${t.cls} shrink-0`}>{t.text}</span>
                      <a class="text-[color:var(--color-accent)] hover:underline truncate flex-1" href={`/problems/${p.slug}`}>
                        {problemLabel(p)}
                      </a>
                      {p.score && <span class="text-[10px] text-zinc-500 tabular-nums">{p.score}점</span>}
                    </li>
                  );
                })}
              </ul>
            </details>
          )}
        </section>
      )}

      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">개념 지도</h3>
        <a href={`/graph?node=${encodeURIComponent(entry.id)}`} class="block text-center px-3 py-2 rounded-md bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-sm font-medium transition">
          개념 지도에서 보기 →
        </a>
      </section>

      <LearningNoteButton client:load slug={entry.id} unitTitle={fm.unit ?? entry.id} collection="concepts" />

      {linkedSyntheses.length > 0 && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2 flex items-center gap-1.5">
            <span aria-hidden>🗒</span>
            <span>저장된 노트</span>
            <span class="ml-auto text-[10px] font-mono text-[color:var(--color-subtle)]">{linkedSyntheses.length}</span>
          </h3>
          <ul class="space-y-2 text-sm">
            {linkedSyntheses.slice(0, 8).map((s) => (
              <li>
                <a class="text-[color:var(--color-accent)] hover:underline block leading-tight" href={`/syntheses/${encodeURIComponent(s.slug)}`}>
                  {s.title}
                </a>
                <div class="flex items-center gap-2 mt-0.5 text-[10px] text-[color:var(--color-subtle)]">
                  {s.created && <span>{s.created}</span>}
                  {s.review_state && <span class="chip">{s.review_state}</span>}
                </div>
              </li>
            ))}
            {linkedSyntheses.length > 8 && (
              <li class="text-[10px] text-[color:var(--color-subtle)] pt-1 border-t border-[color:var(--color-border)]/40">
                +{linkedSyntheses.length - 8}개 더 — <a class="text-[color:var(--color-accent)] hover:underline" href="/syntheses">전체 보기</a>
              </li>
            )}
          </ul>
        </section>
      )}

      {fm.concept_type !== 'unit' && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">본문 갱신</h3>
          <RegenerateBodyButton client:load slug={entry.id} noteCount={linkedSyntheses.length} />
        </section>
      )}
    </ContextDrawer>
  </div>

  <script define:vars={{ conceptSlug: entry.id }}>
    // PromotionCard 가 mastery 적용 시 보내는 이벤트로 사이드바 mastery 칩을 리로드 없이
    // 즉시 갱신(리로드는 대화의 promote 펜스 재프롬프트 루프를 유발하므로 제거됨).
    window.addEventListener('math-study:mastery-applied', (e) => {
      const d = e.detail;
      if (!d || d.slug !== conceptSlug) return;
      const chip = document.getElementById('masteryChip');
      const KO = { unknown: '미습득', learning: '학습중', proficient: '능숙', mastered: '마스터' };
      if (chip) { chip.textContent = KO[d.to] ?? d.to; chip.className = `chip chip-mastery-${d.to}`; }
    });
  </script>
</BaseLayout>
