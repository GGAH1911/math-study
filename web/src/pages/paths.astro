---
// Phase 3 C그룹 — 계산은 `/api/learning-path`(그래프 알고리즘·사용자 mastery).
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningPath from '../components/LearningPath.tsx';

const goal = Astro.url.searchParams.get('goal') ?? '';
---
<BaseLayout title="학습 경로">
  <div class="max-w-4xl mx-auto px-6 py-8 space-y-6">
    <header>
      <h1 class="text-2xl font-semibold tracking-tight">학습 경로</h1>
      <p class="text-sm text-[color:var(--color-muted)] mt-1">
        목표 개념을 고르면, 아직 익히지 않은 <strong>선행 개념</strong>을 학습 순서(선행 → 목표)대로 위상정렬해 보여줍니다.
      </p>
    </header>

    <LearningPath client:load goal={goal} />
  </div>
</BaseLayout>
