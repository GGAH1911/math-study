---
// Phase 3 C그룹 — 데이터는 `/api/concept-graph`(그래프 + 사용자 mastery + 노트수).
// ★`/concepts` 카드는 `?highlight=`, 기존 북마크는 `?node=` 를 쓴다 — 둘 다 받는다.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptGraphView from '../components/ConceptGraphView.tsx';

const highlight =
  Astro.url.searchParams.get('highlight') ??
  Astro.url.searchParams.get('node') ??
  undefined;
---
<BaseLayout title="개념 지도" containerClass="h-[calc(100vh-3.5rem)]">
  <div class="h-full">
    <ConceptGraphView client:load highlight={highlight} />
  </div>
</BaseLayout>
