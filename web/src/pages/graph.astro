---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptDAG from '../components/ConceptDAG.tsx';
import { readConceptGraph } from '../lib/health.ts';
import { getMasteryMap } from '../lib/mastery.ts';

import synthesesIndex from '../data/syntheses-by-concept.json';

const graph = readConceptGraph();
// 멀티유저: 로그인 사용자의 mastery 를 노드에 오버레이(전역 그래프값 대신).
const masteryMap = Astro.locals.user ? await getMasteryMap(Astro.locals.user.id) : new Map<string, string>();
// 노트 카운트 (concept slug → 개수)를 노드에 주입해서 그래프가 `🗒N` 배지를 그릴 수 있게.
const notesByConcept: Record<string, unknown[]> = (synthesesIndex as any).byConcept ?? {};
const annotatedGraph = {
  ...graph,
  nodes: graph.nodes.map((n: any) => ({
    ...n,
    mastery: masteryMap.get(n.id) ?? 'unknown',
    note_count: notesByConcept[n.id]?.length ?? 0,
  })),
};
// /concepts 카드는 ?highlight=를, 기존 북마크는 ?node=를 쓸 수 있어 둘 다 받음.
const highlight =
  Astro.url.searchParams.get('highlight') ??
  Astro.url.searchParams.get('node') ??
  undefined;
---
<BaseLayout title="개념 지도" containerClass="h-[calc(100vh-3.5rem)]">
  <div class="h-full">
    {graph.stats.nodes > 0 ? (
      <ConceptDAG client:load data={annotatedGraph} variant="full" highlight={highlight} />
    ) : (
      <div class="flex items-center justify-center h-full text-[color:var(--color-muted)]">
        <div class="text-center">
          <div class="text-5xl mb-3">◈</div>
          <p class="text-lg">아직 개념 지도가 비어 있습니다.</p>
          <p class="text-sm mt-1">docs/concepts/ 에 첫 개념을 시드해주세요.</p>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
