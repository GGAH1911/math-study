---
// Phase 3 전환 6호 — 껍데기는 서버, 목록·필터는 클라이언트(`/api/content-index/problems`).
// 단원→과목 매핑은 방출기가 `concept-graph.json` 에서 만들어 목록에 `unitDomain` 으로 얹어 준다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProblemsByUnit from '../../components/ProblemsByUnit.tsx';
---
<BaseLayout title="기출 — 단원별">
  <div class="max-w-6xl mx-auto px-6 py-6 space-y-5">
    <header class="space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight">
        기출 <span class="text-xs text-[color:var(--color-muted)] font-normal">— 단원별</span>
      </h1>
      <nav class="flex gap-1.5 text-sm">
        <a href="/problems" class="chip opacity-50 hover:opacity-100">회차별</a>
        <a href="/problems/units" class="chip border-[color:var(--color-text)]/40">단원별</a>
      </nav>
    </header>

    <ProblemsByUnit client:load />
  </div>
</BaseLayout>

<style is:global>
  /* ★`ProblemCard.astro` 의 컴포넌트 스코프 스타일을 여기로 옮겼다 — React 아일랜드는
     Astro 의 스코프 `<style>` 을 못 쓴다. 클래스 이름은 `ProblemCard.tsx` 와 동일하다.
     ⚠️ 클래스를 바꾸려면 양쪽을 같이 고칠 것. */
  .problem-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: border-color 150ms ease;
  }
  .problem-card:hover { border-color: var(--color-accent); }
  .thumb-wrap {
    position: relative;
    height: 160px;
    overflow: hidden;
    /* 짧은 문제는 이미지가 박스보다 짧아 하단에 배경이 드러난다. 라이트는 흰 스캔과 흰 배경이
       맞아 안 보이지만, 다크는 스캔이 invert 돼 흑연이 되는데 배경만 white 라 '로딩 끊긴 듯'
       흰 띠가 생겼다. 다크에선 배경도 invert 된 종이톤으로 맞춘다. */
    background: white;
    border-bottom: 1px solid var(--color-border);
  }
  html.dark .thumb-wrap { background: #141414; }
  /* 썸네일 = 문제 이미지를 좌우 꽉 채워 상단만 보여준다. object-fit:cover 는 긴 문제를
     확대-크롭해 무슨 문제인지 안 보였다 → 원본 비율 유지, 넘치는 하단은 wrap 이 클립. */
  .thumb {
    width: 100%;
    height: auto;
    display: block;
    filter: invert(0.92) hue-rotate(180deg);
  }

  /* 필터로 빈 그룹/섹션 숨김 + 과목/단원 접힘. */
  .problem-card-wrap.filtered-out,
  .problem-unit-group.filtered-out,
  .problem-domain-section.filtered-out { display: none !important; }
  .pdomain-body.collapsed,
  .punit-problems.collapsed { display: none !important; }
  /* content-visibility 는 펼쳐진 본문에만 — 섹션에 걸면 접혀도 공간을 예약해 빈 틈이 생긴다. */
  .pdomain-body { content-visibility: auto; contain-intrinsic-size: 600px 1200px; }
</style>
