---
// SSR — frontmatter 변경 (audit/fix) 시 즉시 반영. prerender=true 면 dev 시작
// 시점 캐시라 stale. concept 페이지와 동일 패턴.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';
import TutorChat from '../../components/TutorChat.astro';
import ProblemAttemptPanel from '../../components/ProblemAttemptPanel.tsx';
import InkCanvas from '../../components/InkCanvas.tsx';   // 손풀이 필기 캔버스(펜·태블릿, 자동저장)
import SolutionPanel from '../../components/SolutionPanel.tsx';
import RoundNav from '../../components/RoundNav.astro';
import { yearLabel, FORMAT_LABEL, TIER_BADGE } from '../../lib/problem-meta';
import { STATUS_LABEL_KO } from '../../lib/srs.ts';
import { renderReconstruct } from '../../lib/reconstruct';
import Geometry from '../../components/Geometry.tsx';
import reconData from '../../data/problem-reconstructions.json';
import { hasWidget } from '../../lib/concept-widgets';

const slug = Astro.params.slug as string;
const entry = await getEntry('problems', slug);
if (!entry) {
  return new Response('Not found', { status: 404 });
}
const { Content } = await render(entry);
const fm = entry.data;
// 재구성 뷰: searchable_text(로제타 기하 디코드)를 KaTeX 로 렌더 (원본 이미지 토글용)
// 도형은 figure_after_line(추출 시 PDF 세로 위치로 계산된 줄) 뒤에 삽입; 없으면 첫 줄 뒤.
// 도형: 추출 PNG(figure_image) 우선. 없으면(선택과목 등 추출불가) 원본 전체이미지 폴백 —
// /problem-images/<stem>.png 은 db/raw 이미지의 public 심링크(도형 포함 전체 문제, 과목별 정상).
const figFull =
  !fm.figure_image && !(fm.figures && fm.figures.length) && fm.has_figure && fm.image_paths && fm.image_paths[0]
    ? `/problem-images/${String(fm.image_paths[0]).split('/').pop()}`
    : null;
const figSrc = fm.figure_image || figFull;
const figDivOf = (src: string, full = false) =>
  `<div class="recon-fig-wrap"><img src="${src}" alt="도형" class="recon-fig${full ? ' recon-fig-full' : ''}" loading="lazy" />${full ? '<span class="recon-fig-note">원본 전체 이미지 (도형만 추출 불가)</span>' : ''}</div>`;
// 다중 그림(figures: [{image, after_line}]) 우선 → 각자 위치에 삽입. 없으면 단일 figure_image/전체이미지 폴백.
const figureList = Array.isArray(fm.figures) && fm.figures.length
  ? (fm.figures as any[]).map((f) => ({ html: figDivOf(String(f.image)), afterLine: f.after_line }))
  : (figSrc ? [{ html: figDivOf(figSrc, !!figFull), afterLine: fm.figure_after_line }] : []);
// 인라인 도형: 본문 줄 중간 {{INLn}} 자리에 인라인 <img>(임베드 객체 src). 블록 figures 와 별개.
const inlineFigList = Array.isArray(fm.inline_figures)
  ? (fm.inline_figures as any[]).map((f) => String(f.image))
  : [];
const figDiv = figSrc ? figDivOf(figSrc, !!figFull) : '';
// 표·연립 등 복잡한 2D 구조는 텍스트 재구성이 근본적으로 깨진다(표준정규분포표→분수, 연립 2식
// 뒤섞임) → 재구성 대신 원본 전체이미지로 표시(해당 문제들은 전부 image_paths 보유).
const _sText = fm.searchable_text ?? '';
const _wholeStem =
  fm.image_paths && fm.image_paths[0] ? String(fm.image_paths[0]).split('/').pop() : null;
// 표: 표준정규분포표(셀이 분수로 깨짐)·P(0≤Z 헤더·소수격자 분수. 연립: '연립방정식'이되 정상
// \begin{cases}로 디코드된 건 제외(텍스트 재구성 양호). 해당 문제는 전부 image_paths 보유.
const reconUnsupported =
  !(fm.tables && fm.tables.length) &&  // 표가 table JSON으로 추출됐으면 HTML <table> 재구성 지원(폴백 해제)
  !!_wholeStem &&
  (/표준정규분포표|P\(\s*0\s*[≤<]\s*Z|\\frac\{[\d.]+\s+[\d.]+/.test(_sText) ||
    (/연립방정식/.test(_sText) && !/\\begin\{cases\}/.test(_sText)));
const reconFull = reconUnsupported
  ? `<div class="recon-fig-wrap"><img src="/problem-images/${_wholeStem}" alt="문제" class="recon-fig recon-fig-full" loading="lazy" /><span class="recon-fig-note">표·연립 등 복잡한 구조 — 원본 이미지로 표시 (텍스트 재구성 미지원)</span></div>`
  : renderReconstruct(_sText, { figures: figureList, tables: fm.tables, inlineFigures: inlineFigList });
// 재구성은 어드민 전용: 도형 라벨이 이미지 밖으로 새는 등 엣지케이스가 있어 사용자에겐 부적합 →
// 사용자는 원본 이미지(<Content/>)만, 재구성 토글·뷰는 admin 만. (디코더의 가치는 인제스트용 searchable_text.)
const isAdmin = !!Astro.locals.user?.is_admin;
const reconHTML = isAdmin ? reconFull : ''; // 빈 문자열=토글/재구성 숨김 → 비어드민은 <Content/> 원본만
// Gemini 비전 교정 재구성(있으면): 결정론적 reconFull 대신 교정 전사(KaTeX) + bareAxes 도식으로
// 원본과 동일하게. fixes(교정내역)는 백엔드 보관용 — 프론트 미노출. 선행 번호("13.")는 recon-head 와
// 중복되므로 제거.
const gRecon = (reconData as Record<string, any>)[entry.id] ?? null;
// Gemini 교정본 정리: 선행 번호("13.")·본문 끝 점수([3점], recon-head 에 이미 있음) 제거,
// $...$ 구분자 제거(renderReconstruct=katex SSOT 는 구분자 없는 형식 기대 — 안 그러면 raw 노출).
const gClean = gRecon
  ? String(gRecon.corrected || '')
      .replace(/^\s*\d{1,2}\.\s*/, '')
      .replace(/\[\s*\d+\s*점\s*\]/g, '')
      .replace(/\$/g, '')
      .trim()
  : '';
// 그림 위치를 원본과 동일하게: 수능 객관식은 [문제]→[그림]→[선택지]. 선택지(①~⑤) 경계에서
// 분리해 그림을 그 사이에 둔다(선택지 없으면 그림이 본문 끝 — 그대로 맞음).
const _ci = gClean.search(/[①②③④⑤⑥⑦⑧⑨⑩]/);
const gStmtHtml = (isAdmin && gRecon) ? renderReconstruct(_ci > 0 ? gClean.slice(0, _ci) : gClean, {}) : '';
const gChoiceHtml = (isAdmin && gRecon && _ci > 0) ? renderReconstruct(gClean.slice(_ci), {}) : '';
// 'docs/concepts/algebra/근의_공식.md' → 'algebra/근의_공식'
const fmtPath = (p: string) => p.replace(/^docs\/concepts\//, '').replace(/\.md$/, '');
const labelOf = (slug: string) => (slug.split('/').pop() ?? slug);
// 개념 ref 해석: exact id → 그대로, 아니면 정규화 leaf(공백·_ 제거)로 정식 노드 찾기.
// 해석되면 정식 경로로 링크, 안 되면 평문(깨진 링크 방지). 노드 다이어트로 flat→nested 이동·병합 다수.
const allConceptsForLink = await getCollection('concepts');
const conceptIdSet = new Set(allConceptsForLink.map((c) => c.id.normalize('NFC')));
const conceptLeafKey = (s: string) => (s.split('/').pop() ?? s).normalize('NFC').replace(/[\s_]/g, '').toLowerCase();
const conceptLeafToId = new Map<string, string>();
for (const c of allConceptsForLink) { const k = conceptLeafKey(c.id); if (!conceptLeafToId.has(k)) conceptLeafToId.set(k, c.id); }
const resolveConcept = (ref: string): string | null => {
  const id = fmtPath(ref).normalize('NFC');
  if (conceptIdSet.has(id)) return id;
  return conceptLeafToId.get(conceptLeafKey(id)) ?? null;
};
// '단일'(고1·고2·통합형)은 과목 표기 생략 — "2025년 모의고사 9번"처럼.
const subjLabel = fm.source?.subject && fm.source.subject !== '단일' ? `${fm.source.subject} ` : '';
const unitTitle = fm.source?.subject
  ? `${yearLabel(fm.source.year, fm.source.exam_type)} ${fm.source.exam_type} ${subjLabel}${fm.source.number}번`
  : entry.id;

// 회차 내 이전/다음 네비게이션. 같은 회차(연도·시험·세션·학년·기관) 전체를 모아
// 공통(1-22)↔선택(23-30) 경계에서 분기: 공통 마지막 → 선택과목 선택, 선택 첫 → 공통 복귀.
// 가/나형·단일(검정고시·고1·2)은 공통이 없어 같은 과목 내 선형 이동.
const src = fm.source;
type ProbEntry = Awaited<ReturnType<typeof getCollection<'problems'>>>[number];
const byNum = (a: ProbEntry, b: ProbEntry) => Number(a.data.source?.number ?? 0) - Number(b.data.source?.number ?? 0);
const roundAll: ProbEntry[] = src
  ? (await getCollection('problems', (e) => {
      const s = e.data.source;
      return !!s && s.year === src.year && s.exam_type === src.exam_type
        && (s.session ?? '') === (src.session ?? '')
        && (s.grade ?? '') === (src.grade ?? '')
        && (s.agency ?? '') === (src.agency ?? '');
    })).sort(byNum)
  : [];
const ELECTIVE_ORDER = ['확률과통계', '미적분', '기하'];
const gongtong = roundAll.filter((e) => e.data.source?.subject === '공통');
const electiveSubjects = [...new Set(roundAll
  .map((e) => e.data.source?.subject).filter((s): s is string => !!s && s !== '공통'))]
  .sort((a, b) => ((ELECTIVE_ORDER.indexOf(a) + 1) || 99) - ((ELECTIVE_ORDER.indexOf(b) + 1) || 99));
const hasGongtong = gongtong.length > 0;

let prevEntry: ProbEntry | null = null;
let nextEntries: ProbEntry[] = [];
if (src) {
  const isGongtong = src.subject === '공통';
  const subjList = roundAll.filter((e) => e.data.source?.subject === src.subject);
  const i = subjList.findIndex((e) => e.id === entry.id);
  // 이전: 과목 내 앞 문제. 선택 첫 문제(23)면 공통 마지막(22)으로 복귀.
  if (i > 0) prevEntry = subjList[i - 1];
  else if (hasGongtong && !isGongtong && i === 0) prevEntry = gongtong[gongtong.length - 1] ?? null;
  // 다음: 공통 마지막이면 선택과목 분기(각 과목 첫 문제), 아니면 과목 내 다음.
  if (hasGongtong && isGongtong && i === subjList.length - 1) {
    nextEntries = electiveSubjects
      .map((s) => roundAll.filter((e) => e.data.source?.subject === s).sort(byNum)[0])
      .filter((e): e is ProbEntry => !!e);
  } else if (i >= 0 && i < subjList.length - 1) {
    nextEntries = [subjList[i + 1]];
  }
}
---
<BaseLayout title={entry.id}>
  {/* 하이브리드 레이아웃:
       · 넓은 화면(lg+) — [문제·풀이·메타 (스크롤)] | [튜터 채팅 (우측 고정 full-height)]
       · 좁은 화면      — 문제 단일 컬럼 + 채팅 하단 dock 고정
     문제와 대화를 동시에 보면서 풀 수 있게. */}
  <div id="prob-grid" style="--chat-w: 400px"
       class="max-w-[1500px] mx-auto px-4 sm:px-6 py-8
              md:grid md:grid-cols-[minmax(0,1fr)_16px_var(--chat-w,400px)] md:gap-3 md:items-start">

    {/* ── 왼쪽: 문제 + 풀이 + 메타 (문서와 함께 스크롤) ── */}
    <div class="min-w-0">
      {src && (prevEntry || nextEntries.length > 0) && (
        <div class="mb-4"><RoundNav prev={prevEntry} nexts={nextEntries} curSubject={src.subject} currentLabel={`${subjLabel}${src.number}번`} /></div>
      )}
      <article class="max-w-none">
        {reconHTML && (
          <div class="prob-toggle inline-flex rounded-lg border border-[color:var(--color-border)] overflow-hidden mb-4 text-sm" role="tablist" aria-label="문제 보기 방식">
            <button type="button" id="pv-raw" class="px-3.5 py-1.5 font-medium">🖼 원본 이미지</button>
            <button type="button" id="pv-recon" class="px-3.5 py-1.5 font-medium border-l border-[color:var(--color-border)]">✦ 재구성</button>
          </div>
        )}
        <div class="prose prose-invert max-w-none" id="pv-content">
          <Content />
        </div>
        {reconHTML && (
          <div class="recon-view" id="pv-reconview" hidden>
            <div class="recon-head">
              <span class="recon-num">{fm.source?.number ?? ''}.</span>
              {fm.source?.score && <span class="recon-score">[{fm.source.score}점]</span>}
            </div>
            {isAdmin && gRecon ? (
              <>
                <div set:html={gStmtHtml} />
                {gRecon.figure && (
                  <div class="recon-fig-wrap">
                    <Geometry client:load spec={gRecon.figure} width={520} height={420} hideCaption noBroadcast />
                  </div>
                )}
                {fm.choice_figures && fm.choice_figures.length > 0 ? (
                  <div class="recon-choices recon-choices-img">
                    {fm.choice_figures.map((c) => (
                      <div class="recon-choice-fig">
                        <span class="recon-choice-label">{c.label}</span>
                        <img src={c.image} alt={`보기 ${c.label}`} loading="lazy" />
                      </div>
                    ))}
                  </div>
                ) : (gChoiceHtml && <div set:html={gChoiceHtml} />)}
              </>
            ) : (
              <div set:html={reconFull} />
            )}
          </div>
        )}
        <details class="not-prose my-6" open>
          <summary class="cursor-pointer text-sm font-semibold select-none" style="color:var(--color-muted)">✏️ 손풀이 — 펜·태블릿으로 직접 풀어보세요 (자동 저장)</summary>
          <div class="mt-3">
            <InkCanvas client:only="react" storageKey={`problem:${entry.id}`} />
          </div>
        </details>
        <div class="my-6">
          <ProblemAttemptPanel client:load slug={entry.id} />
        </div>
        <SolutionPanel client:load solution={fm.solution} />
      </article>

      {/* 메타데이터: 우측 rail 을 채팅에 내주고 문제 아래 가로 카드로 재배치 */}
      <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">상태</h3>
          <dl class="text-sm space-y-1.5">
            <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">상태</dt><dd><span class={`chip chip-status-${fm.status}`}>{STATUS_LABEL_KO[fm.status] ?? fm.status}</span></dd></div>
            {fm.format && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">유형</dt><dd>{FORMAT_LABEL[fm.format] ?? fm.format}</dd></div>}
            {fm.killer_tier && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">난이도</dt><dd><span class={`chip ${TIER_BADGE[fm.killer_tier]?.cls ?? ''}`}>{TIER_BADGE[fm.killer_tier]?.text ?? fm.killer_tier}</span></dd></div>}
            {fm.cognitive_type && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">인지 유형</dt><dd>{fm.cognitive_type}</dd></div>}
            {fm.answer && (
              <div class="flex justify-between items-center"><dt class="text-[color:var(--color-muted)]">정답</dt>
                <dd>
                  <button
                    type="button"
                    class="answer-blur font-mono text-sm px-2 py-0.5 rounded border border-[color:var(--color-border)] bg-[color:var(--color-surface-2)] hover:border-[color:var(--color-accent)] transition cursor-pointer"
                    data-answer={fm.answer}
                    aria-label="정답 보기"
                    onclick="this.classList.toggle('revealed')"
                  >{fm.answer}</button>
                </dd>
              </div>
            )}
            {fm.official_pass_rate && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">정답률</dt><dd>{fm.official_pass_rate}%</dd></div>}
            {fm.difficulty && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">난이도</dt><dd>{fm.difficulty}</dd></div>}
            {fm.next_review && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">다음 복습</dt><dd>{fm.next_review.toISOString().slice(0,10)}</dd></div>}
          </dl>
          {fm.exam_intent && (
            <p class="mt-3 pt-3 border-t border-[color:var(--color-border)] text-xs text-[color:var(--color-muted)] leading-relaxed">
              🎯 {fm.exam_intent}
            </p>
          )}
        </section>

        {fm.source && (
          <section class="card">
            <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">출처</h3>
            <dl class="text-sm space-y-1">
              <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">시행</dt><dd>{fm.source.agency} · {fm.source.exam_type}</dd></div>
              <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">회차</dt><dd>{yearLabel(fm.source.year, fm.source.exam_type)}{fm.source.session ? ` · ${fm.source.session}` : ''}</dd></div>
              <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">과목</dt><dd>{fm.source.subject}</dd></div>
              <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">번호</dt><dd>{fm.source.number}번 · {fm.source.score ?? '?'}점</dd></div>
            </dl>
          </section>
        )}

        {fm.concepts.length > 0 && (
          <section class="card">
            <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">매핑된 개념</h3>
            <ul class="space-y-1.5 text-sm">
              {fm.concepts.map((p) => {
                const resolved = resolveConcept(p);
                const label = labelOf(fmtPath(p));
                return <li>{resolved
                  ? <><a class="text-[color:var(--color-accent)] hover:underline" href={`/concepts/${resolved}`}>{label}</a>{hasWidget(resolved) && <span class="iw-mark" title="인터랙티브 위젯 있음"> 🔭</span>}</>
                  : <span class="text-[color:var(--color-subtle)]" title="아직 개념 노드가 없는 태그">{label}</span>}</li>;
              })}
            </ul>
          </section>
        )}
      </div>

      {src && (prevEntry || nextEntries.length > 0) && (
        <div class="mt-8"><RoundNav prev={prevEntry} nexts={nextEntries} curSubject={src.subject} currentLabel={`${subjLabel}${src.number}번`} /></div>
      )}
    </div>

    {/* 드래그 핸들 — 채팅 폭 조절 (md+ 컬럼 전용; 모바일은 FAB라 숨김) */}
    <div id="chat-resize" title="드래그해서 채팅 폭 조절" aria-hidden="true"
         class="hidden md:flex md:sticky md:top-16 md:h-[calc(100vh-5rem)] items-center justify-center cursor-col-resize group touch-none select-none">
      <div class="h-16 w-1 group-hover:w-1.5 rounded-full bg-[color:var(--color-border)] group-hover:bg-[color:var(--color-accent)] transition-all"></div>
    </div>

    {/* ── 오른쪽: 튜터 채팅 ──
         md+(태블릿·데스크탑): 우측 고정 full-height 컬럼(현행, 폭 드래그) — TutorChat 가 인라인 배치
         모바일(<md): 우측 하단 FAB → 큰 대화창(다크 dock 폐지, 테마 통일) */}
    <TutorChat fab="mobile" slug={entry.id} unitTitle={unitTitle} collection="problems" />
  </div>

  {/* 채팅 폭 드래그 조절 — 폭은 localStorage 기억 */}
  <script is:inline>
    (function () {
      const grid = document.getElementById('prob-grid');
      const handle = document.getElementById('chat-resize');
      if (!grid || !handle) return;
      const KEY = 'math-study:chat-width', MIN = 320, MAX = 760;
      const saved = parseInt(localStorage.getItem(KEY) || '', 10);
      if (saved >= MIN && saved <= MAX) grid.style.setProperty('--chat-w', saved + 'px');
      let dragging = false;
      handle.addEventListener('pointerdown', function (e) {
        dragging = true;
        try { handle.setPointerCapture(e.pointerId); } catch (_) {}
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'col-resize';
      });
      window.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        const right = grid.getBoundingClientRect().right - 24; // px-6 보정
        let w = Math.max(MIN, Math.min(MAX, right - e.clientX));
        grid.style.setProperty('--chat-w', w + 'px');
      });
      window.addEventListener('pointerup', function () {
        if (!dragging) return;
        dragging = false;
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
        const w = parseInt(grid.style.getPropertyValue('--chat-w'), 10);
        if (w) localStorage.setItem(KEY, String(w));
      });
      // (모바일 dock 접기/펴기 폐지 — 이제 우측 하단 FAB → 대화창. TutorChat 가 개폐 처리)
    })();
  </script>

  {/* 원본 이미지 ↔ 재구성(LaTeX) 토글 — 선택 기억 */}
  <script is:inline>
    (function () {
      const KEY = 'math-study:prob-view';
      const content = document.getElementById('pv-content');
      const recon = document.getElementById('pv-reconview');
      const bRaw = document.getElementById('pv-raw');
      const bRecon = document.getElementById('pv-recon');
      if (!content || !recon || !bRaw || !bRecon) return;
      function apply(mode) {
        const r = mode === 'recon';
        content.hidden = r;
        recon.hidden = !r;
        bRaw.classList.toggle('pv-active', !r);
        bRecon.classList.toggle('pv-active', r);
      }
      apply(localStorage.getItem(KEY) === 'recon' ? 'recon' : 'raw');
      bRaw.addEventListener('click', function () { localStorage.setItem(KEY, 'raw'); apply('raw'); });
      bRecon.addEventListener('click', function () { localStorage.setItem(KEY, 'recon'); apply('recon'); });
    })();
  </script>

  <style is:global>
    .prob-toggle button { background: var(--color-surface-2, #1b1b1f); color: var(--color-muted, #9ca3af); cursor: pointer; transition: background .15s, color .15s; }
    .prob-toggle button.pv-active { background: var(--color-accent, #6366f1); color: #fff; }
    /* overflow-x:auto → 긴 인라인 수식(nowrap)이 있어도 이 컨테이너의 min-content 가 0 이 되어
       grid 셀(minmax(0,1fr))이 줄어들 수 있다 → 우측 채팅(var(--chat-w))을 밀어내지 않음(16번 깨짐 수정). */
    .recon-view { font-family: var(--font-serif, serif); font-size: 1.05rem; line-height: 1.95; color: var(--color-text, #e5e7eb); background: var(--color-surface, #18181b); border: 1px solid var(--color-border, #333); border-radius: 12px; padding: 1.5rem 1.75rem; overflow-wrap: break-word; overflow-x: auto; }
    .recon-view .recon-line { overflow-wrap: anywhere; }
    .recon-view .recon-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--color-border, #333); padding-bottom: 0.5rem; margin-bottom: 1rem; }
    .recon-view .recon-num { font-size: 1.25rem; font-weight: 500; }
    .recon-view .recon-score { font-size: 0.9rem; color: var(--color-muted, #9ca3af); }
    .recon-view .recon-line { margin: 0.5em 0; }
    .recon-view .recon-disp { text-align: center; margin: 1.1em 0; overflow-x: auto; }
    .recon-view .recon-deriv { text-align: left; margin: 0.35em 0; }  /* 도출(= 체인) 줄: 좌측정렬·간격축소로 통일 */
    .recon-view .recon-deriv .katex-display { text-align: left; margin: 0; }  /* KaTeX display 자체 가운데정렬 무시(= 체인 좌측 통일) */
    .recon-view .recon-fig-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 1.3em 0; gap: 0.3em; }
    .recon-view .recon-fig { max-width: 380px; width: 100%; height: auto; background: #fff; border-radius: 8px; padding: 10px; box-sizing: border-box; }
    .recon-view .recon-fig-full { max-width: 560px; }
    .recon-view .recon-fig-note { font-size: 0.8rem; color: var(--color-muted, #9ca3af); }
    .recon-view .recon-choices { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 1.3rem; padding-top: 0.7rem; border-top: 1px solid var(--color-border, #333); }
    .recon-view .recon-choices-img { gap: 1rem; }
    .recon-view .recon-choice-fig { display: flex; align-items: flex-start; gap: 0.3em; }
    .recon-view .recon-choice-fig img { max-width: 170px; width: 100%; height: auto; background: #fff; border-radius: 6px; padding: 6px; box-sizing: border-box; }
    .recon-view .recon-choice-label { font-weight: 600; }
    .recon-view .recon-choice { white-space: nowrap; display: inline-flex; align-items: baseline; gap: 0.3em; }
    .recon-view .recon-cnum { font-weight: 500; }
    .recon-view .recon-box { border: 1px solid var(--color-border, #555); border-radius: 8px; padding: 0.6em 1.1em; margin: 1.1em 0; }
    .recon-view .recon-blank { display: inline-block; border: 1px solid var(--color-border, #555); border-radius: 4px; padding: 0.05em 0.9em; margin: 0 0.15em; text-align: center; }
    /* 인라인 KaTeX 수식은 줄 끝에서 중간이 쪼개지지 않고 통째로 다음 줄로 */
    .recon-view .recon-line .katex { display: inline-block; white-space: nowrap; }
    .recon-view .recon-table { border-collapse: collapse; margin: 1.1em auto; }
    .recon-view .recon-table th, .recon-view .recon-table td { border: 1px solid var(--color-border, #555); padding: 0.3em 0.9em; text-align: center; }
    .recon-view .recon-table th { font-weight: 600; }
    .recon-view .recon-bullet { text-align: left; padding-left: 1.3em; text-indent: -1.3em; }
    .recon-view .recon-box .recon-line:first-child { margin-top: 0; }
    .recon-view .recon-box .recon-line:last-child { margin-bottom: 0; }
  </style>
</BaseLayout>
