---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import ProblemFilters from '../../components/ProblemFilters.tsx';
import { getCollection } from 'astro:content';
import { roundTitle } from '../../lib/problem-meta';
import { groupByRound, buildFilterAxes, cardProps, dataAttrs } from '../../lib/problem-card';

const problems = await getCollection('problems');
const byYear = groupByRound(problems);
const axes = buildFilterAxes(problems);
---
<BaseLayout title="문제 — 회차별">
  <div class="max-w-6xl mx-auto px-6 py-6 space-y-5">
    <header class="space-y-3">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <h1 class="text-2xl font-semibold tracking-tight">
          문제 <span class="text-xs text-[color:var(--color-muted)] font-normal">— 회차별</span>
        </h1>
        <a href="/exam" class="chip hover:border-[color:var(--color-accent)]">📝 모의시험 모드</a>
      </div>
      <nav class="flex gap-1.5 text-sm">
        <a href="/problems" class="chip border-[color:var(--color-text)]/40">회차별</a>
        <a href="/problems/units" class="chip opacity-50 hover:opacity-100">단원별</a>
      </nav>
    </header>

    <ProblemFilters client:load axes={axes} total={problems.length} groupSelector=".problem-group" />

    {problems.length === 0 ? (
      <p class="text-sm text-[color:var(--color-muted)] py-12 text-center">아직 문제가 없습니다.</p>
    ) : (
      [...byYear.entries()].map(([year, rounds]) => (
        <section class="problem-lens-section space-y-3" data-year={year}>
          <header class="flex items-baseline gap-3 sticky top-16 bg-[color:var(--color-bg)]/85 backdrop-blur py-2 -mx-6 px-6 z-10 border-b border-[color:var(--color-border)]">
            <h2 class="text-base font-semibold">{year}</h2>
            <span class="text-xs text-[color:var(--color-muted)]">
              {rounds.length}회차 · {rounds.reduce((s, r) => s + r.problems.length, 0)}문항
            </span>
          </header>

          {rounds.map((r) => (
            <div class="problem-group space-y-2">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div class="min-w-0">
                  <h3 class="font-semibold text-sm">{roundTitle(r.meta)}</h3>
                  <p class="text-[11px] text-[color:var(--color-subtle)]">
                    {r.meta.agency} · {r.problems.length}문항
                  </p>
                </div>
                <a
                  href={`/exam/round/${year}/${r.round}`}
                  class="chip text-[11px] hover:border-[color:var(--color-accent)] shrink-0"
                >▶ 시험 모드로 풀기</a>
              </div>
              <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
                {r.problems.map((p) => (
                  <li class="problem-card-wrap" {...dataAttrs(p)}>
                    <ProblemCard {...cardProps(p)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    )}
  </div>
</BaseLayout>

<style>
  /* 썸네일은 고정 150px 박스라 로드돼도 레이아웃이 안 흔들림(CLS 0). 2584장은
     loading="lazy" 만으로 뷰포트 근처만 로드 → 충분. (content-visibility:auto 는
     native lazy 와 충돌해 가시 카드까지 안 뜨는 문제가 있어 사용하지 않음.) */
  :global(.problem-card-wrap.filtered-out),
  :global(.problem-group.filtered-out),
  :global(.problem-lens-section.filtered-out) {
    display: none !important;
  }
</style>
