---
// Phase 3 전환 4호 — 껍데기는 서버, 목록·필터는 클라이언트(`/api/content-index/problems`).
// 필터와 목록은 **같은 섬**(`ProblemsByRound`)이다 — 따로 두면 필터가 빈 DOM 을 훑고 죽는다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProblemsByRound from '../../components/ProblemsByRound.tsx';
---
<BaseLayout title="기출">
  <div class="max-w-6xl mx-auto px-6 py-6 space-y-5">
    <header class="space-y-3">
      <h1 class="text-2xl font-semibold tracking-tight">
        기출 <span class="text-xs text-[color:var(--color-muted)] font-normal">— 회차별</span>
      </h1>
      <nav class="flex gap-1.5 text-sm">
        <a href="/problems" class="chip border-[color:var(--color-text)]/40">회차별</a>
        <a href="/problems/units" class="chip opacity-50 hover:opacity-100">단원별</a>
      </nav>
    </header>

    <section class="card flex items-center justify-between gap-3">
      <div>
        <h2 class="font-semibold">🎲 랜덤 모의시험</h2>
        <p class="text-xs text-[color:var(--color-muted)] mt-0.5">
          코퍼스 전체에서 공통 22 + 선택 8을 난이도 분포 맞춰 무작위 조합
        </p>
      </div>
      <a href="/exam/random" class="chip hover:border-[color:var(--color-accent)] whitespace-nowrap">▶ 시작</a>
    </section>

    <ProblemsByRound client:load />
  </div>
</BaseLayout>
