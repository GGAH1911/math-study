---
// Phase 3 C그룹 — 프론트매터 계산은 `/api/home` 으로 갔다(`lib/home-overview.ts`).
// ★네 섬이 같은 요청을 쓴다(`useJsonOnce` 캐시). 홈은 마크업이 흩어져 한 섬으로 못 묶는다.
// ★`HealthCards`·`ActivityFeed`·`TutorChat` 은 자기 데이터를 스스로 읽는 Astro 컴포넌트라 그대로 둔다.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import HealthCards from '../components/HealthCards.astro';
import DueTodayListDb from '../components/DueTodayListDb.tsx';
import ActivityFeed from '../components/ActivityFeed.astro';
import TutorChat from '../components/TutorChat.astro';
import { HomeHero, HomeGraph, HomeProgress, HomeSyntheses, HomeNodeCount } from '../components/home-islands.tsx';
---
<BaseLayout title="홈">
  <!-- 히어로 「오늘의 페이지」 — 모눈이 그대로 비치는 영역(카드로 감싸지 않는다) -->
  <section class="max-w-6xl mx-auto px-6 pt-8 pb-6">
    <HomeHero client:load />
  </section>

  <!-- 본문: 모바일 = 「행동 먼저」 order 스택 / lg = 6컬럼 그리드(row 명시로 현행 시각 순서 유지) -->
  <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col gap-5 lg:grid lg:grid-cols-6 lg:gap-5">
    <!-- 오늘 복습 큐 — 모바일 1순위 · 데스크톱 Due 행 좌 -->
    <section id="due-today" class="order-1 lg:order-none lg:row-start-3 lg:col-start-1 lg:col-span-3">
      <DueTodayListDb client:load />
    </section>

    <!-- 스탯 — 데스크톱 1행 풀폭 -->
    <div class="order-2 lg:order-none lg:row-start-1 lg:col-start-1 lg:col-span-6">
      <HealthCards />
    </div>

    <!-- 최근 학습 노트 -->
    <section class="card order-3 lg:order-none lg:row-start-4 lg:col-start-1 lg:col-span-6">
      <HomeSyntheses client:load />
    </section>

    <!-- 모바일 전용: 개념 지도 정적 프리뷰 — DAG 하이드레이션 컷의 대체 진입점 -->
    <a href="/graph" class="card order-4 lg:hidden flex items-center gap-3">
      <span class="text-2xl text-[color:var(--color-accent)]">◈</span>
      <span>
        <span class="block text-sm font-semibold">개념 지도</span>
        <span class="block text-xs text-[color:var(--color-muted)]"><HomeNodeCount client:load /> 노드 · 탭하여 펼치기</span>
      </span>
    </a>

    <!-- Concept Network 미리보기 — 데스크톱 전용(client:media 로 모바일 ReactFlow 비용 0) -->
    <section class="card hidden lg:block lg:order-none lg:row-start-2 lg:col-start-1 lg:col-span-4 p-0 overflow-hidden">
      <header class="flex items-center justify-between px-5 pt-4 pb-2">
        <div>
          <h2 class="text-sm font-semibold">개념 지도</h2>
          <p class="text-xs text-[color:var(--color-muted)]">개념 의존성 DAG 미리보기 · 노드 색 = mastery</p>
        </div>
        <a href="/graph" class="text-xs text-[color:var(--color-accent)] hover:underline">풀스크린 →</a>
      </header>
      <div class="h-[340px] border-t border-[color:var(--color-border)]">
        <HomeGraph client:media="(min-width: 1024px)" />
      </div>
    </section>

    <!-- 단원 진행 (스포크 mastery 롤업) -->
    <section class="card order-5 lg:order-none lg:row-start-2 lg:col-start-5 lg:col-span-2">
      <HomeProgress client:load />
    </section>

    <!-- 활동 피드 — 데스크톱 Due 행 우 -->
    <div class="order-6 lg:order-none lg:row-start-3 lg:col-start-4 lg:col-span-3">
      <ActivityFeed />
    </div>

  </div>
  {/* 학습 길잡이 채팅 — 그리드 인라인 폐지(태블릿서 안 보이던 문제 해결). 모든 화면에서
       우측 하단 FAB → 큰 대화창. display:contents 라 그리드 자리 미점유. */}
  <TutorChat slug="__nav__" unitTitle="학습 길잡이" collection="dashboard" fab="always" fabLabel="학습 길잡이와 대화" />
</BaseLayout>
