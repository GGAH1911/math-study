---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import HealthCards from '../components/HealthCards.astro';
import DueTodayList from '../components/DueTodayList.astro';
import DueTodayListDb from '../components/DueTodayListDb.tsx';
import ActivityFeed from '../components/ActivityFeed.astro';
import MasteryDonut from '../components/MasteryDonut.tsx';
import ConceptDAG from '../components/ConceptDAG.tsx';
import ChatPanel from '../components/ChatPanel.tsx';
import { readHealth, readConceptGraph, unitSummary } from '../lib/health.ts';
import synthesesIndex from '../data/syntheses-by-concept.json';

const health = readHealth();
const graph = readConceptGraph();
const units = unitSummary();
const us = units.byStatus;
type SynthesisRecent = { slug: string; title: string; created: string | null; origin_concept: string | null; excerpt: string | null };
const recentSyntheses: SynthesisRecent[] = ((synthesesIndex as any).recent ?? []).slice(0, 5);
const totalSyntheses: number = (synthesesIndex as any).total ?? 0;
const leafOf = (p: string | null) => p ? (p.split('/').pop() ?? p).replace(/_/g, ' ') : '';
---
<BaseLayout title="Dashboard">
  <div class="glow-hero">
    <div class="max-w-6xl mx-auto px-6 pt-8 pb-6">
      <div class="flex items-end justify-between gap-6 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-[color:var(--color-subtle)]">2026-05-16 · LWIP v1.2 + Math Study Ch.7</p>
          <h1 class="mt-2 text-3xl md:text-4xl font-semibold tracking-tight">
            <span class="bg-gradient-to-r from-zinc-50 via-zinc-200 to-zinc-400 bg-clip-text text-transparent">
              학습 신경망 대시보드
            </span>
          </h1>
          <p class="mt-2 text-sm text-[color:var(--color-muted)] max-w-2xl">
            한국 수능·평가원·교육청 기출 기반의 개념 지도와 mastery 추적. 오답이 발생하면 D14가 자동으로
            루트 구멍 concept을 짚어 학습 경로를 제시합니다.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/graph" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-sm font-medium transition">
            <span>◈</span><span>개념 지도 열기</span>
          </a>
        </div>
      </div>
      <div class="mt-5">
        <p class="text-xs text-[color:var(--color-subtle)]"><span class="text-[color:var(--color-muted)]">권장 다음 작업:</span> {health.suggestedAction}</p>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-6 space-y-6">
    <HealthCards />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      <!-- Concept Network preview, large -->
      <section class="card lg:col-span-2 p-0 overflow-hidden">
        <header class="flex items-center justify-between px-5 pt-4 pb-2">
          <div>
            <h2 class="text-sm font-semibold">Concept Network</h2>
            <p class="text-xs text-[color:var(--color-muted)]">개념 의존성 DAG 미리보기 · 노드 색 = mastery</p>
          </div>
          <a href="/graph" class="text-xs text-[color:var(--color-accent)] hover:underline">풀스크린 →</a>
        </header>
        <div class="h-[340px] border-t border-[color:var(--color-border)]">
          {graph.stats.nodes > 0 ? (
            <ConceptDAG client:load data={graph} variant="mini" />
          ) : (
            <p class="text-sm text-[color:var(--color-muted)] p-6">아직 concept 노드가 없습니다. <code class="text-[color:var(--color-accent)]">docs/concepts/</code>에 첫 페이지를 시드해보세요.</p>
          )}
        </div>
      </section>

      <!-- 단원 진행 (스포크 mastery 롤업) -->
      <section class="card">
        <header class="mb-3">
          <h2 class="text-sm font-semibold">단원 진행</h2>
          <p class="text-xs text-[color:var(--color-muted)]">
            착수 <span class="stat-num text-[color:var(--color-text)]">{units.started}</span> / {units.total} 단원 · 스포크 mastery 롤업
          </p>
        </header>
        <MasteryDonut client:load unknown={us.unknown} learning={us.learning} proficient={us.proficient} mastered={us.mastered} />
        <ul class="mt-4 space-y-1.5 text-sm">
          <li class="flex items-center gap-2"><span class="size-2 rounded-full bg-[color:var(--color-mastery-unknown)]"></span><span class="text-[color:var(--color-muted)]">미착수</span><span class="ml-auto stat-num">{us.unknown}</span></li>
          <li class="flex items-center gap-2"><span class="size-2 rounded-full bg-[color:var(--color-mastery-learning)]"></span><span class="text-[color:var(--color-muted)]">학습중</span><span class="ml-auto stat-num">{us.learning}</span></li>
          <li class="flex items-center gap-2"><span class="size-2 rounded-full bg-[color:var(--color-mastery-proficient)]"></span><span class="text-[color:var(--color-muted)]">능숙</span><span class="ml-auto stat-num">{us.proficient}</span></li>
          <li class="flex items-center gap-2"><span class="size-2 rounded-full bg-[color:var(--color-mastery-mastered)]"></span><span class="text-[color:var(--color-muted)]">숙달</span><span class="ml-auto stat-num">{us.mastered}</span></li>
        </ul>
      </section>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <DueTodayListDb client:load />
      <ActivityFeed />
    </div>

    <section class="card">
      <header class="mb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold">🗒 최근 학습 노트</h2>
          <p class="text-xs text-[color:var(--color-muted)]">{totalSyntheses}개 · 채팅에서 promote한 영구 노트</p>
        </div>
        <a href="/syntheses" class="text-xs text-[color:var(--color-accent)] hover:underline">전체 보기 →</a>
      </header>
      {recentSyntheses.length === 0 ? (
        <p class="text-sm text-[color:var(--color-muted)] py-3">
          아직 저장한 노트가 없어요. 컨셉 페이지에서 LLM과 대화한 뒤
          <span class="text-[color:var(--color-fg)]"> "📝 학습 노트 작성 요청" → "💾 저장"</span> 으로 만들 수 있습니다.
        </p>
      ) : (
        <ul class="divide-y divide-[color:var(--color-border)]/40">
          {recentSyntheses.map((s) => (
            <li class="py-2 first:pt-0 last:pb-0">
              <div class="flex items-baseline gap-2">
                <a class="text-sm font-medium text-[color:var(--color-fg)] hover:text-[color:var(--color-accent)] truncate" href={`/syntheses/${encodeURIComponent(s.slug)}`}>{s.title}</a>
                {s.created && <span class="text-[10px] text-[color:var(--color-subtle)] tabular-nums whitespace-nowrap">{s.created}</span>}
              </div>
              {s.origin_concept && (
                <a class="text-[11px] text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] truncate block" href={`/concepts/${s.origin_concept}`} title={s.origin_concept}>
                  ← {leafOf(s.origin_concept)}
                </a>
              )}
              {s.excerpt && <p class="text-xs text-[color:var(--color-muted)] mt-0.5 line-clamp-1">{s.excerpt}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <ChatPanel client:load slug="__nav__" unitTitle="학습 길잡이" collection="dashboard" />
  </div>
</BaseLayout>
