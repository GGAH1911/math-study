---
// Phase 3 전환 1호 — **껍데기는 서버, 목록은 클라이언트.**
// 목록은 `/api/content-index/tools`(방출물)에서 온다. `getCollection` 을 쓰지 않으므로
// 이 페이지는 tme 가 콘텐츠를 렌더하지 않아도 뜬다 — 그게 Phase 3 의 목적이다.
//
// ★제목·h1·설명은 서버에 남긴다: ① JS 로딩 전에도 어느 화면인지 보인다
//   ② 라우트 스냅샷이 title·h1 로 계속 회귀를 잰다(전부 옮기면 원본 HTML 이 비어 못 잰다).
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolsList from '../components/ToolsList.tsx';
---
<BaseLayout title="학습 자료">
  <div class="max-w-6xl mx-auto px-6 py-8 space-y-6">
    <header>
      <h1 class="text-2xl font-semibold tracking-tight">학습 자료</h1>
      <p class="text-sm text-[color:var(--color-muted)] mt-1">책 · 강의 · 문제집 · 사이트 · 기타 — D5: raw 복붙 금지, 요약과 출처만</p>
    </header>

    <ToolsList client:load />
  </div>
</BaseLayout>
