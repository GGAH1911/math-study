---
// 교정기 샘플 결과 뷰어 — /tmp/corrector_sample.json (10문제 배열) 을 원본 이미지·재현 도식·전사 교정 비교로.
// 샘플 생성: node /tmp/corrector_sample.mjs (agy 로 ①전사 교정 ②Geometry figure 재현). 요청 시 읽음.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Geometry from '../../components/Geometry.tsx';
import { renderReconstruct } from '../../lib/reconstruct';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const REPO = fileURLToPath(new URL('../../../../', import.meta.url)); // .../math-study/
let samples: any[] = [];
try {
  const raw = JSON.parse(readFileSync('/tmp/corrector_sample.json', 'utf-8'));
  samples = Array.isArray(raw) ? raw : [raw];
  // 모델이 'shapes' 대신 'elements' 키로 도형 배열을 내는 변이 흡수(교정기 정규화 반영 전까지의 임시 보정).
  const SHAPE_KEYS = ['point', 'segment', 'line', 'circle', 'ellipse', 'parabola', 'hyperbola', 'parametric', 'angle', 'text', 'area', 'polygon', 'sequence', 'vector'];
  const normShape = (sh: any) => { // {polygon:{...}} (타입=키) → {type:'polygon',...}
    if (!sh || sh.type) return sh;
    const k = Object.keys(sh).find((kk) => SHAPE_KEYS.includes(kk) && sh[kk] && typeof sh[kk] === 'object');
    return k ? { type: k, ...sh[k] } : sh;
  };
  const normFig = (fig: any) => { if (!fig) return; if (!Array.isArray(fig.shapes) && Array.isArray(fig.elements)) fig.shapes = fig.elements; if (fig.showAxes === true) { fig.bareAxes = true; fig.showAxes = false; } if (Array.isArray(fig.shapes)) fig.shapes = fig.shapes.map(normShape); };
  for (const s of samples) { if (s?.figure) normFig(s.figure); if (Array.isArray(s?.figures)) s.figures.forEach(normFig); } // 단일 figure + 다중 figures(subs) 정규화
} catch { /* 아직 없음 */ }

function imgB64(id: string) {
  const [round, sn] = id.split('/');
  try { return 'data:image/png;base64,' + readFileSync(`${REPO}db/raw/${round}/images/${round}_${sn}.png`).toString('base64'); }
  catch { return ''; }
}
function recon(corrected: string) {
  if (!corrected) return { stmt: '', choice: '', err: '' };
  try {
    const clean = String(corrected).replace(/^\s*\d{1,2}\.\s*/, '').replace(/\[\s*\d+\s*점\s*\]/g, '').replace(/\$/g, '').trim();
    const ci = clean.search(/[①②③④⑤⑥⑦⑧⑨⑩]/);
    return { stmt: renderReconstruct(ci > 0 ? clean.slice(0, ci) : clean, {}), choice: ci > 0 ? renderReconstruct(clean.slice(ci), {}) : '', err: '' };
  } catch (e: any) { return { stmt: '', choice: '', err: String(e?.message ?? e) }; }
}
const ok = samples.filter((s) => !s.error).length;
const fail = samples.filter((s) => s.error);
---
<BaseLayout title="교정기 샘플 (10문제)">
  <div class="max-w-6xl mx-auto px-6 py-8 space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">교정기 샘플 — agy(Gemini) 전사 교정 + 도식 재현</h1>
      <p class="text-sm text-[color:var(--color-muted)]">
        결정론적 전사 → Gemini 가 원본 이미지 보고 ①전사 교정 ②그림을 Geometry 도식으로 재현.
        {samples.length > 0 ? ` · ${ok}/${samples.length} 성공` : ' · 결과 없음 (node /tmp/corrector_sample.mjs 실행)'}
      </p>
      {fail.length > 0 && (
        <p class="text-xs text-rose-400">실패: {fail.map((s) => `${s.id}(${s.error})`).join(' · ')}</p>
      )}
    </header>

    {samples.length === 0 ? (
      <div class="text-sm text-zinc-500">결과 파일 없음. <code>node /tmp/corrector_sample.mjs</code> 실행 후 새로고침.</div>
    ) : (
      <div class="space-y-10">
        {samples.filter((s) => !s.error).map((s) => {
          const rc = recon(s.corrected);
          const img = imgB64(s.id);
          return (
            <article class="space-y-3 border-b border-zinc-800 pb-8">
              <h2 class="text-base font-semibold text-zinc-200">{s.id}
                <span class="text-xs font-normal text-zinc-500 ml-2">fixes {(s.fixes || []).length}건 · shapes {((s.figure?.shapes) || []).length} · axes {String(s.figure?.showAxes ?? (s.figure?.bareAxes ? 'bare' : '—'))} · {s.elapsed}s</span>
              </h2>
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                <section class="card border border-zinc-700 rounded-lg p-4 space-y-2">
                  <h3 class="text-xs font-semibold text-zinc-400">① 원본 이미지</h3>
                  <div class="bg-white rounded p-2">{img ? <img src={img} alt={s.id} class="w-full" /> : <span class="text-zinc-500 text-xs">이미지 없음</span>}</div>
                </section>
                <section class="card border border-zinc-700 rounded-lg p-4 space-y-2">
                  <h3 class="text-xs font-semibold text-zinc-400">② Gemini 재현 도식</h3>
                  <div class="bg-zinc-950 rounded p-2 flex justify-center">
                    {s.figures ? <div class="flex flex-wrap gap-2 justify-center">{s.figures.map((f: any, i: number) => <div class="text-center"><div class="text-[10px] text-zinc-500">그림{i + 1}</div><Geometry client:load spec={f} width={230} height={200} hideCaption noBroadcast /></div>)}</div> : s.figure ? <Geometry client:load spec={s.figure} width={480} height={380} hideCaption noBroadcast /> : <span class="text-zinc-600 text-xs">도식 없음</span>}
                  </div>
                  {s.figureNote && <p class="text-[11px] text-[color:var(--color-muted)]">{s.figureNote}</p>}
                </section>
              </div>
              {rc.err ? <pre class="text-xs text-rose-400 whitespace-pre-wrap">recon 에러: {rc.err}</pre> : (
                <section class="card border border-zinc-700 rounded-lg p-4 space-y-2">
                  <h3 class="text-xs font-semibold text-zinc-400">②-b 재구성 (문제→그림→선택지)</h3>
                  <div class="recon-view">
                    <div class="prose prose-invert max-w-none" set:html={rc.stmt} />
                    {s.figures ? <div class="recon-fig-wrap my-3 flex flex-wrap gap-2 justify-center">{s.figures.map((f: any) => <Geometry client:load spec={f} width={220} height={190} hideCaption noBroadcast />)}</div> : s.figure && <div class="recon-fig-wrap my-3"><Geometry client:load spec={s.figure} width={440} height={360} hideCaption noBroadcast /></div>}
                    {rc.choice && <div class="prose prose-invert max-w-none" set:html={rc.choice} />}
                  </div>
                </section>
              )}
              {s.measure && (
                <section class="card border border-sky-800/60 rounded-lg p-4 space-y-2">
                  <h3 class="text-xs font-semibold text-sky-400">⓪ 측정 명세 — Gemini가 그리기 전에 잰 요소(과정)</h3>
                  <pre class="text-[11px] leading-relaxed whitespace-pre-wrap bg-zinc-900/60 rounded p-3 text-sky-200/90 max-h-96 overflow-auto">{JSON.stringify(s.measure, null, 2)}</pre>
                </section>
              )}
              <section class="card border border-zinc-700 rounded-lg p-4 space-y-2">
                <h3 class="text-xs font-semibold text-zinc-400">③ 전사 교정 (fixes {(s.fixes || []).length}건)</h3>
                <ul class="text-[11px] text-amber-300/90 space-y-0.5 list-disc pl-5">
                  {(s.fixes || []).map((f: string) => <li>{f}</li>)}
                </ul>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-1">
                  <div>
                    <div class="text-[10px] uppercase tracking-wider text-zinc-500 mb-1">결정론적 전사 (원본)</div>
                    <pre class="text-[11px] leading-relaxed whitespace-pre-wrap bg-zinc-900/60 rounded p-3 text-zinc-400 max-h-80 overflow-auto">{s.det}</pre>
                  </div>
                  <div>
                    <div class="text-[10px] uppercase tracking-wider text-emerald-500 mb-1">Gemini 교정본</div>
                    <pre class="text-[11px] leading-relaxed whitespace-pre-wrap bg-zinc-900/60 rounded p-3 text-zinc-200 max-h-80 overflow-auto">{s.corrected}</pre>
                  </div>
                </div>
              </section>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
