---
export const prerender = false;
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

// figure-triage.json 읽기 (admin 게이팅은 middleware /dev/*)
const IDX = fileURLToPath(new URL('../../data/figure-triage.json', import.meta.url));
let idx: { figures: Record<string, any> } = { figures: {} };
try { idx = JSON.parse(readFileSync(IDX, 'utf-8')); } catch { /* 없으면 빈 */ }
const all = Object.entries(idx.figures).map(([image, v]) => ({ image, ...(v as any) }));

const STATUSES = ['untriaged', 'reuse', 'redraw-2d', 'redraw-3d', 'delete'] as const;
const counts: Record<string, number> = { all: all.length };
for (const s of STATUSES) counts[s] = all.filter((f) => f.status === s).length;

const url = Astro.url;
const status = url.searchParams.get('status') ?? 'untriaged';
const q = (url.searchParams.get('q') ?? '').trim();
const page = Math.max(1, Number(url.searchParams.get('page') ?? 1) || 1);
const PER = 48;

let rows = all;
if (status !== 'all') rows = rows.filter((f) => f.status === status);
if (q) rows = rows.filter((f) => f.problem_slug?.includes(q) || f.image?.includes(q));
rows.sort((a, b) => (a.problem_slug || '').localeCompare(b.problem_slug || ''));
const total = rows.length;
const pages = Math.max(1, Math.ceil(total / PER));
const pageRows = rows.slice((page - 1) * PER, page * PER);

const link = (over: Record<string, string>) => {
  const p = new URLSearchParams({ status, ...(q ? { q } : {}), page: String(page), ...over });
  if (!over.page) p.set('page', '1');
  return '?' + p.toString();
};
const badge: Record<string, string> = { untriaged: '#9aa0a6', reuse: '#1a7f37', 'redraw-2d': '#9a6700', 'redraw-3d': '#1f6feb', delete: '#b22222' };
const label: Record<string, string> = { untriaged: '미분류', reuse: '재활용', 'redraw-2d': '2D 재생성', 'redraw-3d': '3D', delete: '삭제(추출오류)' };
---
<!doctype html>
<html lang="ko"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Figure Triage</title>
<style>
  body{margin:0;background:#0f1115;color:#e6e6e6;font-family:system-ui,sans-serif;font-size:14px}
  header{position:sticky;top:0;background:#161922;padding:10px 16px;border-bottom:1px solid #2a2f3a;z-index:5}
  h1{font-size:16px;margin:0 0 8px}
  .tabs a,.flt a{display:inline-block;padding:4px 10px;margin-right:6px;border-radius:6px;background:#222733;color:#cfd3dc;text-decoration:none;font-size:13px}
  .tabs a.on{background:#1f6feb;color:#fff}
  .cnt{color:#9aa0a6;font-size:12px}
  form{display:inline}
  input{background:#222733;border:1px solid #2a2f3a;color:#e6e6e6;border-radius:6px;padding:4px 8px;width:240px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;padding:16px}
  .card{background:#161922;border:1px solid #2a2f3a;border-radius:8px;overflow:hidden;display:flex;flex-direction:column}
  .thumb{background:#fff;height:150px;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .thumb img{max-width:100%;max-height:100%;object-fit:contain}
  .meta{padding:7px 9px;font-size:12px;color:#aeb4bf;word-break:break-all}
  .bdg{display:inline-block;padding:1px 7px;border-radius:10px;color:#fff;font-size:11px;margin-bottom:4px}
  .btns{display:flex;gap:4px;padding:0 9px 9px;flex-wrap:wrap}
  .btns button{flex:1;min-width:54px;border:1px solid #2a2f3a;background:#222733;color:#cfd3dc;border-radius:6px;padding:5px 0;cursor:pointer;font-size:12px}
  .btns button:hover{background:#2a3140}
  .btns button.del{color:#ff9b9b;border-color:#5a2a2a}
  .pg{padding:12px 16px;text-align:center}
  .pg a{margin:0 4px;color:#8ab4f8;text-decoration:none}
</style>
</head><body>
<header>
  <h1>Figure Triage 큐 <span class="cnt">— 기출 도형 분류 (재활용 / 2D 재생성 / 3D)</span></h1>
  <div class="tabs">
    {['all', ...STATUSES].map((s) => (
      <a class={status === s ? 'on' : ''} href={link({ status: s, page: '1' })}>{s === 'all' ? '전체' : label[s]} <span class="cnt">{counts[s] ?? 0}</span></a>
    ))}
    <form><input type="hidden" name="status" value={status} /><input name="q" value={q} placeholder="문제 slug 검색…" /></form>
  </div>
</header>

<div class="grid">
  {pageRows.map((f) => (
    <div class="card" data-image={f.image}>
      <div class="thumb"><img src={f.image} loading="lazy" alt="" /></div>
      <div class="meta">
        <span class="bdg" style={`background:${badge[f.status]}`}>{label[f.status]}</span><br />
        {f.problem_slug}<br /><span class="cnt">{f.round} · {f.subject} · fig{f.figure_index}</span>
      </div>
      <div class="btns">
        <button data-s="reuse">재활용</button>
        <button data-s="redraw-2d">2D</button>
        <button data-s="redraw-3d">3D</button>
        <button data-s="delete" class="del">삭제</button>
        <button data-s="untriaged">미분류</button>
      </div>
    </div>
  ))}
  {pageRows.length === 0 && <p style="color:#9aa0a6;padding:20px">해당 항목 없음.</p>}
</div>

<div class="pg">
  {page > 1 && <a href={link({ page: String(page - 1) })}>← 이전</a>}
  <span class="cnt">{page} / {pages} (총 {total})</span>
  {page < pages && <a href={link({ page: String(page + 1) })}>다음 →</a>}
</div>

<script>
  type St = 'untriaged' | 'reuse' | 'redraw-2d' | 'redraw-3d' | 'delete';
  const C: Record<St, string> = { untriaged: '#9aa0a6', reuse: '#1a7f37', 'redraw-2d': '#9a6700', 'redraw-3d': '#1f6feb', delete: '#b22222' };
  const L: Record<St, string> = { untriaged: '미분류', reuse: '재활용', 'redraw-2d': '2D 재생성', 'redraw-3d': '3D', delete: '삭제(추출오류)' };
  const SHORT: Record<St, string> = { untriaged: '미분류', reuse: '재활용', 'redraw-2d': '2D', 'redraw-3d': '3D', delete: '삭제' };
  document.querySelectorAll<HTMLButtonElement>('.card .btns button').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('.card') as HTMLElement | null;
      if (!card) return;
      const image = card.dataset.image;
      const status = btn.dataset.s as St;
      btn.textContent = '…';
      try {
        const r = await fetch('/api/figure-triage', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ image, status }) });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || r.status);
        const bdg = card.querySelector('.bdg') as HTMLElement | null;
        if (bdg) { bdg.textContent = L[status]; bdg.style.background = C[status]; }
      } catch (e) { alert('실패: ' + e); }
      btn.textContent = SHORT[status];
    });
  });
</script>
</body></html>
