---
// redraw 그래프(function-plot) 단독 렌더 검증 하네스 — /tmp/redraw_plot.json 읽어 RedrawPlot 으로.
import RedrawPlot from '../../components/RedrawPlot.tsx';
import 'katex/dist/katex.min.css';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
const w = Math.max(200, Math.min(900, Number(Astro.url.searchParams.get('w') ?? 440)));
const id = Astro.url.searchParams.get('id') ?? '';
let spec: unknown = null;
// /tmp(라이브) 우선 → repo(영속) 폴백
const SPEC_DIRS = ['/tmp/redraw_specs', fileURLToPath(new URL('../../data/redraw_specs', import.meta.url))];
if (id) { for (const base of SPEC_DIRS) { if (spec) break; try { spec = JSON.parse(readFileSync(`${base}/${id}.json`, 'utf-8')).spec; } catch { /* 없음 */ } } }
if (!spec) { try { spec = JSON.parse(readFileSync('/tmp/redraw_plot.json', 'utf-8')); } catch { /* 없음 */ } }
---
<!doctype html>
<html lang="ko">
  <head><meta charset="utf-8" /><title>figrender-plot</title></head>
  <body style="margin:0;padding:16px;background:#0a0a0b;">
    <div style={`width:${w}px;border:1px solid #333;border-radius:8px;overflow:hidden;`}>
      {spec ? <RedrawPlot client:only="react" spec={spec as never} width={w - 8} height={Math.round((w - 8) * 0.82)} /> : <p style="color:#aaa;font-family:sans-serif;">no spec at /tmp/redraw_plot.json</p>}
    </div>
  </body>
</html>
