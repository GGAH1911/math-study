---
// 그림 추출 프로토타입 뷰어 — /tmp/proto/figures.json (이미지 객체 bbox 추출+병합+크롭+정규화)
// 원본 페이지 ↔ 추출 그림 absolute 배치(정규화 bbox)로 "위치 보존" 검증.
export const prerender = false;
import { readFileSync } from 'node:fs';
let data: any = null, err = '';
try { data = JSON.parse(readFileSync('/tmp/proto/figures.json', 'utf8')); }
catch (e: any) { err = String(e?.message ?? e); }
const b64 = (f: string) => { try { return 'data:image/png;base64,' + readFileSync('/tmp/proto/' + f).toString('base64'); } catch { return ''; } };
const pageImg = data ? b64(data.page) : '';
const ar = data ? (data.pw / data.ph) : 0.707;
const W = 460;
---
<html lang="ko">
  <head><meta charset="utf-8" /><title>그림 추출 프로토타입</title></head>
  <body style="margin:0;padding:24px;background:#1a1a1c;color:#e8e8e8;font-family:system-ui,sans-serif;">
    <h1 style="font-size:18px;">그림 추출 프로토타입 — 이미지 객체 bbox → 페이지 렌더 크롭 → 정규화 absolute 배치</h1>
    {err && <p style="color:#f88;">figures.json 없음: {err}</p>}
    {data && (
      <>
        <p style="font-size:13px;color:#9a9;">LLM 재생성 0 · 원본 픽셀 그대로 · 라벨(텍스트레이어) 포함 · 인접 객체 병합 · 위치=정규화 bbox</p>
        <div style="display:flex;gap:28px;align-items:flex-start;flex-wrap:wrap;">
          <div>
            <div style="font-size:12px;color:#9ab;margin-bottom:6px;">① 원본 페이지(렌더)</div>
            <img src={pageImg} style={`width:${W}px;border:1px solid #444;display:block;`} />
          </div>
          <div>
            <div style="font-size:12px;color:#9ab;margin-bottom:6px;">② 추출 그림을 정규화 bbox로 absolute 배치 (위치 동일해야 함)</div>
            <div style={`position:relative;width:${W}px;aspect-ratio:${ar};background:#fff;border:1px solid #444;`}>
              {data.figures.map((f: any, i: number) => (
                <div style={`position:absolute;left:${f.x * 100}%;top:${f.y * 100}%;width:${f.w * 100}%;height:${f.h * 100}%;outline:2px solid rgba(220,40,40,.6);`}>
                  <img src={b64(f.file)} style="width:100%;height:100%;display:block;" />
                  <span style="position:absolute;top:-16px;left:0;font-size:10px;color:#c22;">fig{i}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <div style="font-size:12px;color:#9ab;margin-bottom:6px;">③ 추출 그림 단독 ({data.figures.length}개)</div>
            {data.figures.map((f: any, i: number) => (
              <div style="margin-bottom:10px;">
                <div style="font-size:10px;color:#888;">fig{i} · bbox(정규화) [{f.x}, {f.y}, {f.w}, {f.h}]</div>
                <img src={b64(f.file)} style="max-width:300px;background:#fff;border:1px solid #444;display:block;" />
              </div>
            ))}
          </div>
        </div>
        <pre style="font-size:11px;color:#8c8;margin-top:16px;">{JSON.stringify(data.figures, null, 2)}</pre>
      </>
    )}
  </body>
</html>
