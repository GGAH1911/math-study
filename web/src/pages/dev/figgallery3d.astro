---
export const prerender = false;
import Lazy3D from '../../components/Lazy3D.tsx';
import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import '../../styles/global.css';

// 3D 도식 갤러리. 두 소스:
//   기본(파일럿): /tmp/gen3d_final.json = [{concept,label,backend,score,scores,spec,note}] (5카테고리 검수)
//   ?src=cache: 본 캐시 concept-figures.json 의 figure3d 전수(전수 생성분 검토용)
const src = Astro.url.searchParams.get('src') ?? 'final';
let items: any[] = [];

/** 문제 md 경로 목록 — stem 으로 slug 를 되찾기 위해서만 쓴다. */
function glob3dProblems(): string[] {
  const out: string[] = [];
  const walk = (dir: string) => {
    for (const n of readdirSync(dir)) {
      const p = `${dir}/${n}`;
      if (statSync(p).isDirectory()) walk(p);
      else if (n.endsWith('.md')) out.push(p.slice(p.indexOf('docs/problems/')));
    }
  };
  try { walk(new URL('../../../../docs/problems', import.meta.url).pathname); } catch { /* */ }
  return out;
}
const CATS = ['스키마', '좌표정확', 'primitive', '가독성', '충실성'];
if (src === 'problems') {
  // 기출 3D 레지스트리(web/src/data/figures-3d/*.json) 검수.
  // ★원본 문제 그림을 **나란히** 놓는다 — 좌표가 조건을 만족해도 원본과 거울상일 수 있고,
  //   그건 sympy 로는 절대 안 잡힌다. 눈으로만 갈린다.
  const { listFigure3D, readFigure3D } = await import('../../lib/figures-3d');
  const { readProblem } = await import('../../lib/concept-fs');
  const idx = new Map<string, string>();
  for (const p of glob3dProblems()) idx.set(p.split('/').pop()!.replace(/\.md$/, ''), p);
  for (const stem of listFigure3D()) {
    const e = readFigure3D(stem);
    if (!e) continue;
    const slug = (idx.get(stem) ?? '').replace(/^docs\/problems\//, '').replace(/\.md$/, '');
    const prob = slug ? readProblem(slug) : null;
    items.push({
      concept: stem, label: stem, backend: `조건 ${e.conditions?.length ?? 0}개 검증`,
      score: 0, spec: e.spec, note: e.note ?? '',
      // 원본은 `/problem-images/<stem>.png`(db/raw 심링크)로 항상 있다.
      // figure_image(추출 도형)는 대부분 없어서 그것만 보면 원본이 안 뜬다 — 폴백 필수.
      figure: prob?.fm?.figure_image ?? `/problem-images/${encodeURIComponent(stem)}.png`,
      conditions: e.conditions ?? [],
    });
  }
} else if (src === 'cache') {
  try {
    const d = JSON.parse(readFileSync(new URL('../../data/concept-figures.json', import.meta.url), 'utf-8'));
    for (const [id, v] of Object.entries<any>(d.figures ?? {})) {
      if (v?.figure3d) items.push({ concept: id, label: v.label ?? id, backend: v.model3d ?? '?', score: 0, spec: v.figure3d, note: v.note3d ?? '' });
    }
  } catch { /* */ }
} else {
  const FINAL = '/tmp/gen3d_final.json';
  if (existsSync(FINAL)) { try { items = JSON.parse(readFileSync(FINAL, 'utf-8')); } catch { /* */ } }
}
// ★페이지네이션: 한 페이지에 WebGL Canvas 가 많으면(~16+) 브라우저 컨텍스트 한계로 빈화면.
//   페이지당 PER 개만 마운트. ?page=N (1-base).
items.sort((a, b) => String(a.concept).localeCompare(String(b.concept)));
// Lazy3D(IntersectionObserver)가 화면 보이는 것만 마운트 → 동시 컨텍스트 안전.
// ★헤드리스(swiftshader)는 컨텍스트 한계가 훨씬 낮아 12개면 'Context Lost' 로 검게 뜬다.
//   자동 검수용으로 ?per=3 처럼 줄일 수 있게 뒀다.
const PER = Math.min(24, Math.max(1, Number(Astro.url.searchParams.get('per') ?? 12)));
const total = items.length;
const pages = Math.max(1, Math.ceil(total / PER));
const page = Math.min(pages, Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1)));
const pageItems = items.slice((page - 1) * PER, page * PER);
const qsBase = `?src=${src}&per=${PER}`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>3D 도식 갤러리 — 5카테고리 검수</title>
  </head>
  <body style="margin:0;padding:24px;background:#0a0a0b;color:#e4e4e7;font-family:sans-serif;">
    <h1 style="font-size:20px;margin:0 0 4px;">3D 개념 도식 — 검수 갤러리 {src === 'cache' ? `(전수 ${total}개)` : '(파일럿 검수)'}</h1>
    <p style="color:#888;font-size:13px;margin:0 0 12px;">
      각 도식 드래그로 회전 · 페이지 {page}/{pages} (개당 WebGL 컨텍스트라 12개씩 분할) · {src === 'cache' ? '본 캐시 figure3d 전수' : '5카테고리 ≥45 합격 최선본'}
    </p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
      {Array.from({ length: pages }, (_, i) => i + 1).map((p) => (
        <a href={`${qsBase}&page=${p}`} style={`padding:4px 10px;border-radius:6px;font-size:12px;text-decoration:none;border:1px solid ${p === page ? '#22c55e' : '#3f3f46'};color:${p === page ? '#22c55e' : '#a1a1aa'};`}>{p}</a>
      ))}
    </div>
    {total === 0 && <p style="color:#f87171;">아직 3D 도식 없음</p>}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(720px,1fr));gap:20px;">
      {pageItems.map((it) => (
        <div style={`border:1px solid ${it.score >= 45 ? '#22c55e55' : '#52525244'};border-radius:12px;padding:14px;background:#18181b;`}>
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;">
            <strong style="font-size:15px;">{it.label}</strong>
            {it.score > 0 && <span style={`font-size:18px;font-weight:700;color:${it.score >= 45 ? '#22c55e' : '#a1a1aa'};`}>{it.score}/50</span>}
          </div>
          <div style="font-size:11px;color:#888;margin-bottom:10px;">
            {it.backend}{it.score > 0 ? (it.score >= 45 ? ' · ✓ 합격' : ' · 미달(참고)') : ''}
            {it.scores && ` · ${CATS.map((c, i) => `${c} ${it.scores[i]}`).join(' · ')}`}
          </div>
          <div style="display:flex;gap:10px;align-items:flex-start;">
            {it.figure && (
              <div style="flex:1 1 0;min-width:0;">
                <div style="font-size:10px;color:#666;margin-bottom:3px;">원본</div>
                <img src={it.figure} style="width:100%;background:#fff;border-radius:6px;" />
              </div>
            )}
            <div style="flex:1 1 0;min-width:0;">
              <div style="font-size:10px;color:#666;margin-bottom:3px;display:flex;justify-content:space-between;">
                <span>우리 3D (드래그 회전)</span>
                {src === 'problems' && (
                  <a href={`/dev/figrender3d?src=prob3d&id=${encodeURIComponent(it.concept)}&w=800&review=1`}
                     style="color:#60a5fa;text-decoration:none;">검수 →</a>
                )}
              </div>
              {it.spec
                ? <Lazy3D client:only="react" spec={it.spec} width={340} height={290} />
                : <p style="color:#777;font-size:12px;">spec 없음</p>}
            </div>
          </div>
          {it.note && <p style="font-size:11px;color:#71717a;margin:8px 0 0;">{it.note}</p>}
          {it.conditions?.length > 0 && (
            <details style="margin-top:6px;">
              <summary style="font-size:11px;color:#71717a;cursor:pointer;">검증된 조건 {it.conditions.length}개</summary>
              <ul style="font-size:11px;color:#a1a1aa;margin:4px 0 0;padding-left:16px;">
                {it.conditions.map((c: string) => <li>{c}</li>)}
              </ul>
            </details>
          )}
        </div>
      ))}
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:20px;">
      {Array.from({ length: pages }, (_, i) => i + 1).map((p) => (
        <a href={`${qsBase}&page=${p}`} style={`padding:4px 10px;border-radius:6px;font-size:12px;text-decoration:none;border:1px solid ${p === page ? '#22c55e' : '#3f3f46'};color:${p === page ? '#22c55e' : '#a1a1aa'};`}>{p}</a>
      ))}
    </div>
  </body>
</html>
