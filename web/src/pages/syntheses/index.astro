---
// Phase 3 전환 3호 — 껍데기는 서버, 목록은 클라이언트(`/api/content-index/syntheses`).
//
// ★총 개수는 헤더에 서버가 찍던 값이었다. 이제 목록과 함께 오므로 **아일랜드 안**으로 옮겼다 —
//   서버에서 세려면 `getCollection` 이 필요하고, 그러면 이 페이지가 다시 콘텐츠에 묶인다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SynthesesList from '../../components/SynthesesList.tsx';
---
<BaseLayout title="학습 노트">
  <div class="max-w-6xl mx-auto px-6 py-8 space-y-5">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">
        🗒 학습 노트
        <span class="text-xs text-[color:var(--color-muted)] font-normal">— LLM 대화에서 promote한 영구 노트</span>
      </h1>
      <p class="text-sm text-[color:var(--color-muted)]">채팅에서 [💾 저장] 누른 노트가 모입니다.</p>
    </header>

    <SynthesesList client:load />
  </div>
</BaseLayout>
