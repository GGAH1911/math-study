---
// SSR (prerender=false, 인증 게이팅). getStaticPaths/Astro.props 는 prerender=true
// 에서만 동작 — SSR 에선 실행되지 않아 Astro.props 가 비고 entry=undefined →
// render(undefined) 크래시(500)였다. Astro.params + getEntry 로 직접 조회한다
// (concepts/[...slug] 와 동일한 SSR 패턴).
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import SynthesisDeleteButton from '../../components/SynthesisDeleteButton.tsx';
import ContextDrawer from '../../components/ContextDrawer.astro';
import synthesesIndex from '../../data/syntheses-by-concept.json';
import { REVIEW_STATE_LABEL_KO } from '../../lib/srs.ts';

const slug = Astro.params.slug as string;
const entry = await getEntry('syntheses', slug);
if (!entry) {
  return new Response('Not found', { status: 404 });
}
const { Content } = await render(entry);
const fm = entry.data;

const originSlug = (fm.origin_concept ?? '')
  .replace(/^docs\/concepts\//, '')
  .replace(/\.md$/, '');
const originLabel = originSlug.split('/').pop()?.replace(/_/g, ' ') ?? '';

// build-syntheses-index.mjs already cleaned the title (concept-graph label
// when the note's h1 was a raw path). Use it for the page heading; fall back
// to the concept leaf label, never the raw id.
type IndexEntry = { slug: string; title?: string; origin_title?: string };
const indexEntry = ((synthesesIndex as any).recent ?? [] as IndexEntry[])
  .find((r: IndexEntry) => r.slug === entry.id);
const pageTitle = indexEntry?.title ?? indexEntry?.origin_title ?? originLabel ?? entry.id;

const fmt = (d: Date | undefined) => d ? d.toISOString().slice(0, 10) : null;
const created = fmt(fm.created) ?? entry.id.match(/^(\d{4}-\d{2}-\d{2})/)?.[1] ?? null;
const updated = fmt(fm.updated);
const nextReview = fmt(fm.next_review);
---
<BaseLayout title={pageTitle}>
  <div class="max-w-6xl mx-auto pl-6 xl:pr-6 max-xl:pr-14 py-8 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-8">
    <article class="prose prose-invert max-w-none min-w-0">
      <Content />
    </article>

    <ContextDrawer label="노트 정보 · 출처" icon="🗒">
      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">메타정보</h3>
        <dl class="text-sm space-y-1.5">
          {created && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">작성일</dt><dd>{created}</dd></div>}
          {updated && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">수정일</dt><dd>{updated}</dd></div>}
          {fm.review_state && (
            <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">복습 상태</dt><dd><span class="chip">{REVIEW_STATE_LABEL_KO[fm.review_state] ?? fm.review_state}</span></dd></div>
          )}
          {nextReview && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">다음 복습</dt><dd>{nextReview}</dd></div>}
          {fm.promoted_from && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">출처</dt><dd>{fm.promoted_from}</dd></div>}
        </dl>
      </section>

      {originSlug && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">출처</h3>
          <a class="text-sm text-[color:var(--color-accent)] hover:underline block" href={`/concepts/${originSlug}`}>
            ← {originLabel}
          </a>
          <p class="text-[10px] font-mono text-[color:var(--color-subtle)] mt-1 truncate" title={originSlug}>
            {originSlug}
          </p>
          <a
            href={`/graph?highlight=${encodeURIComponent(originSlug)}`}
            class="mt-3 block text-center px-3 py-1.5 rounded-md bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-xs font-medium transition"
          >개념 지도에서 보기 →</a>
        </section>
      )}

      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">목록</h3>
        <a class="text-sm text-[color:var(--color-accent)] hover:underline" href="/syntheses">← 학습 노트 전체</a>
      </section>

      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">관리</h3>
        <SynthesisDeleteButton client:load slug={entry.id} />
      </section>
    </ContextDrawer>
  </div>
</BaseLayout>
