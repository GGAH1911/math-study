---
// Phase 3 전환 10호(A그룹 2/4) — 본문은 선렌더 방출물(`/api/content/syntheses/<id>`).
// ★제목은 별도 빌드 산출물에서 오므로 서버가 모른다 — 섬이 `document.title` 을 갱신한다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContextDrawer from '../../components/ContextDrawer.astro';
import ContentArticle from '../../components/ContentArticle.tsx';
import SynthesisMeta from '../../components/SynthesisMeta.tsx';

const slug = Astro.params.slug as string;
if (!slug) return new Response('Not found', { status: 404 });
---
<BaseLayout title="학습 노트">
  <div class="max-w-6xl mx-auto px-6 md:max-xl:pr-14 py-8 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-8">
    <article class="prose prose-invert max-w-none min-w-0">
      <ContentArticle client:load collection="syntheses" id={slug} />
    </article>

    <ContextDrawer label="노트 정보 · 출처" icon="🗒">
      <SynthesisMeta client:load id={slug} />
    </ContextDrawer>
  </div>
</BaseLayout>
