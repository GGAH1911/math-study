---
// SSR (prerender=false, 인증 게이팅). getStaticPaths/Astro.props 는 prerender=true
// 에서만 동작 — SSR 에선 entry=undefined → render(undefined) 크래시(500)였다.
// Astro.params + getEntry 로 직접 조회(concepts/[...slug] 와 동일 패턴).
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const slug = Astro.params.slug as string;
const entry = await getEntry('mistakes', slug);
if (!entry) {
  return new Response('Not found', { status: 404 });
}
const { Content } = await render(entry);
const fm = entry.data;
// 'docs/problems/<slug>.md' (flat) → path-aware slug 'YYYY/round/<slug>'
const SUBJECT_RE = /^(\d{4})_(.+)_(?:공통|기하|미적분|확률과통계|단일)_\d+$/;
const fmtProblemPath = (p: string) => {
  const flat = p.replace(/^docs\/problems\//, '').replace(/\.md$/, '');
  const m = flat.match(SUBJECT_RE);
  return m ? `${m[1]}/${m[2]}/${flat}` : flat;
};
const labelOf = (slug: string) => slug.split('/').pop() ?? slug;
---
<BaseLayout title={entry.id}>
  <div class="max-w-6xl mx-auto px-6 lg:px-4 xl:px-6 py-8 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_216px] xl:grid-cols-[minmax(0,1fr)_280px] gap-8 lg:gap-6 xl:gap-8">
    <article class="prose prose-invert max-w-none min-w-0">
      <Content />
    </article>

    <aside class="lg:sticky lg:top-20 self-start space-y-4">
      <section class="card">
        <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">Mistake meta</h3>
        <dl class="text-sm space-y-1.5">
          <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">error</dt><dd><span class={`chip chip-error-${fm.error_type}`}>{fm.error_type}</span></dd></div>
          {fm.revisit_date && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">revisit</dt><dd>{fm.revisit_date.toISOString().slice(0,10)}</dd></div>}
          {fm.next_review && <div class="flex justify-between"><dt class="text-[color:var(--color-muted)]">next review</dt><dd>{fm.next_review.toISOString().slice(0,10)}</dd></div>}
        </dl>
        {fm.lesson && (
          <p class="text-xs text-[color:var(--color-muted)] mt-3 leading-relaxed">{fm.lesson}</p>
        )}
      </section>

      {fm.problem && (
        <section class="card">
          <h3 class="text-xs uppercase tracking-[0.15em] text-[color:var(--color-subtle)] mb-2">원 문제</h3>
          <a class="text-sm text-[color:var(--color-accent)] hover:underline" href={`/problems/${fmtProblemPath(fm.problem)}`}>{labelOf(fmtProblemPath(fm.problem))} →</a>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>
