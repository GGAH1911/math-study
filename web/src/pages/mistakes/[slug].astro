---
// Phase 3 전환 9호(A그룹 1/4) — 본문은 선렌더 방출물(`/api/content/mistakes/<id>`).
//
// ★`ContextDrawer` 의 껍데기와 개폐 스크립트는 서버 렌더로 **남긴다.** 그쪽까지 섬으로 옮기면
//   스크립트가 빈 DOM 을 훑는 타이밍 함정을 또 만든다(ProblemFilters 에서 겪은 것과 같다).
//   서랍 **안의 내용만** 섬으로 넣는다.
// ★본문 섬과 메타 섬이 같은 문서를 쓰지만 요청은 한 번이다 — `lib/content-entry.ts` 가
//   모듈 수준에서 약속을 공유한다.
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContextDrawer from '../../components/ContextDrawer.astro';
import ContentArticle from '../../components/ContentArticle.tsx';
import MistakeMeta from '../../components/MistakeMeta.tsx';

const slug = Astro.params.slug as string;
if (!slug) return new Response('Not found', { status: 404 });
---
<BaseLayout title={slug}>
  <div class="max-w-6xl mx-auto px-6 md:max-xl:pr-14 py-8 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-8">
    <article class="prose prose-invert max-w-none min-w-0">
      <ContentArticle client:load collection="mistakes" id={slug} />
    </article>

    <ContextDrawer label="오답 정보" icon="✕">
      <MistakeMeta client:load id={slug} />
    </ContextDrawer>
  </div>
</BaseLayout>
