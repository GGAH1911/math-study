# deploy/.env — docker compose 시크릿/설정. ★실제 .env 는 미커밋(.gitignore). tme 에서 생성.
# 사용: cp .env.example .env && 값 채우기 → docker compose up -d --build

# postgres 비밀번호(강하게). web↔db 내부 통신 + 호스트 미노출.
MS_DB_PASSWORD=change-me-to-strong-password

# 관리자 이메일(allowlist). /dev/* 와 admin API 접근.
MS_ADMIN_EMAILS=hwangi0404@gmail.com

# 튜터 claude -p 구독 인증 디렉터리(호스트). 컨테이너 /home/node/.claude 로 마운트(rw).
MS_CLAUDE_DIR=/home/insung/.claude

# 학습기 노출 포트(호스트). 포렌식 3000/8000/5432 와 무충돌(4324 빔). 프록시 뒤로 가면 127.0.0.1 바인드로.
MS_WEB_PORT=4324

# TLS 리버스 프록시(도메인 HTTPS) 붙인 뒤에만 true. http 직접 접속 단계에선 false(쿠키 전달).
MS_SECURE_COOKIES=false

# ★제품 튜터(Nous Portal). **필수 — 없으면 튜터가 503 으로 죽는다.**
#   학생 트래픽은 전부 이 경로다(chat.ts: 프런트가 model 을 안 보내 기본값 'tutor' 로 고정).
#   폴백은 의도적으로 없다 — 폴백은 장애를 숨겨 발견을 늦춘다(2026-08-12 에 15시간 늦었다).
MS_NOUS_API_KEY=nous-api-key-here
# 튜터 모델. 미설정이면 openai/gpt-5.6-luna (40문항 블라인드 A/B 로 채택).
# MS_TUTOR_MODEL=openai/gpt-5.6-luna

# ★claude -p 구독 인증(1년 장기 토큰). `claude setup-token` 으로 발급.
#   대화형 로그인이 만든 ~/.claude/.credentials.json 은 조용히 만료된다(2026-08-12 에
#   claudeAiOauth 블록이 사라져 튜터가 15시간 죽었고 /api/health 는 내내 200이었다).
#   튜터 외에 **인제스트 교정 파이프라인**(web/scripts/lib/claude_p.mjs)도 이 값을 읽는다 —
#   없으면 claude 가 "Not logged in" 만 뱉고 exit 0 이라 **문항이 조용히 격리된다**(2026-08-14 실측).
MS_CLAUDE_OAUTH_TOKEN=sk-ant-oat-...
